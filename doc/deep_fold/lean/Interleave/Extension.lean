/-
Theorem 6.1 of the paper for a code given by a generator, with values in any finite-dimensional
vector space: the statement of Section 6.1 that "an `h`-lane `E`-valued word is a `2h`-lane
`K`-valued word with the same list", composed with the tree bound.

A basis of `V` over `K` turns a `V`-valued word into an interleaved `K`-valued word, with one
lane for each basis vector, and a list of messages `κ → V` into a list of tuples of codewords.
-/
import Interleave.Tree
import Interleave.Projection

open Finset

namespace Interleave

variable {K : Type*} [Field K] {ι κ : Type*} [Fintype κ] {G : ι → κ → K} {D : Finset ι}
  {d a L : ℕ}

theorem GenListBound.mono {V : Type*} [AddCommGroup V] [Module K V] {a' L' : ℕ}
    (h : GenListBound G D V a L) (ha : a ≤ a') (hL : L ≤ L') : GenListBound G D V a' L' :=
  fun w S hS => (h w S fun m hm => ha.trans (hS m hm)).trans hL

/-- With more than `|D|` agreements asked, every list is empty. -/
theorem genListBound_zero (V : Type*) [AddCommGroup V] [Module K V] (G : ι → κ → K)
    (h : D.card < a) : GenListBound G D V a 0 := by
  intro w S hS
  by_contra hne
  obtain ⟨m, hm⟩ : S.Nonempty := card_pos.mp (Nat.pos_of_ne_zero fun h0 => hne (le_of_eq h0))
  have := (hS m hm).trans (card_le_card (agr_subset D w (enc G m)))
  omega

/-- The zero message is in the list of the zero word, so a list bound is positive unless
more than `|D|` agreements are asked. -/
theorem GenListBound.pos_or {V : Type*} [AddCommGroup V] [Module K V]
    (h : GenListBound G D V a L) : 1 ≤ L ∨ D.card < a := by
  by_contra hcon
  have := h (enc G 0) {0} fun m hm => by
    rw [mem_singleton.mp hm, agr_self]
    omega
  rw [card_singleton] at this
  omega

/-- The code generated by `G` over `K` has the agreement bound, as a set of words. -/
theorem agreeLE_range (hG : ∀ m m' : κ → K, m ≠ m' → (agr D (enc G m) (enc G m')).card ≤ d) :
    AgreeLE D (Set.range (enc (V := K) G)) d := by
  rintro _ ⟨m, rfl⟩ _ ⟨m', rfl⟩ hne
  exact hG m m' fun h => hne (by rw [h])

/-- A list bound for messages is a list bound for the words of the code. -/
theorem GenListBound.listBound_range (hL : GenListBound G D K a L) :
    ListBound D (Set.range (enc (V := K) G)) a L := by
  classical
  intro w S hS
  choose! f hf using fun c (hc : c ∈ S) => (hS c hc).1
  have hinj : Set.InjOn f S := by
    intro c hc c' hc' h
    rw [← hf c hc, ← hf c' hc', h]
  rw [← card_image_of_injOn hinj]
  refine hL w _ fun m hm => ?_
  obtain ⟨c, hc, rfl⟩ := mem_image.mp hm
  rw [hf c hc]
  exact (hS c hc).2

/-- Unique decoding for a generated code. -/
theorem gen_unique (hG : ∀ m m' : κ → K, m ≠ m' → (agr D (enc G m) (enc G m')).card ≤ d)
    (h : D.card + d < 2 * a) : GenListBound G D K a 1 := by
  classical
  intro w S hS
  refine card_le_one.mpr fun m hm m' hm' => ?_
  by_contra hne
  have h1 := card_union_add_card_inter (agr D w (enc G m)) (agr D w (enc G m'))
  have h2 : (agr D w (enc G m) ∪ agr D w (enc G m')).card ≤ D.card :=
    card_le_card (union_subset (agr_subset _ _ _) (agr_subset _ _ _))
  have h3 : (agr D w (enc G m) ∩ agr D w (enc G m')).card ≤ d :=
    (card_le_card fun _ hi => mem_agr_of_mem_agr (mem_inter.mp hi).1 (mem_inter.mp hi).2).trans
      (hG m m' hne)
  have h4 := hS m hm
  have h5 := hS m' hm'
  omega

/-- **Theorem 6.1 of the paper for a generated code and any finite-dimensional space of values.**
If the words of two distinct `K`-valued messages agree on at most `d` coordinates, `d < a`, and
every `K`-valued word has at most `L` list members at agreement `a`, then every word with values in
a finite-dimensional `K`-vector space `V` has at most `N(n - d)` list members,
`N = treeN L (a - d)`. The field `K` need not be finite. -/
theorem gen_interleave
    (hG : ∀ m m' : κ → K, m ≠ m' → (agr D (enc G m) (enc G m')).card ≤ d) (hda : d < a)
    (hL : GenListBound G D K a L) (V : Type*) [AddCommGroup V] [Module K V]
    [Module.Finite K V] : GenListBound G D V a (treeN L (a - d) (D.card - d)) := by
  classical
  intro w S hS
  obtain ⟨e, he⟩ : ∃ e : V →ₗ[K] (Fin (Module.finrank K V) → K), Function.Injective e :=
    ⟨(Module.finBasis K V).equivFun, LinearEquiv.injective _⟩
  have hI := interleave_listBound (agreeLE_range hG) hda hL.listBound_range
    (Fin (Module.finrank K V))
  -- the tuple of codewords of a message
  obtain ⟨Φ, hΦ⟩ : ∃ Φ : (κ → V) → ι → Fin (Module.finrank K V) → K,
      ∀ m i, Φ m i = e (enc G m i) := ⟨fun m i => e (enc G m i), fun _ _ => rfl⟩
  have hlane : ∀ m j, lane j (Φ m) = enc G (fun k => e (m k) j) := by
    intro m j
    funext i
    rw [lane_apply, hΦ, map_enc]
    simp only [enc, Finset.sum_apply, Pi.smul_apply]
  have hinj : Set.InjOn Φ S := by
    intro m hm m' hm' h
    by_contra hne
    obtain ⟨k, hk⟩ := Function.ne_iff.mp hne
    obtain ⟨j, hj⟩ := Function.ne_iff.mp fun h' => hk (he h')
    have hne' : (fun k => e (m k) j) ≠ (fun k => e (m' k) j) := fun h' => hj (congrFun h' k)
    have h1 := hG _ _ hne'
    rw [← hlane, ← hlane, h, agr_self] at h1
    have h2 := (hS m hm).trans (card_le_card (agr_subset D w (enc G m)))
    omega
  rw [← card_image_of_injOn hinj]
  refine hI (fun i => e (w i)) _ fun c hc => ?_
  obtain ⟨m, hm, rfl⟩ := mem_image.mp hc
  refine ⟨fun j => ?_, (hS m hm).trans (card_le_card fun i hi => ?_)⟩
  · rw [hlane]
    exact ⟨_, rfl⟩
  · refine mem_agr.mpr ⟨(mem_agr.mp hi).1, ?_⟩
    rw [hΦ, (mem_agr.mp hi).2]

/-- The bound of `gen_interleave` can be replaced by any `B` it does not exceed when `1 ≤ L`. -/
theorem gen_interleave_le
    (hG : ∀ m m' : κ → K, m ≠ m' → (agr D (enc G m) (enc G m')).card ≤ d) (hda : d < a)
    (hL : GenListBound G D K a L) (V : Type*) [AddCommGroup V] [Module K V]
    [Module.Finite K V] {B : ℕ} (hB : 1 ≤ L → treeN L (a - d) (D.card - d) ≤ B) :
    GenListBound G D V a B := by
  rcases hL.pos_or with h1 | h1
  · exact (gen_interleave hG hda hL V).mono le_rfl (hB h1)
  · exact (genListBound_zero V G h1).mono le_rfl (Nat.zero_le _)

/-- For `a > (n + 2d)/3`, lanes and extensions cost nothing. -/
theorem gen_interleave_same
    (hG : ∀ m m' : κ → K, m ≠ m' → (agr D (enc G m) (enc G m')).card ≤ d) (hda : d < a)
    (hL : GenListBound G D K a L) (h3 : D.card + 2 * d < 3 * a) (V : Type*) [AddCommGroup V]
    [Module K V] [Module.Finite K V] : GenListBound G D V a L :=
  gen_interleave_le hG hda hL V fun h1 => treeN_le_L h1 (by omega)

/-- For `a > (n + 3d)/4`, lanes and extensions cost at most `2L - 1`. -/
theorem gen_interleave_two_mul
    (hG : ∀ m m' : κ → K, m ≠ m' → (agr D (enc G m) (enc G m')).card ≤ d) (hda : d < a)
    (hL : GenListBound G D K a L) (h4 : D.card + 3 * d < 4 * a) (V : Type*) [AddCommGroup V]
    [Module K V] [Module.Finite K V] : GenListBound G D V a (2 * L - 1) :=
  gen_interleave_le hG hda hL V fun h1 => treeN_le_two_mul h1 (by omega)

/-- For `a > (n + 4d)/5`, lanes and extensions cost at most `L² + L - 1`. -/
theorem gen_interleave_sq
    (hG : ∀ m m' : κ → K, m ≠ m' → (agr D (enc G m) (enc G m')).card ≤ d) (hda : d < a)
    (hL : GenListBound G D K a L) (h5 : D.card + 4 * d < 5 * a) (V : Type*) [AddCommGroup V]
    [Module K V] [Module.Finite K V] : GenListBound G D V a (L * L + L - 1) :=
  gen_interleave_le hG hda hL V fun h1 => treeN_le_sq h1 (by omega)

end Interleave
