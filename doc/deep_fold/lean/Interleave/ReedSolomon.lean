/-
The interleaving reductions for Reed-Solomon codes, in the words of the paper: lists of
polynomials (or tuples of polynomials) of degree at most `d`, agreeing with a word on at least
`a` points of a finite set `D` of points of a field `K`, the word and the polynomials having
their values and coefficients in `K`, in a `K`-algebra `F` (an extension field), or in tuples.

`RSListBound₁ D d a L` is the hypothesis `H_K` (Hypothesis 6.4 of the paper): every word `D → K`
has at most `L` polynomials of `K[X]` of degree at most `d` agreeing with it on at least `a`
points. `RSListBound D F lanes d a L` is the same for words `D → F^lanes` and tuples of
polynomials of `F[X]`: the statement `ListBound` (Hypothesis 5.1 of the paper).

The Reed-Solomon code is the code generated by `powG d x k = x ^ k`, a message being the
coefficient vector of a polynomial, so the statements here are those of `Projection.lean` and
`Extension.lean` read through that dictionary.
-/
import Interleave.Extension

open Finset Polynomial

namespace Interleave

section Coefficients

variable {R : Type*} [Semiring R]

/-- The polynomial with coefficient vector `m`. -/
noncomputable def toPoly (d : ℕ) (m : Fin (d + 1) → R) : R[X] :=
  ∑ k : Fin (d + 1), monomial (k : ℕ) (m k)

theorem toPoly_natDegree_le (d : ℕ) (m : Fin (d + 1) → R) : (toPoly d m).natDegree ≤ d :=
  natDegree_sum_le_of_forall_le _ _ fun k _ =>
    (natDegree_monomial_le _).trans (Nat.lt_succ_iff.mp k.isLt)

theorem toPoly_coeff (d : ℕ) (m : Fin (d + 1) → R) (k : Fin (d + 1)) :
    (toPoly d m).coeff k = m k := by
  classical
  rw [toPoly, finsetSum_coeff]
  simp only [coeff_monomial, Finsupp.single_apply, Fin.val_inj]
  rw [Finset.sum_ite_eq' univ k]
  simp only [mem_univ, ite_true]

theorem toPoly_injective (d : ℕ) : Function.Injective (toPoly (R := R) d) := by
  intro m m' h
  funext k
  rw [← toPoly_coeff d m k, ← toPoly_coeff d m' k, h]

/-- A polynomial of degree at most `d` is determined by its first `d + 1` coefficients. -/
theorem eq_of_coeff_eq {d : ℕ} {P Q : R[X]} (hP : P.natDegree ≤ d) (hQ : Q.natDegree ≤ d)
    (h : ∀ k : Fin (d + 1), P.coeff k = Q.coeff k) : P = Q := by
  ext k
  by_cases hk : k < d + 1
  · exact h ⟨k, hk⟩
  · rw [coeff_eq_zero_of_natDegree_lt (by omega), coeff_eq_zero_of_natDegree_lt (by omega)]

end Coefficients

variable {K : Type*} [Field K]

/-- The generator of the Reed-Solomon code of degree at most `d`: `powG d x k = x ^ k`. -/
def powG (d : ℕ) (x : K) (k : Fin (d + 1)) : K := x ^ (k : ℕ)

section Algebra

variable {F : Type*} [CommRing F] [Algebra K F] {lanes : Type*} {d : ℕ}

/-- The word of the coefficient vector of a polynomial is its evaluation at the points of `K`. -/
theorem enc_powG_coeff {P : F[X]} (hP : P.natDegree ≤ d) (x : K) :
    enc (powG d) (fun k : Fin (d + 1) => P.coeff k) x = P.eval (algebraMap K F x) := by
  rw [eval_eq_sum_range' (Nat.lt_succ_of_le hP),
    ← Fin.sum_univ_eq_sum_range (fun k => P.coeff k * algebraMap K F x ^ k) (d + 1)]
  refine Finset.sum_congr rfl fun k _ => ?_
  rw [powG, Algebra.smul_def, map_pow, mul_comm]

/-- The coefficient vector of a tuple of polynomials: a message with values in `lanes → F`. -/
def coeffs (d : ℕ) (P : lanes → F[X]) (k : Fin (d + 1)) (u : lanes) : F := (P u).coeff k

theorem enc_coeffs {P : lanes → F[X]} (hP : ∀ u, (P u).natDegree ≤ d) :
    enc (powG d) (coeffs d P) = fun (x : K) u => (P u).eval (algebraMap K F x) := by
  funext x u
  rw [← enc_powG_coeff (hP u) x]
  simp only [enc, coeffs, Finset.sum_apply, Pi.smul_apply]

theorem coeffs_injOn {P Q : lanes → F[X]} (hP : ∀ u, (P u).natDegree ≤ d)
    (hQ : ∀ u, (Q u).natDegree ≤ d) (h : coeffs d P = coeffs d Q) : P = Q := by
  funext u
  exact eq_of_coeff_eq (hP u) (hQ u) fun k => congrFun (congrFun h k) u

/-- The tuple of polynomials with coefficient vector `m`. -/
noncomputable def toPolyL (d : ℕ) (m : Fin (d + 1) → lanes → F) (u : lanes) : F[X] :=
  toPoly d (fun k => m k u)

theorem coeffs_toPolyL (m : Fin (d + 1) → lanes → F) : coeffs d (toPolyL d m) = m := by
  funext k u
  exact toPoly_coeff d _ k

end Algebra

/-- The word of a coefficient vector with values in `K`. -/
theorem enc_toPoly {d : ℕ} (m : Fin (d + 1) → K) :
    enc (powG d) m = fun x => (toPoly d m).eval x := by
  funext x
  have h := enc_powG_coeff (F := K) (toPoly_natDegree_le d m) x
  simp only [toPoly_coeff, Algebra.algebraMap_self, RingHom.id_apply] at h
  exact h

/-- Two distinct polynomials of degree at most `d` agree on at most `d` points. -/
theorem rs_agree_le (D : Finset K) {d : ℕ} (m m' : Fin (d + 1) → K) (hne : m ≠ m') :
    (agr D (enc (powG d) m) (enc (powG d) m')).card ≤ d := by
  classical
  have hP : toPoly d m - toPoly d m' ≠ 0 :=
    sub_ne_zero.mpr fun h => hne (toPoly_injective d h)
  have hdeg : (toPoly d m - toPoly d m').natDegree ≤ d :=
    (natDegree_sub_le_of_le (toPoly_natDegree_le d m) (toPoly_natDegree_le d m')).trans
      (max_self d).le
  have hsub : agr D (enc (powG d) m) (enc (powG d) m') ⊆
      (toPoly d m - toPoly d m').roots.toFinset := by
    intro x hx
    have h := (mem_agr.mp hx).2
    rw [enc_toPoly, enc_toPoly] at h
    rw [Multiset.mem_toFinset, mem_roots hP, IsRoot.def, eval_sub, sub_eq_zero]
    exact h
  exact (card_le_card hsub).trans
    ((Multiset.toFinset_card_le _).trans ((card_roots' _).trans hdeg))

/-- `H_K` (Hypothesis 6.4 of the paper): every word `K → K` has at most `L` polynomials of `K[X]`
of degree at most `d` agreeing with it on at least `a` points of `D`. -/
def RSListBound₁ (D : Finset K) (d a L : ℕ) : Prop :=
  ∀ (w : K → K) (S : Finset K[X]),
    (∀ P ∈ S, P.natDegree ≤ d ∧ a ≤ (agr D w (fun x => P.eval x)).card) → S.card ≤ L

/-- `ListBound` (Hypothesis 5.1 of the paper): every word with values in `lanes → F`, for a
`K`-algebra `F`, has at most `L` tuples of polynomials of `F[X]` of degree at most `d` agreeing
with it, in all lanes, on at least `a` points of `D`. -/
def RSListBound (D : Finset K) (F : Type*) [CommRing F] [Algebra K F] (lanes : Type*)
    (d a L : ℕ) : Prop :=
  ∀ (w : K → lanes → F) (S : Finset (lanes → F[X])),
    (∀ P ∈ S, (∀ u, (P u).natDegree ≤ d) ∧
      a ≤ (agr D w (fun x u => (P u).eval (algebraMap K F x))).card) → S.card ≤ L

variable {D : Finset K} {d a L : ℕ}

/-- A list of tuples of polynomials is a list of messages of the same size. -/
theorem exists_messages {F : Type*} [CommRing F] [Algebra K F] {lanes : Type*}
    (w : K → lanes → F) (S : Finset (lanes → F[X]))
    (hS : ∀ P ∈ S, (∀ u, (P u).natDegree ≤ d) ∧
      a ≤ (agr D w (fun x u => (P u).eval (algebraMap K F x))).card) :
    ∃ S' : Finset (Fin (d + 1) → lanes → F), S'.card = S.card ∧
      ∀ m ∈ S', a ≤ (agr D w (enc (powG d) m)).card := by
  classical
  refine ⟨S.image (coeffs d), card_image_of_injOn fun P hP Q hQ h =>
    coeffs_injOn (hS P hP).1 (hS Q hQ).1 h, fun m hm => ?_⟩
  obtain ⟨P, hP, rfl⟩ := mem_image.mp hm
  rw [enc_coeffs (hS P hP).1]
  exact (hS P hP).2

/-- A list of polynomials of `K[X]` is a list of messages of the same size. -/
theorem exists_messages₁ (w : K → K) (S : Finset K[X])
    (hS : ∀ P ∈ S, P.natDegree ≤ d ∧ a ≤ (agr D w (fun x => P.eval x)).card) :
    ∃ S' : Finset (Fin (d + 1) → K), S'.card = S.card ∧
      ∀ m ∈ S', a ≤ (agr D w (enc (powG d) m)).card := by
  classical
  refine ⟨S.image (fun P k => P.coeff k), card_image_of_injOn fun P hP Q hQ h =>
    eq_of_coeff_eq (hS P hP).1 (hS Q hQ).1 fun k => congrFun h k, fun m hm => ?_⟩
  obtain ⟨P, hP, rfl⟩ := mem_image.mp hm
  have h := (hS P hP).2
  have e : enc (powG d) (fun k : Fin (d + 1) => P.coeff k) = fun x => P.eval x := by
    funext x
    rw [enc_powG_coeff (F := K) (hS P hP).1 x, Algebra.algebraMap_self, RingHom.id_apply]
  rw [e]
  exact h

/-- `H_K` is the list bound of the generated code for `K`-valued words. -/
theorem rsListBound₁_iff : RSListBound₁ D d a L ↔ GenListBound (powG d) D K a L := by
  classical
  constructor
  · intro h w S hS
    rw [← card_image_of_injective S (toPoly_injective d)]
    refine h w _ fun P hP => ?_
    obtain ⟨m, hm, rfl⟩ := mem_image.mp hP
    refine ⟨toPoly_natDegree_le d m, ?_⟩
    have := hS m hm
    rwa [enc_toPoly] at this
  · intro h w S hS
    obtain ⟨S', hcard, hS'⟩ := exists_messages₁ w S hS
    rw [← hcard]
    exact h w S' hS'

/-- `ListBound` for tuples is the list bound of the generated code for `F^lanes`-valued words. -/
theorem rsListBound_iff {F : Type*} [CommRing F] [Algebra K F] {lanes : Type*} :
    RSListBound D F lanes d a L ↔ GenListBound (powG d) D (lanes → F) a L := by
  classical
  constructor
  · intro h w S hS
    have hinj : Function.Injective (toPolyL (F := F) (lanes := lanes) d) := fun m m' h' => by
      rw [← coeffs_toPolyL m, ← coeffs_toPolyL m', h']
    rw [← card_image_of_injective S hinj]
    refine h w _ fun P hP => ?_
    obtain ⟨m, hm, rfl⟩ := mem_image.mp hP
    have hdeg : ∀ u, (toPolyL d m u).natDegree ≤ d := fun u => toPoly_natDegree_le d _
    refine ⟨hdeg, ?_⟩
    have := hS m hm
    rwa [← coeffs_toPolyL m, enc_coeffs hdeg] at this
  · intro h w S hS
    obtain ⟨S', hcard, hS'⟩ := exists_messages w S hS
    rw [← hcard]
    exact h w S' hS'

/-- The same bound with the points and the word in `F`, the shape of the DEEP fold lemma
(`DeepFold.agrL`): the points are the images in `F` of the points of `D`, the word is any
function `F → lanes → F`, and a tuple is evaluated at points of `F`. -/
theorem RSListBound.image {F : Type*} [CommRing F] [Algebra K F] {lanes : Type*}
    [DecidableEq F] (h : RSListBound D F lanes d a L) (w : F → lanes → F)
    (S : Finset (lanes → F[X]))
    (hS : ∀ P ∈ S, (∀ u, (P u).natDegree ≤ d) ∧
      a ≤ (agr (D.image (algebraMap K F)) w (fun y u => (P u).eval y)).card) : S.card ≤ L := by
  refine h (fun x => w (algebraMap K F x)) S fun P hP => ⟨(hS P hP).1, (hS P hP).2.trans ?_⟩
  refine le_trans (card_le_card ?_)
    (card_image_le (s := agr D (fun x => w (algebraMap K F x))
      (fun x u => (P u).eval (algebraMap K F x))) (f := algebraMap K F))
  intro y hy
  obtain ⟨hyD, hyw⟩ := mem_agr.mp hy
  obtain ⟨x, hx, rfl⟩ := mem_image.mp hyD
  exact mem_image.mpr ⟨x, mem_agr.mpr ⟨hx, hyw⟩, rfl⟩

/-- Unique decoding: for `a > (n + d)/2` the hypothesis `H_K` holds with `L = 1`. -/
theorem rsListBound₁_one (D : Finset K) {d a : ℕ} (h : D.card + d < 2 * a) :
    RSListBound₁ D d a 1 :=
  rsListBound₁_iff.mpr (gen_unique (rs_agree_le D) h)

section TheoremI

variable (F : Type*) [CommRing F] [Algebra K F] [Module.Finite K F] (lanes : Type*)
  [Finite lanes]

/-- **Theorem 6.1 of the paper for Reed-Solomon codes.** From `H_K` with list size `L` at
agreement `a > d`: every word with values in `F^lanes`, for a `K`-algebra `F` of finite dimension
over `K` and any finite number of lanes, has at most `N(n - d)` tuples of polynomials within
agreement `a`, with `N = treeN L (a - d)` and `n = |D|`. The field `K` need not be finite. -/
theorem rs_interleave (hL : RSListBound₁ D d a L) (hda : d < a) :
    RSListBound D F lanes d a (treeN L (a - d) (D.card - d)) :=
  rsListBound_iff.mpr (gen_interleave (rs_agree_le D) hda (rsListBound₁_iff.mp hL) (lanes → F))

/-- For `a > (n + 2d)/3`: lanes and extensions cost nothing. -/
theorem rs_interleave_same (hL : RSListBound₁ D d a L) (hda : d < a)
    (h3 : D.card + 2 * d < 3 * a) : RSListBound D F lanes d a L :=
  rsListBound_iff.mpr
    (gen_interleave_same (rs_agree_le D) hda (rsListBound₁_iff.mp hL) h3 (lanes → F))

/-- For `a > (n + 3d)/4`: lanes and extensions cost at most `2L - 1`. -/
theorem rs_interleave_two_mul (hL : RSListBound₁ D d a L) (hda : d < a)
    (h4 : D.card + 3 * d < 4 * a) : RSListBound D F lanes d a (2 * L - 1) :=
  rsListBound_iff.mpr
    (gen_interleave_two_mul (rs_agree_le D) hda (rsListBound₁_iff.mp hL) h4 (lanes → F))

/-- For `a > (n + 4d)/5`: lanes and extensions cost at most `L² + L - 1`. -/
theorem rs_interleave_sq (hL : RSListBound₁ D d a L) (hda : d < a)
    (h5 : D.card + 4 * d < 5 * a) : RSListBound D F lanes d a (L * L + L - 1) :=
  rsListBound_iff.mpr
    (gen_interleave_sq (rs_agree_le D) hda (rsListBound₁_iff.mp hL) h5 (lanes → F))

end TheoremI

section R2

variable (F : Type*) [CommRing F] [Algebra K F] [Finite F] (lanes : Type*) [Finite lanes]

section SingleLane

variable [Fintype K]

/-- **Proposition 6.2 of the paper for Reed-Solomon codes, from single `K`-valued words**
(`s = 1`). From `H_K` with list size `L` and `2L ≤ |K|`: every list `S` of a word with values in
`F^lanes`, for a finite `K`-algebra `F` and any finite number of lanes, has `|S| ≤ 2L - 1` and
`|S|·(|K| - L) ≤ L·|K|`, that is `|S| ≤ L/(1 - L/|K|)`. -/
theorem rs_descent₁ (hL : RSListBound₁ D d a L) (h2 : 2 * L ≤ Fintype.card K)
    (w : K → lanes → F) (S : Finset (lanes → F[X]))
    (hS : ∀ P ∈ S, (∀ u, (P u).natDegree ≤ d) ∧
      a ≤ (agr D w (fun x u => (P u).eval (algebraMap K F x))).card) :
    S.card ≤ 2 * L - 1 ∧ S.card * (Fintype.card K - L) ≤ L * Fintype.card K := by
  obtain ⟨S', hcard, hS'⟩ := exists_messages w S hS
  rw [← hcard]
  exact descent (rsListBound₁_iff.mp hL) h2 w S' hS'

/-- The bound of `rs_descent₁` as a quotient. -/
theorem rs_descent₁_div (hL : RSListBound₁ D d a L) (h2 : 2 * L ≤ Fintype.card K)
    (w : K → lanes → F) (S : Finset (lanes → F[X]))
    (hS : ∀ P ∈ S, (∀ u, (P u).natDegree ≤ d) ∧
      a ≤ (agr D w (fun x u => (P u).eval (algebraMap K F x))).card) :
    (S.card : ℚ) ≤ (L : ℚ) / (1 - (L : ℚ) / (Fintype.card K : ℚ)) := by
  obtain ⟨S', hcard, hS'⟩ := exists_messages w S hS
  rw [← hcard]
  exact descent_div (rsListBound₁_iff.mp hL) h2 w S' hS'

/-- `rs_descent₁` as a list bound: `2L - 1` for all lanes and extensions when `2L ≤ |K|`. -/
theorem rs_descent₁_listBound (hL : RSListBound₁ D d a L) (h2 : 2 * L ≤ Fintype.card K) :
    RSListBound D F lanes d a (2 * L - 1) :=
  fun w S hS => (rs_descent₁ F lanes hL h2 w S hS).1

/-- **Hypothesis 6.4 of the paper implies Hypothesis 5.1**: from `H_K` with list size `L`,
`2L ≤ |K|`, at agreement `a > d`, the list bound for all lanes and extensions is the smaller of
the tree bound `N(n - d)` and `2L - 1`. -/
theorem rs_listBound_min (hL : RSListBound₁ D d a L) (hda : d < a)
    (h2 : 2 * L ≤ Fintype.card K) :
    RSListBound D F lanes d a (min (treeN L (a - d) (D.card - d)) (2 * L - 1)) := by
  have : Module.Finite K F := Module.Finite.of_finite
  exact fun w S hS => le_min (rs_interleave F lanes hL hda w S hS)
    (rs_descent₁ F lanes hL h2 w S hS).1

end SingleLane

variable (F₀ : Type*) [CommRing F₀] [Algebra K F₀] [Fintype F₀] (lanes₀ : Type*)
  [Fintype lanes₀]

/-- **Proposition 6.2 of the paper for Reed-Solomon codes, general form.** The hypothesis is a
list bound `L` for words with values in `F₀^lanes₀` (for `F₀ = K` and `s` lanes, the `K^s` of the
paper; for an extension `F₀ = E` and one lane, single `E`-valued words), with
`2L ≤ q = |F₀|^|lanes₀|`. The conclusion is for words with values in `F^lanes`, any finite
`K`-algebra `F`, any finite number of lanes: `|S| ≤ 2L - 1` and `|S|·(q - L) ≤ L·q`. -/
theorem rs_descent (hL : RSListBound D F₀ lanes₀ d a L)
    (h2 : 2 * L ≤ Fintype.card F₀ ^ Fintype.card lanes₀)
    (w : K → lanes → F) (S : Finset (lanes → F[X]))
    (hS : ∀ P ∈ S, (∀ u, (P u).natDegree ≤ d) ∧
      a ≤ (agr D w (fun x u => (P u).eval (algebraMap K F x))).card) :
    S.card ≤ 2 * L - 1 ∧
      S.card * (Fintype.card F₀ ^ Fintype.card lanes₀ - L) ≤
        L * Fintype.card F₀ ^ Fintype.card lanes₀ := by
  classical
  obtain ⟨S', hcard, hS'⟩ := exists_messages w S hS
  rw [← hcard, ← Fintype.card_fun]
  rw [← Fintype.card_fun] at h2
  exact descent (rsListBound_iff.mp hL) h2 w S' hS'

/-- The bound of `rs_descent` as a quotient. -/
theorem rs_descent_div (hL : RSListBound D F₀ lanes₀ d a L)
    (h2 : 2 * L ≤ Fintype.card F₀ ^ Fintype.card lanes₀)
    (w : K → lanes → F) (S : Finset (lanes → F[X]))
    (hS : ∀ P ∈ S, (∀ u, (P u).natDegree ≤ d) ∧
      a ≤ (agr D w (fun x u => (P u).eval (algebraMap K F x))).card) :
    (S.card : ℚ) ≤ (L : ℚ) /
      (1 - (L : ℚ) / ((Fintype.card F₀ : ℚ) ^ Fintype.card lanes₀)) := by
  classical
  obtain ⟨S', hcard, hS'⟩ := exists_messages w S hS
  rw [← Fintype.card_fun] at h2
  have h := descent_div (rsListBound_iff.mp hL) h2 w S' hS'
  rw [hcard, Fintype.card_fun, Nat.cast_pow] at h
  exact h

end R2

end Interleave
