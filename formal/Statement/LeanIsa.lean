module

public import Statement.Field

/-!
# leanISA

The leanVM instruction set, from §2 of the leanVM specification
(`doc/leanvm/body/02-vm-specification.tex`) at the pin: memory, registers, instructions, programs,
one step, `run`, a valid execution (`ValidExecution`), the instruction counts, the encoding of an
instruction as sixteen `K` slots (specification §8.1, how the verifier receives a program), and a
program assembled from compiled functions (`CompiledFunction`, `assemble`), the form of the guest
program's generated bytecode (`Statement/Data/`).

Words are elements of `E = K[y]/(y³ + y + 1)`, `K = GF(2^64)`. Addresses are powers of the
generator `g` of `K*`: memory word `i` and bytecode slot `i` both sit at `g^i`. The machine has two
registers, `pc` and `fp`, and halts in the final state `(pcFinal, fpFinal) = (g^(N_prog - 1), 1)`:
the last slot in `main`'s frame. The memory is fixed before the run and only read: every instruction
checks a relation on the words it reads, so all nondeterminism is the choice of the memory.
-/

@[expose] public section

namespace LeanVM.Parameters

/-- The six instructions, in bus-code order (`crates/leanvm_core/src/tables.rs:67-72`). -/
inductive Opcode
  /-- `XOR`: an addition in `E`. -/
  | xor
  /-- `MUL`: a product in `E`. -/
  | mulNative
  /-- `SET`: a constant. -/
  | setConstant
  /-- `DEREF`: a read through a computed address. -/
  | deref
  /-- `JUMP`: a conditional jump. -/
  | jump
  /-- `KECCAK`: one Keccak-f[1600] permutation. -/
  | keccak
  deriving DecidableEq

/-- The bus code of an opcode: `g^0, …, g^5` in constructor order (specification §6.4). -/
def Opcode.busCode : Opcode → K
  | .xor => addressOfIndex 0
  | .mulNative => addressOfIndex 1
  | .setConstant => addressOfIndex 2
  | .deref => addressOfIndex 3
  | .jump => addressOfIndex 4
  | .keccak => addressOfIndex 5

/-- The least memory log-size, `2^1` cells, the public input's two (`crates/leanvm_core/src/cpu/mod.rs`,
`MIN_LOG_MEM`; `crates/verifier/src/layout.rs`, `MIN_LOG_MEMORY`). -/
def minLogMem : ℕ := 1

/-- The greatest memory log-size, `2^32` cells (`crates/leanvm_core/src/cpu/mod.rs:41`,
`MAX_LOG_MEM`). -/
def maxLogMem : ℕ := 32

/-- The greatest bytecode log-size, in instructions (`crates/verifier/src/layout.rs:501`). -/
def maxLogBytecode : ℕ := 32

end LeanVM.Parameters

namespace LeanVM.Semantics

open LeanVM.Parameters

/-! ## Memory -/

open Classical in
/-- The index of an address: `some i` when `address = g^i` with `i < 2^κ`, otherwise `none`. -/
noncomputable def addressIndex? (κ : ℕ) (address : K) : Option (Fin (2 ^ κ)) :=
  if h : ∃ i : Fin (2 ^ κ), address = addressOfIndex i then some (Classical.choose h) else none

/-- A memory of `2^κ` words, by index. -/
abbrev MemoryImage (κ : ℕ) : Type := Fin (2 ^ κ) → E

/-- The word at address `address`, if `address` is an address. -/
noncomputable def MemoryImage.read {κ : ℕ} (memory : MemoryImage κ) (address : K) : Option E :=
  (addressIndex? κ address).map memory

/-- The public input: 256 bits, as four `K` lanes. -/
structure PublicInput where
  /-- Its four `64`-bit lanes, as `K` words. -/
  lanes : Fin 4 → K
  deriving DecidableEq

/-- Memory word `0` holds `lane₀ + lane₁·y`. -/
def PublicInput.word0 (p : PublicInput) : E := E.ofLimbs (p.lanes 0) (p.lanes 1) 0

/-- Memory word `1` holds `lane₂ + lane₃·y`. -/
def PublicInput.word1 (p : PublicInput) : E := E.ofLimbs (p.lanes 2) (p.lanes 3) 0

/-! ## Instructions and programs

An operand `o` names the word at `fp · o`, written `[o]`. -/

/-- What a `DEREF` stores: a local word, the return address, or the frame pointer. -/
inductive DerefMode
  /-- A local word, `[o₃]`. -/
  | cell
  /-- The return address, `g² · pc`: two instructions on. -/
  | pc
  /-- The frame pointer, `fp`. -/
  | fp
  deriving DecidableEq

/-- How many of a `KECCAK`'s thirteen output cells it writes, from the first on: the first, the
first two (a 256-bit digest), or all thirteen (a state a later block reads) (`OutCells`,
`crates/leanvm_core/src/cpu/isa.rs:59-67`). The program fixes it, never the prover. -/
inductive KeccakOutputCells
  /-- The first output cell. -/
  | one
  /-- The first two output cells. -/
  | two
  /-- All thirteen output cells. -/
  | all
  deriving DecidableEq

/-- The number of output cells written: `1`, `2` or `13` (`OutCells::cells`,
`crates/leanvm_core/src/cpu/isa.rs:70-77`). -/
def KeccakOutputCells.cellCount : KeccakOutputCells → ℕ
  | .one => 1
  | .two => 2
  | .all => 13

/-- The six instructions. -/
inductive LeanIsaInstruction
  /-- `[o_C] = [o_A] + [o_B]`. -/
  | xor (oA oB oC : K)
  /-- `[o_C] = [o_A] · [o_B]`. -/
  | mulNative (oA oB oC : K)
  /-- `[o] = k`. -/
  | setConstant (o : K) (k : E)
  /-- `[o₁]` is in `K`, and the word at address `[o₁] · o₂` is the source `mode` selects
  (`derefSource`); `[o₃]` is read in every mode. -/
  | deref (o1 o2 o3 : K) (mode : DerefMode)
  /-- `[o_c]`, `[o_d]`, `[o_f]` are in `K`; jump to `([o_d], [o_f])` if `[o_c] ≠ 0`. -/
  | jump (oc od of : K)
  /-- One Keccak-f[1600] permutation of a state held in thirteen cells: the cells
  `[o_m₀], …, [o_m₃]`, `[g^k · o_tail]` (`k < 4`), `[o_b8]`, `[g^k · o_cap]` (`k < 4`), read in the
  layout `inOdd`, permute to thirteen cells in the layout `outOdd`, of which the first
  `outCells.cellCount`, the cells `[g^k · o_out]` (`k < outCells.cellCount`), are written; the
  others are left untouched (`KeccakCellsRelation`). -/
  | keccak (om : Fin 4 → K) (otail ob8 ocap oout : K) (inOdd outOdd : Bool)
      (outCells : KeccakOutputCells)
  deriving DecidableEq

/-- The opcode of an instruction. -/
def LeanIsaInstruction.opcode : LeanIsaInstruction → Opcode
  | .xor .. => .xor
  | .mulNative .. => .mulNative
  | .setConstant .. => .setConstant
  | .deref .. => .deref
  | .jump .. => .jump
  | .keccak .. => .keccak

/-- A program: `2^logSize ≤ 2^32` instructions, instruction `i` at address `g^i`. -/
structure LeanIsaProgram where
  /-- The log-size: `2^logSize` instructions. -/
  logSize : ℕ
  /-- At most `2^32` instructions. -/
  logSize_le : logSize ≤ maxLogBytecode
  /-- Instruction `i`, at address `g^i`. -/
  instructions : Fin (2 ^ logSize) → LeanIsaInstruction

/-- The instruction at address `pc`. -/
noncomputable def LeanIsaProgram.fetch (program : LeanIsaProgram) (pc : K) : Option
    LeanIsaInstruction :=
  (addressIndex? program.logSize pc).map program.instructions

/-! ## `KECCAK`

How the 25 lanes of a Keccak state are held in thirteen memory words, two lanes to a word, in the
words' limbs `0` and `1`, the `y²` limb zero (specification §2, the `KECCAK` paragraph;
`keccak_cell_lanes`, `layout.rs:302-309`; `cell_lanes`,
`crates/leanvm_core/src/keccak.rs:60-81`):

* even layout: cell `c < 8` holds lanes `(2c, 2c + 1)`, cell `8` holds `(16, ·)`;
* odd layout: cell `0` holds `(·, 0)`, cell `1 ≤ c ≤ 8` holds `(2c − 1, 2c)`;
* both: cell `9 ≤ c < 13` holds `(2c − 1, 2c)`.

A limb `·` holds no lane: it is ignored when read and zero when written. -/

/-- The lanes cell `c` holds in limbs `0` and `1`, in the layout `odd`; `none` marks a limb that
holds no lane (`keccak_cell_lanes`, `layout.rs:302-309`, which the verifier's flushes read
too). -/
def cellLanes (odd : Bool) (c : ℕ) : Option ℕ × Option ℕ :=
  if 9 ≤ c ∨ (odd ∧ 1 ≤ c) then (some (2 * c - 1), some (2 * c))
  else if odd then (none, some 0)
  else if c = 8 then (some 16, none)
  else (some (2 * c), some (2 * c + 1))

/-- The state thirteen cells hold in the layout `odd`: lane `l` is the limb of the cell that holds
it (`state_of_cells`, `crates/leanvm_core/src/keccak.rs:83-101`). -/
def stateOfCells (cells : Fin 13 → E) (odd : Bool) : KeccakState :=
  (List.finRange 13).foldl (fun s (c : Fin 13) ↦
    let (lo, hi) := cellLanes odd c.val
    let s := match lo with
      | some l => s.setIfInBounds l (cells c |>.limb 0).lane
      | none => s
    match hi with
      | some l => s.setIfInBounds l (cells c |>.limb 1).lane
      | none => s) (Vector.replicate 25 0)

/-- The thirteen cells holding a state in the layout `odd`, a limb holding no lane zero, the `y²`
limb zero (`cells_of_state`, `crates/leanvm_core/src/keccak.rs:103-110`). -/
def cellsOfState (s : KeccakState) (odd : Bool) (c : Fin 13) : E :=
  let limb := fun (l : Option ℕ) ↦ match l with
    | some l => K.ofLane (Keccak.lane s l)
    | none => 0
  E.ofLimbs (limb (cellLanes odd c).1) (limb (cellLanes odd c).2) 0

/-- What `KECCAK` checks: the thirteen cells read have no `y²` term, and the first
`outCells.cellCount` cells written are those cells, in the layout `outOdd`, of Keccak-f[1600] of
the state the cells read hold in the layout `inOdd`; nothing is asked of a cell past them, which
the instruction does not write (`crates/leanvm_core/src/cpu/execute.rs:958-994`). -/
def KeccakCellsRelation (input : Fin 13 → E) (inOdd : Bool) (output : Fin 13 → E) (outOdd : Bool)
    (outCells : KeccakOutputCells) : Prop :=
  (∀ c, IsCanonical128 (input c)) ∧
    ∀ c : Fin 13, c.val < outCells.cellCount →
      output c = cellsOfState (keccakF1600 (stateOfCells input inOdd)) outOdd c

instance {input : Fin 13 → E} {inOdd : Bool} {output : Fin 13 → E} {outOdd : Bool}
    {outCells : KeccakOutputCells} :
    Decidable (KeccakCellsRelation input inOdd output outOdd outCells) := by
  unfold KeccakCellsRelation; infer_instance

/-- The address of read cell `c` relative to the frame: `o_m₀, …, o_m₃`, then `g^k · o_tail`
(`k < 4`), `o_b8`, then `g^k · o_cap` (`k < 4`) (`flushes_keccak`'s `address`,
`layout.rs:343-348`). -/
def keccakInputCellOffset (om : Fin 4 → K) (otail ob8 ocap : K) (c : Fin 13) : K :=
  if h : c.val < 4 then om ⟨c.val, h⟩
  else if c.val < 8 then g ^ (c.val - 4) * otail
  else if c.val = 8 then ob8
  else g ^ (c.val - 9) * ocap

/-- Read the thirteen words at the frame-relative offsets `offset c`, in order; `none` if any read
fails. -/
def readCells (read : K → Option E) (fp : K) (offset : Fin 13 → K) : Option (Fin 13 → E) :=
  (List.finRange 13).foldr (fun c acc ↦ do
    let v ← read (fp * offset c)
    let rest ← acc
    pure fun c' ↦ if c' = c then v else rest c') (some fun _ ↦ 0)

/-- Read the first `count` of the thirteen words at the frame-relative offsets `offset c`, in
order; a word past them is not read and is `0`; `none` if any read fails. -/
def readFirstCells (read : K → Option E) (fp : K) (offset : Fin 13 → K) (count : ℕ) :
    Option (Fin 13 → E) :=
  (List.finRange 13).foldr (fun c acc ↦ if c.val < count then do
    let v ← read (fp * offset c)
    let rest ← acc
    pure fun c' ↦ if c' = c then v else rest c' else acc) (some fun _ ↦ 0)

/-! ## One step -/

/-- The registers: the program counter and the frame pointer. -/
structure Registers (F : Type) where
  /-- The program counter: the address of the next instruction. -/
  pc : F
  /-- The frame pointer: operand `o` names the word at `fp · o`. -/
  fp : F

/-- Register equality is decided field by field. Not derived: the derived instance decides the
second field under `h ▸` for the first, whose `Eq.rec` makes the kernel compare two register
values by definitional unfolding instead of evaluation, and `g * 1 = g ^ 1` then never
decides. -/
instance {F : Type} [DecidableEq F] : DecidableEq (Registers F) := fun x y ↦
  decidable_of_iff (x.pc = y.pc ∧ x.fp = y.fp) (by cases x; cases y; simp)

/-- The next instruction, same frame: `(g · pc, fp)`. -/
def Registers.next (registers : Registers K) : Registers K := ⟨g * registers.pc, registers.fp⟩

/-- What a `DEREF` stores: the local word `[o₃]`, the return address `g² · pc`, or `fp`. -/
def derefSource : DerefMode → Registers K → E → E
  | .cell, _, v3 => v3
  | .pc, registers, _ => ofK (g ^ 2 * registers.pc)
  | .fp, registers, _ => ofK registers.fp

/-- Execute an instruction with the memory reader `read`: read its words, check its relation, and
return the next registers; `none` if a read or a check fails. A taken `JUMP` moves to any elements
`(d, f)` of `K`, as in the specification and the verifier; the Rust executor also requires both to
be powers of `g` with a 32-bit exponent, the target inside the bytecode
(`crates/leanvm_core/src/cpu/execute.rs:914-952`, `cpu/hints.rs:139`), and stops after `MAX_STEPS`
(`10^8`, `execute.rs:156`) steps, which nothing here bounds: those are the executor's limits, not
the statement's. -/
def executeWith (read : K → Option E) (registers : Registers K) :
    LeanIsaInstruction → Option (Registers K)
  | .xor oA oB oC => do
    let vA ← read (registers.fp * oA)
    let vB ← read (registers.fp * oB)
    let vC ← read (registers.fp * oC)
    guard (vC = vA + vB)
    pure registers.next
  | .mulNative oA oB oC => do
    let vA ← read (registers.fp * oA)
    let vB ← read (registers.fp * oB)
    let vC ← read (registers.fp * oC)
    guard (vC = vA * vB)
    pure registers.next
  | .setConstant o k => do
    let v ← read (registers.fp * o)
    guard (v = k)
    pure registers.next
  | .deref o1 o2 o3 mode => do
    let p ← read (registers.fp * o1)
    guard (IsInK p)
    let v3 ← read (registers.fp * o3)
    let v2 ← read (p.limb 0 * o2)
    guard (v2 = derefSource mode registers v3)
    pure registers.next
  | .jump oc od of => do
    let c ← read (registers.fp * oc)
    let d ← read (registers.fp * od)
    let f ← read (registers.fp * of)
    guard (IsInK c ∧ IsInK d ∧ IsInK f)
    pure (if c = 0 then registers.next else ⟨d.limb 0, f.limb 0⟩)
  | .keccak om otail ob8 ocap oout inOdd outOdd outCells => do
    let input ← readCells read registers.fp (keccakInputCellOffset om otail ob8 ocap)
    let output ← readFirstCells read registers.fp (fun c ↦ g ^ c.val * oout) outCells.cellCount
    guard (KeccakCellsRelation input inOdd output outOdd outCells)
    pure registers.next

/-- Execute an instruction on `memory`. -/
noncomputable def execute {κ : ℕ} (memory : MemoryImage κ) (registers : Registers K) :
    LeanIsaInstruction → Option (Registers K) :=
  executeWith memory.read registers

/-- One step: fetch the instruction at `pc` and execute it. -/
noncomputable def step {κ : ℕ} (program : LeanIsaProgram) (memory : MemoryImage κ)
    (registers : Registers K) : Option (Registers K) :=
  program.fetch registers.pc >>= execute memory registers

/-! ## Valid executions -/

/-- The initial `pc`: the first bytecode slot, `g^0 = 1`. -/
abbrev pcInitial : K := 1

/-- The initial `fp`: `main`'s frame, `g^0 = 1`. -/
abbrev fpInitial : K := 1

/-- The final `pc`: the last bytecode slot, `g^(2^logSize − 1)`. -/
def LeanIsaProgram.pcFinal (program : LeanIsaProgram) : K :=
  addressOfIndex (2 ^ program.logSize - 1)

/-- The final `fp`: `main`'s frame again. -/
abbrev fpFinal : K := 1

/-- The initial state `(pcInitial, fpInitial)`. -/
def Registers.initial : Registers K := ⟨pcInitial, fpInitial⟩

/-- The final state `(pcFinal, fpFinal)`, where the machine halts. -/
def Registers.final (program : LeanIsaProgram) : Registers K := ⟨program.pcFinal, fpFinal⟩

/-- `n` steps from `r`, halting in the final state: `none` if a step fails or the machine halts
first. The machine halts when both registers are the final state's, checked before each step, as
the Rust's loop does (`crates/leanvm_core/src/cpu/execute.rs:543-554`): the last slot reached in
another frame executes like any other slot, and a step that falls through it, to
`g^(2^logSize)`, which is no bytecode address, fails. The specification's loop
(`doc/leanvm/body/02-vm-specification.tex`, §2) executes an instruction before it checks for the
final state; the two differ only at `logSize = 0`, where the initial and final states coincide
and this `run` and the Rust's accept a run of zero steps. -/
noncomputable def run {κ : ℕ} (program : LeanIsaProgram) (memory : MemoryImage κ) :
    ℕ → Registers K → Option (Registers K)
  | 0, r => some r
  | n + 1, r =>
    if r = Registers.final program then none else step program memory r >>= run program memory n

/-- An execution: a memory of `2^logMemorySize` words (`2^κ` in the specification) and a number of
steps. -/
structure Execution (program : LeanIsaProgram) where
  /-- `κ`: the memory holds `2^κ` words. -/
  logMemorySize : ℕ
  /-- The memory, fixed before the run and only read. -/
  memory : MemoryImage logMemorySize
  /-- The number of steps the run takes. -/
  stepCount : ℕ

/-- The memory has between `2^16` and `2^32` words and holds the public input in words `0`, `1`. -/
def HoldsPublicInput {program : LeanIsaProgram} (input : PublicInput)
    (execution : Execution program) : Prop :=
  minLogMem ≤ execution.logMemorySize ∧ execution.logMemorySize ≤ maxLogMem ∧
    execution.memory.read (addressOfIndex 0) = some input.word0 ∧
    execution.memory.read (addressOfIndex 1) = some input.word1

/-- **A valid execution** of `program` on `input`: the memory holds the public input, and
`execution.stepCount` steps from the initial state halt in the final state. -/
def ValidExecution (program : LeanIsaProgram) (input : PublicInput)
    (execution : Execution program) : Prop :=
  HoldsPublicInput input execution ∧
    run program execution.memory execution.stepCount Registers.initial =
      some (Registers.final program)

/-! ## Instruction counts -/

/-- The number of instructions of opcode `opcode` executed in `n` steps from `r`, stepping as `run`
does; the count stops at a step that fails. -/
noncomputable def opcodeCountInRun {κ : ℕ} (program : LeanIsaProgram) (memory : MemoryImage κ)
    (opcode : Opcode) : ℕ → Registers K → ℕ
  | 0, _ => 0
  | n + 1, r =>
    match program.fetch r.pc, step program memory r with
    | some ins, some r' =>
      (if ins.opcode = opcode then 1 else 0) + opcodeCountInRun program memory opcode n r'
    | _, _ => 0

/-- The number of instructions of opcode `opcode` an execution executes. -/
noncomputable def Execution.opcodeCount {program : LeanIsaProgram} (execution : Execution program)
    (opcode : Opcode) : ℕ :=
  opcodeCountInRun program execution.memory opcode execution.stepCount Registers.initial

end LeanVM.Semantics

namespace LeanVM.Arithmetization

open LeanVM.Parameters LeanVM.Semantics

/-! ## The bytecode encoding (specification §8.1) -/

/-- The `DEREF` store-mode flags `(f_pc, f_fp)`: `cell ↦ (0, 0)`, `pc ↦ (1, 0)`, `fp ↦ (0, 1)`
(`crates/leanvm_core/src/cpu/isa.rs:85-93`; specification §7.4). -/
def derefFlags : DerefMode → K × K
  | .cell => (0, 0)
  | .pc => (1, 0)
  | .fp => (0, 1)

/-- A layout flag as the bytecode carries it: `0` or `1` (`flag`,
`crates/leanvm_core/src/cpu/layout.rs:301`). -/
def layoutFlagWord (b : Bool) : K := if b then 1 else 0

/-- `KECCAK`'s output flags `(out_two, out_all)`: whether output cell `1` is written, and whether
cells `2` to `12` are: `one ↦ (0, 0)`, `two ↦ (1, 0)`, `all ↦ (1, 1)` (`OutCells::flags`,
`crates/leanvm_core/src/cpu/isa.rs:79-82`; `cpu/layout.rs:335-348`). -/
def keccakOutputFlags (outCells : KeccakOutputCells) : K × K :=
  (layoutFlagWord (outCells != .one), layoutFlagWord (outCells == .all))

/-- The bus entry of an instruction, `(opcode, op₁, …, op₁₂)`: slots 3 to 15 of specification
§8.1, the thirteen public columns of `bytecode_columns` (`cpu/layout.rs:292-366`): offsets as
g-powers, a `SET` immediate as its three limbs, the `DEREF` store-mode flags and `KECCAK`'s
layout and output flags as `0` or `1`, unused slots zero. -/
def busEntry : LeanIsaInstruction → Vector K 13
  | .xor oA oB oC => #v[Opcode.xor.busCode, oA, oB, oC, 0, 0, 0, 0, 0, 0, 0, 0, 0]
  | .mulNative oA oB oC => #v[Opcode.mulNative.busCode, oA, oB, oC, 0, 0, 0, 0, 0, 0, 0, 0, 0]
  | .setConstant o k =>
      #v[Opcode.setConstant.busCode, o, k.limb 0, k.limb 1, k.limb 2, 0, 0, 0, 0, 0, 0, 0, 0]
  | .deref o1 o2 o3 mode =>
      #v[Opcode.deref.busCode, o1, o2, o3, (derefFlags mode).1, (derefFlags mode).2, 0, 0, 0, 0,
        0, 0, 0]
  | .jump oc od of => #v[Opcode.jump.busCode, oc, od, of, 0, 0, 0, 0, 0, 0, 0, 0, 0]
  | .keccak om otail ob8 ocap oout inOdd outOdd outCells =>
      #v[Opcode.keccak.busCode, om 0, om 1, om 2, om 3, otail, ob8, ocap, oout,
        layoutFlagWord inOdd, layoutFlagWord outOdd, (keccakOutputFlags outCells).1,
        (keccakOutputFlags outCells).2]

/-- The sixteen slots of an instruction (specification §8.1; `BYTECODE_PUBLIC_SLOT = 3`,
`crates/leanvm_core/src/leaf.rs:777`): the entry at slots 3 to 15, zero at slots 0 to 2. -/
def instructionSlots (i : LeanIsaInstruction) : Vector K 16 :=
  let e := busEntry i
  #v[0, 0, 0, e[0], e[1], e[2], e[3], e[4], e[5], e[6], e[7], e[8], e[9], e[10], e[11], e[12]]

end LeanVM.Arithmetization

namespace LeanVM

open LeanVM.Parameters LeanVM.Semantics LeanVM.Arithmetization LeanVM.Protocol

/-- The bytecode the verifier reads: the sixteen slots of every instruction (`instructionSlots`),
slot by slot: word `i + 2^logSize · s` is slot `s` of instruction `i`. -/
def bytecodeWords (program : LeanIsaProgram) : List K :=
  (List.finRange 16).flatMap fun s ↦
    (List.finRange (2 ^ program.logSize)).map fun i ↦ (instructionSlots (program.instructions i))[s]

/-- The public input as the verifier reads it: its four lanes, the digest's four words
(`public_input_bytes`, `crates/leanvm_core/src/cpu/mod.rs:613-621`; `Digest::halves`,
`crates/verifier/src/hash.rs:110-113`). -/
def publicInputDigest (input : PublicInput) : Digest :=
  #v[(input.lanes 0).lane, (input.lanes 1).lane, (input.lanes 2).lane, (input.lanes 3).lane]

/-- The public input whose digest is `d` (`publicInputDigest`'s inverse): its four lanes as `K`
words. -/
def Semantics.PublicInput.ofDigest (d : Digest) : PublicInput :=
  ⟨![K.ofLane d[0], K.ofLane d[1], K.ofLane d[2], K.ofLane d[3]]⟩

end LeanVM

namespace LeanVM.Guest

open LeanVM.Parameters LeanVM.Semantics

/-! ## Compiled functions, assembled into a program -/

/-- An instruction with frame offsets as `ℕ` and a `SET` immediate as three limbs. -/
inductive OffsetInstruction
  /-- `fp[c] = fp[a] + fp[b]`. -/
  | xor (a b c : ℕ)
  /-- `fp[c] = fp[a] · fp[b]`. -/
  | mul (a b c : ℕ)
  /-- `fp[o] = k0 + k1·y + k2·y²`, each limb a 64-bit word. -/
  | set (o k0 k1 k2 : ℕ)
  /-- `*(fp[o1]·g^o2)` is the source `mode` selects, `fp[o3]` for `.cell`. -/
  | deref (o1 o2 o3 : ℕ) (mode : DerefMode)
  /-- If `fp[oc] ≠ 0`, `(pc, fp) := (fp[od], fp[of])`. -/
  | jump (oc od of : ℕ)
  /-- `KECCAK`: the thirteen cells `fp[m0], …, fp[m3]`, `fp[tail + k]` (`k < 4`), `fp[b8]`,
  `fp[cap + k]` (`k < 4`), in that order, hold a Keccak state in the layout `inOdd`, and the
  cells `fp[out + k]` (`k < outCells.cellCount`) hold the first `outCells.cellCount` of the
  thirteen cells of its Keccak-f[1600] in the layout `outOdd` (`KeccakCellsRelation`;
  `Op::Keccak`, `crates/leanvm_core/src/cpu/isa.rs:35-56`). -/
  | keccak (m0 m1 m2 m3 tail b8 cap out : ℕ) (inOdd outOdd : Bool) (outCells : KeccakOutputCells)
  deriving DecidableEq

/-- The padding instruction, `SET fp[0] = 0`. -/
def OffsetInstruction.padding : OffsetInstruction := .set 0 0 0 0

/-- The word of a `SET` immediate's limbs. -/
def OffsetInstruction.immediateWord (k0 k1 k2 : ℕ) : E := E.ofLimbs (K.ofBits k0) (K.ofBits k1)
    (K.ofBits k2)

/-- The instruction of the ISA (`LeanIsaInstruction`) an offset-form instruction denotes. -/
def OffsetInstruction.toLeanIsaInstruction : OffsetInstruction → LeanIsaInstruction
  | .xor a b c => .xor (addressOfIndex a) (addressOfIndex b) (addressOfIndex c)
  | .mul a b c => .mulNative (addressOfIndex a) (addressOfIndex b) (addressOfIndex c)
  | .set o k0 k1 k2 => .setConstant (addressOfIndex o) (OffsetInstruction.immediateWord k0 k1 k2)
  | .deref o1 o2 o3 mode => .deref (addressOfIndex o1) (addressOfIndex o2) (addressOfIndex o3) mode
  | .jump oc od of => .jump (addressOfIndex oc) (addressOfIndex od) (addressOfIndex of)
  | .keccak m0 m1 m2 m3 tail b8 cap out inOdd outOdd outCells =>
      .keccak ![addressOfIndex m0, addressOfIndex m1, addressOfIndex m2, addressOfIndex m3]
          (addressOfIndex tail) (addressOfIndex b8) (addressOfIndex cap) (addressOfIndex out)
        inOdd outOdd outCells

/-- The instructions per chunk of a compiled function's code. -/
def chunkSize : ℕ := 2048

/-- Element `n` of a list, `fallback` past its end; structural, for the kernel. -/
def listElementOrDefault {α : Type} : List α → ℕ → α → α
  | [], _, fallback => fallback
  | a :: _, 0, _ => a
  | _ :: as, n + 1, fallback => listElementOrDefault as n fallback

/-- A compiled function: its name (`f__L…` for a specialization), entry pc, number of
instructions, and code in chunks of `chunkSize` instructions (the last shorter). -/
structure CompiledFunction where
  /-- Its name, for a reader of the generated data. -/
  name : String
  /-- The pc of its first instruction. -/
  entryPc : ℕ
  /-- Its number of instructions. -/
  instructionCount : ℕ
  /-- Its code, in chunks of `chunkSize` instructions. -/
  chunks : List (List OffsetInstruction)

/-- The instruction at offset `i`, the padding past the end. -/
def CompiledFunction.instructionAt (f : CompiledFunction) (i : ℕ) : OffsetInstruction :=
  listElementOrDefault (listElementOrDefault f.chunks (i / chunkSize) []) (i % chunkSize) .padding

/-- The instruction at pc `pc` of the functions `functions`, the padding outside them. It reads
`functions` as laid out contiguously from pc `0`, each function's entry pc its predecessor's end
(the first function whose end exceeds `pc` holds it; its `entryPc` is not compared with `pc`), as
the guest's are: `lean_vm/scripts/guest-export` asserts it of the compiled guest
(`src/export/bytecode.rs`, "not laid out after its predecessor") before it writes
`Statement/Data/`. -/
def instructionAtPc : List CompiledFunction → ℕ → OffsetInstruction
  | [], _ => .padding
  | f :: fs, pc => if pc < f.entryPc + f.instructionCount then f.instructionAt (pc - f.entryPc) else
      instructionAtPc fs pc

/-- The program of `2^logSize` slots holding the functions `functions`, padded. -/
def assemble (functions : List CompiledFunction) (logSize : ℕ)
    (logSize_le : logSize ≤ maxLogBytecode) : LeanIsaProgram :=
  ⟨logSize, logSize_le, fun i ↦ (instructionAtPc functions i).toLeanIsaInstruction⟩

end LeanVM.Guest

