/-- The dyadic `a / 2^k` of a table entry. -/
def dyadic (e : ℕ × ℕ) : ℚ := (e.1 : ℚ) / 2 ^ e.2

def aT (m : ℕ) : ℚ := dyadic (aTab.getD m (0, 0))

def gT (m : ℕ) : ℚ := dyadic (gTab.getD m (0, 0))

def bT (m : ℕ) : ℚ := dyadic (bTab.getD m (0, 0))

/-! ## The kernel certificates -/

set_option maxRecDepth 100000 in
theorem eHat_cert : 1 / ∑ i ∈ range 60, poisRate ^ i / (i ! : ℚ) ≤ eHat := by
  decide +kernel

set_option maxRecDepth 100000 in
theorem fHat_cert :
    1 / ∑ i ∈ range 60, ((signatureLimit - 150).choose i : ℚ) * (1 / 2 ^ 26) ^ i ≤ fHat := by
  simp only [choose_cast_eq]
  decide +kernel

set_option maxRecDepth 100000 in
theorem tHat_cert :
    2 ^ 128 * ((signatureLimit.choose 150 : ℚ) * (1 / 2 ^ 26) ^ 150 / (1 - 1 / 8)) ≤ tHat := by
  simp only [choose_cast_eq]
  decide +kernel

set_option maxRecDepth 100000 in
theorem etaHat_cert :
    1 / ∑ i ∈ range 40, (chernoffRate * signatureLimit) ^ i / (i ! : ℚ) ≤ etaHat := by
  decide +kernel

theorem etaHat_le_half : etaHat ≤ 1 / 2 := by decide +kernel

theorem poisRate_pos : 0 < poisRate := by decide +kernel

theorem poisRate_lt : poisRate < 22 := by decide +kernel

set_option maxRecDepth 100000 in
theorem aT_cert : ∀ m < 100, 0 < m →
    coverProb m * poisRate ^ m / (m ! : ℚ) / ((m : ℚ) ^ 24 / 2 ^ 240) ≤ aT m := by
  decide +kernel

set_option maxRecDepth 100000 in
theorem gT_cert : ∀ m < 101, poisRate ^ m / (m ! : ℚ) ≤ gT m := by
  decide +kernel

set_option maxRecDepth 100000 in
theorem bT_cert : ∀ m < 150,
    2 ^ 128 * (fHat * ((signatureLimit.choose m : ℚ) * (1 / 2 ^ 26) ^ m * coverProb m)) ≤
      bT m := by
  simp only [choose_cast_eq]
  decide +kernel

/-! ## The parameter sets -/

/-- A parameter set: the rate `λ = lamN / 2^lamE` (per `2^-128`), the cut `k0`, and certified
constants `κ = kapN / 2^kapE`, `β = betN / 2^betE`. -/
structure CovParam where
  lamN : ℕ
  lamE : ℕ
  k0 : ℕ
  kapN : ℕ
  kapE : ℕ
  betN : ℕ
  betE : ℕ

def CovParam.lam (P : CovParam) : ℚ := (P.lamN : ℚ) / 2 ^ P.lamE

def CovParam.kap (P : CovParam) : ℚ := (P.kapN : ℚ) / 2 ^ P.kapE

def CovParam.bet (P : CovParam) : ℚ := (P.betN : ℚ) / 2 ^ P.betE

/-- `2^26 · eHat · D + 2 · etaHat`, `D` the cut part of the exponential moment at rate
`s = λ 2^102`: `Σ_{1 ≤ m ≤ k0} (e^{s (m/2^10)^24} - 1) aT m` plus the tail beyond `k0`. -/
def CovParam.kapExpr (P : CovParam) : ℚ :=
  2 ^ 26 * eHat * (∑ m ∈ Ico 1 (P.k0 + 1),
      (expUB (P.lamN * m ^ 24) (2 ^ P.lamE * 2 ^ 138) - 1) * aT m +
    (expUB (P.lamN * P.k0 ^ 24) (2 ^ P.lamE * 2 ^ 138) - 1) * gT (P.k0 + 1) /
      (1 - poisRate / (P.k0 + 2))) + 2 * etaHat

/-- `Σ_{k0 < m < 150} bT m + tHat`. -/
def CovParam.betExpr (P : CovParam) : ℚ := ∑ m ∈ Ico (P.k0 + 1) 150, bT m + tHat

/-- The checked conditions of a parameter set. -/
def CovParam.Cert (P : CovParam) : Prop :=
  0 < P.lamN ∧ 20 ≤ P.k0 ∧ P.k0 < 99 ∧ P.kapExpr ≤ P.kap ∧ P.betExpr ≤ P.bet

instance instDecidablePredCovParamCert : DecidablePred CovParam.Cert := fun P ↦ by
  unfold CovParam.Cert
  infer_instance

