module

public import Quantum.Sphincs.Coverage

@[expose] public section

/-!
# Rational certificates for the worst user's coverage price

The numbers of the bound on `E max_i price_i` (`Quantum.Qrom.Sphincs.Multi.CovMax`), all checked by
the kernel:

* `poisRate = N (1 + 2^-13) / 2^26`: the Poisson mean per instance, `N = signatureLimit`;
  `eHat ≥ e^{-poisRate}`, `etaHat` bounds the Poisson mass below `N` through
  `chernoffRate = ε²/2 - 13ε³/18 - 2ε⁴/9`, `ε = 2^-13`.
* `aT m ≥ coverProb m · ρ^m / m! / (m / 2^10)^24`, `gT m ≥ ρ^m / m!` (`ρ = poisRate`), and
  `bT m ≥ 2^128 · fHat · C(N, m) 2^{-26 m} coverProb m`, `fHat ≥ (1 - 2^-26)^(N - 150)`;
  `tHat` bounds the binomial tail beyond load `150`. The tables store `(a, k)` for `a / 2^k`.
* `expUB a b ≥ e^{a/b}`: `e ≤ 2.7182818286` to the integer part, a Taylor bound of degree `8`
  for the half of the fractional part, squared.
* `covTable`: 34 parameter sets `(λ, k0, κ, β)`, one per cut `k0 = 47, …, 80`; `CovParam.Cert`
  checks `κ ≥ 2^26 · eHat · D + 2 · etaHat` with `D` the cut part of the exponential moment and
  `β ≥ Σ_{k0 < m < 150} bT m + tHat` (`covTable_cert`).
-/

open Finset Nat
open Sphincs (signatureLimit)
open Quantum.Sphincs (coverProb choose_cast_eq)

namespace Quantum.Qrom.Sphincs.Multi

/-- The Poisson mean per instance, `N (1 + 2^-13) / 2^26`. -/
def poisRate : ℚ := signatureLimit * (1 + 1 / 2 ^ 13) / 2 ^ 26

/-- `ε²/2 - 13ε³/18 - 2ε⁴/9` at `ε = 2^-13`: `e^{-ε} (1 + ε) ≤ 1 - chernoffRate`. -/
def chernoffRate : ℚ :=
  (1 / 2 ^ 13) ^ 2 / 2 - 13 / 18 * (1 / 2 ^ 13) ^ 3 - 2 / 9 * (1 / 2 ^ 13) ^ 4

/-- The Taylor bound of `e^t` on `[0, 1]`, degree `8`. -/
def expTaylor (t : ℚ) : ℚ := ∑ i ∈ range 8, t ^ i / (i ! : ℚ) + t ^ 8 * 9 / ((8 ! : ℚ) * 8)

/-- An upper bound of `e^{a/b}`. -/
def expUB (a b : ℕ) : ℚ :=
  (27182818286 / 10 ^ 10 : ℚ) ^ (a / b) * expTaylor ((a % b : ℕ) / (2 * b : ℕ)) ^ 2

/-- `≥ e^{-poisRate}`. -/
def eHat : ℚ := 51593185541 / 2 ^ 61

/-- `≥ (1 - 2^-26)^(N - 150)`. -/
def fHat : ℚ := 1654539357587 / 2 ^ 66

/-- `≥ 2^128 C(N, 150) 2^{-26·150} / (1 - 1/8)`. -/
def tHat : ℚ := 569983 / 2 ^ 143

/-- `≥ e^{-chernoffRate · N}`. -/
def etaHat : ℚ := 82450333 / 2 ^ 39

