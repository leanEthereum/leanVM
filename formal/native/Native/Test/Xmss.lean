import Native.Test.Run
import Native.Xmss

/-!
# leanXMSS verification on EthLib's test vectors

The word model `verifyW` gives EthLib's verdict on its test vectors
(`crates/lean_xmss/tests/lean_xmss/ethlib/verify`): two valid signatures (the second in another
bottom tree), a tampered chain value, a digest whose digits sum to 105, one whose last digit is not
zero, a wrong root. `XmssVerifier.body`, run on the first valid signature and on the tampered one,
leaves that verdict in `rax` and restores the callee-saved registers.

The model stands in for `LeanXmss.verifyWithKeccak`, which `verifyW_encode` proves it equal to:
the specification does not evaluate in reasonable time, since its `sequenceFin` builds the chain
ends with `Fin.cases`, which evaluates every smaller index first.
-/

namespace Native.Test.XmssTest

open LeanXmss HashSig Native.XmssVerifier

/-- A test vector: the public key, message and signature as hex, and whether it verifies. -/
structure Case where
  publicKey : String
  message : String
  signature : String
  verifies : Bool

/-- The bytes of a hex string. -/
def hexBytes (s : String) : List UInt8 :=
  let digit (c : Char) : Nat := if c.isDigit then c.toNat - '0'.toNat else c.toNat - 'a'.toNat + 10
  let rec go : List Char → List UInt8
    | a :: b :: rest => (16 * digit a + digit b).toUInt8 :: go rest
    | _ => []
  go s.toList

/-- The little-endian number of bytes. -/
def leNat (bs : List UInt8) : Nat := bs.foldr (fun b acc ↦ b.toNat + 256 * acc) 0

/-- The 16-byte digest at `off`. -/
def digestAt (bs : List UInt8) (off : Nat) : Digest :=
  BitVec.ofNat 128 (leNat ((bs.drop off).take 16))

def Case.pk (c : Case) : PublicKey :=
  let bs := hexBytes c.publicKey
  ⟨digestAt bs 0, digestAt bs 16⟩

def Case.msg (c : Case) : Message := BitVec.ofNat 256 (leNat (hexBytes c.message))

def Case.sig (c : Case) : Signature :=
  let bs := hexBytes c.signature
  ⟨⟨leNat (bs.take 4) % lifetime, Nat.mod_lt _ (by decide)⟩, fun l ↦
    let off := 4 + 1200 * l.val
    ⟨digestAt bs off, fun i ↦ digestAt bs (off + 16 + 16 * i.val),
      fun j ↦ digestAt bs (off + 944 + 16 * j.val)⟩⟩

def ctxBase : UInt64 := 0x100000

/-- The callee-saved registers' values before the run. -/
def saved : List (Reg64 × UInt64) :=
  [(.rbx, 11), (.rbp, 12), (.r12, 13), (.r13, 14), (.r14, 15), (.r15, 16)]

/-- `rax` after `body` from a context holding the input, if the run ends and restores the
callee-saved registers. -/
def runBody (inp : Nat → UInt64) : Option UInt64 := do
  let s := RState.ofWords ctxBase <| (List.range Context.ctxWords).map fun k ↦
    (ctxBase + (8 * k).toUInt64,
      if inputW ≤ k ∧ k < inputW + inputWords then inp (k - inputW) else 0)
  let s := { s with regs := saved.foldl (fun regs (r, v) ↦ regs.set! (regIdx r) v) s.regs }
  match ← Native.Test.run 10000000 body s with
  | (.ok s, _) =>
    if saved.all fun (r, v) ↦ s.regs.getD (regIdx r) 0 == v then some (s.regs.getD 0 0) else none
  | _ => none

/-- The model gives the vector's verdict. -/
def Case.model (c : Case) : Bool := verifyW (encode c.pk c.msg c.sig) == c.verifies

/-- The code leaves the vector's verdict in `rax`. -/
def Case.code (c : Case) : Bool :=
  runBody (encode c.pk c.msg c.sig) == some (if c.verifies then 1 else 0)

