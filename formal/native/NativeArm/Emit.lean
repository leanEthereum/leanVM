module

public import NativeArm.Compile.Code
public import Kraken.AArch64.Print

/-!
# AArch64 assembly of a compiled program

`emit sym body onFail` is `Compile.program body onFail` in Kraken's AArch64 printing, as an
assembly file exporting `sym` at the program's first directive, the label `qm_entry`:
`uint64_t sym(uint64_t *ctx)` in AAPCS64 when `body` takes its context in `rdi` (X0) and leaves its
result in `rax` (the program moves it to X0). The directives around it place it in `.text`, export
the symbol and change no instruction; `qm_entry`, `qm_fail` and the `.L<n>` labels stay local.
-/

open Native

namespace NativeArm

/-- The assembly file exporting `sym` at the code of `body` and `onFail`. -/
public def emit (sym : String) (body onFail : Stmt) : String :=
  String.intercalate "\n" [
    "// Generated by NativeArm.emit; do not edit.",
    "\t.text",
    "\t.p2align 2",
    s!"\t.globl {sym}",
    s!"\t.type {sym}, %function",
    s!"{sym}:",
    Kraken.AArch64.print (Compile.program body onFail),
    s!"\t.size {sym}, .-{sym}",
    "\t.section .note.GNU-stack,\"\",%progbits",
    ""]

end NativeArm
