module

public import NativeRustcVm.Mem
public import NativeVm.Model.Layout
public import NativeVm.Model.KeccakGkr
import all Init.Data.String.Pattern.String

/-!
# The crate's read-only data

The arrays of `rustc/vm/src/data.rs` (generated by `rustc/vm/gen/Data.lean` from the model) as Lean
values computed from the model the way the generator computes them (`Data.terms`, `Data.forms`,
`Data.tuples`, …), with the bytes rustc lays them out in (`#[repr(C)]`, `usize`/`u64` eight bytes
little-endian, `u32` four, `u8`/`bool` one). Besides them, rustc's read-only data holds two arrays
of the crate's code: `whir.rs`'s `PER_CHALLENGE` (`128 / d`, `Data.perChallenge`) and `bus.rs`'s
`&[ONE]` (`Data.one`).

`Data.Item` names each item, `Item.bytes` its bytes; `RodataAt d addr sb n` says each item's bytes
are at its address (`addr`, per architecture the address of its label), not wrapping around and
apart from the `n` bytes at `sb` (the stack below SP).
-/

namespace NativeRustcVm.Data

open NativeVm.Model LeanVM.Parameters LeanVM.Protocol.Verifier

@[expose] public section

/-! ## The arrays -/

/-- `Span` (`layout.rs`): a range of an array. -/
structure Span where
  start : Nat
  len : Nat
  deriving DecidableEq, Repr

/-- `Block` (`layout.rs`): a bus tuple of a table. -/
structure Block where
  owner : Nat
  tuple : Nat
  deriving DecidableEq, Repr

/-- `TermW` (`layout.rs`): a monomial of `degree ≤ 2` columns and its coefficient. -/
structure Term where
  degree : Nat
  col0 : Nat
  col1 : Nat
  coeff : EW
  deriving DecidableEq, Repr

/-- `TableW` (`layout.rs`). -/
structure Table where
  opcode : Nat
  width : Nat
  nConstraints : Nat
  padding : Span
  deriving DecidableEq, Repr

/-- Consecutive spans of the given lengths from `s`. -/
def spansFrom (s : Nat) : List Nat → List Span
  | [] => []
  | n :: ns => ⟨s, n⟩ :: spansFrom (s + n) ns

/-- Whether a column's name starts with `cnt`, by its bytes (`cntPrefix_eq`): the kernel evaluates
it where `String.startsWith` gets stuck. -/
def cntPrefix (name : String) : Bool := name.toByteArray.data.toList.take 3 == [99, 110, 116]

/-- `Table.countColumns` by `cntPrefix` (`countCols_eq`). -/
def countCols (t : LeanVM.Protocol.Verifier.Table) : List Nat :=
  (t.columns.zipIdx.filter fun (name, _) ↦ cntPrefix name).map (·.2)

/-- A table's tuples on a side: `0` its pushes, `1` its pulls, `2` its count columns. -/
def tuplesOf (t : LeanVM.Protocol.Verifier.Table) : Nat → List (List Form)
  | 0 => t.flushes.push
  | 1 => t.flushes.pull
  | _ => (countCols t).map fun l ↦ [Form.col l]

/-- Every bus tuple, table by table, side by side: its table's opcode, its side, its forms. -/
def allTuples : List (Nat × Nat × List Form) :=
  LeanVM.Protocol.Verifier.tables.flatMap fun t ↦
    [0, 1, 2].flatMap fun side ↦ (tuplesOf t side).map fun tu ↦ (t.opcode, side, tu)

/-- Every form of every tuple. -/
def allForms : List Form := allTuples.flatMap fun x ↦ x.2.2

/-- A monomial and its coefficient as `TermW`. -/
def Term.ofMono (mc : List Nat × E) : Term :=
  ⟨mc.1.length, mc.1.getD 0 0, mc.1.getD 1 0, EW.ofE mc.2⟩

/-- `TERMS`. -/
def terms : List Term := allForms.flatMap fun f ↦ f.terms.map Term.ofMono

/-- `FORMS`. -/
def forms : List Span := spansFrom 0 (allForms.map fun f ↦ f.terms.length)

/-- `TUPLES`. -/
def tuples : List Span := spansFrom 0 (allTuples.map fun x ↦ x.2.2.length)

/-- The blocks of a side. -/
def blocks (side : Nat) : List Block :=
  (allTuples.zipIdx.filter fun x ↦ x.1.2.1 == side).map fun x ↦ ⟨x.1.1, x.2⟩

/-- `PUSH_BLOCKS`. -/
def pushBlocks : List Block := blocks 0
/-- `PULL_BLOCKS`. -/
def pullBlocks : List Block := blocks 1
/-- `COUNT_BLOCKS`. -/
def countBlocks : List Block := blocks 2

/-- `PADDING`. -/
def padding : List EW := LeanVM.Protocol.Verifier.tables.flatMap fun t ↦ t.padding.map EW.ofE

/-- `TABLES`. -/
def tables : List Table :=
  (LeanVM.Protocol.Verifier.tables.zip
      (spansFrom 0 (LeanVM.Protocol.Verifier.tables.map fun t ↦ t.padding.length))).map
    fun (t, s) ↦ ⟨t.opcode, t.width, t.nConstraints, s⟩

/-- A column's `q_keccak` slot as a byte, `NO_SLOT = 255` for none. -/
def slotByte : Option Nat → UInt8
  | some s => s.toUInt8
  | none => 255

/-- `KECCAK_SLOT`: `keccakSlotTable`. -/
def keccakSlot : List UInt8 := (List.range columnCount).map fun c ↦ slotByte (LeanVM.Protocol.Verifier.keccakSlot c)

/-- `KECCAK_OUTPUT`: `keccakOutputTable`. -/
def keccakOutput : List Bool :=
  (List.range columnCount).map fun c ↦ decide (c ∈ keccakOutputColumns)

/-- `RMFE_PROJECT`: `rmfeProjectW`. -/
def rmfeProject : List UInt64 := LeanVM.Protocol.Verifier.rmfeProject.map (·.toUInt64)

/-- `KECCAK_RC`: `keccakRCW`. -/
def keccakRC : List UInt64 := LeanVM.Parameters.keccakRC

/-- `KECCAK_RHO`: `keccakRhoW`. -/
def keccakRho : List Nat := LeanVM.Parameters.keccakRho

/-- `QUERY_TABLE`: `Whir.queryTable`, each entry padded with zeros to six levels. -/
def queryTable : List (List (List Nat)) :=
  Whir.queryTable.map fun row ↦ row.map fun c ↦ c ++ List.replicate (6 - c.length) 0

/-- `QUERY_LEVELS`. -/
def queryLevels : List (List Nat) := Whir.queryTable.map fun row ↦ row.map List.length

/-- `whir.rs`'s `PER_CHALLENGE`: `128 / d`, `0` at `0`. -/
def perChallenge : List Nat := (List.range 129).map fun d ↦ if d = 0 then 0 else 128 / d

/-- `bus.rs`'s `&[ONE]`. -/
def one : List EW := [⟨1, 0⟩]

end

public section

theorem startsWith_cnt (s : String) :
    s.startsWith "cnt" = true ↔ s.toByteArray.data.toList.take 3 = [99, 110, 116] := by
  rw [String.startsWith_eq_startsWith_toSlice, String.Slice.startsWith_eq_forwardPatternStartsWith]
  simp [String.Slice.Pattern.ForwardPattern.startsWith,
    String.Slice.Pattern.ForwardSliceSearcher.startsWith,
    String.Slice.Pattern.Internal.memcmpSlice_eq_true_iff]
  have h3 : "cnt".utf8ByteSize = 3 := by decide
  have hc : "cnt".toByteArray.extract 0 3 = ⟨#[99, 110, 116]⟩ := by decide
  simp only [h3, hc]
  constructor
  · rintro ⟨hle, he⟩
    have := congrArg (fun b : ByteArray ↦ b.data.toList) he
    simpa [ByteArray.data_extract] using this
  · intro h
    have hl := congrArg List.length h
    simp at hl
    have hs := @String.size_toByteArray s
    simp only [ByteArray.size] at hs
    refine ⟨by omega, ?_⟩
    apply ByteArray.ext
    apply Array.toList_inj.mp
    simpa [ByteArray.data_extract] using h

theorem cntPrefix_eq (s : String) : cntPrefix s = s.startsWith "cnt" := by
  rw [Bool.eq_iff_iff, startsWith_cnt, cntPrefix, beq_iff_eq]

theorem countCols_eq (t : LeanVM.Protocol.Verifier.Table) : countCols t = t.countColumns := by
  simp only [countCols, Table.countColumns, cntPrefix_eq]

end

@[expose] public section

/-! ## Their bytes -/

/-- A `usize` (or `u64`) of a number: eight bytes, little-endian. -/
def natBytes (n : Nat) : List UInt8 := wordBytes n.toUInt64

/-- A `u32`: four bytes, little-endian. -/
def u32Bytes (n : Nat) : List UInt8 := (wordBytes n.toUInt64).take 4

def Span.bytes (s : Span) : List UInt8 := natBytes s.start ++ natBytes s.len

def Block.bytes (b : Block) : List UInt8 := natBytes b.owner ++ natBytes b.tuple

def Term.bytes (t : Term) : List UInt8 :=
  natBytes t.degree ++ natBytes t.col0 ++ natBytes t.col1 ++ ewBytes t.coeff

def Table.bytes (t : Table) : List UInt8 :=
  natBytes t.opcode ++ natBytes t.width ++ natBytes t.nConstraints ++ t.padding.bytes

/-- The read-only data items. -/
inductive Item where
  | rmfeProject | keccakRC | keccakRho | tuples | tables | padding | pushBlocks | pullBlocks
  | countBlocks | one | perChallenge | queryTable | queryLevels | forms | terms | keccakSlot
  | keccakOutput
  deriving DecidableEq, Repr

/-- Every item, in the order of their labels (`.Lanon.….0` to `.16` on AArch64). -/
def Item.all : List Item :=
  [.rmfeProject, .keccakRC, .keccakRho, .tuples, .tables, .padding, .pushBlocks, .pullBlocks,
    .countBlocks, .one, .perChallenge, .queryTable, .queryLevels, .forms, .terms, .keccakSlot,
    .keccakOutput]

/-- An item's bytes. -/
def Item.bytes : Item → List UInt8
  | .rmfeProject => Data.rmfeProject.flatMap wordBytes
  | .keccakRC => Data.keccakRC.flatMap wordBytes
  | .keccakRho => Data.keccakRho.flatMap u32Bytes
  | .tuples => Data.tuples.flatMap Span.bytes
  | .tables => Data.tables.flatMap Table.bytes
  | .padding => Data.padding.flatMap ewBytes
  | .pushBlocks => Data.pushBlocks.flatMap Block.bytes
  | .pullBlocks => Data.pullBlocks.flatMap Block.bytes
  | .countBlocks => Data.countBlocks.flatMap Block.bytes
  | .one => Data.one.flatMap ewBytes
  | .perChallenge => Data.perChallenge.map Nat.toUInt8
  | .queryTable => Data.queryTable.flatten.flatten.flatMap natBytes
  | .queryLevels => Data.queryLevels.flatten.flatMap natBytes
  | .forms => Data.forms.flatMap Span.bytes
  | .terms => Data.terms.flatMap Term.bytes
  | .keccakSlot => Data.keccakSlot
  | .keccakOutput => Data.keccakOutput.map fun b ↦ if b then 1 else 0

end

end NativeRustcVm.Data

namespace NativeRustcVm

@[expose] public section

/-- **The read-only data in memory**: each item's bytes at its address `addr t`, not wrapping
around, apart from the `n` bytes from `sb`. -/
def RodataAt (d : Mem 64) (addr : Data.Item → BitVec 64) (sb : BitVec 64) (n : Nat) : Prop :=
  ∀ t, BytesAt d (addr t) t.bytes ∧ NoWrap (addr t) t.bytes.length ∧
    Apart (addr t) t.bytes.length sb n

/-- The `n` bytes from `a` are apart from every read-only data item. -/
def RodataApart (addr : Data.Item → BitVec 64) (a : BitVec 64) (n : Nat) : Prop :=
  ∀ t, Apart a n (addr t) t.bytes.length

end

end NativeRustcVm
