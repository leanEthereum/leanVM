/-- The state at the loop head of round `i`: SP the stack frame's base (region 0), X27 `8 * i`. -/
def start (i : Nat) : SState :=
  init [(192, true), (192, false)] (.ptr 0 0) [(.X27, .lit (8 * i))] [(NativeRustcArm.roundConstantsLabel, 1)]

sym_block round0 := exec body (start 0)

sym_block round23 := exec body (start 23)

/-- The state at the loop head of any round: X27 the variable 0, below 185. -/
def startAny : SState :=
  init [(192, true), (192, false)] (.ptr 0 0) [(.X27, .var 0)] [(NativeRustcArm.roundConstantsLabel, 1)] [(.var 0, 185)]

sym_block roundAny := exec body startAny

/-- The round constant: the table's 8 bytes at X27. -/
example : (exec body startAny).map (·.1.mem.length) = some 11 := by
  rw [roundAny]
  rfl

open NativeRustcArm in
/-- After round 0 the loop branches back, X27 is 8, and X12 (lane `A[2][1]`'s new value, before
the next round's `θ`) is the plain BitVec expression of `χ ∘ π ∘ ρ ∘ θ` over the registers and
stack slots at the loop head. -/
theorem round0_spec [Host] {k : Nat} (hk : body.IsInfixAt Host.prog k) {env : Env}
    (hwf : env.WF) {m : MachineData} (hm : Match env (start 0) m) :
    Eventually (step1 Host.exe) (fun st => st.pc = Labels.label NativeRustcArm.Common.KeccakF.label_1 ∧
      (st.data.regs.getXReg .X27).toBitVec = 8#64 ∧
      (st.data.regs.getXReg .X12).toBitVec =
        ((env.load 0 64 8 ^^^ (env.regs .X8 ^^^ (env.regs .X0).rotateRight 63)).rotateRight 36 &&&
            ~~~(env.regs .X16 ^^^ (env.regs .X30 ^^^ (env.regs .X15).rotateRight 63)).rotateRight 3) ^^^
          (env.regs .X19 ^^^ (env.regs .X28 ^^^ (env.regs .X8).rotateRight 63)).rotateRight 19)
      ⟨m, Host.addrOf k⟩ := by
  refine NativeRustcArm.Eventually.mono (exec_sound hk round0 hwf hm) fun st ⟨hm', hpc⟩ =>
    ⟨?_, ?_, ?_⟩
  · simpa [PcOk, SBool.eval] using hpc
  · rw [hm'.regs .X27 _ rfl]
    rfl
  · rw [hm'.regs .X12 _ rfl]
    sym_simp

end NativeRustcArm.Sym.Test.Keccak
