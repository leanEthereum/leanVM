import NativeVm.Model.Verify

/-!
Writes `src/data.rs`: the model's fixed data (`NativeVm.Model`'s `tablesW` with its bus tuples,
`keccakSlotTable`, `keccakOutputTable`, `globalColumnBasesW`, `rmfeEmbedW`, `rmfeProjectW`,
`keccakRCW`, `keccakRhoW`, `Whir.queryTable`), evaluated here so the Rust holds the model's values
term for term, in the model's order.

From `formal/native`: `lake env lean --run rustc/vm/gen/Data.lean rustc/vm/src/data.rs`.
-/

open NativeVm.Model LeanVM.Parameters LeanVM.Protocol.Verifier

def hex (w : UInt64) : String :=
  let s := String.ofList (Nat.toDigits 16 w.toNat)
  "0x" ++ String.ofList (List.replicate (16 - s.length) '0') ++ s

def ew (x : EW) : String := s!"EW::new({hex x.c0}, {hex x.c1})"

def list (xs : List String) : String := ",\n    ".intercalate xs

/-- Every tuple of a table, side `0` (push), `1` (pull), `2` (count), in the model's order. -/
def tuplesOf (t : TableW) : Nat → Array (Array FormW)
  | 0 => t.push
  | 1 => t.pull
  | _ => t.countColumns.map fun l ↦ #[FormW.ofForm (Form.col l)]

def main (args : List String) : IO Unit := do
  let path := args.headD "data.rs"
  let mut terms : Array String := #[]
  let mut forms : Array String := #[]
  let mut tuples : Array String := #[]
  let mut blocks : Array (Array String) := #[#[], #[], #[]]
  for t in tablesW do
    for side in [0, 1, 2] do
      for tuple in tuplesOf t side do
        blocks := blocks.modify side (·.push s!"Block \{ owner: {t.opcode}, tuple: {tuples.size} }")
        let formFirst := forms.size
        for f in tuple do
          let termFirst := terms.size
          for term in f do
            let c0 := term.cols.getD 0 0
            let c1 := term.cols.getD 1 0
            if 2 < term.cols.size then throw (IO.userError "a monomial of degree above 2")
            terms := terms.push
              s!"TermW \{ degree: {term.cols.size}, cols: [{c0}, {c1}], coeff: {ew term.coeff} }"
          forms := forms.push s!"Span \{ start: {termFirst}, len: {f.size} }"
        tuples := tuples.push s!"Span \{ start: {formFirst}, len: {tuple.size} }"
  let mut padding : Array String := #[]
  let mut tables : Array String := #[]
  for t in tablesW do
    let pFirst := padding.size
    padding := padding ++ t.padding.map ew
    tables := tables.push (s!"TableW \{ opcode: {t.opcode}, width: {t.width}, " ++
      s!"n_constraints: {t.nConstraints}, padding: Span \{ start: {pFirst}, len: {t.padding.size} } }")
  let slot := keccakSlotTable.toList.map fun o ↦ match o with
    | some s => toString s
    | none => "NO_SLOT"
  let output := keccakOutputTable.toList.map fun b ↦ if b then "true" else "false"
  let queries := Whir.queryTable.map fun row ↦
    "[" ++ list (row.map fun counts ↦
      "[" ++ list ((counts ++ List.replicate (6 - counts.length) 0).map toString) ++ "]") ++ "]"
  let qlens := Whir.queryTable.map fun row ↦
    "[" ++ list (row.map fun counts ↦ toString counts.length) ++ "]"
  let out := String.intercalate "\n" [
    "//! Generated by `gen/Data.lean` from the model (`NativeVm.Model`): do not edit.",
    "",
    "use crate::field::EW;",
    "use crate::layout::{Block, Span, TableW, TermW, NO_SLOT};",
    "",
    s!"/// The terms of every form of `tablesW`, form by form.",
    s!"pub const TERMS: [TermW; {terms.size}] = [{list terms.toList}];",
    s!"/// Each form's terms in `TERMS`.",
    s!"pub const FORMS: [Span; {forms.size}] = [{list forms.toList}];",
    s!"/// Each bus tuple's forms in `FORMS`: every table's pushes, pulls, then count columns (`busBlocks`).",
    s!"pub const TUPLES: [Span; {tuples.size}] = [{list tuples.toList}];",
    s!"/// The push side's blocks (`busBlocks`), in order.",
    s!"pub const PUSH_BLOCKS: [Block; {(blocks.getD 0 #[]).size}] = [{list (blocks.getD 0 #[]).toList}];",
    s!"/// The pull side's blocks.",
    s!"pub const PULL_BLOCKS: [Block; {(blocks.getD 1 #[]).size}] = [{list (blocks.getD 1 #[]).toList}];",
    s!"/// The count side's blocks.",
    s!"pub const COUNT_BLOCKS: [Block; {(blocks.getD 2 #[]).size}] = [{list (blocks.getD 2 #[]).toList}];",
    s!"/// Every table's padding row, table by table.",
    s!"pub const PADDING: [EW; {padding.size}] = [{list padding.toList}];",
    s!"/// `tablesW`.",
    s!"pub const TABLES: [TableW; {tables.size}] = [{list tables.toList}];",
    s!"/// `keccakSlotTable`.",
    s!"pub const KECCAK_SLOT: [u8; {slot.length}] = [{list slot}];",
    s!"/// `keccakOutputTable`.",
    s!"pub const KECCAK_OUTPUT: [bool; {output.length}] = [{list output}];",
    s!"/// `globalColumnBasesW`.",
    s!"pub const GLOBAL_COLUMN_BASES: [usize; {globalColumnBasesW.size}] = [{list (globalColumnBasesW.toList.map toString)}];",
    s!"/// `rmfeEmbedW`.",
    s!"pub const RMFE_EMBED: [u64; {rmfeEmbedW.size}] = [{list (rmfeEmbedW.toList.map hex)}];",
    s!"/// `rmfeProjectW`.",
    s!"pub const RMFE_PROJECT: [u64; {rmfeProjectW.size}] = [{list (rmfeProjectW.toList.map hex)}];",
    s!"/// `keccakRCW`.",
    s!"pub const KECCAK_RC: [u64; {keccakRCW.size}] = [{list (keccakRCW.toList.map hex)}];",
    s!"/// `keccakRhoW`.",
    s!"pub const KECCAK_RHO: [u32; {keccakRhoW.size}] = [{list (keccakRhoW.toList.map toString)}];",
    s!"/// `Whir.queryTable`, each entry padded with zeros to six levels.",
    s!"pub const QUERY_TABLE: [[[u64; 6]; 15]; 4] = [{list queries}];",
    s!"/// The levels of each entry of `Whir.queryTable`.",
    s!"pub const QUERY_LEVELS: [[usize; 15]; 4] = [{list qlens}];",
    ""]
  IO.FS.writeFile path out
