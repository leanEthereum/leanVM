/-
  LeanVM.Protocol.ToArkLib.Whir.AffineCombinerDeployedTable

  The interpolation parameters the Rust picks for every fold round of every admissible WHIR
  ladder, and their kernel-checked certificate.
-/

module

public import LeanVM.Protocol.ToArkLib.Whir.AffineCombinerDeployed

/-!
# The deployed fold rounds

`foldTable`, indexed by the rate exponent `R - 1`, then the stack size `log_n - 15` (`15` to `28`),
then the level, lists `(κ, R, k, Aend, rounds)`: the level's message variables, rate exponent,
fold rounds and final threshold, and the witness `(m, D, B)` of each round `j = 1..k`. It was
exported from `WhirSecurityConfig::derive_config_with_log_inv_rate(log_n + LOG_PACKING, R)`
(`crates/pcs/src/whir_config.rs`, `affine_mca::find_witness`) at leanVM `dfd2cd550`. The table is
untrusted data; `foldTable_ok` checks every round with `foldRoundOK` at the fold budget
`2^12 = 2^(128 - (125 - 9))` (`budget(FOLD_GRINDING_BITS, SECURITY_BITS)`) by kernel evaluation,
and `levelOK_round` reads one round's check off a level's.
-/

namespace LeanVM.Protocol.Whir.AffineCombiner

@[expose] public section

/-- The fold budget `2^12`: a round's escapes at most `2^12 q²`, probability `2^-116`, `2^-125`
after the 9-bit fold grind. -/
abbrev foldBudget : ℕ := 2 ^ 12

