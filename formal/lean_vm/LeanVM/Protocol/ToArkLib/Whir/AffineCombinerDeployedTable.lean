    (6, 16, 4, 21931, [(3, 1789, 21926), (3, 1788, 21925), (3, 1787, 21926), (3, 1786, 21927)]),
    (2, 19, 4, 5994, [(4, 3423, 5990), (4, 3423, 5990), (4, 3424, 5991), (4, 3425, 5993)])]

/-- The deployed levels `(κ, R, k, Aend, [(m, D, B)])`. -/
def foldTable : List (List (List (ℕ × ℕ × ℕ × ℕ × List (ℕ × ℕ × ℕ)))) :=
  [[foldTable_1_15, foldTable_1_16, foldTable_1_17, foldTable_1_18, foldTable_1_19, foldTable_1_20, foldTable_1_21, foldTable_1_22, foldTable_1_23, foldTable_1_24, foldTable_1_25, foldTable_1_26, foldTable_1_27, foldTable_1_28],
   [foldTable_2_15, foldTable_2_16, foldTable_2_17, foldTable_2_18, foldTable_2_19, foldTable_2_20, foldTable_2_21, foldTable_2_22, foldTable_2_23, foldTable_2_24, foldTable_2_25, foldTable_2_26, foldTable_2_27, foldTable_2_28],
   [foldTable_3_15, foldTable_3_16, foldTable_3_17, foldTable_3_18, foldTable_3_19, foldTable_3_20, foldTable_3_21, foldTable_3_22, foldTable_3_23, foldTable_3_24, foldTable_3_25, foldTable_3_26, foldTable_3_27, foldTable_3_28],
   [foldTable_4_15, foldTable_4_16, foldTable_4_17, foldTable_4_18, foldTable_4_19, foldTable_4_20, foldTable_4_21, foldTable_4_22, foldTable_4_23, foldTable_4_24, foldTable_4_25, foldTable_4_26, foldTable_4_27, foldTable_4_28]]

/-- A level's rounds all pass `foldRoundOK`. -/
def levelOK (budget : ℕ) (lv : ℕ × ℕ × ℕ × ℕ × List (ℕ × ℕ × ℕ)) : Bool :=
  lv.2.2.2.2.length == lv.2.2.1 &&
    lv.2.2.2.2.zipIdx.all fun wi ↦
      foldRoundOK lv.1 lv.2.1 lv.2.2.1 lv.2.2.2.1 (wi.2 + 1) wi.1.1 wi.1.2.1 wi.1.2.2 budget

/-- **Every deployed fold round passes**, by kernel evaluation. -/
theorem foldTable_ok :
    foldTable.all (fun r ↦ r.all fun sh ↦ sh.all (levelOK foldBudget)) = true := by
  decide +kernel

/-- One round's check, from its level's. -/
theorem levelOK_round {budget κ R k Aend : ℕ} {rounds : List (ℕ × ℕ × ℕ)}
    (h : levelOK budget (κ, R, k, Aend, rounds) = true) (i : ℕ) (hi : i < rounds.length) :
    rounds.length = k ∧ foldRoundOK κ R k Aend (i + 1) rounds[i].1 rounds[i].2.1 rounds[i].2.2
      budget = true := by
  unfold levelOK at h
  rw [Bool.and_eq_true, beq_iff_eq, List.all_eq_true] at h
  refine ⟨h.1, ?_⟩
  have hmem : (rounds[i], i) ∈ rounds.zipIdx := by
    rw [List.mem_iff_getElem]
    exact ⟨i, by simpa using hi, by simp⟩
  have h2 := h.2 _ hmem
  dsimp only at h2
  exact h2

end

