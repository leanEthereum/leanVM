module

public import LeanVM.Cost.Decoder.GuestTables
public import Statement.CostMachine
import Mathlib.Data.List.GetD

/-!
# The size of the guest's table of frame cells, by chunks: the definitions

The decoder program holds the guest's frame cells as one literal (`guestLocsTableC`, its body
`Term.literal` of the table's encoding, `Rule.literalNatArrays`): its size is that of every row's
encoding, `rowSize` (`MachineValue.sizeList` of the row's numbers, and one for the array). The
kernel evaluates them by chunks of rows (`rowsSize a n`, rows `a … a + n - 1`), the largest row,
function `21`'s, by chunks of its lists (`namesSize`), each chunk a module of its own
(`DecoderSize/Rows*.lean`, generated by `scripts/decoder-table-chunks`): one evaluation of the whole
table takes over `18` GB. Here the definitions and the lemmas that compose the chunks
(`DecoderSize/Locs.lean`).
-/

namespace LeanVM.Cost.Decoder

open LeanVM.Cost

@[expose] public section

/-- A row's encoding's size: its numbers' and one for the array. -/
def rowSize (r : List ℕ) : ℕ := MachineValue.sizeList (r.map encodeValue) + 1

/-- The sizes of rows `a … a + n - 1` of the guest's table of frame cells. -/
def rowsSize (a n : ℕ) : ℕ := (((guestLocsList.drop a).take n).map rowSize).sum

/-- The sizes of lists `a … a + n - 1` of `ls`, each list's numbers'. -/
def namesSize (ls : List (List ℕ)) (a n : ℕ) : ℕ :=
  (((ls.drop a).take n).map fun l ↦ MachineValue.sizeList (l.map encodeValue)).sum

theorem sum_drop_take_add {α : Type} (f : α → ℕ) (l : List α) (a n m : ℕ) :
    (((l.drop a).take (n + m)).map f).sum =
      (((l.drop a).take n).map f).sum + (((l.drop (a + n)).take m).map f).sum := by
  rw [List.take_add, List.map_append, List.sum_append, List.drop_drop]

theorem rowsSize_add (a n m : ℕ) : rowsSize a (n + m) = rowsSize a n + rowsSize (a + n) m :=
  sum_drop_take_add rowSize guestLocsList a n m

theorem namesSize_add (ls : List (List ℕ)) (a n m : ℕ) :
    namesSize ls a (n + m) = namesSize ls a n + namesSize ls (a + n) m :=
  sum_drop_take_add _ ls a n m

/-- `rowsSize_add` at numerals: the sums given as hypotheses (`rfl` on numerals), so that no
chunk's size is unfolded to match them. -/
theorem rowsSize_split (a n m b c : ℕ) (hb : b = a + n) (hc : c = n + m) :
    rowsSize a c = rowsSize a n + rowsSize b m := by
  subst hb hc; exact rowsSize_add a n m

/-- `namesSize_add` at numerals. -/
theorem namesSize_split (ls : List (List ℕ)) (a n m b c : ℕ) (hb : b = a + n) (hc : c = n + m) :
    namesSize ls a c = namesSize ls a n + namesSize ls b m := by
  subst hb hc; exact namesSize_add ls a n m

theorem rowsSize_zero (a : ℕ) : rowsSize a 0 = 0 := by simp [rowsSize]

theorem namesSize_zero (ls : List (List ℕ)) (a : ℕ) : namesSize ls a 0 = 0 := by
  simp [namesSize]

theorem sizeList_append (l l' : List MachineValue) :
    MachineValue.sizeList (l ++ l') = MachineValue.sizeList l + MachineValue.sizeList l' := by
  induction l with
  | nil => simp [MachineValue.sizeList]
  | cons v l ih => simp only [List.cons_append, MachineValue.sizeList, ih]; omega

theorem sizeList_map {α : Type} (f : α → MachineValue) (l : List α) :
    MachineValue.sizeList (l.map f) = (l.map fun x ↦ (f x).size).sum := by
  induction l with
  | nil => simp [MachineValue.sizeList]
  | cons x l ih => simp [MachineValue.sizeList, ih]

/-- **A table literal's size**: its rows', the array's and `Term.literal`'s. Stated for any table:
on the guest's, a ground term, `simp` would evaluate it. -/
theorem literal_size (L : List (List ℕ)) :
    (Term.literal (MachineValue.array
      (L.map fun r ↦ MachineValue.array (r.map encodeValue).toArray).toArray)).size =
      (L.map rowSize).sum + 2 := by
  simp only [Term.size, MachineValue.size, sizeList_map]
  have hr : (fun r : List ℕ ↦ (List.map (fun x ↦ (encodeValue x).size) r).sum + 1) = rowSize := by
    funext r
    simp [rowSize, sizeList_map]
  rw [hr]

/-- **A row of lists**: its size, its lists' and one. -/
theorem rowSize_flatten (ls : List (List ℕ)) :
    rowSize ls.flatten = namesSize ls 0 ls.length + 1 := by
  unfold rowSize namesSize
  rw [List.drop_zero, List.take_length]
  congr 1
  induction ls with
  | nil => simp [MachineValue.sizeList]
  | cons l ls ih => simp only [List.flatten_cons, List.map_append, sizeList_append, ih,
      List.map_cons, List.sum_cons]

/-- One row, as a chunk. -/
theorem rowsSize_one {a : ℕ} (h : a < guestLocsList.length) :
    rowsSize a 1 = rowSize (guestLocsList.getD a []) := by
  rw [rowsSize, List.getD_eq_getElem _ _ h]
  rw [show (guestLocsList.drop a).take 1 = [guestLocsList[a]] by
    rw [List.take_one, List.head?_drop, List.getElem?_eq_getElem h]; rfl]
  simp

/-- The whole table's rows, as one chunk. -/
theorem sum_rowSize_eq_rowsSize :
    (guestLocsList.map rowSize).sum = rowsSize 0 guestLocsList.length := by
  rw [rowsSize, List.drop_zero, List.take_length]

end

end LeanVM.Cost.Decoder
