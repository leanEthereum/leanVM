module

public import LeanVM.Cost.Decoder.GuestTables
public import LeanVM.Cost.Decoder.GuestLanes
public import Statement.CostMachine

/-!
# The size of the guest's packed table of frame cells, by chunks: the definitions

The decoder program holds the guest's frame cells packed (`Cost/Decoder/Lanes.lean`), as one
literal (`guestLocsTableC`, its body `Term.literal` of the table's encoding,
`Rule.literalNatArrays`): its size is that of every row's encoding, `rowSize`
(`MachineValue.sizeList` of the row's numbers, and one for the array). Every packed number is one
limb, so the slots' row is its length and one, and a group's row its longest function's number of
cells and one (`groupLen`). The kernel evaluates the groups' by chunks (`groupsSize a n`, groups
`a … a + n - 1`), each chunk a module of its own (`DecoderSize/Rows*.lean`, generated by
`scripts/decoder-table-chunks`). Here the definitions and the lemmas that compose the chunks
(`DecoderSize/Locs.lean`).
-/

namespace LeanVM.Cost.Decoder

open LeanVM.Cost

@[expose] public section

/-- A row's encoding's size: its numbers' and one for the array. -/
def rowSize (r : List ℕ) : ℕ := MachineValue.sizeList (r.map encodeValue) + 1

/-- A group's longest function's number of frame cells. -/
def groupLen (g : List ℕ) : ℕ := (g.map fun j ↦ (guestLocsList.getD j []).length).foldr max 0

/-- The sizes of groups `a … a + n - 1`'s rows: each its longest function's cells and one. -/
def groupsSize (a n : ℕ) : ℕ := (((guestLaneGroups.drop a).take n).map fun g ↦ groupLen g + 1).sum

theorem sum_drop_take_add {α : Type} (f : α → ℕ) (l : List α) (a n m : ℕ) :
    (((l.drop a).take (n + m)).map f).sum =
      (((l.drop a).take n).map f).sum + (((l.drop (a + n)).take m).map f).sum := by
  rw [List.take_add, List.map_append, List.sum_append, List.drop_drop]

theorem groupsSize_add (a n m : ℕ) :
    groupsSize a (n + m) = groupsSize a n + groupsSize (a + n) m :=
  sum_drop_take_add _ guestLaneGroups a n m

/-- `groupsSize_add` at numerals: the sums given as hypotheses (`rfl` on numerals), so that no
chunk's size is unfolded to match them. -/
theorem groupsSize_split (a n m b c : ℕ) (hb : b = a + n) (hc : c = n + m) :
    groupsSize a c = groupsSize a n + groupsSize b m := by
  subst hb hc; exact groupsSize_add a n m

theorem groupsSize_zero (a : ℕ) : groupsSize a 0 = 0 := by simp [groupsSize]

theorem sizeList_map {α : Type} (f : α → MachineValue) (l : List α) :
    MachineValue.sizeList (l.map f) = (l.map fun x ↦ (f x).size).sum := by
  induction l with
  | nil => simp [MachineValue.sizeList]
  | cons x l ih => simp [MachineValue.sizeList, ih]

/-- **A table literal's size**: its rows', the array's and `Term.literal`'s. Stated for any table:
on the guest's, a ground term, `simp` would evaluate it. -/
theorem literal_size (L : List (List ℕ)) :
    (Term.literal (MachineValue.array
      (L.map fun r ↦ MachineValue.array (r.map encodeValue).toArray).toArray)).size =
      (L.map rowSize).sum + 2 := by
  simp only [Term.size, MachineValue.size, sizeList_map]
  have hr : (fun r : List ℕ ↦ (List.map (fun x ↦ (encodeValue x).size) r).sum + 1) = rowSize := by
    funext r
    simp [rowSize, sizeList_map]
  rw [hr]

/-- The whole table's groups, as one chunk. -/
theorem sum_groupSize_eq_groupsSize :
    (guestLaneGroups.map fun g ↦ groupLen g + 1).sum = groupsSize 0 guestLaneGroups.length := by
  rw [groupsSize, List.drop_zero, List.take_length]

end

end LeanVM.Cost.Decoder
