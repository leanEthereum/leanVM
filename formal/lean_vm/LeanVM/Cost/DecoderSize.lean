module

public import LeanVM.Cost.DecoderProgram
public import LeanVM.Cost.Decoder.Top
public import LeanVM.Cost.DecoderSize.Locs
public import LeanVM.Cost.Decoder.LanesCheck

/-!
# The guest decoder's program: its indices and its size, by evaluation

A firewall (`AGENTS.md`), as `Cost/ExtractorSize.lean` is the extractor's: the kernel evaluations
over the decoder program's bodies, in a module of their own that imports only the program's
definition with its facts, the compiled top and the row chunks, none of the proofs that use these
evaluations, so that no edit of those proofs rebuilds them. Through the program's definition and the
compiled top it imports what the compiled chain imports (`Guest/Located/Replay.lean`,
`Guest/B1/Main/Interface.lean`, the extractor's `Cost/Extractor/Top.lean`), not the proofs that use
them. For the program `decoderProgramOf j deps` (`Cost/DecoderProgram.lean`) of a compiled top `j`
with its bodies `deps`:

* the indices increase from the entry's `0` (`increasingFrom 0 (deps.map (·.1))`, by
  `decide +kernel`): the program holds its bodies and its entry (`decoderProgramOf_includes`,
  `decoderProgramOf_entry`);
* its size is exactly the bodies' sizes and two per index without a body (a literal `0`), the
  indices being distinct (`size_ofList_add_length`, `decoderProgramOf_size_le_of_increasing`): at
  most a measured number, then `guestWitnessDecoderSizeBound`. The guest's frame cells' packed
  literal (`guestLocsTableC`: the table's `guestLanesRowSize`, generated, and two for the array and
  its `Term.literal` node, `Decoder/Lanes.lean`) is its rows' sizes: the slots' row by evaluation,
  each group's row its longest function's number of cells and one (`rowSize_packLanes`, every packed
  number one limb), the groups' lengths evaluated by chunks, each in a module of its own
  (`DecoderSize/Rows*.lean`, summed in `DecoderSize/Locs.lean`, both generated by
  `scripts/decoder-table-chunks`); the literal is the bodies' one at its index
  (`decoderProgramBodies_filter_locs`, by unfolding); the other bodies' sizes, `otherBodiesSize`,
  a sum `decide +kernel` evaluates reading the literal's index alone.

For the compiled top `decTopC` (`Decoder/Top.lean`): at most the bodies' sizes (the frame cells'
`guestLanesRowSize + 2` and the others', the entry's among them, `otherBodiesSize`, each exact)
plus two per index without a body, the indices up to the top's, `decTopC`'s own (the last index
allocated), less the bodies (`costIdx - costDeps.length`; so the bound names no index, which moves
when a module before it in the chain gains a function): the program's exact size
(`LeanVMTests/Cost/DecoderSize.lean`). The guest's frame cells are packed four to a number, the
functions grouped by decreasing number of cells, the largest function's setting its group's
length. -/

namespace LeanVM.Cost

open LeanVM.Cost.Decoder

public section

/-- The bodies' indices increase from the entry's `0`. -/
theorem decoderProgram_indices_increasing :
    increasingFrom 0 (decTopC.costDeps.map (·.1)) = true := by
  decide +kernel

/-- A row of one-limb numbers: its length and one. -/
theorem rowSize_of_lt (r : List ℕ) (h : ∀ x ∈ r, x < 2 ^ 64) : rowSize r = r.length + 1 := by
  unfold rowSize
  rw [sizeList_map]
  congr 1
  induction r with
  | nil => rfl
  | cons x r ih =>
    rw [List.map_cons, List.sum_cons, ih (fun y hy ↦ h y (by simp [hy])), List.length_cons]
    show limbCount x + _ = _
    rw [limbs_of_lt (h x (by simp))]
    omega

/-- At most four rows of cells below `2^16`, packed: the longest row's length and one. -/
theorem rowSize_packLanes (rows : List (List ℕ)) (h : ∀ r ∈ rows, ∀ x ∈ r, x < 65536)
    (hl : rows.length ≤ 4) : rowSize (packLanes rows) = maxLength rows + 1 := by
  rw [rowSize_of_lt _ (fun x hx ↦ ?_), packLanes_length]
  obtain ⟨i, hi, rfl⟩ := List.mem_iff_getElem.1 hx
  have := packLanes_lt rows h hl i
  rwa [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hi, Option.getD_some] at this

/-- Groups of at most four functions, packed: each group's longest function's cells and one. -/
theorem sum_rowSize_groups (G : List (List ℕ)) (hG : ∀ g ∈ G, g.length ≤ 4) :
    (G.map (rowSize ∘ fun g ↦ packLanes (g.map fun j ↦ guestLocsList.getD j []))).sum =
      (G.map fun g ↦ groupLen g + 1).sum := by
  induction G with
  | nil => rfl
  | cons g G ih =>
    rw [List.map_cons, List.map_cons, List.sum_cons, List.sum_cons,
      ih (fun g' hg' ↦ hG g' (by simp [hg'])), Function.comp_apply,
      rowSize_packLanes _ (group_rows_lt g) (by rw [List.length_map]; exact hG g (by simp))]
    unfold maxLength groupLen
    rw [List.map_map]
    rfl

/-- **The guest's frame cells' packed literal**: its size, its rows' (the slots' and the groups',
`guestLanes_rowSize`, the chunks of `DecoderSize/Locs.lean`), the array's and `Term.literal`'s. -/
theorem guestLocsTable_size : guestLocsTableC.costBody.size = guestLanesRowSize + 2 := by
  have h : guestLocsTableC.costBody = Term.literal (MachineValue.array
      (guestLanesList.map fun r ↦ MachineValue.array (r.map encodeValue).toArray).toArray) := rfl
  have h4 := guestLaneGroups_le
  rw [List.all_eq_true] at h4
  have hg := sum_rowSize_groups guestLaneGroups (fun g hg ↦ of_decide_eq_true (h4 g hg))
  have e := guestLanes_rowSize
  rw [h, literal_size, guestLanesList, List.map_cons, List.sum_cons, List.map_map]
  omega

/-- The sum of a function over a list: over the entries `p` keeps and over the others. -/
theorem sum_map_filter_add {α : Type} (f : α → ℕ) (p : α → Bool) (l : List α) :
    (l.map f).sum = ((l.filter p).map f).sum + ((l.filter fun x ↦ !p x).map f).sum := by
  induction l with
  | nil => rfl
  | cons x l ih => cases h : p x <;> simp [h, ih] <;> omega

set_option maxRecDepth 100000 in
/-- The literal's body is the bodies' one at its index (by unfolding: no body is evaluated). -/
theorem decoderProgramBodies_filter_locs :
    (decoderProgramBodiesOf decTopC.costIdx decTopC.costDeps).filter
        (fun p ↦ p.1 == guestLocsTableC.costIdx) =
      [(guestLocsTableC.costIdx, guestLocsTableC.costBody)] := by
  rfl

/-- The bound of `size_ofList_add_length` on bodies `L`, from one body's size at index `i` and
the others', with `d + 1` bodies up to index `k`: their sizes and two per index without a body.
Stated for any list: on the program's bodies, a ground term, `rw` and `omega` would evaluate
them. -/
theorem bodies_size_bound_of_split (L : List (ℕ × Term)) (i k n r s d : ℕ) (b : Term)
    (hf : L.filter (fun p ↦ p.1 == i) = [(i, b)]) (hb : b.size = n)
    (hrest : ((L.filter fun p ↦ !(p.1 == i)).map fun p ↦ p.2.size).sum ≤ r)
    (hmax : (L.map (·.1)).foldr max 0 = k) (hs : n + r = s) (hd : d ≤ k) :
    (L.map fun p ↦ p.2.size).sum + 2 * ((L.map (·.1)).foldr max 0 + 1) ≤
      s + 2 * (k - d) + 2 * (d + 1) := by
  rw [sum_map_filter_add _ (fun p ↦ p.1 == i), hf, hmax, List.map_singleton, List.sum_singleton,
    hb]
  omega

/-- The bodies' sizes, the frame cells' literal's but. -/
@[expose] def otherBodiesSize : ℕ :=
  (((decoderProgramBodiesOf decTopC.costIdx decTopC.costDeps).filter fun p ↦ !(p.1 == guestLocsTableC.costIdx)).map
    fun p ↦ p.2.size).sum

/-- **The program's size**, evaluated: the bodies' sizes, the frame cells' literal
(`guestLocsTable_size`) and the others (`otherBodiesSize`), and two
per index without a body: the indices up to the top's, `decTopC.costIdx + 1`, less the bodies,
the entry and `decTopC.costDeps`. -/
theorem decoderProgram_size_le_measured :
    (decoderProgramOf decTopC.costIdx decTopC.costDeps).size ≤
      guestLanesRowSize + 2 + otherBodiesSize + 2 * (decTopC.costIdx - decTopC.costDeps.length) :=
  decoderProgramOf_size_le_of_increasing decoderProgram_indices_increasing
    (bodies_size_bound_of_split _ guestLocsTableC.costIdx decTopC.costIdx _ otherBodiesSize _
      decTopC.costDeps.length _ decoderProgramBodies_filter_locs guestLocsTable_size
      (Nat.le_refl _) (by decide +kernel) rfl (by decide +kernel))

end

end LeanVM.Cost
