/-- An `ext` function's entry: the first whose name has the same bytes. -/
def xSpecOf (f : String) : Option XSpec :=
  let k := nameKey f
  (xTab.find? (fun p => nameKey p.1 == k)).map (·.2)

/-- **The guest's `ext` preconditions**, `X` of `UOf`. -/
def guestX (rd : Reader) (f : String) (a : List E) : Prop :=
  ∀ s, xSpecOf f = some s → s.Holds rd a

end
