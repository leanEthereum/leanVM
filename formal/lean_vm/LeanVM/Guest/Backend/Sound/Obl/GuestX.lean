/-
  LeanVM.Guest.Backend.Sound.Obl.GuestX

  The guest's relational preconditions: the functions the table marks `ext`, and what each asks.
-/

module

public import LeanVM.Guest.Backend.Sound.Obl.Check
public import LeanVM.Guest.WalkTags

/-!
# The guest's `ext` preconditions

The preconditions not of the table's form (`Obl.Sig`) are relations between a function's arguments
and memory, B1's (`WalkWindows.lean`, `WalkTags.lean`):

* `gkr`: `verify_bus_gkr_loop0` (compiled `__loop6`), `GkrPar` on its `[layers, x, start_g,
  k_mod_next]` (arguments `3, 0, 2, 9`): the parity words its dispatch reads;
* `loop w`: a loop helper of `opening_queries` on `[x, N, positions, qptrs, …]`, the walk from `x`
  to `N` (`WinWalk2` at level `0`, `base = 1`, else `WinWalk`) on `qptrs` and `x ≠ N`;
* `main w`: an `opening_queries` specialization, `OqMainWins` on its window pointers `qptrs`
  (argument `6`) and `N` (argument `7`);
* `lq n w`: a `level_queries` specialization, `OqMainWins` on its window pointers (argument `5`)
  at `N = g^n`, what it hands its `opening_queries` with `N` set to `g^n` (`n` the loop's
  iterations: the queries but an odd first, halved at level `0`).

`w` is the walk's shape: depth `d`, cap depth `cd`, `odd`, `base`. `xTab` lists the functions,
`guestX` is the precondition `UOf` takes for them.
-/

namespace LeanVM.Guest.Backend.Obl

open LeanVM.Parameters LeanVM.Semantics LeanVM.Guest LeanVM.Guest.Core LeanVM.Guest.B1
open LeanVM.Protocol.Verifier

@[expose] public section

/-- A walk's shape: depth `d`, cap depth `cd`, an odd count's first query `odd`, `base`. -/
structure WalkSpec where
  d : Nat
  cd : Nat
  odd : Nat
  base : Nat
  deriving DecidableEq, Repr

/-- What an `ext` function asks of its arguments. -/
inductive XSpec where
  | gkr
  | loop (w : WalkSpec)
  | main (w : WalkSpec)
  | lq (n : Nat) (w : WalkSpec)
  deriving DecidableEq, Repr

/-- The walk of a loop helper from `x` to `N` on `t`. -/
def LoopWalk (rd : Reader) (w : WalkSpec) (t x N : E) : Prop :=
  if w.base = 1 then WinWalk2 rd w.d w.cd w.odd t x N else WinWalk rd w.d w.cd t x N

/-- **What an `ext` function asks** of its argument words `a`. -/
def XSpec.Holds (rd : Reader) (a : List E) : XSpec → Prop
  | .gkr => GkrPar rd (a.getD 3 0) (a.getD 0 0) (a.getD 2 0) (a.getD 9 0)
  | .loop w => LoopWalk rd w (a.getD 3 0) (a.getD 0 0) (a.getD 1 0) ∧ a.getD 0 0 ≠ a.getD 1 0
  | .main w => OqMainWins rd w.d w.cd w.odd w.base (a.getD 6 0) (a.getD 7 0)
  | .lq n w => OqMainWins rd w.d w.cd w.odd w.base (a.getD 5 0) (gen ^ n)

