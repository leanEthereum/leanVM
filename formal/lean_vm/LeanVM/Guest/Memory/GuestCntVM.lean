/-- The certificates counting `mulNative` instructions, by name. -/
noncomputable def kvmcertOf (g : String) : Cert := kvmcertJ (coreIdx g)

theorem kvmcertOf_of_idx {j : ℕ} {g : String} (h : (coreProgram[j]?).map Fn.name = some g) :
    kvmcertOf g = kvmcertJ j := by
  rw [kvmcertOf, coreIdx_of_name h]

/-- Only the covered functions have certificates. -/
theorem kvmcertJ_list : (List.range coreProgram.length).all
    (fun j => decide (kcvIn j) || match kvmcertJ j with | .none => true | _ => false) = true := by
  rw [coreProgram_length]; decide +kernel

/-- The covered functions call only covered functions. -/
theorem kvmlnk_list : kcvST.all (fun j => (kvmlnkJ j).all fun q => decide (kcvIn q.2)) = true := by
  decide +kernel

theorem kvmcertJ_none {j : ℕ} (hj : j < coreProgram.length) (hS : ¬ kcvIn j) : kvmcertJ j = .none := by
  have h := List.all_eq_true.mp kvmcertJ_list j (List.mem_range.mpr hj)
  simp only [hS, decide_false, Bool.false_or] at h
  split at h
  · assumption
  · exact absurd h (by simp)

/-- The certificates were made at the frame weights `B2C.ωArm B2C.xmssArmC .mulNative`. -/
theorem kvmomegaJ_eq {j : ℕ} (hS : kcvIn j) (hj : j < coreProgram.length) :
    kvmomegaJ j = B2C.ωArm B2C.xmssArmC .mulNative coreProgram[j].name := by
  have h := (kcvPm_eq hS).2.1
  have e := kcvArmJ_eq hj .mulNative
  rw [show B2C.opIdx .mulNative = 1 from rfl] at e
  rw [e] at h
  unfold B2C.ωArm B2C.pathMax
  rw [kcv_idxOf hj]
  exact h

theorem kvmlookJ_ok {j : ℕ}
    (hl : (kvmlnkJ j).all (fun q => decide ((coreProgram[q.2]?).map Fn.name = some q.1)) = true) :
    LookOk (kvmlookJ j) kvmcertOf := by
  intro g hg
  unfold kvmlookJ at hg ⊢
  rcases hf : (kvmlnkJ j).find (nameKey g) with _ | q
  · rw [hf] at hg; exact absurd rfl hg
  · rw [hf] at hg
    dsimp only at hg ⊢
    by_cases hq : g = q.1
    · have hp := NTree.find_all hl hf
      simp only [decide_eq_true_eq] at hp
      rw [ite_eq_left (c := g = q.1) hq, kvmcertOf_of_idx (hq ▸ hp)]
    · rw [ite_eq_right (c := g = q.1) hq] at hg; exact absurd rfl hg

theorem kvmomLookJ_ok {j : ℕ} (hS : kcvIn j)
    (hl : (kvmlnkJ j).all (fun q => decide ((coreProgram[q.2]?).map Fn.name = some q.1)) = true) :
    WlOk (kvmomLookJ j) (B2C.ωArm B2C.xmssArmC .mulNative) := by
  intro g n hg
  unfold kvmomLookJ at hg
  rcases hf : (kvmlnkJ j).find (nameKey g) with _ | q
  · rw [hf] at hg; cases hg
  · rw [hf] at hg
    dsimp only at hg
    by_cases hq : g = q.1
    · rw [ite_eq_left (c := g = q.1) hq, Option.some.injEq] at hg
      have hp := NTree.find_all hl hf
      simp only [decide_eq_true_eq] at hp
      have hqS : kcvIn q.2 := by
        have h1 := NTree.find_all (p := fun j => (kvmlnkJ j).all fun q => decide (kcvIn q.2))
          kvmlnk_list hS
        have := NTree.find_all h1 hf
        simpa using this
      rcases hj : coreProgram[q.2]? with _ | fn
      · rw [hj] at hp; exact absurd hp (by simp)
      · rw [hj] at hp
        obtain ⟨hlt, hfn⟩ := List.getElem?_eq_some_iff.mp hj
        simp only [Option.map_some, Option.some.injEq] at hp
        show B2C.ωArm B2C.xmssArmC .mulNative g ≤ n
        rw [hq, ← hp, ← hfn, ← kvmomegaJ_eq hqS hlt, hg]
    · rw [ite_eq_right (c := g = q.1) hq] at hg; cases hg

/-- **The certificates counting `mulNative` instructions check.** -/
theorem kvm_checked : Checked coreProgram false kvmcertOf (B2C.ωArm B2C.xmssArmC .mulNative) := by
  intro fn hfn _
  obtain ⟨j, hj, rfl⟩ := List.mem_iff_getElem.mp hfn
  have hc := kvmchkIdx_all j (by rw [coreProgram_length] at hj; exact hj)
  unfold kvmchkIdx at hc
  rw [List.getElem?_eq_getElem hj] at hc
  simp only [kvmhandJ, List.any_nil, Bool.false_or, Bool.and_eq_true] at hc
  by_cases hS : kcvIn j
  · refine ⟨kvmlookJ j, kvmomLookJ j, kvmlookJ_ok hc.1, kvmomLookJ_ok hS hc.1, ?_⟩
    show chkFn _ _ false (kvmcertOf coreProgram[j].name) (B2C.ωArm B2C.xmssArmC .mulNative coreProgram[j].name) _ = true
    rw [kvmcertOf, coreIdx_getElem hj, ← kvmomegaJ_eq hS hj]
    exact hc.2
  · refine ⟨fun _ => .none, fun _ => none, fun _ h => absurd rfl h, fun _ _ h => (by cases h), ?_⟩
    rw [kvmcertOf, coreIdx_getElem hj, kvmcertJ_none hj hS]
    rfl

/-- A function with a constant certificate counting `mulNative` instructions. -/
theorem kvm_weightLe {f : String} {B : ℕ} {ks : List (V × ℕ)}
    (hcf : kvmcertOf f = .stat [] ⟨B, []⟩ ks) : WeightLe coreProgram (B2C.ωArm B2C.xmssArmC .mulNative) f fun _ => B :=
  weightLe_of_stat kvm_checked hcf

/-- A function with a certificate counting `mulNative` instructions, under its preconditions. -/
theorem kvm_weight_le_of_stat {f : String} {pre : List (ℕ × ℕ)} {b : Aff} {ks : List (V × ℕ)}
    (hcf : kvmcertOf f = .stat pre b ks) {rd : Reader} {t : Tree} {args rets : List E}
    (hn : t.name = f) (hv : t.Valid coreProgram rd args rets) (hb : t.BufsOk coreProgram)
    (hpre : ArgsPre pre args) : t.weight (B2C.ωArm B2C.xmssArmC .mulNative) ≤ b.eval args :=
  weight_le_of_stat kvm_checked hcf hn hv hb hpre

/-- A loop helper's `mulNative` instructions, from `g^a` to `g^e`. -/
theorem kvm_weight_le_of_loop {f : String} {endc : Option ℕ} {pre : List (ℕ × ℕ)} {b : Aff}
    {ks : List (V × ℕ)} (hcf : kvmcertOf f = .loop endc pre b ks) {rd : Reader} {t : Tree}
    {args rets : List E} (hn : t.name = f) (hv : t.Valid coreProgram rd args rets)
    (hb : t.BufsOk coreProgram) {a e : ℕ} (ha : args.getD 0 0 = ofK (addressOfIndex a))
    (he : endOf endc args = ofK (addressOfIndex e)) (hae : a < e) (heo : e < 2 ^ 64 - 1)
    (hpre : ArgsPre pre args) : t.weight (B2C.ωArm B2C.xmssArmC .mulNative) ≤ (e - a) * b.eval args :=
  weight_le_of_loop kvm_checked hcf hn hv hb ha he hae heo hpre

