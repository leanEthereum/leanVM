namespace LeanVM.Guest

open LeanVM.Parameters LeanVM.Semantics Core Memory Data

@[expose] public section

/-- The certificates counting `blake2s` instructions, by name. -/
noncomputable def kwbcertOf (g : String) : Cert := kwbcertJ (kcIdx g)

theorem kwbcertOf_of_idx {j : ℕ} {g : String} (h : (coreProgram[j]?).map Fn.name = some g) :
    kwbcertOf g = kwbcertJ j := by
  rw [kwbcertOf, kcIdx_of_name h]

/-- Only the functions of `kcS` have certificates. -/
theorem kwbcertJ_list : (List.range coreProgram.length).all
    (fun j => decide (j ∈ kcS) || match kwbcertJ j with | .none => true | _ => false) = true := by
  rw [coreProgram_length]; decide +kernel

/-- The functions of `kcS` call only functions of `kcS`. -/
theorem kwblnk_list : kcS.all (fun j => (kwblnkJ j).all fun q => decide (q.2 ∈ kcS)) = true := by
  decide +kernel

theorem kwbcertJ_none {j : ℕ} (hj : j < coreProgram.length) (hS : j ∉ kcS) : kwbcertJ j = .none := by
  have h := List.all_eq_true.mp kwbcertJ_list j (List.mem_range.mpr hj)
  simp only [hS, decide_false, Bool.false_or] at h
  split at h
  · assumption
  · exact absurd h (by simp)

/-- The certificates were made at the frame weights `B2C.pathMax · .blake2s`. -/
theorem kwbomegaJ_eq {j : ℕ} (hS : j ∈ kcS) (hj : j < coreProgram.length) :
    kwbomegaJ j = B2C.pathMax coreProgram[j].name .blake2s := by
  unfold B2C.pathMax
  rw [kc_idxOf hj]
  exact (kcPm_eq hS).2.2.2.2.2

theorem kwblookJ_ok {j : ℕ}
    (hl : (kwblnkJ j).all (fun q => decide ((coreProgram[q.2]?).map Fn.name = some q.1)) = true) :
    LookOk (kwblookJ j) kwbcertOf := by
  intro g hg
  unfold kwblookJ at hg ⊢
  rcases hf : (kwblnkJ j).find (nameKey g) with _ | q
  · rw [hf] at hg; exact absurd rfl hg
  · rw [hf] at hg
    dsimp only at hg ⊢
    by_cases hq : g = q.1
    · have hp := NTree.find_all hl hf
      simp only [decide_eq_true_eq] at hp
      rw [ite_eq_left (c := g = q.1) hq, kwbcertOf_of_idx (hq ▸ hp)]
    · rw [ite_eq_right (c := g = q.1) hq] at hg; exact absurd rfl hg

theorem kwbomLookJ_ok {j : ℕ} (hS : j ∈ kcS)
    (hl : (kwblnkJ j).all (fun q => decide ((coreProgram[q.2]?).map Fn.name = some q.1)) = true) :
    WlOk (kwbomLookJ j) (B2C.pathMax · .blake2s) := by
  intro g n hg
  unfold kwbomLookJ at hg
  rcases hf : (kwblnkJ j).find (nameKey g) with _ | q
  · rw [hf] at hg; cases hg
  · rw [hf] at hg
    dsimp only at hg
    by_cases hq : g = q.1
    · rw [ite_eq_left (c := g = q.1) hq, Option.some.injEq] at hg
      have hp := NTree.find_all hl hf
      simp only [decide_eq_true_eq] at hp
      have hqS : q.2 ∈ kcS := by
        have := NTree.find_all (List.all_eq_true.mp kwblnk_list j hS) hf
        simpa using this
      rcases hj : coreProgram[q.2]? with _ | fn
      · rw [hj] at hp; exact absurd hp (by simp)
      · rw [hj] at hp
        obtain ⟨hlt, hfn⟩ := List.getElem?_eq_some_iff.mp hj
        simp only [Option.map_some, Option.some.injEq] at hp
        show B2C.pathMax g .blake2s ≤ n
        rw [hq, ← hp, ← hfn, ← kwbomegaJ_eq hqS hlt, hg]
    · rw [ite_eq_right (c := g = q.1) hq] at hg; cases hg

/-- **The certificates counting `blake2s` instructions check.** -/
theorem kwb_checked : Checked coreProgram false kwbcertOf (B2C.pathMax · .blake2s) := by
  intro fn hfn _
  obtain ⟨j, hj, rfl⟩ := List.mem_iff_getElem.mp hfn
  have hc := kwbchkIdx_all j (by rw [coreProgram_length] at hj; exact hj)
  unfold kwbchkIdx at hc
  rw [List.getElem?_eq_getElem hj] at hc
  simp only [kwbhandJ, List.any_nil, Bool.false_or, Bool.and_eq_true] at hc
  by_cases hS : j ∈ kcS
  · refine ⟨kwblookJ j, kwbomLookJ j, kwblookJ_ok hc.1, kwbomLookJ_ok hS hc.1, ?_⟩
    show chkFn _ _ false (kwbcertOf coreProgram[j].name) (B2C.pathMax coreProgram[j].name .blake2s) _ = true
    rw [kwbcertOf, kcIdx_getElem hj, ← kwbomegaJ_eq hS hj]
    exact hc.2
  · refine ⟨fun _ => .none, fun _ => none, fun _ h => absurd rfl h, fun _ _ h => (by cases h), ?_⟩
    rw [kwbcertOf, kcIdx_getElem hj, kwbcertJ_none hj hS]
    rfl

/-- A function with a constant certificate counting `blake2s` instructions. -/
theorem kwb_weightLe {f : String} {B : ℕ} {ks : List (V × ℕ)}
    (hcf : kwbcertOf f = .stat [] ⟨B, []⟩ ks) : WeightLe coreProgram (B2C.pathMax · .blake2s) f fun _ => B :=
  weightLe_of_stat kwb_checked hcf

/-- A function with a certificate counting `blake2s` instructions, under its preconditions. -/
theorem kwb_weight_le_of_stat {f : String} {pre : List (ℕ × ℕ)} {b : Aff} {ks : List (V × ℕ)}
    (hcf : kwbcertOf f = .stat pre b ks) {rd : Reader} {t : Tree} {args rets : List E}
    (hn : t.name = f) (hv : t.Valid coreProgram rd args rets) (hb : t.BufsOk coreProgram)
    (hpre : ArgsPre pre args) : t.weight (B2C.pathMax · .blake2s) ≤ b.eval args :=
  weight_le_of_stat kwb_checked hcf hn hv hb hpre

/-- A loop helper's `blake2s` instructions, from `g^a` to `g^e`. -/
theorem kwb_weight_le_of_loop {f : String} {endc : Option ℕ} {pre : List (ℕ × ℕ)} {b : Aff}
    {ks : List (V × ℕ)} (hcf : kwbcertOf f = .loop endc pre b ks) {rd : Reader} {t : Tree}
    {args rets : List E} (hn : t.name = f) (hv : t.Valid coreProgram rd args rets)
    (hb : t.BufsOk coreProgram) {a e : ℕ} (ha : args.getD 0 0 = ofK (gpow a))
    (he : endOf endc args = ofK (gpow e)) (hae : a < e) (heo : e < 2 ^ 64 - 1)
    (hpre : ArgsPre pre args) : t.weight (B2C.pathMax · .blake2s) ≤ (e - a) * b.eval args :=
  weight_le_of_loop kwb_checked hcf hn hv hb ha he hae heo hpre

