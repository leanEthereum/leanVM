/-- **The certificates counting `blake2s` instructions check.** -/
theorem kwb_checked : Checked coreProgram false kwbcertOf (kcOm .blake2s) := by
  intro fn hfn _
  obtain ⟨j, hj, rfl⟩ := List.mem_iff_getElem.mp hfn
  have hc := kwbchkIdx_all j (by rw [coreProgram_length] at hj; exact hj)
  unfold kwbchkIdx at hc
  rw [List.getElem?_eq_getElem hj] at hc
  simp only [kwbhandJ, List.any_nil, Bool.false_or, Bool.and_eq_true] at hc
  by_cases hS : kcIn j
  · refine ⟨kwblookJ j, kwbomLookJ j, kwblookJ_ok hc.1, kwbomLookJ_ok hS hc.1, ?_⟩
    show chkFn _ _ false (kwbcertOf coreProgram[j].name) (kcOm .blake2s coreProgram[j].name) _ = true
    rw [kwbcertOf, kcIdx_getElem hj, ← kwbomegaJ_eq hS hj]
    exact hc.2
  · refine ⟨fun _ => .none, fun _ => none, fun _ h => absurd rfl h, fun _ _ h => (by cases h), ?_⟩
    rw [kwbcertOf, kcIdx_getElem hj, kwbcertJ_none hj hS]
    rfl

