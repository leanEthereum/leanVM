/-- The exponent of `gen ^ q` is at most `q`. -/
theorem logG_gen_pow_le (q : ℕ) : logG (LeanVM.Protocol.Verifier.gen ^ q) ≤ q := by
  classical
  rw [LeanVM.Guest.Value.gen_pow_eq_ofK]
  have h : ∃ e, ofK (gpow q) = ofK (gpow e) := ⟨q, rfl⟩
  rw [logG, dite_eq_left h]
  exact Nat.find_min' h rfl

/-- **`__loop86`'s bound at its end `gen ^ q`, linear in `q`** (`h86` at `a86 = 482`, `b86 = 0`). -/
theorem loop86_bound_le (q : ℕ) :
    (fun x : E => logG x * 482) (LeanVM.Protocol.Verifier.gen ^ q) ≤ 482 * q + 0 := by
  have := logG_gen_pow_le q
  show logG (LeanVM.Protocol.Verifier.gen ^ q) * 482 ≤ 482 * q + 0
  omega

