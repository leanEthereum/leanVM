/-
  LeanVM.Guest.Memory.GuestCntVJ

  The guest's static certificates counting `jump` instructions (`B2C.ωArm B2C.xmssArmC .jump`),
  checked (`kvj_checked`), and the weight bounds they give (`kvj_weightLe`, `kvj_weight_le_of_stat`,
  `kvj_weight_le_of_loop`). Generated by `scripts/count/gen.py`; do not edit.
-/

module

public import LeanVM.Guest.Memory.GuestCntVJ.All
public import LeanVM.Guest.Memory.GuestCntVPm

namespace LeanVM.Guest

open LeanVM.Parameters LeanVM.Semantics Core Memory Data

@[expose] public section

/-- The certificates counting `jump` instructions, by name. -/
noncomputable def kvjcertOf (g : String) : Cert := kvjcertJ (coreIdx g)

theorem kvjcertOf_of_idx {j : ℕ} {g : String} (h : (coreProgram[j]?).map Fn.name = some g) :
    kvjcertOf g = kvjcertJ j := by
  rw [kvjcertOf, coreIdx_of_name h]

/-- Only the covered functions have certificates. -/
theorem kvjcertJ_list : (List.range coreProgram.length).all
    (fun j => decide (kcvIn j) || match kvjcertJ j with | .none => true | _ => false) = true := by
  rw [coreProgram_length]; decide +kernel

/-- The covered functions call only covered functions. -/
theorem kvjlnk_list : kcvST.all (fun j => (kvjlnkJ j).all fun q => decide (kcvIn q.2)) = true := by
  decide +kernel

theorem kvjcertJ_none {j : ℕ} (hj : j < coreProgram.length) (hS : ¬ kcvIn j) : kvjcertJ j = .none := by
  have h := List.all_eq_true.mp kvjcertJ_list j (List.mem_range.mpr hj)
  simp only [hS, decide_false, Bool.false_or] at h
  split at h
  · assumption
  · exact absurd h (by simp)

/-- The certificates were made at the frame weights `B2C.ωArm B2C.xmssArmC .jump`. -/
theorem kvjomegaJ_eq {j : ℕ} (hS : kcvIn j) (hj : j < coreProgram.length) :
    kvjomegaJ j = B2C.ωArm B2C.xmssArmC .jump coreProgram[j].name := by
  have h := (kcvPm_eq hS).2.2.2.2.1
  have e := kcvArmJ_eq hj .jump
  rw [show B2C.opIdx .jump = 4 from rfl] at e
  rw [e] at h
  unfold B2C.ωArm B2C.pathMax
  rw [kcv_idxOf hj]
  exact h

theorem kvjlookJ_ok {j : ℕ}
    (hl : (kvjlnkJ j).all (fun q => decide ((coreProgram[q.2]?).map Fn.name = some q.1)) = true) :
    LookOk (kvjlookJ j) kvjcertOf := by
  intro g hg
  unfold kvjlookJ at hg ⊢
  rcases hf : (kvjlnkJ j).find (nameKey g) with _ | q
  · rw [hf] at hg; exact absurd rfl hg
  · rw [hf] at hg
    dsimp only at hg ⊢
    by_cases hq : g = q.1
    · have hp := NTree.find_all hl hf
      simp only [decide_eq_true_eq] at hp
      rw [ite_eq_left (c := g = q.1) hq, kvjcertOf_of_idx (hq ▸ hp)]
    · rw [ite_eq_right (c := g = q.1) hq] at hg; exact absurd rfl hg

theorem kvjomLookJ_ok {j : ℕ} (hS : kcvIn j)
    (hl : (kvjlnkJ j).all (fun q => decide ((coreProgram[q.2]?).map Fn.name = some q.1)) = true) :
    WlOk (kvjomLookJ j) (B2C.ωArm B2C.xmssArmC .jump) := by
  intro g n hg
  unfold kvjomLookJ at hg
  rcases hf : (kvjlnkJ j).find (nameKey g) with _ | q
  · rw [hf] at hg; cases hg
  · rw [hf] at hg
    dsimp only at hg
    by_cases hq : g = q.1
    · rw [ite_eq_left (c := g = q.1) hq, Option.some.injEq] at hg
      have hp := NTree.find_all hl hf
      simp only [decide_eq_true_eq] at hp
      have hqS : kcvIn q.2 := by
        have h1 := NTree.find_all (p := fun j => (kvjlnkJ j).all fun q => decide (kcvIn q.2))
          kvjlnk_list hS
        have := NTree.find_all h1 hf
        simpa using this
      rcases hj : coreProgram[q.2]? with _ | fn
      · rw [hj] at hp; exact absurd hp (by simp)
      · rw [hj] at hp
        obtain ⟨hlt, hfn⟩ := List.getElem?_eq_some_iff.mp hj
        simp only [Option.map_some, Option.some.injEq] at hp
        show B2C.ωArm B2C.xmssArmC .jump g ≤ n
        rw [hq, ← hp, ← hfn, ← kvjomegaJ_eq hqS hlt, hg]
    · rw [ite_eq_right (c := g = q.1) hq] at hg; cases hg

/-- **The certificates counting `jump` instructions check.** -/
theorem kvj_checked : Checked coreProgram false kvjcertOf (B2C.ωArm B2C.xmssArmC .jump) := by
  intro fn hfn _
  obtain ⟨j, hj, rfl⟩ := List.mem_iff_getElem.mp hfn
  have hc := kvjchkIdx_all j (by rw [coreProgram_length] at hj; exact hj)
  unfold kvjchkIdx at hc
  rw [List.getElem?_eq_getElem hj] at hc
  simp only [kvjhandJ, List.any_nil, Bool.false_or, Bool.and_eq_true] at hc
  by_cases hS : kcvIn j
  · refine ⟨kvjlookJ j, kvjomLookJ j, kvjlookJ_ok hc.1, kvjomLookJ_ok hS hc.1, ?_⟩
    show chkFn _ _ false (kvjcertOf coreProgram[j].name) (B2C.ωArm B2C.xmssArmC .jump coreProgram[j].name) _ = true
    rw [kvjcertOf, coreIdx_getElem hj, ← kvjomegaJ_eq hS hj]
    exact hc.2
  · refine ⟨fun _ => .none, fun _ => none, fun _ h => absurd rfl h, fun _ _ h => (by cases h), ?_⟩
    rw [kvjcertOf, coreIdx_getElem hj, kvjcertJ_none hj hS]
    rfl

/-- A function with a constant certificate counting `jump` instructions. -/
theorem kvj_weightLe {f : String} {B : ℕ} {ks : List (V × ℕ)}
    (hcf : kvjcertOf f = .stat [] ⟨B, []⟩ ks) : WeightLe coreProgram (B2C.ωArm B2C.xmssArmC .jump) f fun _ => B :=
  weightLe_of_stat kvj_checked hcf

/-- A function with a certificate counting `jump` instructions, under its preconditions. -/
theorem kvj_weight_le_of_stat {f : String} {pre : List (ℕ × ℕ)} {b : Aff} {ks : List (V × ℕ)}
    (hcf : kvjcertOf f = .stat pre b ks) {rd : Reader} {t : Tree} {args rets : List E}
    (hn : t.name = f) (hv : t.Valid coreProgram rd args rets) (hb : t.BufsOk coreProgram)
    (hpre : ArgsPre pre args) : t.weight (B2C.ωArm B2C.xmssArmC .jump) ≤ b.eval args :=
  weight_le_of_stat kvj_checked hcf hn hv hb hpre

/-- A loop helper's `jump` instructions, from `g^a` to `g^e`. -/
theorem kvj_weight_le_of_loop {f : String} {endc : Option ℕ} {pre : List (ℕ × ℕ)} {b : Aff}
    {ks : List (V × ℕ)} (hcf : kvjcertOf f = .loop endc pre b ks) {rd : Reader} {t : Tree}
    {args rets : List E} (hn : t.name = f) (hv : t.Valid coreProgram rd args rets)
    (hb : t.BufsOk coreProgram) {a e : ℕ} (ha : args.getD 0 0 = ofK (addressOfIndex a))
    (he : endOf endc args = ofK (addressOfIndex e)) (hae : a < e) (heo : e < 2 ^ 64 - 1)
    (hpre : ArgsPre pre args) : t.weight (B2C.ωArm B2C.xmssArmC .jump) ≤ (e - a) * b.eval args :=
  weight_le_of_loop kvj_checked hcf hn hv hb ha he hae heo hpre

end
