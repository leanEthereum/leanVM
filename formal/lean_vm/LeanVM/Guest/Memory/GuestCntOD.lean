/-- The certificates counting `deref` instructions, by name. -/
noncomputable def kwodcertOf (g : String) : Cert := kwodcertJ (kcIdx g)

theorem kwodcertOf_of_idx {j : ℕ} {g : String} (h : (coreProgram[j]?).map Fn.name = some g) :
    kwodcertOf g = kwodcertJ j := by
  rw [kwodcertOf, kcIdx_of_name h]

/-- Only the covered functions have certificates. -/
theorem kwodcertJ_list : (List.range coreProgram.length).all
    (fun j => decide (koIn j) || match kwodcertJ j with | .none => true | _ => false) = true := by
  rw [coreProgram_length]; decide +kernel

/-- The covered functions call only covered functions. -/
theorem kwodlnk_list : koST.all (fun j => (kwodlnkJ j).all fun q => decide (koIn q.2)) = true := by
  decide +kernel

theorem kwodcertJ_none {j : ℕ} (hj : j < coreProgram.length) (hS : ¬ koIn j) : kwodcertJ j = .none := by
  have h := List.all_eq_true.mp kwodcertJ_list j (List.mem_range.mpr hj)
  simp only [hS, decide_false, Bool.false_or] at h
  split at h
  · assumption
  · exact absurd h (by simp)

/-- The certificates were made at the frame weights `kcOm .deref`. -/
theorem kwodomegaJ_eq {j : ℕ} (hS : koIn j) (hj : j < coreProgram.length) :
    kwodomegaJ j = kcOm .deref coreProgram[j].name := by
  have hne : ¬ coreProgram[j].name = "verify_lean_xmss" := fun e => ko_ne16 hS ((kc_name_xmss hj).mp e)
  unfold kcOm B2C.pathMax
  rw [ko_idxOf hj]
  simp only [hne, ↓reduceIte, Nat.add_zero]
  exact (koPm_eq hS).2.2.2.1

theorem kwodlookJ_ok {j : ℕ}
    (hl : (kwodlnkJ j).all (fun q => decide ((coreProgram[q.2]?).map Fn.name = some q.1)) = true) :
    LookOk (kwodlookJ j) kwodcertOf := by
  intro g hg
  unfold kwodlookJ at hg ⊢
  rcases hf : (kwodlnkJ j).find (nameKey g) with _ | q
  · rw [hf] at hg; exact absurd rfl hg
  · rw [hf] at hg
    dsimp only at hg ⊢
    by_cases hq : g = q.1
    · have hp := NTree.find_all hl hf
      simp only [decide_eq_true_eq] at hp
      rw [ite_eq_left (c := g = q.1) hq, kwodcertOf_of_idx (hq ▸ hp)]
    · rw [ite_eq_right (c := g = q.1) hq] at hg; exact absurd rfl hg

theorem kwodomLookJ_ok {j : ℕ} (hS : koIn j)
    (hl : (kwodlnkJ j).all (fun q => decide ((coreProgram[q.2]?).map Fn.name = some q.1)) = true) :
    WlOk (kwodomLookJ j) (kcOm .deref) := by
  intro g n hg
  unfold kwodomLookJ at hg
  rcases hf : (kwodlnkJ j).find (nameKey g) with _ | q
  · rw [hf] at hg; cases hg
  · rw [hf] at hg
    dsimp only at hg
    by_cases hq : g = q.1
    · rw [ite_eq_left (c := g = q.1) hq, Option.some.injEq] at hg
      have hp := NTree.find_all hl hf
      simp only [decide_eq_true_eq] at hp
      have hqS : koIn q.2 := by
        have h1 := NTree.find_all (p := fun j => (kwodlnkJ j).all fun q => decide (koIn q.2))
          kwodlnk_list hS
        have := NTree.find_all h1 hf
        simpa using this
      rcases hj : coreProgram[q.2]? with _ | fn
      · rw [hj] at hp; exact absurd hp (by simp)
      · rw [hj] at hp
        obtain ⟨hlt, hfn⟩ := List.getElem?_eq_some_iff.mp hj
        simp only [Option.map_some, Option.some.injEq] at hp
        show kcOm .deref g ≤ n
        rw [hq, ← hp, ← hfn, ← kwodomegaJ_eq hqS hlt, hg]
    · rw [ite_eq_right (c := g = q.1) hq] at hg; cases hg

/-- **The certificates counting `deref` instructions check.** -/
theorem kwod_checked : Checked coreProgram false kwodcertOf (kcOm .deref) := by
  intro fn hfn _
  obtain ⟨j, hj, rfl⟩ := List.mem_iff_getElem.mp hfn
  have hc := kwodchkIdx_all j (by rw [coreProgram_length] at hj; exact hj)
  unfold kwodchkIdx at hc
  rw [List.getElem?_eq_getElem hj] at hc
  simp only [kwodhandJ, List.any_nil, Bool.false_or, Bool.and_eq_true] at hc
  by_cases hS : koIn j
  · refine ⟨kwodlookJ j, kwodomLookJ j, kwodlookJ_ok hc.1, kwodomLookJ_ok hS hc.1, ?_⟩
    show chkFn _ _ false (kwodcertOf coreProgram[j].name) (kcOm .deref coreProgram[j].name) _ = true
    rw [kwodcertOf, kcIdx_getElem hj, ← kwodomegaJ_eq hS hj]
    exact hc.2
  · refine ⟨fun _ => .none, fun _ => none, fun _ h => absurd rfl h, fun _ _ h => (by cases h), ?_⟩
    rw [kwodcertOf, kcIdx_getElem hj, kwodcertJ_none hj hS]
    rfl

/-- A function with a constant certificate counting `deref` instructions. -/
theorem kwod_weightLe {f : String} {B : ℕ} {ks : List (V × ℕ)}
    (hcf : kwodcertOf f = .stat [] ⟨B, []⟩ ks) : WeightLe coreProgram (kcOm .deref) f fun _ => B :=
  weightLe_of_stat kwod_checked hcf

/-- A function with a certificate counting `deref` instructions, under its preconditions. -/
theorem kwod_weight_le_of_stat {f : String} {pre : List (ℕ × ℕ)} {b : Aff} {ks : List (V × ℕ)}
    (hcf : kwodcertOf f = .stat pre b ks) {rd : Reader} {t : Tree} {args rets : List E}
    (hn : t.name = f) (hv : t.Valid coreProgram rd args rets) (hb : t.BufsOk coreProgram)
    (hpre : ArgsPre pre args) : t.weight (kcOm .deref) ≤ b.eval args :=
  weight_le_of_stat kwod_checked hcf hn hv hb hpre

/-- A loop helper's `deref` instructions, from `g^a` to `g^e`. -/
theorem kwod_weight_le_of_loop {f : String} {endc : Option ℕ} {pre : List (ℕ × ℕ)} {b : Aff}
    {ks : List (V × ℕ)} (hcf : kwodcertOf f = .loop endc pre b ks) {rd : Reader} {t : Tree}
    {args rets : List E} (hn : t.name = f) (hv : t.Valid coreProgram rd args rets)
    (hb : t.BufsOk coreProgram) {a e : ℕ} (ha : args.getD 0 0 = ofK (gpow a))
    (he : endOf endc args = ofK (gpow e)) (hae : a < e) (heo : e < 2 ^ 64 - 1)
    (hpre : ArgsPre pre args) : t.weight (kcOm .deref) ≤ (e - a) * b.eval args :=
  weight_le_of_loop kwod_checked hcf hn hv hb ha he hae heo hpre

