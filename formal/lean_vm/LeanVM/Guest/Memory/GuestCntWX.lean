open LeanVM.Parameters LeanVM.Semantics Core Memory Data

@[expose] public section

/-- The certificates counting `xor` instructions, by name. -/
noncomputable def kuxcertOf (g : String) : Cert := kuxcertJ (coreIdx g)

theorem kuxcertOf_of_idx {j : ℕ} {g : String} (h : (coreProgram[j]?).map Fn.name = some g) :
    kuxcertOf g = kuxcertJ j := by
  rw [kuxcertOf, coreIdx_of_name h]

/-- Only the covered functions have certificates. -/
theorem kuxcertJ_list : (List.range coreProgram.length).all
    (fun j => decide (kcuIn j) || match kuxcertJ j with | .none => true | _ => false) = true := by
  rw [coreProgram_length]; decide +kernel

/-- The covered functions call only covered functions. -/
theorem kuxlnk_list : kcuST.all (fun j => (kuxlnkJ j).all fun q => decide (kcuIn q.2)) = true := by
  decide +kernel

theorem kuxcertJ_none {j : ℕ} (hj : j < coreProgram.length) (hS : ¬ kcuIn j) : kuxcertJ j = .none := by
  have h := List.all_eq_true.mp kuxcertJ_list j (List.mem_range.mpr hj)
  simp only [hS, decide_false, Bool.false_or] at h
  split at h
  · assumption
  · exact absurd h (by simp)

/-- The certificates were made at the frame weights `B2C.ωArm B2C.xmssArmC .xor`. -/
theorem kuxomegaJ_eq {j : ℕ} (hS : kcuIn j) (hj : j < coreProgram.length) :
    kuxomegaJ j = B2C.ωArm B2C.xmssArmC .xor coreProgram[j].name := by
  have h := (kcuPm_eq hS).1
  have e := kcuArmJ_eq hj .xor
  rw [show B2C.opIdx .xor = 0 from rfl] at e
  rw [e] at h
  unfold B2C.ωArm B2C.pathMax
  rw [kcu_idxOf hj]
  exact h

theorem kuxlookJ_ok {j : ℕ}
    (hl : (kuxlnkJ j).all (fun q => decide ((coreProgram[q.2]?).map Fn.name = some q.1)) = true) :
    LookOk (kuxlookJ j) kuxcertOf := by
  intro g hg
  unfold kuxlookJ at hg ⊢
  rcases hf : (kuxlnkJ j).find (nameKey g) with _ | q
  · rw [hf] at hg; exact absurd rfl hg
  · rw [hf] at hg
    dsimp only at hg ⊢
    by_cases hq : g = q.1
    · have hp := NTree.find_all hl hf
      simp only [decide_eq_true_eq] at hp
      rw [ite_eq_left (c := g = q.1) hq, kuxcertOf_of_idx (hq ▸ hp)]
    · rw [ite_eq_right (c := g = q.1) hq] at hg; exact absurd rfl hg

theorem kuxomLookJ_ok {j : ℕ} (hS : kcuIn j)
    (hl : (kuxlnkJ j).all (fun q => decide ((coreProgram[q.2]?).map Fn.name = some q.1)) = true) :
    WlOk (kuxomLookJ j) (B2C.ωArm B2C.xmssArmC .xor) := by
  intro g n hg
  unfold kuxomLookJ at hg
  rcases hf : (kuxlnkJ j).find (nameKey g) with _ | q
  · rw [hf] at hg; cases hg
  · rw [hf] at hg
    dsimp only at hg
    by_cases hq : g = q.1
    · rw [ite_eq_left (c := g = q.1) hq, Option.some.injEq] at hg
      have hp := NTree.find_all hl hf
      simp only [decide_eq_true_eq] at hp
      have hqS : kcuIn q.2 := by
        have h1 := NTree.find_all (p := fun j => (kuxlnkJ j).all fun q => decide (kcuIn q.2))
          kuxlnk_list hS
        have := NTree.find_all h1 hf
        simpa using this
      rcases hj : coreProgram[q.2]? with _ | fn
      · rw [hj] at hp; exact absurd hp (by simp)
      · rw [hj] at hp
        obtain ⟨hlt, hfn⟩ := List.getElem?_eq_some_iff.mp hj
        simp only [Option.map_some, Option.some.injEq] at hp
        show B2C.ωArm B2C.xmssArmC .xor g ≤ n
        rw [hq, ← hp, ← hfn, ← kuxomegaJ_eq hqS hlt, hg]
    · rw [ite_eq_right (c := g = q.1) hq] at hg; cases hg

/-- **The certificates counting `xor` instructions check.** -/
theorem kux_checked : Checked coreProgram false kuxcertOf (B2C.ωArm B2C.xmssArmC .xor) := by
  intro fn hfn _
  obtain ⟨j, hj, rfl⟩ := List.mem_iff_getElem.mp hfn
  have hc := kuxchkIdx_all j (by rw [coreProgram_length] at hj; exact hj)
  unfold kuxchkIdx at hc
  rw [List.getElem?_eq_getElem hj] at hc
  simp only [kuxhandJ, List.any_nil, Bool.false_or, Bool.and_eq_true] at hc
  by_cases hS : kcuIn j
  · refine ⟨kuxlookJ j, kuxomLookJ j, kuxlookJ_ok hc.1, kuxomLookJ_ok hS hc.1, ?_⟩
    show chkFn _ _ false (kuxcertOf coreProgram[j].name) (B2C.ωArm B2C.xmssArmC .xor coreProgram[j].name) _ = true
    rw [kuxcertOf, coreIdx_getElem hj, ← kuxomegaJ_eq hS hj]
    exact hc.2
  · refine ⟨fun _ => .none, fun _ => none, fun _ h => absurd rfl h, fun _ _ h => (by cases h), ?_⟩
    rw [kuxcertOf, coreIdx_getElem hj, kuxcertJ_none hj hS]
    rfl

/-- A function with a constant certificate counting `xor` instructions. -/
theorem kux_weightLe {f : String} {B : ℕ} {ks : List (V × ℕ)}
    (hcf : kuxcertOf f = .stat [] ⟨B, []⟩ ks) : WeightLe coreProgram (B2C.ωArm B2C.xmssArmC .xor) f fun _ => B :=
  weightLe_of_stat kux_checked hcf

/-- A function with a certificate counting `xor` instructions, under its preconditions. -/
theorem kux_weight_le_of_stat {f : String} {pre : List (ℕ × ℕ)} {b : Aff} {ks : List (V × ℕ)}
    (hcf : kuxcertOf f = .stat pre b ks) {rd : Reader} {t : Tree} {args rets : List E}
    (hn : t.name = f) (hv : t.Valid coreProgram rd args rets) (hb : t.BufsOk coreProgram)
    (hpre : ArgsPre pre args) : t.weight (B2C.ωArm B2C.xmssArmC .xor) ≤ b.eval args :=
  weight_le_of_stat kux_checked hcf hn hv hb hpre

/-- A loop helper's `xor` instructions, from `g^a` to `g^e`. -/
theorem kux_weight_le_of_loop {f : String} {endc : Option ℕ} {pre : List (ℕ × ℕ)} {b : Aff}
    {ks : List (V × ℕ)} (hcf : kuxcertOf f = .loop endc pre b ks) {rd : Reader} {t : Tree}
    {args rets : List E} (hn : t.name = f) (hv : t.Valid coreProgram rd args rets)
    (hb : t.BufsOk coreProgram) {a e : ℕ} (ha : args.getD 0 0 = ofK (addressOfIndex a))
    (he : endOf endc args = ofK (addressOfIndex e)) (hae : a < e) (heo : e < 2 ^ 64 - 1)
    (hpre : ArgsPre pre args) : t.weight (B2C.ωArm B2C.xmssArmC .xor) ≤ (e - a) * b.eval args :=
  weight_le_of_loop kux_checked hcf hn hv hb ha he hae heo hpre

