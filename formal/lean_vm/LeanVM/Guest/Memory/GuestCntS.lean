/-- The certificates counting `setConstant` instructions, by name. -/
noncomputable def kwscertOf (g : String) : Cert := kwscertJ (kcIdx g)

theorem kwscertOf_of_idx {j : ℕ} {g : String} (h : (coreProgram[j]?).map Fn.name = some g) :
    kwscertOf g = kwscertJ j := by
  rw [kwscertOf, kcIdx_of_name h]

/-- Only the covered functions have certificates. -/
theorem kwscertJ_list : (List.range coreProgram.length).all
    (fun j => decide (kcIn j) || match kwscertJ j with | .none => true | _ => false) = true := by
  rw [coreProgram_length]; decide +kernel

/-- The covered functions call only covered functions. -/
theorem kwslnk_list : kcST.all (fun j => (kwslnkJ j).all fun q => decide (kcIn q.2)) = true := by
  decide +kernel

theorem kwscertJ_none {j : ℕ} (hj : j < coreProgram.length) (hS : ¬ kcIn j) : kwscertJ j = .none := by
  have h := List.all_eq_true.mp kwscertJ_list j (List.mem_range.mpr hj)
  simp only [hS, decide_false, Bool.false_or] at h
  split at h
  · assumption
  · exact absurd h (by simp)

/-- The certificates were made at the frame weights `kcOm .setConstant`. -/
theorem kwsomegaJ_eq {j : ℕ} (hS : kcIn j) (hj : j < coreProgram.length) :
    kwsomegaJ j = kcOm .setConstant coreProgram[j].name := by
  have h := (kcPm_eq hS).2.2.1
  have e := kcArmJ_eq hj .setConstant
  rw [show B2C.opIdx .setConstant = 2 from rfl] at e
  rw [e] at h
  unfold kcOm B2C.pathMax
  rw [kc_idxOf hj]
  exact h

theorem kwslookJ_ok {j : ℕ}
    (hl : (kwslnkJ j).all (fun q => decide ((coreProgram[q.2]?).map Fn.name = some q.1)) = true) :
    LookOk (kwslookJ j) kwscertOf := by
  intro g hg
  unfold kwslookJ at hg ⊢
  rcases hf : (kwslnkJ j).find (nameKey g) with _ | q
  · rw [hf] at hg; exact absurd rfl hg
  · rw [hf] at hg
    dsimp only at hg ⊢
    by_cases hq : g = q.1
    · have hp := NTree.find_all hl hf
      simp only [decide_eq_true_eq] at hp
      rw [ite_eq_left (c := g = q.1) hq, kwscertOf_of_idx (hq ▸ hp)]
    · rw [ite_eq_right (c := g = q.1) hq] at hg; exact absurd rfl hg

theorem kwsomLookJ_ok {j : ℕ} (hS : kcIn j)
    (hl : (kwslnkJ j).all (fun q => decide ((coreProgram[q.2]?).map Fn.name = some q.1)) = true) :
    WlOk (kwsomLookJ j) (kcOm .setConstant) := by
  intro g n hg
  unfold kwsomLookJ at hg
  rcases hf : (kwslnkJ j).find (nameKey g) with _ | q
  · rw [hf] at hg; cases hg
  · rw [hf] at hg
    dsimp only at hg
    by_cases hq : g = q.1
    · rw [ite_eq_left (c := g = q.1) hq, Option.some.injEq] at hg
      have hp := NTree.find_all hl hf
      simp only [decide_eq_true_eq] at hp
      have hqS : kcIn q.2 := by
        have h1 := NTree.find_all (p := fun j => (kwslnkJ j).all fun q => decide (kcIn q.2))
          kwslnk_list hS
        have := NTree.find_all h1 hf
        simpa using this
      rcases hj : coreProgram[q.2]? with _ | fn
      · rw [hj] at hp; exact absurd hp (by simp)
      · rw [hj] at hp
        obtain ⟨hlt, hfn⟩ := List.getElem?_eq_some_iff.mp hj
        simp only [Option.map_some, Option.some.injEq] at hp
        show kcOm .setConstant g ≤ n
        rw [hq, ← hp, ← hfn, ← kwsomegaJ_eq hqS hlt, hg]
    · rw [ite_eq_right (c := g = q.1) hq] at hg; cases hg

/-- **The certificates counting `setConstant` instructions check.** -/
theorem kws_checked : Checked coreProgram false kwscertOf (kcOm .setConstant) := by
  intro fn hfn _
  obtain ⟨j, hj, rfl⟩ := List.mem_iff_getElem.mp hfn
  have hc := kwschkIdx_all j (by rw [coreProgram_length] at hj; exact hj)
  unfold kwschkIdx at hc
  rw [List.getElem?_eq_getElem hj] at hc
  simp only [kwshandJ, List.any_nil, Bool.false_or, Bool.and_eq_true] at hc
  by_cases hS : kcIn j
  · refine ⟨kwslookJ j, kwsomLookJ j, kwslookJ_ok hc.1, kwsomLookJ_ok hS hc.1, ?_⟩
    show chkFn _ _ false (kwscertOf coreProgram[j].name) (kcOm .setConstant coreProgram[j].name) _ = true
    rw [kwscertOf, kcIdx_getElem hj, ← kwsomegaJ_eq hS hj]
    exact hc.2
  · refine ⟨fun _ => .none, fun _ => none, fun _ h => absurd rfl h, fun _ _ h => (by cases h), ?_⟩
    rw [kwscertOf, kcIdx_getElem hj, kwscertJ_none hj hS]
    rfl

/-- A function with a constant certificate counting `setConstant` instructions. -/
theorem kws_weightLe {f : String} {B : ℕ} {ks : List (V × ℕ)}
    (hcf : kwscertOf f = .stat [] ⟨B, []⟩ ks) : WeightLe coreProgram (kcOm .setConstant) f fun _ => B :=
  weightLe_of_stat kws_checked hcf

/-- A function with a certificate counting `setConstant` instructions, under its preconditions. -/
theorem kws_weight_le_of_stat {f : String} {pre : List (ℕ × ℕ)} {b : Aff} {ks : List (V × ℕ)}
    (hcf : kwscertOf f = .stat pre b ks) {rd : Reader} {t : Tree} {args rets : List E}
    (hn : t.name = f) (hv : t.Valid coreProgram rd args rets) (hb : t.BufsOk coreProgram)
    (hpre : ArgsPre pre args) : t.weight (kcOm .setConstant) ≤ b.eval args :=
  weight_le_of_stat kws_checked hcf hn hv hb hpre

/-- A loop helper's `setConstant` instructions, from `g^a` to `g^e`. -/
theorem kws_weight_le_of_loop {f : String} {endc : Option ℕ} {pre : List (ℕ × ℕ)} {b : Aff}
    {ks : List (V × ℕ)} (hcf : kwscertOf f = .loop endc pre b ks) {rd : Reader} {t : Tree}
    {args rets : List E} (hn : t.name = f) (hv : t.Valid coreProgram rd args rets)
    (hb : t.BufsOk coreProgram) {a e : ℕ} (ha : args.getD 0 0 = ofK (gpow a))
    (he : endOf endc args = ofK (gpow e)) (hae : a < e) (heo : e < 2 ^ 64 - 1)
    (hpre : ArgsPre pre args) : t.weight (kcOm .setConstant) ≤ (e - a) * b.eval args :=
  weight_le_of_loop kws_checked hcf hn hv hb ha he hae heo hpre

