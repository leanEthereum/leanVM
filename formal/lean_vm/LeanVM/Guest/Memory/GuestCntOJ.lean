/-
  LeanVM.Guest.Memory.GuestCntOJ

  The static certificates counting `jump` instructions (`kcOm .jump`) of `verify_sub`'s
  statically bounded callees, checked (`kwoj_checked`), and the weight bounds they give
  (`kwoj_weightLe`, `kwoj_weight_le_of_stat`, `kwoj_weight_le_of_loop`). Generated by
  `~/fv-handoff/agents/g3b-tools/genos.py` (after k4's `genweights.py`).
-/

module

public import LeanVM.Guest.Memory.GuestCntOJ.All
public import LeanVM.Guest.Memory.GuestCntOPmAll

namespace LeanVM.Guest

open LeanVM.Parameters LeanVM.Semantics Core Memory Data

@[expose] public section

/-- The certificates counting `jump` instructions, by name. -/
noncomputable def kwojcertOf (g : String) : Cert := kwojcertJ (kcIdx g)

theorem kwojcertOf_of_idx {j : ℕ} {g : String} (h : (coreProgram[j]?).map Fn.name = some g) :
    kwojcertOf g = kwojcertJ j := by
  rw [kwojcertOf, kcIdx_of_name h]

/-- Only the covered functions have certificates. -/
theorem kwojcertJ_list : (List.range coreProgram.length).all
    (fun j => decide (koIn j) || match kwojcertJ j with | .none => true | _ => false) = true := by
  rw [coreProgram_length]; decide +kernel

/-- The covered functions call only covered functions. -/
theorem kwojlnk_list : koST.all (fun j => (kwojlnkJ j).all fun q => decide (koIn q.2)) = true := by
  decide +kernel

theorem kwojcertJ_none {j : ℕ} (hj : j < coreProgram.length) (hS : ¬ koIn j) : kwojcertJ j = .none := by
  have h := List.all_eq_true.mp kwojcertJ_list j (List.mem_range.mpr hj)
  simp only [hS, decide_false, Bool.false_or] at h
  split at h
  · assumption
  · exact absurd h (by simp)

/-- The certificates were made at the frame weights `kcOm .jump`. -/
theorem kwojomegaJ_eq {j : ℕ} (hS : koIn j) (hj : j < coreProgram.length) :
    kwojomegaJ j = kcOm .jump coreProgram[j].name := by
  have hne : ¬ coreProgram[j].name = "verify_lean_xmss" := fun e => ko_ne16 hS ((kc_name_xmss hj).mp e)
  unfold kcOm B2C.pathMax
  rw [ko_idxOf hj]
  simp only [hne, ↓reduceIte, Nat.add_zero]
  exact (koPm_eq hS).2.2.2.2.1

theorem kwojlookJ_ok {j : ℕ}
    (hl : (kwojlnkJ j).all (fun q => decide ((coreProgram[q.2]?).map Fn.name = some q.1)) = true) :
    LookOk (kwojlookJ j) kwojcertOf := by
  intro g hg
  unfold kwojlookJ at hg ⊢
  rcases hf : (kwojlnkJ j).find (nameKey g) with _ | q
  · rw [hf] at hg; exact absurd rfl hg
  · rw [hf] at hg
    dsimp only at hg ⊢
    by_cases hq : g = q.1
    · have hp := NTree.find_all hl hf
      simp only [decide_eq_true_eq] at hp
      rw [ite_eq_left (c := g = q.1) hq, kwojcertOf_of_idx (hq ▸ hp)]
    · rw [ite_eq_right (c := g = q.1) hq] at hg; exact absurd rfl hg

theorem kwojomLookJ_ok {j : ℕ} (hS : koIn j)
    (hl : (kwojlnkJ j).all (fun q => decide ((coreProgram[q.2]?).map Fn.name = some q.1)) = true) :
    WlOk (kwojomLookJ j) (kcOm .jump) := by
  intro g n hg
  unfold kwojomLookJ at hg
  rcases hf : (kwojlnkJ j).find (nameKey g) with _ | q
  · rw [hf] at hg; cases hg
  · rw [hf] at hg
    dsimp only at hg
    by_cases hq : g = q.1
    · rw [ite_eq_left (c := g = q.1) hq, Option.some.injEq] at hg
      have hp := NTree.find_all hl hf
      simp only [decide_eq_true_eq] at hp
      have hqS : koIn q.2 := by
        have h1 := NTree.find_all (p := fun j => (kwojlnkJ j).all fun q => decide (koIn q.2))
          kwojlnk_list hS
        have := NTree.find_all h1 hf
        simpa using this
      rcases hj : coreProgram[q.2]? with _ | fn
      · rw [hj] at hp; exact absurd hp (by simp)
      · rw [hj] at hp
        obtain ⟨hlt, hfn⟩ := List.getElem?_eq_some_iff.mp hj
        simp only [Option.map_some, Option.some.injEq] at hp
        show kcOm .jump g ≤ n
        rw [hq, ← hp, ← hfn, ← kwojomegaJ_eq hqS hlt, hg]
    · rw [ite_eq_right (c := g = q.1) hq] at hg; cases hg

/-- **The certificates counting `jump` instructions check.** -/
theorem kwoj_checked : Checked coreProgram false kwojcertOf (kcOm .jump) := by
  intro fn hfn _
  obtain ⟨j, hj, rfl⟩ := List.mem_iff_getElem.mp hfn
  have hc := kwojchkIdx_all j (by rw [coreProgram_length] at hj; exact hj)
  unfold kwojchkIdx at hc
  rw [List.getElem?_eq_getElem hj] at hc
  simp only [kwojhandJ, List.any_nil, Bool.false_or, Bool.and_eq_true] at hc
  by_cases hS : koIn j
  · refine ⟨kwojlookJ j, kwojomLookJ j, kwojlookJ_ok hc.1, kwojomLookJ_ok hS hc.1, ?_⟩
    show chkFn _ _ false (kwojcertOf coreProgram[j].name) (kcOm .jump coreProgram[j].name) _ = true
    rw [kwojcertOf, kcIdx_getElem hj, ← kwojomegaJ_eq hS hj]
    exact hc.2
  · refine ⟨fun _ => .none, fun _ => none, fun _ h => absurd rfl h, fun _ _ h => (by cases h), ?_⟩
    rw [kwojcertOf, kcIdx_getElem hj, kwojcertJ_none hj hS]
    rfl

/-- A function with a constant certificate counting `jump` instructions. -/
theorem kwoj_weightLe {f : String} {B : ℕ} {ks : List (V × ℕ)}
    (hcf : kwojcertOf f = .stat [] ⟨B, []⟩ ks) : WeightLe coreProgram (kcOm .jump) f fun _ => B :=
  weightLe_of_stat kwoj_checked hcf

/-- A function with a certificate counting `jump` instructions, under its preconditions. -/
theorem kwoj_weight_le_of_stat {f : String} {pre : List (ℕ × ℕ)} {b : Aff} {ks : List (V × ℕ)}
    (hcf : kwojcertOf f = .stat pre b ks) {rd : Reader} {t : Tree} {args rets : List E}
    (hn : t.name = f) (hv : t.Valid coreProgram rd args rets) (hb : t.BufsOk coreProgram)
    (hpre : ArgsPre pre args) : t.weight (kcOm .jump) ≤ b.eval args :=
  weight_le_of_stat kwoj_checked hcf hn hv hb hpre

/-- A loop helper's `jump` instructions, from `g^a` to `g^e`. -/
theorem kwoj_weight_le_of_loop {f : String} {endc : Option ℕ} {pre : List (ℕ × ℕ)} {b : Aff}
    {ks : List (V × ℕ)} (hcf : kwojcertOf f = .loop endc pre b ks) {rd : Reader} {t : Tree}
    {args rets : List E} (hn : t.name = f) (hv : t.Valid coreProgram rd args rets)
    (hb : t.BufsOk coreProgram) {a e : ℕ} (ha : args.getD 0 0 = ofK (gpow a))
    (he : endOf endc args = ofK (gpow e)) (hae : a < e) (heo : e < 2 ^ 64 - 1)
    (hpre : ArgsPre pre args) : t.weight (kcOm .jump) ≤ (e - a) * b.eval args :=
  weight_le_of_loop kwoj_checked hcf hn hv hb ha he hae heo hpre

end
