/-- The certificates counting `setConstant` instructions, by name. -/
noncomputable def kvscertOf (g : String) : Cert := kvscertJ (coreIdx g)

theorem kvscertOf_of_idx {j : ℕ} {g : String} (h : (coreProgram[j]?).map Fn.name = some g) :
    kvscertOf g = kvscertJ j := by
  rw [kvscertOf, coreIdx_of_name h]

/-- Only the covered functions have certificates. -/
theorem kvscertJ_list : (List.range coreProgram.length).all
    (fun j => decide (kcvIn j) || match kvscertJ j with | .none => true | _ => false) = true := by
  rw [coreProgram_length]; decide +kernel

/-- The covered functions call only covered functions. -/
theorem kvslnk_list : kcvST.all (fun j => (kvslnkJ j).all fun q => decide (kcvIn q.2)) = true := by
  decide +kernel

theorem kvscertJ_none {j : ℕ} (hj : j < coreProgram.length) (hS : ¬ kcvIn j) : kvscertJ j = .none := by
  have h := List.all_eq_true.mp kvscertJ_list j (List.mem_range.mpr hj)
  simp only [hS, decide_false, Bool.false_or] at h
  split at h
  · assumption
  · exact absurd h (by simp)

/-- The certificates were made at the frame weights `B2C.ωArm B2C.xmssArmC .setConstant`. -/
theorem kvsomegaJ_eq {j : ℕ} (hS : kcvIn j) (hj : j < coreProgram.length) :
    kvsomegaJ j = B2C.ωArm B2C.xmssArmC .setConstant coreProgram[j].name := by
  have h := (kcvPm_eq hS).2.2.1
  have e := kcvArmJ_eq hj .setConstant
  rw [show B2C.opIdx .setConstant = 2 from rfl] at e
  rw [e] at h
  unfold B2C.ωArm B2C.pathMax
  rw [kcv_idxOf hj]
  exact h

theorem kvslookJ_ok {j : ℕ}
    (hl : (kvslnkJ j).all (fun q => decide ((coreProgram[q.2]?).map Fn.name = some q.1)) = true) :
    LookOk (kvslookJ j) kvscertOf := by
  intro g hg
  unfold kvslookJ at hg ⊢
  rcases hf : (kvslnkJ j).find (nameKey g) with _ | q
  · rw [hf] at hg; exact absurd rfl hg
  · rw [hf] at hg
    dsimp only at hg ⊢
    by_cases hq : g = q.1
    · have hp := NTree.find_all hl hf
      simp only [decide_eq_true_eq] at hp
      rw [ite_eq_left (c := g = q.1) hq, kvscertOf_of_idx (hq ▸ hp)]
    · rw [ite_eq_right (c := g = q.1) hq] at hg; exact absurd rfl hg

theorem kvsomLookJ_ok {j : ℕ} (hS : kcvIn j)
    (hl : (kvslnkJ j).all (fun q => decide ((coreProgram[q.2]?).map Fn.name = some q.1)) = true) :
    WlOk (kvsomLookJ j) (B2C.ωArm B2C.xmssArmC .setConstant) := by
  intro g n hg
  unfold kvsomLookJ at hg
  rcases hf : (kvslnkJ j).find (nameKey g) with _ | q
  · rw [hf] at hg; cases hg
  · rw [hf] at hg
    dsimp only at hg
    by_cases hq : g = q.1
    · rw [ite_eq_left (c := g = q.1) hq, Option.some.injEq] at hg
      have hp := NTree.find_all hl hf
      simp only [decide_eq_true_eq] at hp
      have hqS : kcvIn q.2 := by
        have h1 := NTree.find_all (p := fun j => (kvslnkJ j).all fun q => decide (kcvIn q.2))
          kvslnk_list hS
        have := NTree.find_all h1 hf
        simpa using this
      rcases hj : coreProgram[q.2]? with _ | fn
      · rw [hj] at hp; exact absurd hp (by simp)
      · rw [hj] at hp
        obtain ⟨hlt, hfn⟩ := List.getElem?_eq_some_iff.mp hj
        simp only [Option.map_some, Option.some.injEq] at hp
        show B2C.ωArm B2C.xmssArmC .setConstant g ≤ n
        rw [hq, ← hp, ← hfn, ← kvsomegaJ_eq hqS hlt, hg]
    · rw [ite_eq_right (c := g = q.1) hq] at hg; cases hg

/-- **The certificates counting `setConstant` instructions check.** -/
theorem kvs_checked : Checked coreProgram false kvscertOf (B2C.ωArm B2C.xmssArmC .setConstant) := by
  intro fn hfn _
  obtain ⟨j, hj, rfl⟩ := List.mem_iff_getElem.mp hfn
  have hc := kvschkIdx_all j (by rw [coreProgram_length] at hj; exact hj)
  unfold kvschkIdx at hc
  rw [List.getElem?_eq_getElem hj] at hc
  simp only [kvshandJ, List.any_nil, Bool.false_or, Bool.and_eq_true] at hc
  by_cases hS : kcvIn j
  · refine ⟨kvslookJ j, kvsomLookJ j, kvslookJ_ok hc.1, kvsomLookJ_ok hS hc.1, ?_⟩
    show chkFn _ _ false (kvscertOf coreProgram[j].name) (B2C.ωArm B2C.xmssArmC .setConstant coreProgram[j].name) _ = true
    rw [kvscertOf, coreIdx_getElem hj, ← kvsomegaJ_eq hS hj]
    exact hc.2
  · refine ⟨fun _ => .none, fun _ => none, fun _ h => absurd rfl h, fun _ _ h => (by cases h), ?_⟩
    rw [kvscertOf, coreIdx_getElem hj, kvscertJ_none hj hS]
    rfl

/-- A function with a constant certificate counting `setConstant` instructions. -/
theorem kvs_weightLe {f : String} {B : ℕ} {ks : List (V × ℕ)}
    (hcf : kvscertOf f = .stat [] ⟨B, []⟩ ks) : WeightLe coreProgram (B2C.ωArm B2C.xmssArmC .setConstant) f fun _ => B :=
  weightLe_of_stat kvs_checked hcf

/-- A function with a certificate counting `setConstant` instructions, under its preconditions. -/
theorem kvs_weight_le_of_stat {f : String} {pre : List (ℕ × ℕ)} {b : Aff} {ks : List (V × ℕ)}
    (hcf : kvscertOf f = .stat pre b ks) {rd : Reader} {t : Tree} {args rets : List E}
    (hn : t.name = f) (hv : t.Valid coreProgram rd args rets) (hb : t.BufsOk coreProgram)
    (hpre : ArgsPre pre args) : t.weight (B2C.ωArm B2C.xmssArmC .setConstant) ≤ b.eval args :=
  weight_le_of_stat kvs_checked hcf hn hv hb hpre

/-- A loop helper's `setConstant` instructions, from `g^a` to `g^e`. -/
theorem kvs_weight_le_of_loop {f : String} {endc : Option ℕ} {pre : List (ℕ × ℕ)} {b : Aff}
    {ks : List (V × ℕ)} (hcf : kvscertOf f = .loop endc pre b ks) {rd : Reader} {t : Tree}
    {args rets : List E} (hn : t.name = f) (hv : t.Valid coreProgram rd args rets)
    (hb : t.BufsOk coreProgram) {a e : ℕ} (ha : args.getD 0 0 = ofK (addressOfIndex a))
    (he : endOf endc args = ofK (addressOfIndex e)) (hae : a < e) (heo : e < 2 ^ 64 - 1)
    (hpre : ArgsPre pre args) : t.weight (B2C.ωArm B2C.xmssArmC .setConstant) ≤ (e - a) * b.eval args :=
  weight_le_of_loop kvs_checked hcf hn hv hb ha he hae heo hpre

