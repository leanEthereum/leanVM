theorem kcu_name_xmss {j : ℕ} (hj : j < coreProgram.length) :
    coreProgram[j].name = "__loop2" ↔ j = 36 := by
  have hx : (coreProgram[36]?).map Fn.name = some "__loop2" := by decide +kernel
  constructor
  · intro h
    have := coreIdx_getElem hj
    rw [h, coreIdx_of_name hx] at this
    exact this.symm
  · rintro rfl
    rw [List.getElem?_eq_getElem hj] at hx
    simpa using hx

/-- The families' frame weights at function `j` are its `pathMax` and arms. -/
noncomputable def kcuPmAt (j : ℕ) : Bool :=
  kuxomegaJ j == (B2C.plumbOf (j + 1)).pmax.getD 0 0 + kcuArmJ j 0 &&
    kumomegaJ j == (B2C.plumbOf (j + 1)).pmax.getD 1 0 + kcuArmJ j 1 &&
    kusomegaJ j == (B2C.plumbOf (j + 1)).pmax.getD 2 0 + kcuArmJ j 2 &&
    kudomegaJ j == (B2C.plumbOf (j + 1)).pmax.getD 3 0 + kcuArmJ j 3 &&
    kujomegaJ j == (B2C.plumbOf (j + 1)).pmax.getD 4 0 + kcuArmJ j 4 &&
    kukomegaJ j == (B2C.plumbOf (j + 1)).pmax.getD 5 0 + kcuArmJ j 5

