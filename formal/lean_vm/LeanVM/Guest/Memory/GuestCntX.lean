/-- The certificates counting `xor` instructions, by name. -/
noncomputable def kwxcertOf (g : String) : Cert := kwxcertJ (kcIdx g)

theorem kwxcertOf_of_idx {j : ℕ} {g : String} (h : (coreProgram[j]?).map Fn.name = some g) :
    kwxcertOf g = kwxcertJ j := by
  rw [kwxcertOf, kcIdx_of_name h]

/-- Only the covered functions have certificates. -/
theorem kwxcertJ_list : (List.range coreProgram.length).all
    (fun j => decide (kcIn j) || match kwxcertJ j with | .none => true | _ => false) = true := by
  rw [coreProgram_length]; decide +kernel

/-- The covered functions call only covered functions. -/
theorem kwxlnk_list : kcST.all (fun j => (kwxlnkJ j).all fun q => decide (kcIn q.2)) = true := by
  decide +kernel

theorem kwxcertJ_none {j : ℕ} (hj : j < coreProgram.length) (hS : ¬ kcIn j) : kwxcertJ j = .none := by
  have h := List.all_eq_true.mp kwxcertJ_list j (List.mem_range.mpr hj)
  simp only [hS, decide_false, Bool.false_or] at h
  split at h
  · assumption
  · exact absurd h (by simp)

/-- The certificates were made at the frame weights `kcOm .xor`. -/
theorem kwxomegaJ_eq {j : ℕ} (hS : kcIn j) (hj : j < coreProgram.length) :
    kwxomegaJ j = kcOm .xor coreProgram[j].name := by
  have h := (kcPm_eq hS).1
  have e := kcArmJ_eq hj .xor
  rw [show B2C.opIdx .xor = 0 from rfl] at e
  rw [e] at h
  unfold kcOm B2C.pathMax
  rw [kc_idxOf hj]
  exact h

theorem kwxlookJ_ok {j : ℕ}
    (hl : (kwxlnkJ j).all (fun q => decide ((coreProgram[q.2]?).map Fn.name = some q.1)) = true) :
    LookOk (kwxlookJ j) kwxcertOf := by
  intro g hg
  unfold kwxlookJ at hg ⊢
  rcases hf : (kwxlnkJ j).find (nameKey g) with _ | q
  · rw [hf] at hg; exact absurd rfl hg
  · rw [hf] at hg
    dsimp only at hg ⊢
    by_cases hq : g = q.1
    · have hp := NTree.find_all hl hf
      simp only [decide_eq_true_eq] at hp
      rw [ite_eq_left (c := g = q.1) hq, kwxcertOf_of_idx (hq ▸ hp)]
    · rw [ite_eq_right (c := g = q.1) hq] at hg; exact absurd rfl hg

theorem kwxomLookJ_ok {j : ℕ} (hS : kcIn j)
    (hl : (kwxlnkJ j).all (fun q => decide ((coreProgram[q.2]?).map Fn.name = some q.1)) = true) :
    WlOk (kwxomLookJ j) (kcOm .xor) := by
  intro g n hg
  unfold kwxomLookJ at hg
  rcases hf : (kwxlnkJ j).find (nameKey g) with _ | q
  · rw [hf] at hg; cases hg
  · rw [hf] at hg
    dsimp only at hg
    by_cases hq : g = q.1
    · rw [ite_eq_left (c := g = q.1) hq, Option.some.injEq] at hg
      have hp := NTree.find_all hl hf
      simp only [decide_eq_true_eq] at hp
      have hqS : kcIn q.2 := by
        have h1 := NTree.find_all (p := fun j => (kwxlnkJ j).all fun q => decide (kcIn q.2))
          kwxlnk_list hS
        have := NTree.find_all h1 hf
        simpa using this
      rcases hj : coreProgram[q.2]? with _ | fn
      · rw [hj] at hp; exact absurd hp (by simp)
      · rw [hj] at hp
        obtain ⟨hlt, hfn⟩ := List.getElem?_eq_some_iff.mp hj
        simp only [Option.map_some, Option.some.injEq] at hp
        show kcOm .xor g ≤ n
        rw [hq, ← hp, ← hfn, ← kwxomegaJ_eq hqS hlt, hg]
    · rw [ite_eq_right (c := g = q.1) hq] at hg; cases hg

/-- **The certificates counting `xor` instructions check.** -/
theorem kwx_checked : Checked coreProgram false kwxcertOf (kcOm .xor) := by
  intro fn hfn _
  obtain ⟨j, hj, rfl⟩ := List.mem_iff_getElem.mp hfn
  have hc := kwxchkIdx_all j (by rw [coreProgram_length] at hj; exact hj)
  unfold kwxchkIdx at hc
  rw [List.getElem?_eq_getElem hj] at hc
  simp only [kwxhandJ, List.any_nil, Bool.false_or, Bool.and_eq_true] at hc
  by_cases hS : kcIn j
  · refine ⟨kwxlookJ j, kwxomLookJ j, kwxlookJ_ok hc.1, kwxomLookJ_ok hS hc.1, ?_⟩
    show chkFn _ _ false (kwxcertOf coreProgram[j].name) (kcOm .xor coreProgram[j].name) _ = true
    rw [kwxcertOf, kcIdx_getElem hj, ← kwxomegaJ_eq hS hj]
    exact hc.2
  · refine ⟨fun _ => .none, fun _ => none, fun _ h => absurd rfl h, fun _ _ h => (by cases h), ?_⟩
    rw [kwxcertOf, kcIdx_getElem hj, kwxcertJ_none hj hS]
    rfl

/-- A function with a constant certificate counting `xor` instructions. -/
theorem kwx_weightLe {f : String} {B : ℕ} {ks : List (V × ℕ)}
    (hcf : kwxcertOf f = .stat [] ⟨B, []⟩ ks) : WeightLe coreProgram (kcOm .xor) f fun _ => B :=
  weightLe_of_stat kwx_checked hcf

/-- A function with a certificate counting `xor` instructions, under its preconditions. -/
theorem kwx_weight_le_of_stat {f : String} {pre : List (ℕ × ℕ)} {b : Aff} {ks : List (V × ℕ)}
    (hcf : kwxcertOf f = .stat pre b ks) {rd : Reader} {t : Tree} {args rets : List E}
    (hn : t.name = f) (hv : t.Valid coreProgram rd args rets) (hb : t.BufsOk coreProgram)
    (hpre : ArgsPre pre args) : t.weight (kcOm .xor) ≤ b.eval args :=
  weight_le_of_stat kwx_checked hcf hn hv hb hpre

/-- A loop helper's `xor` instructions, from `g^a` to `g^e`. -/
theorem kwx_weight_le_of_loop {f : String} {endc : Option ℕ} {pre : List (ℕ × ℕ)} {b : Aff}
    {ks : List (V × ℕ)} (hcf : kwxcertOf f = .loop endc pre b ks) {rd : Reader} {t : Tree}
    {args rets : List E} (hn : t.name = f) (hv : t.Valid coreProgram rd args rets)
    (hb : t.BufsOk coreProgram) {a e : ℕ} (ha : args.getD 0 0 = ofK (gpow a))
    (he : endOf endc args = ofK (gpow e)) (hae : a < e) (heo : e < 2 ^ 64 - 1)
    (hpre : ArgsPre pre args) : t.weight (kcOm .xor) ≤ (e - a) * b.eval args :=
  weight_le_of_loop kwx_checked hcf hn hv hb ha he hae heo hpre

