module

public import LeanVM.Guest.Memory.GuestWords.All
public import LeanVM.Guest.Memory.FamilySound
public import LeanVM.Guest.Memory.StaticWords
public import LeanVM.Guest.B2C.Defs

namespace LeanVM.Guest

open LeanVM.Parameters LeanVM.Semantics Core Memory Data

@[expose] public section

/-- The frame sizes `B2C.fs`, by core index: `main`'s holding the jump table, the others at least
the header. -/
def wfsList : List ℕ := B2C.mainFrame :: (Data.frameSizes.drop 2).map fun n => max 2 n

/-- The frame size of function `j`. -/
def wfsJ (j : ℕ) : ℕ := wfsList.getD j 0

/-- The certificates counting words were made at the frame sizes. -/
theorem womegaJ_list : (List.range coreProgram.length).map womegaJ = wfsList := by
  rw [coreProgram_length]; decide +kernel

theorem womegaJ_eq' {j : ℕ} (hj : j < coreProgram.length) : womegaJ j = wfsJ j := by
  rw [wfsJ, ← womegaJ_list, List.getD_eq_getElem?_getD, List.getElem?_map, List.getElem?_range hj]
  rfl

/-- `wfsJ` is `B2C.fs` by index. -/
theorem wfs_eq {j : ℕ} (hj : j < coreProgram.length) : B2C.fs coreProgram[j].name = wfsJ j := by
  have hl : j < 1549 := by rw [coreProgram_length] at hj; exact hj
  unfold B2C.fs
  rw [coreProgram_indexOf?_getElem hj]
  rcases j with _ | k
  · rfl
  · have hk : k + 2 < Data.frameSizes.length := by rw [frameSizes_length]; omega
    simp [wfsJ, wfsList, fsAt, List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hk,
      Nat.add_comm 2 k]

/-- The guest's certificates counting words, by name. -/
noncomputable def wcertOf (g : String) : Cert := wcertJ (coreIdx g)

theorem wcertOf_of_idx {j : ℕ} {g : String} (h : (coreProgram[j]?).map Fn.name = some g) :
    wcertOf g = wcertJ j := by
  rw [wcertOf, coreIdx_of_name h]

/-- **The guest's certificates counting words check at the frame sizes `B2C.fs`.** -/
theorem w_checked : Checked coreProgram true wcertOf B2C.fs :=
  checked_of_chkS w_all fun _ hj => (wfs_eq hj).trans (womegaJ_eq' hj).symm

/-- No function is left to a hand bound. -/
theorem w_handOk : HandOk coreProgram B2C.fs wcertOf fun _ => False := fun _ h => h.elim

/-- **A guest function's words at `B2C.fs`**, by its certificate counting words. -/
theorem fs_total_le_of_stat {f : String} {pre : List (ℕ × ℕ)} {b : Aff} {ks : List (V × ℕ)}
    (hcf : wcertOf f = .stat pre b ks) {rd : Reader} {t : Tree} {args rets : List E} (hn : t.name = f)
    (hv : t.Valid coreProgram rd args rets) (hb : t.BufsOk coreProgram) (hpre : ArgsPre pre args) :
    t.total B2C.fs ≤ b.eval args :=
  total_le_of_stat w_checked w_handOk hcf hn hv hb hpre

/-- **A guest loop's words at `B2C.fs`**, by its certificate counting words. -/
theorem fs_total_le_of_loop {f : String} {endc : Option ℕ} {pre : List (ℕ × ℕ)} {b : Aff}
    {ks : List (V × ℕ)} (hcf : wcertOf f = .loop endc pre b ks) {rd : Reader} {t : Tree}
    {args rets : List E} (hn : t.name = f) (hv : t.Valid coreProgram rd args rets)
    (hb : t.BufsOk coreProgram) {a e : ℕ} (ha : args.getD 0 0 = ofK (addressOfIndex a))
    (he : endOf endc args = ofK (addressOfIndex e)) (hae : a < e) (heo : e < 2 ^ 64 - 1)
    (hpre : ArgsPre pre args) : t.total B2C.fs ≤ (e - a) * b.eval args + B2C.fs f :=
  total_le_of_loop w_checked w_handOk hcf hn hv hb ha he hae heo hpre

/-- **A guest function's words at `B2C.fs`, constant.** -/
theorem fs_totalLe {f : String} {B : ℕ} {ks : List (V × ℕ)} (hcf : wcertOf f = .stat [] ⟨B, []⟩ ks) :
    TotalLe coreProgram B2C.fs f fun _ => B :=
  totalLe_of_stat w_checked w_handOk hcf

end
end LeanVM.Guest
