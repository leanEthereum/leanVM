open LeanVM.Parameters LeanVM.Semantics Core Memory Data

@[expose] public section

/-- The certificates counting `xor` instructions, by name. -/
noncomputable def kvxcertOf (g : String) : Cert := kvxcertJ (coreIdx g)

theorem kvxcertOf_of_idx {j : ℕ} {g : String} (h : (coreProgram[j]?).map Fn.name = some g) :
    kvxcertOf g = kvxcertJ j := by
  rw [kvxcertOf, coreIdx_of_name h]

/-- Only the covered functions have certificates. -/
theorem kvxcertJ_list : (List.range coreProgram.length).all
    (fun j => decide (kcvIn j) || match kvxcertJ j with | .none => true | _ => false) = true := by
  rw [coreProgram_length]; decide +kernel

/-- The covered functions call only covered functions. -/
theorem kvxlnk_list : kcvST.all (fun j => (kvxlnkJ j).all fun q => decide (kcvIn q.2)) = true := by
  decide +kernel

theorem kvxcertJ_none {j : ℕ} (hj : j < coreProgram.length) (hS : ¬ kcvIn j) : kvxcertJ j = .none := by
  have h := List.all_eq_true.mp kvxcertJ_list j (List.mem_range.mpr hj)
  simp only [hS, decide_false, Bool.false_or] at h
  split at h
  · assumption
  · exact absurd h (by simp)

/-- The certificates were made at the frame weights `B2C.ωArm B2C.xmssArmC .xor`. -/
theorem kvxomegaJ_eq {j : ℕ} (hS : kcvIn j) (hj : j < coreProgram.length) :
    kvxomegaJ j = B2C.ωArm B2C.xmssArmC .xor coreProgram[j].name := by
  have h := (kcvPm_eq hS).1
  have e := kcvArmJ_eq hj .xor
  rw [show B2C.opIdx .xor = 0 from rfl] at e
  rw [e] at h
  unfold B2C.ωArm B2C.pathMax
  rw [kcv_idxOf hj]
  exact h

theorem kvxlookJ_ok {j : ℕ}
    (hl : (kvxlnkJ j).all (fun q => decide ((coreProgram[q.2]?).map Fn.name = some q.1)) = true) :
    LookOk (kvxlookJ j) kvxcertOf := by
  intro g hg
  unfold kvxlookJ at hg ⊢
  rcases hf : (kvxlnkJ j).find (nameKey g) with _ | q
  · rw [hf] at hg; exact absurd rfl hg
  · rw [hf] at hg
    dsimp only at hg ⊢
    by_cases hq : g = q.1
    · have hp := NTree.find_all hl hf
      simp only [decide_eq_true_eq] at hp
      rw [ite_eq_left (c := g = q.1) hq, kvxcertOf_of_idx (hq ▸ hp)]
    · rw [ite_eq_right (c := g = q.1) hq] at hg; exact absurd rfl hg

theorem kvxomLookJ_ok {j : ℕ} (hS : kcvIn j)
    (hl : (kvxlnkJ j).all (fun q => decide ((coreProgram[q.2]?).map Fn.name = some q.1)) = true) :
    WlOk (kvxomLookJ j) (B2C.ωArm B2C.xmssArmC .xor) := by
  intro g n hg
  unfold kvxomLookJ at hg
  rcases hf : (kvxlnkJ j).find (nameKey g) with _ | q
  · rw [hf] at hg; cases hg
  · rw [hf] at hg
    dsimp only at hg
    by_cases hq : g = q.1
    · rw [ite_eq_left (c := g = q.1) hq, Option.some.injEq] at hg
      have hp := NTree.find_all hl hf
      simp only [decide_eq_true_eq] at hp
      have hqS : kcvIn q.2 := by
        have h1 := NTree.find_all (p := fun j => (kvxlnkJ j).all fun q => decide (kcvIn q.2))
          kvxlnk_list hS
        have := NTree.find_all h1 hf
        simpa using this
      rcases hj : coreProgram[q.2]? with _ | fn
      · rw [hj] at hp; exact absurd hp (by simp)
      · rw [hj] at hp
        obtain ⟨hlt, hfn⟩ := List.getElem?_eq_some_iff.mp hj
        simp only [Option.map_some, Option.some.injEq] at hp
        show B2C.ωArm B2C.xmssArmC .xor g ≤ n
        rw [hq, ← hp, ← hfn, ← kvxomegaJ_eq hqS hlt, hg]
    · rw [ite_eq_right (c := g = q.1) hq] at hg; cases hg

/-- **The certificates counting `xor` instructions check.** -/
theorem kvx_checked : Checked coreProgram false kvxcertOf (B2C.ωArm B2C.xmssArmC .xor) := by
  intro fn hfn _
  obtain ⟨j, hj, rfl⟩ := List.mem_iff_getElem.mp hfn
  have hc := kvxchkIdx_all j (by rw [coreProgram_length] at hj; exact hj)
  unfold kvxchkIdx at hc
  rw [List.getElem?_eq_getElem hj] at hc
  simp only [kvxhandJ, List.any_nil, Bool.false_or, Bool.and_eq_true] at hc
  by_cases hS : kcvIn j
  · refine ⟨kvxlookJ j, kvxomLookJ j, kvxlookJ_ok hc.1, kvxomLookJ_ok hS hc.1, ?_⟩
    show chkFn _ _ false (kvxcertOf coreProgram[j].name) (B2C.ωArm B2C.xmssArmC .xor coreProgram[j].name) _ = true
    rw [kvxcertOf, coreIdx_getElem hj, ← kvxomegaJ_eq hS hj]
    exact hc.2
  · refine ⟨fun _ => .none, fun _ => none, fun _ h => absurd rfl h, fun _ _ h => (by cases h), ?_⟩
    rw [kvxcertOf, coreIdx_getElem hj, kvxcertJ_none hj hS]
    rfl

/-- A function with a constant certificate counting `xor` instructions. -/
theorem kvx_weightLe {f : String} {B : ℕ} {ks : List (V × ℕ)}
    (hcf : kvxcertOf f = .stat [] ⟨B, []⟩ ks) : WeightLe coreProgram (B2C.ωArm B2C.xmssArmC .xor) f fun _ => B :=
  weightLe_of_stat kvx_checked hcf

/-- A function with a certificate counting `xor` instructions, under its preconditions. -/
theorem kvx_weight_le_of_stat {f : String} {pre : List (ℕ × ℕ)} {b : Aff} {ks : List (V × ℕ)}
    (hcf : kvxcertOf f = .stat pre b ks) {rd : Reader} {t : Tree} {args rets : List E}
    (hn : t.name = f) (hv : t.Valid coreProgram rd args rets) (hb : t.BufsOk coreProgram)
    (hpre : ArgsPre pre args) : t.weight (B2C.ωArm B2C.xmssArmC .xor) ≤ b.eval args :=
  weight_le_of_stat kvx_checked hcf hn hv hb hpre

/-- A loop helper's `xor` instructions, from `g^a` to `g^e`. -/
theorem kvx_weight_le_of_loop {f : String} {endc : Option ℕ} {pre : List (ℕ × ℕ)} {b : Aff}
    {ks : List (V × ℕ)} (hcf : kvxcertOf f = .loop endc pre b ks) {rd : Reader} {t : Tree}
    {args rets : List E} (hn : t.name = f) (hv : t.Valid coreProgram rd args rets)
    (hb : t.BufsOk coreProgram) {a e : ℕ} (ha : args.getD 0 0 = ofK (addressOfIndex a))
    (he : endOf endc args = ofK (addressOfIndex e)) (hae : a < e) (heo : e < 2 ^ 64 - 1)
    (hpre : ArgsPre pre args) : t.weight (B2C.ωArm B2C.xmssArmC .xor) ≤ (e - a) * b.eval args :=
  weight_le_of_loop kvx_checked hcf hn hv hb ha he hae heo hpre

