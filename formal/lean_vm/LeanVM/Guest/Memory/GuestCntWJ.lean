/-
  LeanVM.Guest.Memory.GuestCntWJ

  The guest's static certificates counting `jump` instructions (`B2C.ωArm B2C.xmssArmC .jump`),
  checked (`kuj_checked`), and the weight bounds they give (`kuj_weightLe`, `kuj_weight_le_of_stat`,
  `kuj_weight_le_of_loop`). Generated by `scripts/count/gen.py`; do not edit.
-/

module

public import LeanVM.Guest.Memory.GuestCntWJ.All
public import LeanVM.Guest.Memory.GuestCntWPm

namespace LeanVM.Guest

open LeanVM.Parameters LeanVM.Semantics Core Memory Data

@[expose] public section

/-- The certificates counting `jump` instructions, by name. -/
noncomputable def kujcertOf (g : String) : Cert := kujcertJ (coreIdx g)

theorem kujcertOf_of_idx {j : ℕ} {g : String} (h : (coreProgram[j]?).map Fn.name = some g) :
    kujcertOf g = kujcertJ j := by
  rw [kujcertOf, coreIdx_of_name h]

/-- Only the covered functions have certificates. -/
theorem kujcertJ_list : (List.range coreProgram.length).all
    (fun j => decide (kcuIn j) || match kujcertJ j with | .none => true | _ => false) = true := by
  rw [coreProgram_length]; decide +kernel

/-- The covered functions call only covered functions. -/
theorem kujlnk_list : kcuST.all (fun j => (kujlnkJ j).all fun q => decide (kcuIn q.2)) = true := by
  decide +kernel

theorem kujcertJ_none {j : ℕ} (hj : j < coreProgram.length) (hS : ¬ kcuIn j) : kujcertJ j = .none := by
  have h := List.all_eq_true.mp kujcertJ_list j (List.mem_range.mpr hj)
  simp only [hS, decide_false, Bool.false_or] at h
  split at h
  · assumption
  · exact absurd h (by simp)

/-- The certificates were made at the frame weights `B2C.ωArm B2C.xmssArmC .jump`. -/
theorem kujomegaJ_eq {j : ℕ} (hS : kcuIn j) (hj : j < coreProgram.length) :
    kujomegaJ j = B2C.ωArm B2C.xmssArmC .jump coreProgram[j].name := by
  have h := (kcuPm_eq hS).2.2.2.2.1
  have e := kcuArmJ_eq hj .jump
  rw [show B2C.opIdx .jump = 4 from rfl] at e
  rw [e] at h
  unfold B2C.ωArm B2C.pathMax
  rw [kcu_idxOf hj]
  exact h

theorem kujlookJ_ok {j : ℕ}
    (hl : (kujlnkJ j).all (fun q => decide ((coreProgram[q.2]?).map Fn.name = some q.1)) = true) :
    LookOk (kujlookJ j) kujcertOf := by
  intro g hg
  unfold kujlookJ at hg ⊢
  rcases hf : (kujlnkJ j).find (nameKey g) with _ | q
  · rw [hf] at hg; exact absurd rfl hg
  · rw [hf] at hg
    dsimp only at hg ⊢
    by_cases hq : g = q.1
    · have hp := NTree.find_all hl hf
      simp only [decide_eq_true_eq] at hp
      rw [ite_eq_left (c := g = q.1) hq, kujcertOf_of_idx (hq ▸ hp)]
    · rw [ite_eq_right (c := g = q.1) hq] at hg; exact absurd rfl hg

theorem kujomLookJ_ok {j : ℕ} (hS : kcuIn j)
    (hl : (kujlnkJ j).all (fun q => decide ((coreProgram[q.2]?).map Fn.name = some q.1)) = true) :
    WlOk (kujomLookJ j) (B2C.ωArm B2C.xmssArmC .jump) := by
  intro g n hg
  unfold kujomLookJ at hg
  rcases hf : (kujlnkJ j).find (nameKey g) with _ | q
  · rw [hf] at hg; cases hg
  · rw [hf] at hg
    dsimp only at hg
    by_cases hq : g = q.1
    · rw [ite_eq_left (c := g = q.1) hq, Option.some.injEq] at hg
      have hp := NTree.find_all hl hf
      simp only [decide_eq_true_eq] at hp
      have hqS : kcuIn q.2 := by
        have h1 := NTree.find_all (p := fun j => (kujlnkJ j).all fun q => decide (kcuIn q.2))
          kujlnk_list hS
        have := NTree.find_all h1 hf
        simpa using this
      rcases hj : coreProgram[q.2]? with _ | fn
      · rw [hj] at hp; exact absurd hp (by simp)
      · rw [hj] at hp
        obtain ⟨hlt, hfn⟩ := List.getElem?_eq_some_iff.mp hj
        simp only [Option.map_some, Option.some.injEq] at hp
        show B2C.ωArm B2C.xmssArmC .jump g ≤ n
        rw [hq, ← hp, ← hfn, ← kujomegaJ_eq hqS hlt, hg]
    · rw [ite_eq_right (c := g = q.1) hq] at hg; cases hg

/-- **The certificates counting `jump` instructions check.** -/
theorem kuj_checked : Checked coreProgram false kujcertOf (B2C.ωArm B2C.xmssArmC .jump) := by
  intro fn hfn _
  obtain ⟨j, hj, rfl⟩ := List.mem_iff_getElem.mp hfn
  have hc := kujchkIdx_all j (by rw [coreProgram_length] at hj; exact hj)
  unfold kujchkIdx at hc
  rw [List.getElem?_eq_getElem hj] at hc
  simp only [kujhandJ, List.any_nil, Bool.false_or, Bool.and_eq_true] at hc
  by_cases hS : kcuIn j
  · refine ⟨kujlookJ j, kujomLookJ j, kujlookJ_ok hc.1, kujomLookJ_ok hS hc.1, ?_⟩
    show chkFn _ _ false (kujcertOf coreProgram[j].name) (B2C.ωArm B2C.xmssArmC .jump coreProgram[j].name) _ = true
    rw [kujcertOf, coreIdx_getElem hj, ← kujomegaJ_eq hS hj]
    exact hc.2
  · refine ⟨fun _ => .none, fun _ => none, fun _ h => absurd rfl h, fun _ _ h => (by cases h), ?_⟩
    rw [kujcertOf, coreIdx_getElem hj, kujcertJ_none hj hS]
    rfl

/-- A function with a constant certificate counting `jump` instructions. -/
theorem kuj_weightLe {f : String} {B : ℕ} {ks : List (V × ℕ)}
    (hcf : kujcertOf f = .stat [] ⟨B, []⟩ ks) : WeightLe coreProgram (B2C.ωArm B2C.xmssArmC .jump) f fun _ => B :=
  weightLe_of_stat kuj_checked hcf

/-- A function with a certificate counting `jump` instructions, under its preconditions. -/
theorem kuj_weight_le_of_stat {f : String} {pre : List (ℕ × ℕ)} {b : Aff} {ks : List (V × ℕ)}
    (hcf : kujcertOf f = .stat pre b ks) {rd : Reader} {t : Tree} {args rets : List E}
    (hn : t.name = f) (hv : t.Valid coreProgram rd args rets) (hb : t.BufsOk coreProgram)
    (hpre : ArgsPre pre args) : t.weight (B2C.ωArm B2C.xmssArmC .jump) ≤ b.eval args :=
  weight_le_of_stat kuj_checked hcf hn hv hb hpre

/-- A loop helper's `jump` instructions, from `g^a` to `g^e`. -/
theorem kuj_weight_le_of_loop {f : String} {endc : Option ℕ} {pre : List (ℕ × ℕ)} {b : Aff}
    {ks : List (V × ℕ)} (hcf : kujcertOf f = .loop endc pre b ks) {rd : Reader} {t : Tree}
    {args rets : List E} (hn : t.name = f) (hv : t.Valid coreProgram rd args rets)
    (hb : t.BufsOk coreProgram) {a e : ℕ} (ha : args.getD 0 0 = ofK (addressOfIndex a))
    (he : endOf endc args = ofK (addressOfIndex e)) (hae : a < e) (heo : e < 2 ^ 64 - 1)
    (hpre : ArgsPre pre args) : t.weight (B2C.ωArm B2C.xmssArmC .jump) ≤ (e - a) * b.eval args :=
  weight_le_of_loop kuj_checked hcf hn hv hb ha he hae heo hpre

