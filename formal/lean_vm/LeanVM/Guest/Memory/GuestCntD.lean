/-
  LeanVM.Guest.Memory.GuestCntD

  The guest's static certificates counting `deref` instructions (`kcOm .deref`), checked
  (`kwd_checked`), and the weight bounds they give (`kwd_weightLe`, `kwd_weight_le_of_stat`,
  `kwd_weight_le_of_loop`). Generated by `~/fv-handoff/agents/k4-tools/genweights.py`.
-/

module

public import LeanVM.Guest.Memory.GuestCntD.All
public import LeanVM.Guest.Memory.GuestCntPm

namespace LeanVM.Guest

open LeanVM.Parameters LeanVM.Semantics Core Memory Data

@[expose] public section

/-- The certificates counting `deref` instructions, by name. -/
noncomputable def kwdcertOf (g : String) : Cert := kwdcertJ (kcIdx g)

theorem kwdcertOf_of_idx {j : ℕ} {g : String} (h : (coreProgram[j]?).map Fn.name = some g) :
    kwdcertOf g = kwdcertJ j := by
  rw [kwdcertOf, kcIdx_of_name h]

/-- Only the covered functions have certificates. -/
theorem kwdcertJ_list : (List.range coreProgram.length).all
    (fun j => decide (kcIn j) || match kwdcertJ j with | .none => true | _ => false) = true := by
  rw [coreProgram_length]; decide +kernel

/-- The covered functions call only covered functions. -/
theorem kwdlnk_list : kcST.all (fun j => (kwdlnkJ j).all fun q => decide (kcIn q.2)) = true := by
  decide +kernel

theorem kwdcertJ_none {j : ℕ} (hj : j < coreProgram.length) (hS : ¬ kcIn j) : kwdcertJ j = .none := by
  have h := List.all_eq_true.mp kwdcertJ_list j (List.mem_range.mpr hj)
  simp only [hS, decide_false, Bool.false_or] at h
  split at h
  · assumption
  · exact absurd h (by simp)

/-- The certificates were made at the frame weights `kcOm .deref`. -/
theorem kwdomegaJ_eq {j : ℕ} (hS : kcIn j) (hj : j < coreProgram.length) :
    kwdomegaJ j = kcOm .deref coreProgram[j].name := by
  have h := (kcPm_eq hS).2.2.2.1
  have e := kcArmJ_eq hj .deref
  rw [show B2C.opIdx .deref = 3 from rfl] at e
  rw [e] at h
  unfold kcOm B2C.pathMax
  rw [kc_idxOf hj]
  exact h

theorem kwdlookJ_ok {j : ℕ}
    (hl : (kwdlnkJ j).all (fun q => decide ((coreProgram[q.2]?).map Fn.name = some q.1)) = true) :
    LookOk (kwdlookJ j) kwdcertOf := by
  intro g hg
  unfold kwdlookJ at hg ⊢
  rcases hf : (kwdlnkJ j).find (nameKey g) with _ | q
  · rw [hf] at hg; exact absurd rfl hg
  · rw [hf] at hg
    dsimp only at hg ⊢
    by_cases hq : g = q.1
    · have hp := NTree.find_all hl hf
      simp only [decide_eq_true_eq] at hp
      rw [ite_eq_left (c := g = q.1) hq, kwdcertOf_of_idx (hq ▸ hp)]
    · rw [ite_eq_right (c := g = q.1) hq] at hg; exact absurd rfl hg

theorem kwdomLookJ_ok {j : ℕ} (hS : kcIn j)
    (hl : (kwdlnkJ j).all (fun q => decide ((coreProgram[q.2]?).map Fn.name = some q.1)) = true) :
    WlOk (kwdomLookJ j) (kcOm .deref) := by
  intro g n hg
  unfold kwdomLookJ at hg
  rcases hf : (kwdlnkJ j).find (nameKey g) with _ | q
  · rw [hf] at hg; cases hg
  · rw [hf] at hg
    dsimp only at hg
    by_cases hq : g = q.1
    · rw [ite_eq_left (c := g = q.1) hq, Option.some.injEq] at hg
      have hp := NTree.find_all hl hf
      simp only [decide_eq_true_eq] at hp
      have hqS : kcIn q.2 := by
        have h1 := NTree.find_all (p := fun j => (kwdlnkJ j).all fun q => decide (kcIn q.2))
          kwdlnk_list hS
        have := NTree.find_all h1 hf
        simpa using this
      rcases hj : coreProgram[q.2]? with _ | fn
      · rw [hj] at hp; exact absurd hp (by simp)
      · rw [hj] at hp
        obtain ⟨hlt, hfn⟩ := List.getElem?_eq_some_iff.mp hj
        simp only [Option.map_some, Option.some.injEq] at hp
        show kcOm .deref g ≤ n
        rw [hq, ← hp, ← hfn, ← kwdomegaJ_eq hqS hlt, hg]
    · rw [ite_eq_right (c := g = q.1) hq] at hg; cases hg

/-- **The certificates counting `deref` instructions check.** -/
theorem kwd_checked : Checked coreProgram false kwdcertOf (kcOm .deref) := by
  intro fn hfn _
  obtain ⟨j, hj, rfl⟩ := List.mem_iff_getElem.mp hfn
  have hc := kwdchkIdx_all j (by rw [coreProgram_length] at hj; exact hj)
  unfold kwdchkIdx at hc
  rw [List.getElem?_eq_getElem hj] at hc
  simp only [kwdhandJ, List.any_nil, Bool.false_or, Bool.and_eq_true] at hc
  by_cases hS : kcIn j
  · refine ⟨kwdlookJ j, kwdomLookJ j, kwdlookJ_ok hc.1, kwdomLookJ_ok hS hc.1, ?_⟩
    show chkFn _ _ false (kwdcertOf coreProgram[j].name) (kcOm .deref coreProgram[j].name) _ = true
    rw [kwdcertOf, kcIdx_getElem hj, ← kwdomegaJ_eq hS hj]
    exact hc.2
  · refine ⟨fun _ => .none, fun _ => none, fun _ h => absurd rfl h, fun _ _ h => (by cases h), ?_⟩
    rw [kwdcertOf, kcIdx_getElem hj, kwdcertJ_none hj hS]
    rfl

/-- A function with a constant certificate counting `deref` instructions. -/
theorem kwd_weightLe {f : String} {B : ℕ} {ks : List (V × ℕ)}
    (hcf : kwdcertOf f = .stat [] ⟨B, []⟩ ks) : WeightLe coreProgram (kcOm .deref) f fun _ => B :=
  weightLe_of_stat kwd_checked hcf

/-- A function with a certificate counting `deref` instructions, under its preconditions. -/
theorem kwd_weight_le_of_stat {f : String} {pre : List (ℕ × ℕ)} {b : Aff} {ks : List (V × ℕ)}
    (hcf : kwdcertOf f = .stat pre b ks) {rd : Reader} {t : Tree} {args rets : List E}
    (hn : t.name = f) (hv : t.Valid coreProgram rd args rets) (hb : t.BufsOk coreProgram)
    (hpre : ArgsPre pre args) : t.weight (kcOm .deref) ≤ b.eval args :=
  weight_le_of_stat kwd_checked hcf hn hv hb hpre

/-- A loop helper's `deref` instructions, from `g^a` to `g^e`. -/
theorem kwd_weight_le_of_loop {f : String} {endc : Option ℕ} {pre : List (ℕ × ℕ)} {b : Aff}
    {ks : List (V × ℕ)} (hcf : kwdcertOf f = .loop endc pre b ks) {rd : Reader} {t : Tree}
    {args rets : List E} (hn : t.name = f) (hv : t.Valid coreProgram rd args rets)
    (hb : t.BufsOk coreProgram) {a e : ℕ} (ha : args.getD 0 0 = ofK (gpow a))
    (he : endOf endc args = ofK (gpow e)) (hae : a < e) (heo : e < 2 ^ 64 - 1)
    (hpre : ArgsPre pre args) : t.weight (kcOm .deref) ≤ (e - a) * b.eval args :=
  weight_le_of_loop kwd_checked hcf hn hv hb ha he hae heo hpre

end
end LeanVM.Guest
