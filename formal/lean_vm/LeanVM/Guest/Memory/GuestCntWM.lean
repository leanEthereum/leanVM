/-- The certificates counting `mulNative` instructions, by name. -/
noncomputable def kumcertOf (g : String) : Cert := kumcertJ (coreIdx g)

theorem kumcertOf_of_idx {j : ℕ} {g : String} (h : (coreProgram[j]?).map Fn.name = some g) :
    kumcertOf g = kumcertJ j := by
  rw [kumcertOf, coreIdx_of_name h]

/-- Only the covered functions have certificates. -/
theorem kumcertJ_list : (List.range coreProgram.length).all
    (fun j => decide (kcuIn j) || match kumcertJ j with | .none => true | _ => false) = true := by
  rw [coreProgram_length]; decide +kernel

/-- The covered functions call only covered functions. -/
theorem kumlnk_list : kcuST.all (fun j => (kumlnkJ j).all fun q => decide (kcuIn q.2)) = true := by
  decide +kernel

theorem kumcertJ_none {j : ℕ} (hj : j < coreProgram.length) (hS : ¬ kcuIn j) : kumcertJ j = .none := by
  have h := List.all_eq_true.mp kumcertJ_list j (List.mem_range.mpr hj)
  simp only [hS, decide_false, Bool.false_or] at h
  split at h
  · assumption
  · exact absurd h (by simp)

/-- The certificates were made at the frame weights `B2C.ωArm B2C.xmssArmC .mulNative`. -/
theorem kumomegaJ_eq {j : ℕ} (hS : kcuIn j) (hj : j < coreProgram.length) :
    kumomegaJ j = B2C.ωArm B2C.xmssArmC .mulNative coreProgram[j].name := by
  have h := (kcuPm_eq hS).2.1
  have e := kcuArmJ_eq hj .mulNative
  rw [show B2C.opIdx .mulNative = 1 from rfl] at e
  rw [e] at h
  unfold B2C.ωArm B2C.pathMax
  rw [kcu_idxOf hj]
  exact h

theorem kumlookJ_ok {j : ℕ}
    (hl : (kumlnkJ j).all (fun q => decide ((coreProgram[q.2]?).map Fn.name = some q.1)) = true) :
    LookOk (kumlookJ j) kumcertOf := by
  intro g hg
  unfold kumlookJ at hg ⊢
  rcases hf : (kumlnkJ j).find (nameKey g) with _ | q
  · rw [hf] at hg; exact absurd rfl hg
  · rw [hf] at hg
    dsimp only at hg ⊢
    by_cases hq : g = q.1
    · have hp := NTree.find_all hl hf
      simp only [decide_eq_true_eq] at hp
      rw [ite_eq_left (c := g = q.1) hq, kumcertOf_of_idx (hq ▸ hp)]
    · rw [ite_eq_right (c := g = q.1) hq] at hg; exact absurd rfl hg

theorem kumomLookJ_ok {j : ℕ} (hS : kcuIn j)
    (hl : (kumlnkJ j).all (fun q => decide ((coreProgram[q.2]?).map Fn.name = some q.1)) = true) :
    WlOk (kumomLookJ j) (B2C.ωArm B2C.xmssArmC .mulNative) := by
  intro g n hg
  unfold kumomLookJ at hg
  rcases hf : (kumlnkJ j).find (nameKey g) with _ | q
  · rw [hf] at hg; cases hg
  · rw [hf] at hg
    dsimp only at hg
    by_cases hq : g = q.1
    · rw [ite_eq_left (c := g = q.1) hq, Option.some.injEq] at hg
      have hp := NTree.find_all hl hf
      simp only [decide_eq_true_eq] at hp
      have hqS : kcuIn q.2 := by
        have h1 := NTree.find_all (p := fun j => (kumlnkJ j).all fun q => decide (kcuIn q.2))
          kumlnk_list hS
        have := NTree.find_all h1 hf
        simpa using this
      rcases hj : coreProgram[q.2]? with _ | fn
      · rw [hj] at hp; exact absurd hp (by simp)
      · rw [hj] at hp
        obtain ⟨hlt, hfn⟩ := List.getElem?_eq_some_iff.mp hj
        simp only [Option.map_some, Option.some.injEq] at hp
        show B2C.ωArm B2C.xmssArmC .mulNative g ≤ n
        rw [hq, ← hp, ← hfn, ← kumomegaJ_eq hqS hlt, hg]
    · rw [ite_eq_right (c := g = q.1) hq] at hg; cases hg

/-- **The certificates counting `mulNative` instructions check.** -/
theorem kum_checked : Checked coreProgram false kumcertOf (B2C.ωArm B2C.xmssArmC .mulNative) := by
  intro fn hfn _
  obtain ⟨j, hj, rfl⟩ := List.mem_iff_getElem.mp hfn
  have hc := kumchkIdx_all j (by rw [coreProgram_length] at hj; exact hj)
  unfold kumchkIdx at hc
  rw [List.getElem?_eq_getElem hj] at hc
  simp only [kumhandJ, List.any_nil, Bool.false_or, Bool.and_eq_true] at hc
  by_cases hS : kcuIn j
  · refine ⟨kumlookJ j, kumomLookJ j, kumlookJ_ok hc.1, kumomLookJ_ok hS hc.1, ?_⟩
    show chkFn _ _ false (kumcertOf coreProgram[j].name) (B2C.ωArm B2C.xmssArmC .mulNative coreProgram[j].name) _ = true
    rw [kumcertOf, coreIdx_getElem hj, ← kumomegaJ_eq hS hj]
    exact hc.2
  · refine ⟨fun _ => .none, fun _ => none, fun _ h => absurd rfl h, fun _ _ h => (by cases h), ?_⟩
    rw [kumcertOf, coreIdx_getElem hj, kumcertJ_none hj hS]
    rfl

/-- A function with a constant certificate counting `mulNative` instructions. -/
theorem kum_weightLe {f : String} {B : ℕ} {ks : List (V × ℕ)}
    (hcf : kumcertOf f = .stat [] ⟨B, []⟩ ks) : WeightLe coreProgram (B2C.ωArm B2C.xmssArmC .mulNative) f fun _ => B :=
  weightLe_of_stat kum_checked hcf

/-- A function with a certificate counting `mulNative` instructions, under its preconditions. -/
theorem kum_weight_le_of_stat {f : String} {pre : List (ℕ × ℕ)} {b : Aff} {ks : List (V × ℕ)}
    (hcf : kumcertOf f = .stat pre b ks) {rd : Reader} {t : Tree} {args rets : List E}
    (hn : t.name = f) (hv : t.Valid coreProgram rd args rets) (hb : t.BufsOk coreProgram)
    (hpre : ArgsPre pre args) : t.weight (B2C.ωArm B2C.xmssArmC .mulNative) ≤ b.eval args :=
  weight_le_of_stat kum_checked hcf hn hv hb hpre

/-- A loop helper's `mulNative` instructions, from `g^a` to `g^e`. -/
theorem kum_weight_le_of_loop {f : String} {endc : Option ℕ} {pre : List (ℕ × ℕ)} {b : Aff}
    {ks : List (V × ℕ)} (hcf : kumcertOf f = .loop endc pre b ks) {rd : Reader} {t : Tree}
    {args rets : List E} (hn : t.name = f) (hv : t.Valid coreProgram rd args rets)
    (hb : t.BufsOk coreProgram) {a e : ℕ} (ha : args.getD 0 0 = ofK (addressOfIndex a))
    (he : endOf endc args = ofK (addressOfIndex e)) (hae : a < e) (heo : e < 2 ^ 64 - 1)
    (hpre : ArgsPre pre args) : t.weight (B2C.ωArm B2C.xmssArmC .mulNative) ≤ (e - a) * b.eval args :=
  weight_le_of_loop kum_checked hcf hn hv hb ha he hae heo hpre

