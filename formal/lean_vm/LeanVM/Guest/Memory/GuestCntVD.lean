/-
  LeanVM.Guest.Memory.GuestCntVD

  The guest's static certificates counting `deref` instructions (`B2C.ωArm B2C.xmssArmC .deref`),
  checked (`kvd_checked`), and the weight bounds they give (`kvd_weightLe`, `kvd_weight_le_of_stat`,
  `kvd_weight_le_of_loop`). Generated by `scripts/count/gen.py`; do not edit.
-/

module

public import LeanVM.Guest.Memory.GuestCntVD.All
public import LeanVM.Guest.Memory.GuestCntVPm

namespace LeanVM.Guest

open LeanVM.Parameters LeanVM.Semantics Core Memory Data

@[expose] public section

/-- The certificates counting `deref` instructions, by name. -/
noncomputable def kvdcertOf (g : String) : Cert := kvdcertJ (coreIdx g)

theorem kvdcertOf_of_idx {j : ℕ} {g : String} (h : (coreProgram[j]?).map Fn.name = some g) :
    kvdcertOf g = kvdcertJ j := by
  rw [kvdcertOf, coreIdx_of_name h]

/-- Only the covered functions have certificates. -/
theorem kvdcertJ_list : (List.range coreProgram.length).all
    (fun j => decide (kcvIn j) || match kvdcertJ j with | .none => true | _ => false) = true := by
  rw [coreProgram_length]; decide +kernel

/-- The covered functions call only covered functions. -/
theorem kvdlnk_list : kcvST.all (fun j => (kvdlnkJ j).all fun q => decide (kcvIn q.2)) = true := by
  decide +kernel

theorem kvdcertJ_none {j : ℕ} (hj : j < coreProgram.length) (hS : ¬ kcvIn j) : kvdcertJ j = .none := by
  have h := List.all_eq_true.mp kvdcertJ_list j (List.mem_range.mpr hj)
  simp only [hS, decide_false, Bool.false_or] at h
  split at h
  · assumption
  · exact absurd h (by simp)

/-- The certificates were made at the frame weights `B2C.ωArm B2C.xmssArmC .deref`. -/
theorem kvdomegaJ_eq {j : ℕ} (hS : kcvIn j) (hj : j < coreProgram.length) :
    kvdomegaJ j = B2C.ωArm B2C.xmssArmC .deref coreProgram[j].name := by
  have h := (kcvPm_eq hS).2.2.2.1
  have e := kcvArmJ_eq hj .deref
  rw [show B2C.opIdx .deref = 3 from rfl] at e
  rw [e] at h
  unfold B2C.ωArm B2C.pathMax
  rw [kcv_idxOf hj]
  exact h

theorem kvdlookJ_ok {j : ℕ}
    (hl : (kvdlnkJ j).all (fun q => decide ((coreProgram[q.2]?).map Fn.name = some q.1)) = true) :
    LookOk (kvdlookJ j) kvdcertOf := by
  intro g hg
  unfold kvdlookJ at hg ⊢
  rcases hf : (kvdlnkJ j).find (nameKey g) with _ | q
  · rw [hf] at hg; exact absurd rfl hg
  · rw [hf] at hg
    dsimp only at hg ⊢
    by_cases hq : g = q.1
    · have hp := NTree.find_all hl hf
      simp only [decide_eq_true_eq] at hp
      rw [ite_eq_left (c := g = q.1) hq, kvdcertOf_of_idx (hq ▸ hp)]
    · rw [ite_eq_right (c := g = q.1) hq] at hg; exact absurd rfl hg

theorem kvdomLookJ_ok {j : ℕ} (hS : kcvIn j)
    (hl : (kvdlnkJ j).all (fun q => decide ((coreProgram[q.2]?).map Fn.name = some q.1)) = true) :
    WlOk (kvdomLookJ j) (B2C.ωArm B2C.xmssArmC .deref) := by
  intro g n hg
  unfold kvdomLookJ at hg
  rcases hf : (kvdlnkJ j).find (nameKey g) with _ | q
  · rw [hf] at hg; cases hg
  · rw [hf] at hg
    dsimp only at hg
    by_cases hq : g = q.1
    · rw [ite_eq_left (c := g = q.1) hq, Option.some.injEq] at hg
      have hp := NTree.find_all hl hf
      simp only [decide_eq_true_eq] at hp
      have hqS : kcvIn q.2 := by
        have h1 := NTree.find_all (p := fun j => (kvdlnkJ j).all fun q => decide (kcvIn q.2))
          kvdlnk_list hS
        have := NTree.find_all h1 hf
        simpa using this
      rcases hj : coreProgram[q.2]? with _ | fn
      · rw [hj] at hp; exact absurd hp (by simp)
      · rw [hj] at hp
        obtain ⟨hlt, hfn⟩ := List.getElem?_eq_some_iff.mp hj
        simp only [Option.map_some, Option.some.injEq] at hp
        show B2C.ωArm B2C.xmssArmC .deref g ≤ n
        rw [hq, ← hp, ← hfn, ← kvdomegaJ_eq hqS hlt, hg]
    · rw [ite_eq_right (c := g = q.1) hq] at hg; cases hg

/-- **The certificates counting `deref` instructions check.** -/
theorem kvd_checked : Checked coreProgram false kvdcertOf (B2C.ωArm B2C.xmssArmC .deref) := by
  intro fn hfn _
  obtain ⟨j, hj, rfl⟩ := List.mem_iff_getElem.mp hfn
  have hc := kvdchkIdx_all j (by rw [coreProgram_length] at hj; exact hj)
  unfold kvdchkIdx at hc
  rw [List.getElem?_eq_getElem hj] at hc
  simp only [kvdhandJ, List.any_nil, Bool.false_or, Bool.and_eq_true] at hc
  by_cases hS : kcvIn j
  · refine ⟨kvdlookJ j, kvdomLookJ j, kvdlookJ_ok hc.1, kvdomLookJ_ok hS hc.1, ?_⟩
    show chkFn _ _ false (kvdcertOf coreProgram[j].name) (B2C.ωArm B2C.xmssArmC .deref coreProgram[j].name) _ = true
    rw [kvdcertOf, coreIdx_getElem hj, ← kvdomegaJ_eq hS hj]
    exact hc.2
  · refine ⟨fun _ => .none, fun _ => none, fun _ h => absurd rfl h, fun _ _ h => (by cases h), ?_⟩
    rw [kvdcertOf, coreIdx_getElem hj, kvdcertJ_none hj hS]
    rfl

/-- A function with a constant certificate counting `deref` instructions. -/
theorem kvd_weightLe {f : String} {B : ℕ} {ks : List (V × ℕ)}
    (hcf : kvdcertOf f = .stat [] ⟨B, []⟩ ks) : WeightLe coreProgram (B2C.ωArm B2C.xmssArmC .deref) f fun _ => B :=
  weightLe_of_stat kvd_checked hcf

/-- A function with a certificate counting `deref` instructions, under its preconditions. -/
theorem kvd_weight_le_of_stat {f : String} {pre : List (ℕ × ℕ)} {b : Aff} {ks : List (V × ℕ)}
    (hcf : kvdcertOf f = .stat pre b ks) {rd : Reader} {t : Tree} {args rets : List E}
    (hn : t.name = f) (hv : t.Valid coreProgram rd args rets) (hb : t.BufsOk coreProgram)
    (hpre : ArgsPre pre args) : t.weight (B2C.ωArm B2C.xmssArmC .deref) ≤ b.eval args :=
  weight_le_of_stat kvd_checked hcf hn hv hb hpre

/-- A loop helper's `deref` instructions, from `g^a` to `g^e`. -/
theorem kvd_weight_le_of_loop {f : String} {endc : Option ℕ} {pre : List (ℕ × ℕ)} {b : Aff}
    {ks : List (V × ℕ)} (hcf : kvdcertOf f = .loop endc pre b ks) {rd : Reader} {t : Tree}
    {args rets : List E} (hn : t.name = f) (hv : t.Valid coreProgram rd args rets)
    (hb : t.BufsOk coreProgram) {a e : ℕ} (ha : args.getD 0 0 = ofK (addressOfIndex a))
    (he : endOf endc args = ofK (addressOfIndex e)) (hae : a < e) (heo : e < 2 ^ 64 - 1)
    (hpre : ArgsPre pre args) : t.weight (B2C.ωArm B2C.xmssArmC .deref) ≤ (e - a) * b.eval args :=
  weight_le_of_loop kvd_checked hcf hn hv hb ha he hae heo hpre

end
end LeanVM.Guest
