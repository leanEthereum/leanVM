open LeanVM.Parameters LeanVM.Semantics Core Memory Data

@[expose] public section

/-- The certificates counting `keccak` instructions, by name. -/
noncomputable def kukcertOf (g : String) : Cert := kukcertJ (coreIdx g)

theorem kukcertOf_of_idx {j : ℕ} {g : String} (h : (coreProgram[j]?).map Fn.name = some g) :
    kukcertOf g = kukcertJ j := by
  rw [kukcertOf, coreIdx_of_name h]

/-- Only the covered functions have certificates. -/
theorem kukcertJ_list : (List.range coreProgram.length).all
    (fun j => decide (kcuIn j) || match kukcertJ j with | .none => true | _ => false) = true := by
  rw [coreProgram_length]; decide +kernel

/-- The covered functions call only covered functions. -/
theorem kuklnk_list : kcuST.all (fun j => (kuklnkJ j).all fun q => decide (kcuIn q.2)) = true := by
  decide +kernel

theorem kukcertJ_none {j : ℕ} (hj : j < coreProgram.length) (hS : ¬ kcuIn j) : kukcertJ j = .none := by
  have h := List.all_eq_true.mp kukcertJ_list j (List.mem_range.mpr hj)
  simp only [hS, decide_false, Bool.false_or] at h
  split at h
  · assumption
  · exact absurd h (by simp)

/-- The certificates were made at the frame weights `B2C.ωArm B2C.xmssArmC .keccak`. -/
theorem kukomegaJ_eq {j : ℕ} (hS : kcuIn j) (hj : j < coreProgram.length) :
    kukomegaJ j = B2C.ωArm B2C.xmssArmC .keccak coreProgram[j].name := by
  have h := (kcuPm_eq hS).2.2.2.2.2
  have e := kcuArmJ_eq hj .keccak
  rw [show B2C.opIdx .keccak = 5 from rfl] at e
  rw [e] at h
  unfold B2C.ωArm B2C.pathMax
  rw [kcu_idxOf hj]
  exact h

theorem kuklookJ_ok {j : ℕ}
    (hl : (kuklnkJ j).all (fun q => decide ((coreProgram[q.2]?).map Fn.name = some q.1)) = true) :
    LookOk (kuklookJ j) kukcertOf := by
  intro g hg
  unfold kuklookJ at hg ⊢
  rcases hf : (kuklnkJ j).find (nameKey g) with _ | q
  · rw [hf] at hg; exact absurd rfl hg
  · rw [hf] at hg
    dsimp only at hg ⊢
    by_cases hq : g = q.1
    · have hp := NTree.find_all hl hf
      simp only [decide_eq_true_eq] at hp
      rw [ite_eq_left (c := g = q.1) hq, kukcertOf_of_idx (hq ▸ hp)]
    · rw [ite_eq_right (c := g = q.1) hq] at hg; exact absurd rfl hg

theorem kukomLookJ_ok {j : ℕ} (hS : kcuIn j)
    (hl : (kuklnkJ j).all (fun q => decide ((coreProgram[q.2]?).map Fn.name = some q.1)) = true) :
    WlOk (kukomLookJ j) (B2C.ωArm B2C.xmssArmC .keccak) := by
  intro g n hg
  unfold kukomLookJ at hg
  rcases hf : (kuklnkJ j).find (nameKey g) with _ | q
  · rw [hf] at hg; cases hg
  · rw [hf] at hg
    dsimp only at hg
    by_cases hq : g = q.1
    · rw [ite_eq_left (c := g = q.1) hq, Option.some.injEq] at hg
      have hp := NTree.find_all hl hf
      simp only [decide_eq_true_eq] at hp
      have hqS : kcuIn q.2 := by
        have h1 := NTree.find_all (p := fun j => (kuklnkJ j).all fun q => decide (kcuIn q.2))
          kuklnk_list hS
        have := NTree.find_all h1 hf
        simpa using this
      rcases hj : coreProgram[q.2]? with _ | fn
      · rw [hj] at hp; exact absurd hp (by simp)
      · rw [hj] at hp
        obtain ⟨hlt, hfn⟩ := List.getElem?_eq_some_iff.mp hj
        simp only [Option.map_some, Option.some.injEq] at hp
        show B2C.ωArm B2C.xmssArmC .keccak g ≤ n
        rw [hq, ← hp, ← hfn, ← kukomegaJ_eq hqS hlt, hg]
    · rw [ite_eq_right (c := g = q.1) hq] at hg; cases hg

/-- **The certificates counting `keccak` instructions check.** -/
theorem kuk_checked : Checked coreProgram false kukcertOf (B2C.ωArm B2C.xmssArmC .keccak) := by
  intro fn hfn _
  obtain ⟨j, hj, rfl⟩ := List.mem_iff_getElem.mp hfn
  have hc := kukchkIdx_all j (by rw [coreProgram_length] at hj; exact hj)
  unfold kukchkIdx at hc
  rw [List.getElem?_eq_getElem hj] at hc
  simp only [kukhandJ, List.any_nil, Bool.false_or, Bool.and_eq_true] at hc
  by_cases hS : kcuIn j
  · refine ⟨kuklookJ j, kukomLookJ j, kuklookJ_ok hc.1, kukomLookJ_ok hS hc.1, ?_⟩
    show chkFn _ _ false (kukcertOf coreProgram[j].name) (B2C.ωArm B2C.xmssArmC .keccak coreProgram[j].name) _ = true
    rw [kukcertOf, coreIdx_getElem hj, ← kukomegaJ_eq hS hj]
    exact hc.2
  · refine ⟨fun _ => .none, fun _ => none, fun _ h => absurd rfl h, fun _ _ h => (by cases h), ?_⟩
    rw [kukcertOf, coreIdx_getElem hj, kukcertJ_none hj hS]
    rfl

/-- A function with a constant certificate counting `keccak` instructions. -/
theorem kuk_weightLe {f : String} {B : ℕ} {ks : List (V × ℕ)}
    (hcf : kukcertOf f = .stat [] ⟨B, []⟩ ks) : WeightLe coreProgram (B2C.ωArm B2C.xmssArmC .keccak) f fun _ => B :=
  weightLe_of_stat kuk_checked hcf

/-- A function with a certificate counting `keccak` instructions, under its preconditions. -/
theorem kuk_weight_le_of_stat {f : String} {pre : List (ℕ × ℕ)} {b : Aff} {ks : List (V × ℕ)}
    (hcf : kukcertOf f = .stat pre b ks) {rd : Reader} {t : Tree} {args rets : List E}
    (hn : t.name = f) (hv : t.Valid coreProgram rd args rets) (hb : t.BufsOk coreProgram)
    (hpre : ArgsPre pre args) : t.weight (B2C.ωArm B2C.xmssArmC .keccak) ≤ b.eval args :=
  weight_le_of_stat kuk_checked hcf hn hv hb hpre

/-- A loop helper's `keccak` instructions, from `g^a` to `g^e`. -/
theorem kuk_weight_le_of_loop {f : String} {endc : Option ℕ} {pre : List (ℕ × ℕ)} {b : Aff}
    {ks : List (V × ℕ)} (hcf : kukcertOf f = .loop endc pre b ks) {rd : Reader} {t : Tree}
    {args rets : List E} (hn : t.name = f) (hv : t.Valid coreProgram rd args rets)
    (hb : t.BufsOk coreProgram) {a e : ℕ} (ha : args.getD 0 0 = ofK (addressOfIndex a))
    (he : endOf endc args = ofK (addressOfIndex e)) (hae : a < e) (heo : e < 2 ^ 64 - 1)
    (hpre : ArgsPre pre args) : t.weight (B2C.ωArm B2C.xmssArmC .keccak) ≤ (e - a) * b.eval args :=
  weight_le_of_loop kuk_checked hcf hn hv hb ha he hae heo hpre

