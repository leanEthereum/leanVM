/-
  LeanVM.Guest.Memory.GuestCntK

  The guest's static certificates counting `keccak` instructions (`B2C.ωArm B2C.xmssArmC .keccak`),
  checked (`kwk_checked`), and the weight bounds they give (`kwk_weightLe`, `kwk_weight_le_of_stat`,
  `kwk_weight_le_of_loop`). Generated by `scripts/count/gen.py`; do not edit.
-/

module

public import LeanVM.Guest.Memory.GuestCntK.All
public import LeanVM.Guest.Memory.GuestCntPm

namespace LeanVM.Guest

open LeanVM.Parameters LeanVM.Semantics Core Memory Data

@[expose] public section

/-- The certificates counting `keccak` instructions, by name. -/
noncomputable def kwkcertOf (g : String) : Cert := kwkcertJ (coreIdx g)

theorem kwkcertOf_of_idx {j : ℕ} {g : String} (h : (coreProgram[j]?).map Fn.name = some g) :
    kwkcertOf g = kwkcertJ j := by
  rw [kwkcertOf, coreIdx_of_name h]

/-- Only the covered functions have certificates. -/
theorem kwkcertJ_list : (List.range coreProgram.length).all
    (fun j => decide (kcIn j) || match kwkcertJ j with | .none => true | _ => false) = true := by
  rw [coreProgram_length]; decide +kernel

/-- The covered functions call only covered functions. -/
theorem kwklnk_list : kcST.all (fun j => (kwklnkJ j).all fun q => decide (kcIn q.2)) = true := by
  decide +kernel

theorem kwkcertJ_none {j : ℕ} (hj : j < coreProgram.length) (hS : ¬ kcIn j) : kwkcertJ j = .none := by
  have h := List.all_eq_true.mp kwkcertJ_list j (List.mem_range.mpr hj)
  simp only [hS, decide_false, Bool.false_or] at h
  split at h
  · assumption
  · exact absurd h (by simp)

/-- The certificates were made at the frame weights `B2C.ωArm B2C.xmssArmC .keccak`. -/
theorem kwkomegaJ_eq {j : ℕ} (hS : kcIn j) (hj : j < coreProgram.length) :
    kwkomegaJ j = B2C.ωArm B2C.xmssArmC .keccak coreProgram[j].name := by
  have h := (kcPm_eq hS).2.2.2.2.2
  have e := kcArmJ_eq hj .keccak
  rw [show B2C.opIdx .keccak = 5 from rfl] at e
  rw [e] at h
  unfold B2C.ωArm B2C.pathMax
  rw [kc_idxOf hj]
  exact h

theorem kwklookJ_ok {j : ℕ}
    (hl : (kwklnkJ j).all (fun q => decide ((coreProgram[q.2]?).map Fn.name = some q.1)) = true) :
    LookOk (kwklookJ j) kwkcertOf := by
  intro g hg
  unfold kwklookJ at hg ⊢
  rcases hf : (kwklnkJ j).find (nameKey g) with _ | q
  · rw [hf] at hg; exact absurd rfl hg
  · rw [hf] at hg
    dsimp only at hg ⊢
    by_cases hq : g = q.1
    · have hp := NTree.find_all hl hf
      simp only [decide_eq_true_eq] at hp
      rw [ite_eq_left (c := g = q.1) hq, kwkcertOf_of_idx (hq ▸ hp)]
    · rw [ite_eq_right (c := g = q.1) hq] at hg; exact absurd rfl hg

theorem kwkomLookJ_ok {j : ℕ} (hS : kcIn j)
    (hl : (kwklnkJ j).all (fun q => decide ((coreProgram[q.2]?).map Fn.name = some q.1)) = true) :
    WlOk (kwkomLookJ j) (B2C.ωArm B2C.xmssArmC .keccak) := by
  intro g n hg
  unfold kwkomLookJ at hg
  rcases hf : (kwklnkJ j).find (nameKey g) with _ | q
  · rw [hf] at hg; cases hg
  · rw [hf] at hg
    dsimp only at hg
    by_cases hq : g = q.1
    · rw [ite_eq_left (c := g = q.1) hq, Option.some.injEq] at hg
      have hp := NTree.find_all hl hf
      simp only [decide_eq_true_eq] at hp
      have hqS : kcIn q.2 := by
        have h1 := NTree.find_all (p := fun j => (kwklnkJ j).all fun q => decide (kcIn q.2))
          kwklnk_list hS
        have := NTree.find_all h1 hf
        simpa using this
      rcases hj : coreProgram[q.2]? with _ | fn
      · rw [hj] at hp; exact absurd hp (by simp)
      · rw [hj] at hp
        obtain ⟨hlt, hfn⟩ := List.getElem?_eq_some_iff.mp hj
        simp only [Option.map_some, Option.some.injEq] at hp
        show B2C.ωArm B2C.xmssArmC .keccak g ≤ n
        rw [hq, ← hp, ← hfn, ← kwkomegaJ_eq hqS hlt, hg]
    · rw [ite_eq_right (c := g = q.1) hq] at hg; cases hg

/-- **The certificates counting `keccak` instructions check.** -/
theorem kwk_checked : Checked coreProgram false kwkcertOf (B2C.ωArm B2C.xmssArmC .keccak) := by
  intro fn hfn _
  obtain ⟨j, hj, rfl⟩ := List.mem_iff_getElem.mp hfn
  have hc := kwkchkIdx_all j (by rw [coreProgram_length] at hj; exact hj)
  unfold kwkchkIdx at hc
  rw [List.getElem?_eq_getElem hj] at hc
  simp only [kwkhandJ, List.any_nil, Bool.false_or, Bool.and_eq_true] at hc
  by_cases hS : kcIn j
  · refine ⟨kwklookJ j, kwkomLookJ j, kwklookJ_ok hc.1, kwkomLookJ_ok hS hc.1, ?_⟩
    show chkFn _ _ false (kwkcertOf coreProgram[j].name) (B2C.ωArm B2C.xmssArmC .keccak coreProgram[j].name) _ = true
    rw [kwkcertOf, coreIdx_getElem hj, ← kwkomegaJ_eq hS hj]
    exact hc.2
  · refine ⟨fun _ => .none, fun _ => none, fun _ h => absurd rfl h, fun _ _ h => (by cases h), ?_⟩
    rw [kwkcertOf, coreIdx_getElem hj, kwkcertJ_none hj hS]
    rfl

/-- A function with a constant certificate counting `keccak` instructions. -/
theorem kwk_weightLe {f : String} {B : ℕ} {ks : List (V × ℕ)}
    (hcf : kwkcertOf f = .stat [] ⟨B, []⟩ ks) : WeightLe coreProgram (B2C.ωArm B2C.xmssArmC .keccak) f fun _ => B :=
  weightLe_of_stat kwk_checked hcf

/-- A function with a certificate counting `keccak` instructions, under its preconditions. -/
theorem kwk_weight_le_of_stat {f : String} {pre : List (ℕ × ℕ)} {b : Aff} {ks : List (V × ℕ)}
    (hcf : kwkcertOf f = .stat pre b ks) {rd : Reader} {t : Tree} {args rets : List E}
    (hn : t.name = f) (hv : t.Valid coreProgram rd args rets) (hb : t.BufsOk coreProgram)
    (hpre : ArgsPre pre args) : t.weight (B2C.ωArm B2C.xmssArmC .keccak) ≤ b.eval args :=
  weight_le_of_stat kwk_checked hcf hn hv hb hpre

/-- A loop helper's `keccak` instructions, from `g^a` to `g^e`. -/
theorem kwk_weight_le_of_loop {f : String} {endc : Option ℕ} {pre : List (ℕ × ℕ)} {b : Aff}
    {ks : List (V × ℕ)} (hcf : kwkcertOf f = .loop endc pre b ks) {rd : Reader} {t : Tree}
    {args rets : List E} (hn : t.name = f) (hv : t.Valid coreProgram rd args rets)
    (hb : t.BufsOk coreProgram) {a e : ℕ} (ha : args.getD 0 0 = ofK (addressOfIndex a))
    (he : endOf endc args = ofK (addressOfIndex e)) (hae : a < e) (heo : e < 2 ^ 64 - 1)
    (hpre : ArgsPre pre args) : t.weight (B2C.ωArm B2C.xmssArmC .keccak) ≤ (e - a) * b.eval args :=
  weight_le_of_loop kwk_checked hcf hn hv hb ha he hae heo hpre

end
end LeanVM.Guest
