/-
  LeanVM.Guest.Glob

  The guest's functions by index, compiled, as core IR and with their certificates, and the
  program context their checks share.
-/

module

public import LeanVM.Guest.Check
public import LeanVM.Guest.CoreData
public import LeanVM.Guest.Data.Cert
public import LeanVM.Guest.Data.Pows
public import LeanVM.Guest.B1.Tables

/-!
# The guest's checks

Function `j` of the compiled guest is `fnOf j` (`Data.functions`, `__jump_tables` at `0`,
`main` at `1`), its core IR function `coreOf j` (`coreProgram`, which starts at `main`) and its
certificate `certOf j` (`Data.certs`, generated by `lake exe guest-cert`). `sigOf j` is what a
caller knows of it, and `glob` the context every check shares: the signatures, the functions
other than `__jump_tables` and `main` (the callees, `good`), and the jump table. `CheckOk j` is
the check of function `j`, window by window (`WinOk j i`), decided by the kernel in
`Guest/Checked/`.
-/

namespace LeanVM.Guest

open LeanVM.Guest.Check

@[expose] public section

/-- The number of compiled functions. -/
def nFns : ℕ := 1044

instance : Inhabited CompiledFn := ⟨⟨"", 0, 0, []⟩⟩

instance : Inhabited Cert := ⟨⟨{}, [], [], [], 0, [], [], [], [], [], [], []⟩⟩

/-- Compiled function `j`. -/
def fnOf (j : ℕ) : CompiledFn := nth Data.functions j default

/-- The core IR function of compiled function `j ≥ 1`. -/
noncomputable def coreOf (j : ℕ) : Core.Fn := nth coreProgram (j - 1) default

/-- The certificate of compiled function `j`, with the guest's powers of `g` (`Data.powTree`,
checked once) as its executor's. -/
noncomputable def certOf (j : ℕ) : Cert :=
  match nth Data.certs j default with
  | ⟨⟨env, fpOne, _, arms, scaled⟩, los, cells, ins, nret, callees, pre, post, mem, sem, cuts, ends⟩ =>
    ⟨⟨env, fpOne, Data.powTree, arms, scaled⟩, los, cells, ins, nret, callees, pre, post, mem, sem, cuts,
      ends⟩

/-- What a caller knows of function `j`. -/
noncomputable def sigOf (j : ℕ) : Sig :=
  ⟨(coreOf j).name, (fnOf j).entry, (coreOf j).params.length, (certOf j).nret,
    (certOf j).facts.env, (certOf j).pre, (certOf j).post, (certOf j).mem, (certOf j).sem⟩

/-- The callees: every function but `__jump_tables` and `main`. -/
def good (j : ℕ) : Bool := Nat.ble 2 j && Nat.blt j nFns

/-- The context the guest's checks share; the semantic relation is that of the exponent tables
(`B1.ExpTables`), which `verify_sub` assumes of its arguments 4 and 5. -/
noncomputable def glob : Glob := ⟨sigOf, good, Data.jtTrie, B1.ExpTables⟩

/-- **The check of window `i` of function `j`**. -/
noncomputable def WinOk (j i : ℕ) : Prop :=
  checkWin glob (fnOf j) (coreOf j) (certOf j) (j == 1) i = true

noncomputable instance (j i : ℕ) : Decidable (WinOk j i) := inferInstanceAs (Decidable (_ = true))

/-- **The check of function `j`**: every window's. -/
noncomputable def CheckOk (j : ℕ) : Prop := ∀ i ≤ (certOf j).cuts.length, WinOk j i

theorem checkOk_one {j : ℕ} (h : (certOf j).cuts.length = 0) (w : WinOk j 0) : CheckOk j := by
  intro i hi
  obtain rfl : i = 0 := by omega
  exact w

end
end LeanVM.Guest
