/-
  LeanVM.Guest.CoreMode.PairDefs

  The core route's order-aware pairing: the alignment pass with the heap events consumed in order,
  each `DEREF` of a `load` at its pc, checked against the oracle of the pcs whose `DEREF` reads a
  cell the heap certificate proves written.
-/

module

public import LeanVM.Guest.Bridge.AlignDefs
public import LeanVM.Guest.CoreMode.Defs

/-!
# The order-aware pairing

`formal/notes/core-mode.md`, section 3. The heap check (`heapOk`) proves each read of a path written by the events before it; the frame walk (`frameOk`) needs to know, at a `DEREF` of mode `cell`, whether the heap cell it reads is one of them. The pairing ties the two: `Bridge.alignOk`'s forward pass over the code (`Bridge/AlignDefs.lean`, whose zippers, states, tables and names it reuses), its body position at each offset now also past exactly the heap events whose instructions have run.

* The normalization takes a stop predicate (`normG`). After every step it stops at the flow hints and at every `load` (`stopL`), so the position's head at an instruction is the next heap event. Before a flow hint and before a jump by the head statement it skips the reads too (`stopS`, a `load` the certificate names as a read, `isRead`): a read whose cells the compiler shares with an earlier `load` has no `DEREF` of its own, and a read's cell is written before it (`heapOk_sound`), so passing it early writes nothing new.
* A `DEREF o1 o2 o3 .cell` consumes the head `load d p off` at its cells (`locAt p = o1`, `off = o2`, `locAt d = o3`), reads before it skipped (`scan`); with none, the position stays (range checks, `touch`, plumbing).
* At each offset reached the oracle is checked (`kindOk`): a consumed read's offset is in `O` and not in `S`, a consumed store's in `S` and not in `O`, any other offset in neither, but a `DEREF` reading the jump table (`jtd`), which consumes nothing, may be in `O`. `O` and `S` are data, generated by `scripts/core-mode/pair.py`, the pass's mirror.

The pass is `Bridge`'s otherwise (`headStepH`, `jumpStepH`, `stepIH`, `pairGo`, `winOkH`), with `PairCtx.nL` for `normZ`, and is checked in windows from named states for a long function as `Bridge.winOk`.
-/

namespace LeanVM.Guest.CoreMode

open LeanVM.Parameters LeanVM.Semantics LeanVM.Guest LeanVM.Guest.Core LeanVM.Guest.Bridge
open LeanVM.Guest.Exec (Trie natSeq)
open LeanVM.Guest.Check (getF)

@[expose] public section

/-! ## Heap events -/

/-- A `load` atom. -/
def isLoad : Atom → Bool
  | .load .. => true
  | _ => false

/-- **A read**: a `load` the reads `R` (`HCert.readT`) name. -/
noncomputable def isRead (R : Trie (List (ℕ × ℕ × Wit))) : Atom → Bool
  | .load d p off => (readWitT R d p off).isSome
  | _ => false

/-- The heap events: flow hints and `load`s. -/
def stopL (a : Atom) : Bool := flowAtom a || isLoad a

/-- The events a read cannot pass: flow hints and stores. -/
noncomputable def stopS (R : Trie (List (ℕ × ℕ × Wit))) (a : Atom) : Bool := flowAtom a || (isLoad a && !isRead R a)

/-! ## The normalization -/

/-- One step of the normalization stopping at `stop`, `r` the rest of it. -/
def normStepG (stop : Atom → Bool) (r : Zip → Option Zip) : Zip → Option Zip
  | ⟨up, k, s :: ss⟩ => match s with
    | .atom a => bif stop a then some ⟨up, k, s :: ss⟩ else natSeq (Nat.succ k) fun k ↦ r ⟨up, k, ss⟩
    | _ => some ⟨up, k, s :: ss⟩
  | ⟨[], k, []⟩ => some ⟨[], k, []⟩
  | ⟨(k', _, ss) :: up, _, []⟩ => natSeq (Nat.succ k') fun k ↦ r ⟨up, k, ss⟩

/-- **The zipper normalized**, within `f` steps: finished blocks popped, atoms `stop` rejects
skipped. -/
def normG (stop : Atom → Bool) (f : ℕ) : Zip → Option Zip :=
  Nat.rec (motive := fun _ ↦ Zip → Option Zip) (fun _ ↦ none) (fun _ r ↦ normStepG stop r) f

/-! ## The context -/

/-- **What the pairing reads**: the alignment's context, the reads by word, the oracle `O` (offsets
of the reads' `DEREF`s) and the stores' offsets `S`. -/
structure PairCtx where
  X : AlignCtx
  R : Trie (List (ℕ × ℕ × Wit))
  O : Trie Unit
  S : Trie Unit

/-- A trie of offsets holds `i`. -/
noncomputable def hasP (t : Trie Unit) (i : ℕ) : Bool := (getF t i).isSome

/-- A list of offsets as a trie. -/
noncomputable def offsT (l : List ℕ) : Trie Unit := trieOf (l.map fun o ↦ (o, ()))

namespace PairCtx

variable (P : PairCtx)

/-- The context from the alignment's, a heap certificate and the oracle. -/
noncomputable def ofH (X : AlignCtx) (H : HCert) (O S : Trie Unit) : PairCtx := ⟨X, H.readT, O, S⟩

/-- `k P`, the context evaluated first. -/
def seq {β : Type} (k : PairCtx → β) : β :=
  P.X.seq fun X ↦ P.R.seq fun R ↦ P.O.seq fun O ↦ P.S.seq fun S ↦ k ⟨X, R, O, S⟩

/-- The normalization after a step: to the next heap event. -/
noncomputable def nL : Zip → Option Zip := normG stopL P.X.fuel

/-- The normalization before a hint or a jump: past the reads. -/
noncomputable def nS : Zip → Option Zip := normG (stopS P.R) P.X.fuel

/-- **The oracle at offset `i`**: a consumed read (`some true`) in `O` only, a consumed store
(`some false`) in `S` only, nothing in neither. -/
noncomputable def kindOk (i : ℕ) : Option Bool → Bool
  | some true => hasP P.O i && !hasP P.S i
  | some false => !hasP P.O i && hasP P.S i
  | none => !hasP P.O i && !hasP P.S i

end PairCtx

/-! ## The pass -/

/-- The zippers of a `match`'s arms from `j` on, at their targets from slot `base + j`. -/
noncomputable def armZsH (P : PairCtx) (i : ℕ) (z : Zip) (s : Stmt) (ss : List Stmt) (base : ℕ) :
    ℕ → List (List Stmt) → Option (List (ℕ × Zip))
  | _, [] => some []
  | j, _ :: as => match getF P.X.jt (Nat.add base j), P.nL (z.enter s ss j) with
    | some t, some c => match P.X.fwdOff i t, armZsH P i z s ss base (j + 1) as with
      | some o, some l => some ((o, c) :: l)
      | _, _ => none
    | _, _ => none

/-- **A jump by the head statement**, `Bridge.headStep` with the heap normalization. -/
noncomputable def headStepH (P : PairCtx) (i oc od of : ℕ) (tabs : List (ℕ × Zip × ℕ)) (z : Zip) :
    Option (Option Zip × List (ℕ × Zip)) :=
  match z.cur with
  | s@(.ite c _ _) :: ss =>
    bif Nat.beq (P.X.locAt c.idx) oc && P.X.selfAt of then
      match P.X.pcAt od, P.nL (z.enter s ss 0), P.nL (z.enter s ss 1) with
      | some t, some cz, some cn => (P.X.fwdOff i t).map fun o ↦ (some cz, [(o, cn)])
      | _, _, _ => none
    else none
  | s@(.match_ x arms) :: ss =>
    bif P.X.nzAt oc && P.X.selfAt of then
      match getF P.X.arms od with
      | some a => bif Nat.beq a.1 x.idx then
          bif tabHit tabs a.2 z i then some (none, []) else (armZsH P i z s ss a.2 0 arms).map fun l ↦ (none, l)
        else none
      | none => none
    else none
  | .call f args rets :: ss =>
    match P.X.siteAt of args rets, P.X.pcAt od, P.nL (z.next ss) with
    | some s, some t, some c =>
      bif P.X.nzAt oc && P.X.entOk t f then (P.X.fwdOff i s.r).map fun o ↦ (none, [(o, c)]) else none
    | _, _, _ => none
  | .callIf c f args :: ss =>
    bif Nat.beq (P.X.locAt c.idx) oc then
      match P.X.pcAt od, P.nL (z.next ss) with
      | some t, some ca =>
        bif P.X.entOk t f then
          bif P.X.nextAt of then
            bif retNil ca.pos then some (some ca, []) else none
          else match P.X.siteAt of args [] with
            | some s => bif Nat.beq s.r (P.X.entry + i + 1) then some (some ca, []) else none
            | none => none
        else none
      | _, _ => none
    else none
  | .dispatch _ _ args rets :: ss =>
    match P.X.siteAt of args rets, P.nL (z.next ss) with
    | some s, some c =>
      bif P.X.nzAt oc && Nat.beq s.tgt od && !Nat.beq od 0 then (P.X.fwdOff i s.r).map fun o ↦ (none, [(o, c)])
      else none
    | _, _ => none
  | .ret _ :: _ =>
    bif P.X.main then
      bif P.X.nzAt oc && P.X.selfAt of && P.X.pcAt od == some P.X.halt then some (none, []) else none
    else bif P.X.nzAt oc && Nat.beq od 0 && Nat.beq of 1 then some (none, []) else none
  | _ => none

/-- **A `JUMP oc od of` at offset `i`**, the zipper `z`, `zs` the same past its reads: never taken
or a forward jump in the frame from `z`, else by the head statement of `zs`. -/
noncomputable def jumpStepH (P : PairCtx) (i oc od of : ℕ) (tabs : List (ℕ × Zip × ℕ)) (z zs : Zip) :
    Option (Option Zip × List (ℕ × Zip)) :=
  bif P.X.zeroAt oc then some (some z, []) else
  bif fwdJ P.X i oc od of then (P.X.pcAt od).bind fun t ↦ (P.X.fwdOff i t).map fun o ↦ (none, [(o, z)])
  else headStepH P i oc od of tabs zs

/-- One hint at an offset, `r` the rest: a flow hint consumes the head flow hint atom past the
reads, compiling it. -/
noncomputable def hintStepH (P : PairCtx) (r : Zip → Option Zip) (h : Prover.Exec.Hint) (z : Zip) : Option Zip :=
  bif isaFlowHint h then
    (P.nS z).bind fun z ↦ match z.cur with
      | .atom (.hint hc) :: ss => bif compiles P.X.locAt hc h then (P.nL (z.next ss)).bind r else none
      | _ => none
  else r z

/-- The flow hints at an offset consume their atoms in turn. -/
noncomputable def hintsStepH (P : PairCtx) (hs : List Prover.Exec.Hint) : Zip → Option Zip :=
  List.rec (motive := fun _ ↦ Zip → Option Zip) some (fun h _ r ↦ hintStepH P r h) hs

/-- A `load`'s cells are a `DEREF`'s. -/
noncomputable def cellsAt (X : AlignCtx) (o1 o2 o3 : ℕ) (d p : V) (off : ℕ) : Bool :=
  Nat.beq (X.locAt p.idx) o1 && Nat.beq off o2 && Nat.beq (X.locAt d.idx) o3

/-- A site's target cell is `o`; `d` of no site. -/
def siteTgt (d : Bool) (o : ℕ) : Option B2C.Site → Bool
  | some s => Nat.beq s.tgt o
  | none => d

/-- Some call site's dispatch target cell is `o3` (`Site.tgt`). -/
noncomputable def tgtIn (o3 : ℕ) (t : Trie B2C.Site) : Bool :=
  Trie.rec (motive := fun _ ↦ Bool) false (fun v _ _ al ar ↦ siteTgt false o3 v || al || ar) t

/-- No call site is a dispatch's: every target cell `0`. -/
noncomputable def tgtNone (t : Trie B2C.Site) : Bool :=
  Trie.rec (motive := fun _ ↦ Bool) true (fun v _ _ al ar ↦ siteTgt true 0 v && al && ar) t

/-- **A `DEREF o1 o2 o3` reading the jump table**: its word cell a table jump's target cell (`arms`), its
offset the table's base, its pointer cell the selector's; or its word cell a dispatch's target cell, not
`0` (its offset and pointer cell checked at its dispatch, `jtdGo`). -/
noncomputable def jtd (X : AlignCtx) (o1 o2 o3 : ℕ) : Bool :=
  match getF X.arms o3 with
  | some a => Nat.beq a.2 o2 && Nat.beq (X.locAt a.1) o1
  | none => !Nat.beq o3 0 && tgtIn o3 X.sites

/-- One step of a `DEREF`'s scan, `r` the rest: the head `load` at its cells consumed, a read before
it skipped. -/
noncomputable def scanStep (P : PairCtx) (o1 o2 o3 : ℕ) (r : Zip → Option (Zip × Bool)) (z : Zip) :
    Option (Zip × Bool) :=
  match z.cur with
  | .atom (.load d p off) :: ss =>
    bif cellsAt P.X o1 o2 o3 d p off then (P.nL (z.next ss)).map fun z' ↦ (z', isRead P.R (.load d p off))
    else bif isRead P.R (.load d p off) then (P.nL (z.next ss)).bind r else none
  | _ => none

/-- **A `DEREF`'s scan** within `f` steps: the position past the `load` it consumes, and whether
that is a read. -/
noncomputable def scan (P : PairCtx) (o1 o2 o3 : ℕ) (f : ℕ) : Zip → Option (Zip × Bool) :=
  Nat.rec (motive := fun _ ↦ Zip → Option (Zip × Bool)) (fun _ ↦ none) (fun _ r ↦ scanStep P o1 o2 o3 r) f

/-- **An instruction other than a `JUMP`** at offset `i`, from `z`: a `DEREF` of mode `cell`
consumes the `load` its scan finds, if any; the oracle agrees. -/
noncomputable def plainStep (P : PairCtx) (i : ℕ) (ins : OffsetInstruction) (z : Zip) : Option Zip :=
  match ins with
  | .deref o1 o2 o3 .cell => match scan P o1 o2 o3 P.X.fuel z with
    | some (z', b) => bif P.kindOk i (some b) then some z' else none
    | none => bif P.kindOk i none || (jtd P.X o1 o2 o3 && !hasP P.S i) then some z else none
  | _ => bif P.kindOk i none then some z else none

/-- Offset `i` reached with zipper `c`, normalized before its hints `h1`, to offset `i'` with the
hints `hs'`, the arrivals `rest` pending; with what it records. -/
noncomputable def visitH (P : PairCtx) (ins : OffsetInstruction) (i i' : ℕ) (h1 : List Prover.Exec.Hint)
    (hs' : List (ℕ × List Prover.Exec.Hint)) (rest : List (ℕ × Zip)) (tabs : List (ℕ × Zip × ℕ)) (c : Zip) :
    Option (St × Option (ℕ × Zip)) :=
  ((P.nL c).bind (hintsStepH P h1)).bind fun z ↦ match ins with
    | .jump oc od of => bif P.kindOk i none then
        (P.nS z).bind fun zs ↦ (jumpStepH P i oc od of tabs z zs).map fun r ↦
          (⟨i', hs', r.1, mergeP r.2 rest, tabReg P.X i (.jump oc od of) zs r.2 tabs⟩, some (i, c))
      else none
    | _ => (plainStep P i ins z).map fun z' ↦ (⟨i', hs', some z', rest, tabs⟩, some (i, c))

/-- **One offset of the pass**: the zipper falling in, or else the first arrival pending. -/
noncomputable def stepIH (P : PairCtx) (ins : OffsetInstruction) (st : St) : Option (St × Option (ℕ × Zip)) :=
  natSeq (Nat.succ st.i) fun i' ↦
  match spanP st.i st.pend, hintsAt (Nat.add P.X.entry st.i) st.hs with
  | (here, rest), (h1, hs') =>
    match st.cur, here with
    | some c, _ => bif allKey here c then visitH P ins st.i i' h1 hs' rest st.tabs c else none
    | none, [] => some (⟨i', hs', none, rest, st.tabs⟩, none)
    | none, p :: _ => bif allKey here p.2 then visitH P ins st.i i' h1 hs' rest st.tabs p.2 else none

/-- **The forward pass** over the instructions from the state's offset, recording each offset
reached with its zipper. -/
noncomputable def pairGo (P : PairCtx) (code : List OffsetInstruction) :
    St → List (ℕ × Zip) → Option (St × List (ℕ × Zip)) :=
  List.rec (motive := fun _ ↦ St → List (ℕ × Zip) → Option (St × List (ℕ × Zip))) (fun st acc ↦ some (st, acc))
    (fun ins _ r st acc ↦ (stepIH P ins st).bind fun p ↦ r p.1 (p.2.toList ++ acc)) code

/-- The zipper at each offset reached, from the body's start at offset `0`. -/
noncomputable def pairRun (P : PairCtx) (body : List Stmt) (code : List OffsetInstruction)
    (d : ℕ × ℕ × List (ℕ × List Prover.Exec.Hint)) : Option (List (ℕ × Zip)) :=
  (pairGo P code ⟨0, d.2.2, some (Zip.init body), [], []⟩ []).bind fun p ↦ alignEnd p.1 p.2

/-- **The pairing check** of a function: its alignment's context `X`, heap certificate `H`, its
reads' `DEREF` offsets `O` and its stores' `S`, the context evaluated first. -/
noncomputable def pairOk (X : AlignCtx) (H : HCert) (O S : Trie Unit) (body : List Stmt)
    (code : List OffsetInstruction) (d : ℕ × ℕ × List (ℕ × List Prover.Exec.Hint)) : Bool :=
  (PairCtx.ofH X H O S).seq fun P ↦ alignPre P.X d && (pairRun P body code d).isSome

/-- **The body position at offset `off`**, where the pass reaches it. -/
noncomputable def pairAt (P : PairCtx) (body : List Stmt) (code : List OffsetInstruction)
    (d : ℕ × ℕ × List (ℕ × List Prover.Exec.Hint)) (off : ℕ) : Option (List Stmt) :=
  ((pairRun P body code d).bind fun l ↦ l.lookup off).map Zip.pos

/-! ## Windows -/

/-- **A window of the pass**: from the state `Ka` over the instructions to offset `Kb.i`, the pass
reaches `Kb`. -/
noncomputable def winOkH (X : AlignCtx) (H : HCert) (O S : Trie Unit) (body : List Stmt)
    (code : List OffsetInstruction) (d : ℕ × ℕ × List (ℕ × List Prover.Exec.Hint)) (Ka Kb : KSt) : Bool :=
  (PairCtx.ofH X H O S).seq fun P ↦ decide ((pairGo P ((code.drop Ka.i).take (Kb.i - Ka.i))
    (stOfK body d.2.2 Ka) []).map (fun p ↦ keyOfSt d.2.2 p.1) = some Kb)

end

end LeanVM.Guest.CoreMode
