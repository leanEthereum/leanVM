  (List.range 17).all (fun k => kvOkB op (ccmJ.getD k 0) ("child_claim_list_mono_last__L" ++ B1.Whir.natStr k) &&
    kvSBJ op (ccmJ.getD k 0) == (kcCcmT op).getD k 0) &&
  kvOkB op lsJ "list_split" && kvSBJ op lsJ == kcLs op &&
