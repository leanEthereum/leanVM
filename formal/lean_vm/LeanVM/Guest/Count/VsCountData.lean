    kvSKJ op (ccLpJ.getD i 0) == (kcCcLpT op).getD i 0) &&
  (List.range 5).all (fun i => decide ((coreProgram[omJ.getD i 0]?).map Fn.name = some (omNames.getD i "")) &&
