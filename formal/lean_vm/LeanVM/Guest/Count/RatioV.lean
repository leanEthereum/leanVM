/-!
# Counts within a ratio of the words

For each function, `kr*J` lists the core indices of the functions its paths reach, `kr*C` their
calls by index (`krClosedAt`), and `kr*A op` the largest `B2C.pathMax g op / B2C.fs g` over them,
in thousandths, rounded up (`krRatioAt`); both decided in chunks of the indices. `kr*_weight`:
every valid tree of the function counts at most `kr*A op / 1000` of `op`'s instructions per word
it allocates.
-/

@[expose] public section

theorem krVbg_closed : (krVbgJ).all (krClosedAt krVbgJ krVbgC) = true :=
  krVbg_closed0

theorem krVbg_ratio : (krVbgJ).all (krRatioAt krVbgA) = true :=
  krVbg_ratio0

/-- **`verify_bus_gkr`'s counts within its ratios of its words.** -/
theorem krVbg_weight (op : Opcode) : ∀ (rd : Reader) (t : Tree) (args rets : List E),
    t.name = "verify_bus_gkr" → t.Valid coreProgram rd args rets → t.BufsOk coreProgram →
      1000 * t.weight (ωArm xmssArmC op) ≤ krVbgA op * t.total fs :=
  fun _ _ _ _ hn hv _ => kr_weight krVbg_closed krVbg_ratio (by decide +kernel)
    ⟨9, by decide +kernel, by decide +kernel⟩ op hn hv

