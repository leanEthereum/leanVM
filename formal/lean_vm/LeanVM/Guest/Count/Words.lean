/-
  LeanVM.Guest.Count.Words

  Generated by `scripts/count/gen.py`; do not edit.
  Every function's words at `B2C.fs` by name, read off its words certificate: `wSB f` for a constant
  one, `wSK f` per iteration for a loop helper's, with the functions' core indices by name.
-/

module

public import LeanVM.Guest.Count.Static
public import LeanVM.Guest.Memory.GuestCalleesOk

/-!
# Words by name

`wSB f` is the constant of `f`'s words certificate, `wSKt f` a loop helper's per iteration, its
run's one phantom frame apart (`wSKt_totalLeOn`), and `wSK f` with that frame charged to each
iteration (`0` otherwise). `wOkB j f` (`wOkK j f`) checks that core function `j` is `f` and its certificate is a
constant (a loop's per iteration); then `wSB_totalLe` (`wSK_totalLeOn`) bounds `f`'s words.
`wNameIdx f` is the core index of function `f`, by its name's `encS` (`wNameT`) and checked
against `Data.nameT`, and `wIdx f` the same or `0`, for the checks that range over names; a loop
helper is named by `idx%` (`Guest/CoreRef.lean`).
-/

namespace LeanVM.Guest.Count

open LeanVM.Parameters LeanVM.Semantics LeanVM.Guest.Core LeanVM.Guest.Memory LeanVM.Guest LeanVM.Guest.Data

@[expose] public section

/-- The constant of `f`'s words certificate, `0` if it has none. -/
noncomputable def wSB (f : String) : ℕ :=
  match wcertOf f with
  | .stat _ b _ => b.c
  | _ => 0

/-- The words per iteration of loop helper `f`'s certificate, its run's phantom frame apart, `0`
if it has none. -/
noncomputable def wSKt (f : String) : ℕ :=
  match wcertOf f with
  | .loop _ _ b _ => b.c
  | _ => 0

/-- The words per iteration of loop helper `f`, its run's phantom frame charged to each iteration
(`wSKt f + B2C.fs f`), `0` if it has no certificate. -/
noncomputable def wSK (f : String) : ℕ :=
  match wcertOf f with
  | .loop _ _ b _ => b.c + B2C.fs f
  | _ => 0

/-- A constant certificate. -/
def certConstB : Cert → Bool
  | .stat pre b _ => pre.isEmpty && b.cs.isEmpty
  | _ => false

/-- A loop helper's certificate ending at its argument `1`, constant per iteration. -/
def certLoopB : Cert → Bool
  | .loop endc pre b _ => endc.isNone && pre.isEmpty && b.cs.isEmpty
  | _ => false

/-- Core function `j` is `f`. -/
def wNameB (j : ℕ) (f : String) : Bool := Nat.blt j 1605 && decide (Data.nameT.find j = some f)

theorem wNameB_spec {j : ℕ} {f : String} (h : wNameB j f = true) : (coreProgram[j]?).map Fn.name = some f := by
  simp only [wNameB, Bool.and_eq_true, Nat.blt_eq, decide_eq_true_eq] at h
  exact Data.nameT_spec (by rw [coreProgram_length]; exact h.1) h.2

/-- Core function `j` is `f`, its words certificate constant. -/
noncomputable def wOkB (j : ℕ) (f : String) : Bool := wNameB j f && certConstB (wcertJ j)

/-- Core function `j` is `f`, its words certificate a loop's, constant per iteration. -/
noncomputable def wOkK (j : ℕ) (f : String) : Bool := wNameB j f && certLoopB (wcertJ j)

/-- **`f`'s words within `wSB f`.** -/
theorem wSB_totalLe {j : ℕ} {f : String} (h : wOkB j f = true) :
    TotalLe coreProgram B2C.fs f fun _ => wSB f := by
  simp only [wOkB, Bool.and_eq_true] at h
  obtain ⟨hn, hk⟩ := h
  have hc := wcertOf_of_idx (wNameB_spec hn)
  rcases hw : wcertJ j with _ | ⟨pre, ⟨B, cs⟩, ks⟩ | _
  · rw [hw] at hk; cases hk
  · rw [hw] at hk
    simp only [certConstB, Bool.and_eq_true, List.isEmpty_iff] at hk
    obtain ⟨rfl, rfl⟩ := hk
    have hf : wcertOf f = .stat [] ⟨B, []⟩ ks := hc.trans hw
    have hB : wSB f = B := by unfold wSB; rw [hf]
    rw [hB]
    exact fs_totalLe hf
  · rw [hw] at hk; cases hk

/-- **Loop helper `f`'s run within `wSKt f` words per iteration and its phantom frame.** -/
theorem wSKt_loopRunLe {j : ℕ} {f : String} (h : wOkK j f = true) : LoopRunLe B2C.fs f (wSKt f) := by
  simp only [wOkK, Bool.and_eq_true] at h
  obtain ⟨hn, hk⟩ := h
  have hc := wcertOf_of_idx (wNameB_spec hn)
  rcases hw : wcertJ j with _ | _ | ⟨endc, pre, ⟨K, cs⟩, ks⟩
  · rw [hw] at hk; cases hk
  · rw [hw] at hk; cases hk
  · rw [hw] at hk
    simp only [certLoopB, Bool.and_eq_true, List.isEmpty_iff, Option.isNone_iff_eq_none] at hk
    obtain ⟨⟨rfl, rfl⟩, rfl⟩ := hk
    have hf : wcertOf f = .loop none [] ⟨K, []⟩ ks := hc.trans hw
    have hK : wSKt f = K := by unfold wSKt; rw [hf]
    rw [hK]
    exact kw_loopRunLe_of hf

/-- **Loop helper `f`'s run from a start below its end**: `wSKt f` per unit of the end's exponent,
and its phantom frame. -/
theorem wSKt_totalLeOn {j : ℕ} {f : String} (h : wOkK j f = true) :
    TotalLeOn coreProgram B2C.fs f LoopPre fun a => logG (a.getD 1 0) * wSKt f + B2C.fs f :=
  (wSKt_loopRunLe h).totalLeOn

/-- `wSKt` is `wSK` without the phantom frame. -/
theorem wSKt_eq (f : String) : wSKt f = wSK f - B2C.fs f := by
  unfold wSK wSKt
  split <;> simp

/-- **Loop helper `f`'s words within `wSK f` per iteration**, its run's phantom charged to each. -/
theorem wSK_loopTotalLe {j : ℕ} {f : String} (h : wOkK j f = true) : LoopTotalLe B2C.fs f (wSK f) := by
  simp only [wOkK, Bool.and_eq_true] at h
  obtain ⟨hn, hk⟩ := h
  have hc := wcertOf_of_idx (wNameB_spec hn)
  rcases hw : wcertJ j with _ | _ | ⟨endc, pre, ⟨K, cs⟩, ks⟩
  · rw [hw] at hk; cases hk
  · rw [hw] at hk; cases hk
  · rw [hw] at hk
    simp only [certLoopB, Bool.and_eq_true, List.isEmpty_iff, Option.isNone_iff_eq_none] at hk
    obtain ⟨⟨rfl, rfl⟩, rfl⟩ := hk
    have hf : wcertOf f = .loop none [] ⟨K, []⟩ ks := hc.trans hw
    have hK : wSK f = K + B2C.fs f := by unfold wSK; rw [hf]
    rw [hK]
    exact kw_loopTotalLe_of hf

/-- **Loop helper `f`'s words from a start below its end**: `wSK f` per unit of the end's
exponent. -/
theorem wSK_totalLeOn {j : ℕ} {f : String} (h : wOkK j f = true) :
    TotalLeOn coreProgram B2C.fs f LoopPre fun a => logG (a.getD 1 0) * wSK f :=
  (wSK_loopTotalLe h).totalLeOn

theorem all_range_get {p : ℕ → Bool} {n : ℕ} (h : (List.range n).all p = true) {k : ℕ} (hk : k < n) :
    p k = true :=
  List.all_eq_true.mp h k (List.mem_range.mpr hk)

/-- `B2C.fs` by core index. -/
theorem fs_idx {j : ℕ} {f : String} (h : (coreProgram[j]?).map Fn.name = some f) :
    B2C.fs f = wfsJ j := by
  rcases hj : coreProgram[j]? with _ | fn
  · rw [hj] at h; cases h
  · rw [hj] at h
    obtain ⟨hlt, hfn⟩ := List.getElem?_eq_some_iff.mp hj
    simp only [Option.map_some, Option.some.injEq] at h
    rw [← h, ← hfn]
    exact wfs_eq hlt

/-- `wSB` of core function `j`. -/
noncomputable def wSBJ (j : ℕ) : ℕ :=
  match wcertJ j with
  | .stat _ b _ => b.c
  | _ => 0

/-- `wSKt` of core function `j`. -/
noncomputable def wSKtJ (j : ℕ) : ℕ :=
  match wcertJ j with
  | .loop _ _ b _ => b.c
  | _ => 0

/-- `wSK` of core function `j`. -/
noncomputable def wSKJ (j : ℕ) : ℕ :=
  match wcertJ j with
  | .loop _ _ b _ => b.c + wfsJ j
  | _ => 0

/-- `wSB` by core index. -/
theorem wSB_idx {j : ℕ} {f : String} (h : (coreProgram[j]?).map Fn.name = some f) : wSB f = wSBJ j := by
  unfold wSB wSBJ; rw [wcertOf_of_idx h]

/-- `wSK` by core index. -/
theorem wSK_idx {j : ℕ} {f : String} (h : (coreProgram[j]?).map Fn.name = some f) : wSK f = wSKJ j := by
  unfold wSK wSKJ; rw [wcertOf_of_idx h, fs_idx h]

/-- `wSKt` by core index. -/
theorem wSKt_idx {j : ℕ} {f : String} (h : (coreProgram[j]?).map Fn.name = some f) : wSKt f = wSKtJ j := by
  unfold wSKt wSKtJ; rw [wcertOf_of_idx h]


