@[expose] public section

/-- The entry of a name, if the tree has it under its key. -/
def wNameIdx (f : String) : Option ℕ :=
  match wNameTree.find (nameKey f) with
  | some q => if f = q.1 then some q.2 else none
  | none => none

/-- The tree's entries name their functions. -/
theorem wNameTree_ok : wNameTree.all wNameOk = true := by
  unfold wNameTree
  simp only [NTree.all, Bool.and_eq_true, wNameTlll_ok, wNameTllr_ok, wNameTlrl_ok, wNameTlrr_ok, wNameTrll_ok, wNameTrlr_ok, wNameTrrl_ok, wNameTrrr_ok]
  decide +kernel

theorem wNameIdx_spec {f : String} {j : ℕ} (h : wNameIdx f = some j) :
    (coreProgram[j]?).map Fn.name = some f := by
  unfold wNameIdx at h
  rcases hf : wNameTree.find (nameKey f) with _ | q
  · rw [hf] at h; cases h
  · rw [hf] at h
    dsimp only at h
    split at h
    · rename_i hq
      cases h
      have := NTree.find_all wNameTree_ok hf
      simp only [wNameOk, decide_eq_true_eq] at this
      rw [hq]; exact this
    · cases h

/-- `B2C.fs`, by the tree where it has the name. -/
noncomputable def fsFast (f : String) : ℕ :=
  match wNameIdx f with
  | some j => womegaJ j
  | none => B2C.fs f

/-- `wSB`, by the tree where it has the name. -/
noncomputable def wSBFast (f : String) : ℕ :=
  match wNameIdx f with
  | some j => wSBJ j
  | none => wSB f

/-- `wSK`, by the tree where it has the name. -/
noncomputable def wSKFast (f : String) : ℕ :=
  match wNameIdx f with
  | some j => wSKJ j
  | none => wSK f

theorem fsFast_eq : fsFast = B2C.fs := by
  funext f
  unfold fsFast
  rcases h : wNameIdx f with _ | j
  · rfl
  · have hs := wNameIdx_spec h
    rcases hj : coreProgram[j]? with _ | fn
    · rw [hj] at hs; cases hs
    · obtain ⟨hlt, -⟩ := List.getElem?_eq_some_iff.mp hj
      dsimp only
      rw [fs_idx hs, womegaJ_eq' hlt]

theorem wSBFast_eq : wSBFast = wSB := by
  funext f
  unfold wSBFast
  rcases h : wNameIdx f with _ | j
  · rfl
  · dsimp only; rw [wSB_idx (wNameIdx_spec h)]

theorem wSKFast_eq : wSKFast = wSK := by
  funext f
  unfold wSKFast
  rcases h : wNameIdx f with _ | j
  · rfl
  · dsimp only; rw [wSK_idx (wNameIdx_spec h)]

