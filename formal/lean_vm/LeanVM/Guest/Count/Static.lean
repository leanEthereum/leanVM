/-- **`aggregate_claims`' instructions** on `g^n`. -/
theorem kcAgg_le (op : Opcode) : ∀ (rd : Reader) (t : Tree) (args rets : List E) (n : ℕ),
    t.name = "aggregate_claims" → t.Valid coreProgram rd args rets → t.BufsOk coreProgram →
      args.getD 0 0 = ofK (gpow n) → 0 < n → n < 2 ^ 64 - 1 →
        t.weight (kcOm op) ≤ kcAggC op + kcAggD op * n := by
  intro rd t args rets n hn hv hb ha h0 h1
  have hpre : ArgsPre [(0, 0)] args := by
    intro q hq
    simp only [List.mem_singleton] at hq
    subst hq
    exact ⟨n, h0, h1, ha⟩
  have hx : argExp args 0 = n := by rw [argExp, ha, logG_ofK h1]
  cases op
  · have := kwx_weight_le_of_stat (by rw [kwxcertOf_of_idx (j := 29) (by decide +kernel)]; rfl : kwxcertOf "aggregate_claims" = .stat [(0, 0)] ⟨568, [(0, 323), (0, 7), (0, 91), (0, 10), (0, 282)]⟩ [(.n 34, 0), (.n 49, 0), (.n 68, 0), (.n 83, 0), (.n 514, 0)]) hn hv hb hpre
    simp only [Aff.eval, List.map_cons, List.map_nil, List.sum_cons, List.sum_nil, hx] at this
    simp only [kcAggC, kcAggD]; omega
  · have := kwm_weight_le_of_stat (by rw [kwmcertOf_of_idx (j := 29) (by decide +kernel)]; rfl : kwmcertOf "aggregate_claims" = .stat [(0, 0)] ⟨576, [(0, 189), (0, 23), (0, 61), (0, 26), (0, 390)]⟩ [(.n 34, 0), (.n 49, 0), (.n 68, 0), (.n 83, 0), (.n 514, 0)]) hn hv hb hpre
    simp only [Aff.eval, List.map_cons, List.map_nil, List.sum_cons, List.sum_nil, hx] at this
    simp only [kcAggC, kcAggD]; omega
  · have := kws_weight_le_of_stat (by rw [kwscertOf_of_idx (j := 29) (by decide +kernel)]; rfl : kwscertOf "aggregate_claims" = .stat [(0, 0)] ⟨35, [(0, 10), (0, 11), (0, 4), (0, 11), (0, 69)]⟩ [(.n 34, 0), (.n 49, 0), (.n 68, 0), (.n 83, 0), (.n 514, 0)]) hn hv hb hpre
