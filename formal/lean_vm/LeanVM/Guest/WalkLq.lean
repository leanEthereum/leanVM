/-
  LeanVM.Guest.WalkLq

  `level_queries`' cut obligations (`CutsKnown`): at its call of `opening_queries`, the callee's
  walk preconditions, from its own precondition on its window pointers (`lqTag`).
-/

module

public import LeanVM.Guest.WalkKnown

/-!
# `level_queries`' walk obligations

`open_stacked` dispatches on the rate into `level_queries__L{q}_L{base}_…_L{d}_L{cd}_…`,
which hands its window pointers `win_ptrs` (cell `7`), `n_iters_g = g^n` and `odd_g = g^odd` to
`opening_queries` (`lean_ethereum.py`, `level_queries`), whose specializations are keyed by the
path depth `pd = d - cd`. Its precondition is its windows' tag `lqTag n odd base d cd` on
`win_ptrs`, `OqMainWins` at `g^n` (`semRel_lq`), which `open_stacked` hands it at that rate's arm
(`Check.selTag`). The cut before the call asks the callee's tuples, each conditional on one of the
constants its setup sets (`impTag`): its walk for `odd` (`WinWalkP` from `1` deeper, `OqStartP`
at level 0) on `n_iters_g = g^n`; at level 0 `OqStartP` for the other `odd` on `odd_g = g^odd`,
vacuous but for its first pointer's windows, and `odd_g ∈ {1, g}` on the same. `lqOk`
(`WalkKnownDefs`) checks the certificate has those forms, on fixed cells, so `lq_cutsKnown` needs
no template. The instances are `WalkLq0.lean` to `WalkLq3.lean`, generated by
`scripts/whir-queries/genwalklqos.py`.
-/

namespace LeanVM.Guest.End

open LeanVM.Parameters LeanVM.Semantics LeanVM.Guest LeanVM.Guest.Core LeanVM.Guest.Check
open LeanVM.Guest.B1

@[expose] public section

/-- A conditional tag on the immediate `l` at position `1`: the relation holds if the second
word is `l`'s. -/
theorem semRel_impL {t : ℕ} (ht : t < 2 ^ 32) (l : ℕ) (rd : Reader) (ws : List E) :
    SemRel glob (impTag t 1 l) rd ws ↔
      (ws.getD 1 0 = OffsetInstruction.immediateWord l 0 → SemRel0 glob t rd ws) :=
  semRel_impK ht (by decide) l rd ws

/-- The immediate of the word `g^e`. -/
theorem imm_gpow {l e : ℕ} (h : K.ofBits l = gpowK e) (he : e < 992) :
    OffsetInstruction.immediateWord l 0 = Protocol.Verifier.gen ^ e := by
  rw [Exec.imm_of_ofBits h, gpowK_eq (lt_trans he (by unfold u128Bound; norm_num)),
    ← Value.gen_pow_eq_ofK]

/-- **`level_queries`' cut obligations**, from its certificate's check: its precondition's
windows are the call's tuples. -/
theorem lq_cutsKnown {j n odd base d cd : ℕ} (ho : odd < 2) (hb : base < 2) (hc : cd < 64)
    (hd : d < 64) (hn : n < 992) (hok : lqOk (certOf j) n odd base d cd = true) : CutsKnown j := by
  intro κ L _ _ fp _ hsem' i hi h0 _
  simp only [lqOk, Bool.and_eq_true, beq_iff_eq, List.all_eq_true] at hok
  obtain ⟨⟨hs, hq⟩, hcuts⟩ := hok
  rw [hs] at hsem'
  have hW := (semRel_lq ho hb hc hd hn _ _).mp (hsem' _ (List.mem_singleton_self _))
  simp only [List.map_cons, List.map_nil, List.getD_cons_zero] at hW
  have hpd : d - cd < 64 := by omega
  have hcut := hcuts _ (cutAt_mem hi h0)
  simp only [lqCutOk, Bool.and_eq_true, Bool.or_eq_true, List.isEmpty_iff, List.all_eq_true] at hcut
  obtain ⟨⟨hkn, hki⟩, hsm⟩ := hcut
  refine ⟨by rw [hkn]; intro _ h; simp at h, by rw [hki]; intro _ h; simp at h, fun t ht ↦ ?_⟩
  have hlt (k o : ℕ) (hk : k < 4) (ho' : o < 2) : oqTag k o (d - cd) < 2 ^ 32 := by
    have := oqTag_lt hk ho' hpd; omega
  -- the first pointer's windows at level 0, whatever `n_iters_g`
  have hfirst (hb1 : base = 1) : ∀ w, LoadHolds L.read (wd L fp 7) 0 w → WinsP L.read (d - cd) w := by
    subst hb1
    simp only [beq_iff_eq, Bool.or_eq_true, Nat.ble_eq, ↓reduceIte] at hq
    exact (oqStartP_of_mainWins (u := 0) hW (by omega) (by omega) ho).1
  rcases hsm t ht with ((⟨⟨⟨ht1, hl0⟩, hlen⟩, h7⟩ | ⟨⟨⟨⟨hb1, ht1⟩, hl0⟩, hlen⟩, h7⟩) | ⟨⟨⟨hb1, ht1⟩, hl0⟩, hlen⟩)
  · simp only [beq_iff_eq, decide_eq_true_eq] at ht1 hl0 hlen h7
    rw [ht1, semRel_impL (hlt _ _ (by omega) ho), semRel0_oq (by omega) ho hpd]
    intro hx
    rw [getD_map_lt (by split at hlen <;> omega), imm_gpow hl0 hn] at hx
    obtain rfl | rfl : base = 0 ∨ base = 1 := by omega
    · simp only [show ¬ (0 : ℕ) = 1 from by decide, ↓reduceIte, beq_iff_eq] at hq hlen
      subst hq
      rw [walkSem_oq2, getD_map_lt (by omega), getD_map_lt (by omega), h7, hx]
      exact winWalkP_of_mainWins hW
    · simp only [↓reduceIte, beq_iff_eq, Bool.or_eq_true, Nat.ble_eq] at hq hlen
      rw [walkSem_oq3 ho, getD_map_lt (by omega), getD_map_lt (by omega), h7, hx]
      exact oqStartP_of_mainWins hW (by omega) (by omega) ho
  · simp only [beq_iff_eq, decide_eq_true_eq] at hb1 ht1 hl0 hlen h7
    rw [ht1, semRel_impK (hlt _ _ (by decide) (by omega)) (by decide), semRel0_oq (by decide) (by omega) hpd,
      walkSem_oq3 (by omega)]
    intro hx
    rw [getD_map_lt (by omega), imm_gpow hl0 (by omega)] at hx
    refine ⟨?_, fun hu ↦ ?_⟩
    · rw [getD_map_lt (by omega), h7]
      exact hfirst hb1
    · rw [getD_map_lt (by omega)] at hu
      have := Value.gen_pow_inj (by omega) (by omega) (hx.symm.trans hu)
      omega
  · simp only [beq_iff_eq, decide_eq_true_eq] at hb1 ht1 hl0 hlen
    rw [ht1, semRel_impK (by decide) (by decide), semRel0_odd]
    intro hx
    rw [getD_map_lt (by omega)] at hx ⊢
    rw [imm_gpow hl0 (by omega)] at hx
    rw [hx]
    obtain rfl | rfl : odd = 0 ∨ odd = 1 := by omega
    · exact Or.inl (pow_zero _)
    · exact Or.inr (pow_one _)

end
end LeanVM.Guest.End
