module

public import LeanVM.Guest.ExecDecodable
public import LeanVM.Guest.Mode.HintsData
public import LeanVM.Guest.Data.Pows

/-!
# What each certificate contributes

The mode walk's certificates are assembled pack by pack (`Pack/*/ModeCert.lean`, generated by
`scripts/mode-cert/gen.py`) into `ModeCerts` (`Mode/Certs.lean`). Each certificate contributes facts
of its own: `CertSt`, decided by the kernel or by `rfl` (its length, its program, a loop's tail
call and runs, its termination facts' cells); `CertWalk`, its walk and its hints the advice's (from
its pack's checks, or a hypothesis, `WalkHyp`, `HintsHyp`); `FnLink`, its code a function of the
guest's table; `SigsIn`, each callee signature its environment holds a certificate's. `Trie.entries`
lists a trie's entries, so that the signatures an environment holds are a list (`mem_entries`), and
`nodupB` decides that a list of entries has no duplicate, as a bit set.
-/

namespace LeanVM.Guest.Exec.Trie

@[expose] public section

variable {α : Type}

/-- A trie's entries with their keys: key `0` at the root, `2m+1` at key `m` of the left child,
`2m+2` at the right one's. -/
def entries : Trie α → List (ℕ × α)
  | nil => []
  | node v l r => (v.map fun a ↦ (0, a)).toList ++ (l.entries.map fun p ↦ (2 * p.1 + 1, p.2)) ++
      (r.entries.map fun p ↦ (2 * p.1 + 2, p.2))

theorem mem_entries : ∀ {t : Trie α} {n : ℕ} {a : α}, t.get n = some a → (n, a) ∈ t.entries
  | nil, n, a, h => by rw [get_eq_getC] at h; cases h
  | node v l r, n, a, h => by
    rw [get_eq_getC] at h
    simp only [getC] at h
    simp only [entries, List.mem_append, List.mem_map]
    by_cases h0 : n = 0
    · subst h0
      simp only [BEq.rfl, Bool.cond_true] at h
      subst h
      exact Or.inl (Or.inl (by simp))
    · have hb : (n == 0) = false := by simpa using h0
      rw [hb, Bool.cond_false] at h
      by_cases h1 : n % 2 = 1
      · rw [show (n % 2 == 1) = true by simpa using h1, Bool.cond_true, ← get_eq_getC] at h
        exact Or.inl (Or.inr ⟨(n / 2, a), mem_entries h, by simp only [Prod.mk.injEq, and_true]; omega⟩)
      · rw [show (n % 2 == 1) = false by simpa using h1, Bool.cond_false, ← get_eq_getC] at h
        exact Or.inr ⟨(n / 2 - 1, a), mem_entries h, by simp only [Prod.mk.injEq, and_true]; omega⟩

end

end LeanVM.Guest.Exec.Trie

namespace LeanVM.Guest.Mode

open LeanVM.Guest LeanVM.Guest.Exec

@[expose] public section

/-! ## Per certificate -/

/-- A signature guarantees nothing at return (`RetEmpty`). -/
def retEmptyB (G : Sig) : Bool :=
  G.ret.isEmpty && G.post.isEmpty && G.postR.isEmpty && G.postP.isEmpty && G.retV.isEmpty

/-- A tail call into the function itself guarantees nothing at return. -/
noncomputable def tailRetB (K : Cert) : Bool :=
  match K.E.sigs.get K.F.entry with
  | some G => retEmptyB G
  | none => true

/-- Each run a loop guarantees is over its termination fact's range. -/
def loopRngB (G : Sig) : Bool :=
  (G.postL ++ G.postLP.map (·.1)).all fun r ↦ decide ((r.lo, r.hi) ∈ G.term)

/-- The jump table's end: `__jump_tables`' slots, from `main`'s `430` cells on. -/
abbrev jtEnd : ℕ := 430 + Data.f0.instructionCount

/-- The certificate's facts the kernel decides: its length, a code, an entry past `__jump_tables`'s, the guest's jump table and
halting pc, a loop's tail call and runs, its termination facts' cells. -/
noncomputable def staticB (K : Cert) : Bool :=
  K.F.len == K.code.length && 0 < K.code.length && 0 < K.F.entry && K.E.jtLo == 430 && K.E.jtHi == jtEnd &&
    K.E.halt == 524287 && tailRetB K && loopRngB K.F.sig && termFr K.F.sig

/-- **A certificate's static facts**: `staticB`, and the guest's powers and jump table. -/
structure CertSt (K : Cert) : Prop where
  b : staticB K = true
  pows : K.E.pows = Data.powTree
  jt : K.E.jt = Data.jtTrie

/-- A certificate's walk accepts its code. -/
abbrev WalkHyp (K : Cert) : Prop := walk K.E K.F K.code = true

/-- A certificate's hints are the advice's. -/
abbrev HintsHyp (K : Cert) : Prop := HintsOk K.F Data.adviceHints

/-- **A certificate's walk and hints.** -/
def CertWalk (K : Cert) : Prop := WalkHyp K ∧ HintsHyp K

/-- **A certificate's code is a guest function's**, its operands small. -/
def FnLink (K : Cert) : Prop :=
  (∃ f ∈ Data.functions, K.code = f.code ∧ K.F.entry = f.entryPc) ∧ K.code.all offSmall = true

/-- A callee's signature at entry `p.1` is `p.2`, a certificate's among `Ks`, not `main`'s. -/
def SigIn (Ks : List Cert) (p : ℕ × Sig) : Prop :=
  ∃ K' ∈ Ks, K'.F.entry = p.1 ∧ K'.F.sig = p.2 ∧ K'.F.main = false

/-- Every callee signature of `K`'s environment is a certificate's among `Ks`. -/
def SigsIn (Ks : List Cert) (K : Cert) : Prop := ∀ p ∈ K.E.sigs.entries, SigIn Ks p

theorem sigsIn_of {Ks : List Cert} {K : Cert} {l : List (ℕ × Sig)} (h : K.E.sigs.entries = l)
    (h' : ∀ p ∈ l, SigIn Ks p) : SigsIn Ks K := by
  unfold SigsIn; rw [h]; exact h'

/-- A list's facts, element by element. -/
theorem fa_cons {α : Type} {P : α → Prop} {a : α} {l : List α} (h : P a) (t : ∀ x ∈ l, P x) :
    ∀ x ∈ a :: l, P x :=
  List.forall_mem_cons.2 ⟨h, t⟩

theorem fa_nil {α : Type} {P : α → Prop} : ∀ x ∈ ([] : List α), P x := fun _ h ↦ absurd h List.not_mem_nil

/-- The facts of the lists' elements, list by list. -/
theorem fa_flatten {α : Type} {P : α → Prop} {ls : List (List α)} (h : ∀ l ∈ ls, ∀ x ∈ l, P x) :
    ∀ x ∈ ls.flatten, P x := fun x hx ↦ by
  obtain ⟨l, hl, hx⟩ := List.mem_flatten.1 hx
  exact h l hl x hx

theorem mem_flatten_of {α : Type} {ls : List (List α)} {l : List α} {x : α} (hl : l ∈ ls) (hx : x ∈ l) :
    x ∈ ls.flatten :=
  List.mem_flatten.2 ⟨l, hl, hx⟩

/-- **A function's code from the table**: function `j` is `c`, and the certificate's code and entry
are its. -/
theorem fnLink_of {K : Cert} {c f : CompiledFunction} (hf : f ∈ Data.functions) (hc : f = c)
    (hcode : K.code = c.code) (hentry : K.F.entry = c.entryPc) : FnLink K := by
  subst hc
  refine ⟨⟨f, hf, hcode, hentry⟩, ?_⟩
  have := List.all_eq_true.1 functions_offSmall f hf
  rw [hcode, CompiledFunction.code, List.all_eq_true]
  intro x hx
  obtain ⟨l, hl, hx⟩ := List.mem_flatten.1 hx
  exact List.all_eq_true.1 (List.all_eq_true.1 this l hl) x hx

/-! ## No duplicate entry -/

/-- No element of the list twice, nor in the bit set `s`. -/
def nodupB : List ℕ → ℕ → Bool
  | [], _ => true
  | a :: l, s => !s.testBit a && nodupB l (s ||| 2 ^ a)

theorem nodupB_sound : ∀ {l : List ℕ} {s : ℕ}, nodupB l s = true → l.Nodup ∧ ∀ a ∈ l, s.testBit a = false
  | [], _, _ => ⟨List.nodup_nil, fun _ h ↦ absurd h List.not_mem_nil⟩
  | a :: l, s, h => by
    simp only [nodupB, Bool.and_eq_true, Bool.not_eq_true'] at h
    obtain ⟨ha, ih⟩ := nodupB_sound h.2
    have hb : ∀ b ∈ l, b ≠ a ∧ s.testBit b = false := fun b hb ↦ by
      have := ih b hb
      rw [Nat.testBit_or, Bool.or_eq_false_iff] at this
      refine ⟨fun e ↦ ?_, this.1⟩
      subst e
      rw [Nat.testBit_two_pow_self] at this
      exact absurd this.2 (by decide)
    refine ⟨List.nodup_cons.2 ⟨fun hm ↦ (hb a hm).1 rfl, ha⟩, fun b hb' ↦ ?_⟩
    rcases List.mem_cons.1 hb' with rfl | hb'
    · exact h.1
    · exact (hb b hb').2

/-- **Entries tell certificates apart** when no entry repeats. -/
theorem uniq_of_nodupB {Ks : List Cert} (h : nodupB (Ks.map (·.F.entry)) 0 = true) :
    ∀ K ∈ Ks, ∀ K' ∈ Ks, K.F.entry = K'.F.entry → K = K' :=
  fun _ hK _ hK' he ↦ List.inj_on_of_nodup_map (nodupB_sound h).1 hK hK' he

/-! ## `main` -/

/-- An instruction is a return, `JUMP` to the header's return cell. -/
def isRet : OffsetInstruction → Bool
  | .jump _ 0 1 => true
  | _ => false

theorem not_ret_of {code : List OffsetInstruction} (h : code.all (fun ins ↦ !isRet ins) = true) :
    ∀ (i c : ℕ), code[i]? ≠ some (OffsetInstruction.jump c 0 1) := fun i c hi ↦ by
  have := List.all_eq_true.1 h _ (List.mem_of_getElem? hi)
  simp [isRet] at this

/-- The jump table's targets are below `2^62`. -/
theorem jt_lt_of {t : Trie ℕ} (h : t.entries.all (fun p ↦ decide (p.2 < 2 ^ 62)) = true) :
    ∀ d e, t.get d = some e → e < 2 ^ 62 := fun _ _ he ↦ by
  simpa using List.all_eq_true.1 h _ (Trie.mem_entries he)

end

end LeanVM.Guest.Mode
