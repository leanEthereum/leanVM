/-
  LeanVM.Guest.B1.Place.FreeLq

  The arms' `level_queries` callees are entries of `lqTable`, by their names' numbers. Generated by `scripts/arm-masks`; do not edit.
-/

module

public import LeanVM.Guest.B1.Place.FreeMaskData
public import LeanVM.Guest.B1.Place.ArmMuteDef
public import LeanVM.Guest.B1.Whir.TableKeys

namespace LeanVM.Guest.B1.Arm

open LeanVM.Guest.Core LeanVM.Guest.Memory

@[expose] public section

/-- Each callee is named by its numbers, which are an entry's of `lqTable` (numbers compared,
one name built and compared per callee). -/
theorem armLqKeys_ok : ∀ x ∈ armLqKeys, Data.nameT.find x.1 = some (Whir.keyStr "level_queries__L" x.2) ∧
    x.2 ∈ Whir.lqTable.map (Whir.lqKey ·.2) := by
  decide +kernel

theorem armLqNeed_ok : ∀ k ∈ armLqNeed, (Data.nameT.find k).all lqNameB = true := by
  intro k hk
  obtain ⟨x, hx, rfl⟩ := List.mem_map.mp hk
  obtain ⟨h1, h2⟩ := armLqKeys_ok x hx
  obtain ⟨e, he, hk2⟩ := List.mem_map.mp h2
  simp only [h1, Option.all_some, lqNameB, List.any_eq_true, beq_iff_eq]
  exact ⟨e, he, by rw [Whir.lq_names e he]; exact congrArg _ hk2⟩

end
end LeanVM.Guest.B1.Arm
