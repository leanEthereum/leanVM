/-
  LeanVM.Guest.B1.Whir.OsPureInst

  The trees' sizes of `open_stacked`'s pure callees, at every frame size: `osPureSizes`.
-/

module

public import LeanVM.Guest.B1.Whir.OsPure
public import LeanVM.Guest.B1.Whir.OsInstAllB

/-!
# The pure callees' sizes, proved (TRIAGE #36)

`osPureSizes fs : OsPureSizes fs` for every `fs`, from the guest's checked static certificates
(`coreProgram_checked`): `verify_merkle_cap__L{4..8}` by `os_capLoop_tot` (its frame and words,
`(B - 29) / 69` of its loop helper's), each residual loop by `os_selfLoop_tot` (its trip count times
its frame and words). `open_stacked_completeAtB'`: `open_stacked_completeAtB` without them.
-/

namespace LeanVM.Guest.B1

open LeanVM.Parameters LeanVM.Semantics LeanVM.Guest.Core LeanVM.Guest.Value LeanVM.Guest.Memory
open LeanVM.Protocol.Verifier LeanVM.Guest.B1.VerifySub

@[expose] public section

/-- The caps' bounds. -/
def osCapBds (fs : String → ℕ) : List (String × ℕ) :=
  [("verify_merkle_cap__L4", fs "verify_merkle_cap__L4" + wordsVal fs (0, ["__loop454"]) + (512 - 29) / 69 * (fs "__loop454" + wordsVal fs (0, ["__loop454"]))),
    ("verify_merkle_cap__L5", fs "verify_merkle_cap__L5" + wordsVal fs (0, ["__loop433"]) + (1064 - 29) / 69 * (fs "__loop433" + wordsVal fs (0, ["__loop433"]))),
    ("verify_merkle_cap__L6", fs "verify_merkle_cap__L6" + wordsVal fs (0, ["__loop431"]) + (2168 - 29) / 69 * (fs "__loop431" + wordsVal fs (0, ["__loop431"]))),
    ("verify_merkle_cap__L7", fs "verify_merkle_cap__L7" + wordsVal fs (0, ["__loop456"]) + (4376 - 29) / 69 * (fs "__loop456" + wordsVal fs (0, ["__loop456"]))),
    ("verify_merkle_cap__L8", fs "verify_merkle_cap__L8" + wordsVal fs (0, ["__loop429"]) + (8792 - 29) / 69 * (fs "__loop429" + wordsVal fs (0, ["__loop429"])))]

