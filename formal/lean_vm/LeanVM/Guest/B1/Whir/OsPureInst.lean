  · exact fun rd t a r hn hv hb => (os_capLoop_tot fs (j := 579) (jl := 972) (f := "verify_merkle_cap__L8") (g := "__loop429")
      (w := (0, ["__loop429"])) (wl := (0, ["__loop429"])) (B := 8792) (cf := 29) (cl := 69)
