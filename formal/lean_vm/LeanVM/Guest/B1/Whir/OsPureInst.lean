/-- **The pure callees' sizes**, at every frame size. -/
noncomputable def osPureSizes (fs : String → ℕ) : OsPureSizes fs where
  capB := osPairsMax (osCapBds fs)
  cap := osPureSizes_cap fs
  resB := osPairsMax (osResBds fs)
  res := osPureSizes_res fs

/-- **`open_stacked` is complete, placed, at every candidate, by trees of at most `osBop` words**, its
pure callees' sizes proved. -/
theorem open_stacked_completeAtB' (fs : String → ℕ) (cert : String → V → ℕ) (k : ℕ) (h1 : OsCalleesAtB fs cert k)
    (hm : OsCalleesMax h1) (hq : OsOqFits fs cert) :
    CompleteOpenAtB fs cert k CapAgrees (osBop fs hm (osPureSizes fs)) :=
  open_stacked_completeAtB fs cert k h1 hm hq (osPureSizes fs)

