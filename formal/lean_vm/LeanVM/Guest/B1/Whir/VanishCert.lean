/-- Layer `k` in `K`. -/
def layerK (k : ℕ) : List K := (layersLit.getD k []).map K.ofBits

/-- The roots in `K`. -/
def rootK : List K := rootsLit.map K.ofBits

/-- The inverses in `K`. -/
def invK : List K := invsLit.map K.ofBits

/-- Inverse `t` times root `t` is one. -/
def invOk (t : ℕ) : Bool := invK.getD t 0 * rootK.getD t 0 == 1

/-- The last root before layer `k` (`1` before the first). -/
def lastOf (k : ℕ) : K := if k = 0 then 1 else rootK.getD (k - 1) 0

/-- Step `k`: layer `k` squared and shifted by the last root is root `k`, then layer `k + 1`. -/
def stepOk (k : ℕ) : Bool :=
  (layerK k).map (fun v ↦ v * v + lastOf k * v) == rootK.getD k 0 :: layerK (k + 1)

theorem layerK_zero : layerK 0 = (List.range 26).map fun i ↦ K.ofBits (2 ^ (i + 1)) := by
  decide +kernel

theorem rootK_length : rootK.length = 26 := by decide +kernel

