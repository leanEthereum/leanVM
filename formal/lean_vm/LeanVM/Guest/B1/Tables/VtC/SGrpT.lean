    ∀ s ∈ (vtPre.drop (vtGrpA k)).take (vtGrpL k), VSH (coreProgram.Rel rd) rd σv s := by
  interval_cases k
  · exact vtc_grp0 hl hkx hrk hsq hkey hsz
