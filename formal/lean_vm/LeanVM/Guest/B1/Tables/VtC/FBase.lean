/-
  LeanVM.Guest.B1.Tables.VtC.FBase

  `verify_tables`' table evaluations, forms and air terms (statements `2685 ..< 5524`) as facts
  of a valuation: the soundness proof's reading by position, restricted to that window.
-/

module

public import LeanVM.Guest.B1.Tables.VtC.Hon
public import LeanVM.Guest.CoreData

/-!
# The window `2685 ..< 5524`

`VtF rd σ`: every block of statements read inside the window holds. It is what the soundness
proof's forms, evaluations and air terms read of `VtH` (`VtF.slice`, `VtF.atom` take the same
arguments, the window's bounds checked by `decide`), so their twins (`VtC/FForms*`, `FAir`,
`FEvals`, generated by `scripts/b1c-vt/gentwins.py`) hold of any valuation satisfying the window,
in particular of the honest one (`vtF_of_vsh`).
-/

namespace LeanVM.Guest.B1.Tables

open LeanVM.Parameters LeanVM.Semantics LeanVM.Guest.Core LeanVM.Guest.Value

@[expose] public section

/-- The window's first statement. -/
abbrev vtFLo : ℕ := 2685

/-- The window's end: the final check (`assert air_acc == claim`). -/
abbrev vtFHi : ℕ := 5524

/-- **Every block read inside the window holds.** -/
def VtF (rd : Reader) (σ : Val) : Prop :=
  ∀ (n : ℕ) (blk : List Stmt), tbStmtsEqb blk ((vtPre.drop n).take blk.length) = true →
    vtFLo ≤ n → n + blk.length ≤ vtFHi →
      ∃ kret : List E → Prop, Stmt.HoldsList (coreProgram.Rel rd) rd σ blk True kret

section
variable {rd : Reader} {σ : Val}

theorem VtF.slice (h : VtF rd σ) (n : ℕ) (blk : List Stmt)
    (heq : tbStmtsEqb blk ((vtPre.drop n).take blk.length) = true)
    (hr : vtFLo ≤ n ∧ n + blk.length ≤ vtFHi := by decide) :
    ∃ kret : List E → Prop, Stmt.HoldsList (coreProgram.Rel rd) rd σ blk True kret :=
  h n blk heq hr.1 hr.2

theorem VtF.atom (h : VtF rd σ) (n : ℕ) (a : Atom)
    (heq : tbStmtsEqb [.atom a] ((vtPre.drop n).take 1) = true)
    (hr : vtFLo ≤ n ∧ n + 1 ≤ vtFHi := by decide) : a.Holds rd σ := by
  obtain ⟨_, hs⟩ := h.slice n [.atom a] heq hr
  exact hs.1

/-- `VtF.slice` at `vtAt`, what a kernel check evaluates fast. -/
theorem VtF.sliceAt (h : VtF rd σ) (n : ℕ) (blk : List Stmt)
    (heq : tbStmtsEqb blk ((vtAt n).take blk.length) = true)
    (hr : vtFLo ≤ n ∧ n + blk.length ≤ vtFHi := by decide) :
    ∃ kret : List E → Prop, Stmt.HoldsList (coreProgram.Rel rd) rd σ blk True kret :=
  h.slice n blk (vtPre_drop n ▸ heq) hr

/-- `VtF.atom` at `vtAt`, what a kernel check evaluates fast. -/
theorem VtF.atomAt (h : VtF rd σ) (n : ℕ) (a : Atom)
    (heq : tbStmtsEqb [.atom a] ((vtAt n).take 1) = true)
    (hr : vtFLo ≤ n ∧ n + 1 ≤ vtFHi := by decide) : a.Holds rd σ :=
  h.atom n a (vtPre_drop n ▸ heq) hr

theorem mem_take_drop_mono {α : Type} {l : List α} {a b n m : ℕ} (h1 : a ≤ n)
    (h2 : n + m ≤ a + b) {x : α} (hx : x ∈ (l.drop n).take m) : x ∈ (l.drop a).take b := by
  have e : l.drop n = (l.drop a).drop (n - a) := by rw [List.drop_drop]; congr 1; omega
  have e2 : ((l.drop a).drop (n - a)).take m = ((l.drop a).take (n - a + m)).drop (n - a) := by
    rw [List.drop_take]; congr 1; omega
  rw [e, e2] at hx
  exact List.take_subset_take_left _ (by omega) (List.mem_of_mem_drop hx)

/-- **The honest window**: statements `2685 ..< 5524` each holding make `VtF`. -/
theorem vtF_of_vsh
    (hA : ∀ s ∈ (vtPre.drop vtFLo).take (vtFHi - vtFLo), VSH (coreProgram.Rel rd) rd σ s) :
    VtF rd σ := by
  intro n blk heq h1 h2
  have e := tbStmtsEqb_sound heq
  have hm : ∀ s ∈ blk, s ∈ (vtPre.drop vtFLo).take (vtFHi - vtFLo) := fun s hs ↦
    mem_take_drop_mono h1 (by omega) (e ▸ hs)
  have hok : blk.all iteOk = true := by
    rw [List.all_eq_true]
    intro s hs
    exact List.all_eq_true.mp vt_iteOk s (vt_mem_slice heq hs)
  exact ⟨fun _ ↦ True, holdsList_of_vsh blk hok (fun s hs ↦ hA s (hm s hs)) trivial⟩

end

end
end LeanVM.Guest.B1.Tables
