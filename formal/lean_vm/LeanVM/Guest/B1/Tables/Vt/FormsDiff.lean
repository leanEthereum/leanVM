/-
  LeanVM.Guest.B1.Tables.Vt.FormsDiff

  Each pull block's coordinates less its push twin's (`COORD_DIFF_*`): the guest computes a table's
  pull form as its push form plus the differences (G:2470-2499, 2525-2526), and the kernel checks
  that the pull side's baked terms are the push side's plus these, coordinate by coordinate.
  Generated by `scripts/b1c-vt/gendiff.py` from the guest's constants.
-/

module

public import LeanVM.Guest.B1.Tables.Vt.FormsVal

/-!
# The pull side by differences (G:2470-2499)

At `40f877dc` a pull block shares its push twin's selector, and the guest evaluates only the
coordinates where the two differ: `Σ_i W_i · diff_i` (`vtSlots W ev 0` over `vtDTerms t`, an empty
list where they agree), and the table's pull form as `push + Σ_b sel_b · Σ_i W_i · diff_i`.
`vtPullOk P Q D`: every pull coordinate's terms (`Q`) are canonically the push twin's (`P`) followed
by the difference (`D`); `vtSideVal_pull` is then the identity of the two sides' values.
-/

namespace LeanVM.Guest.B1.Tables

open LeanVM.Parameters LeanVM.Protocol LeanVM.Protocol.Verifier
open LeanVM.Protocol.EndToEnd.Complete (canon termsEval_append)

@[expose] public section

/-- A block's coordinates: each pull coordinate is canonically push's followed by the difference. -/
def vtCoordsOk : List (List (List ℕ × ℕ)) → List (List (List ℕ × ℕ)) →
    List (List (List ℕ × ℕ)) → Bool
  | [], [], [] => true
  | p :: ps, q :: qs, d :: ds =>
    decide (canon (vtTermsK q) = canon (vtTermsK (p ++ d))) && vtCoordsOk ps qs ds
  | _, _, _ => false

/-- A side's blocks, by `vtCoordsOk`. -/
def vtPullOk : List (List (List (List ℕ × ℕ))) → List (List (List (List ℕ × ℕ))) →
    List (List (List (List ℕ × ℕ))) → Bool
  | [], [], [] => true
  | p :: ps, q :: qs, d :: ds => vtCoordsOk p q d && vtPullOk ps qs ds
  | _, _, _ => false

/-- The pull side's differences, weighted: the blocks' selectors times `Σ_i W_i · diff_i`. -/
def vtDiffSum (sels : List E) (W ev : ℕ → E) (ds : List (List (List (List ℕ × ℕ)))) : E :=
  (List.zipWith (fun s d ↦ s * vtSlots W ev 0 d) sels ds).sum

theorem vtCoordVal_append (ev : ℕ → E) (p d : List (List ℕ × ℕ)) :
    vtCoordVal ev (p ++ d) = vtCoordVal ev p + vtCoordVal ev d := by
  simp only [vtCoordVal, vtTermsK, liftT, List.map_append, termsEval_append]

theorem vtCoordVal_of_canon (ev : ℕ → E) {p q d : List (List ℕ × ℕ)}
    (h : canon (vtTermsK q) = canon (vtTermsK (p ++ d))) :
    vtCoordVal ev q = vtCoordVal ev p + vtCoordVal ev d := by
  rw [← vtCoordVal_append, vtCoordVal, vtCoordVal, ← termsEval_liftT_canon, h,
    termsEval_liftT_canon]

theorem vtSlots_pull (W ev : ℕ → E) :
    ∀ (p q d : List (List (List ℕ × ℕ))) (i : ℕ), vtCoordsOk p q d = true →
      vtSlots W ev i q = vtSlots W ev i p + vtSlots W ev i d
  | [], [], [], _, _ => by simp [vtSlots]
  | p :: ps, q :: qs, d :: ds, i, h => by
    simp only [vtCoordsOk, Bool.and_eq_true, decide_eq_true_eq] at h
    simp only [vtSlots, vtCoordVal_of_canon ev h.1, vtSlots_pull W ev ps qs ds (i + 1) h.2]
    ring
  | [], [], _ :: _, _, h | [], _ :: _, _, _, h | _ :: _, [], _, _, h
  | _ :: _, _ :: _, [], _, h => by simp [vtCoordsOk] at h

/-- **The pull side is the push side plus the differences.** -/
theorem vtSideVal_pull (β : E) (W ev : ℕ → E) :
    ∀ (sels : List E) (P Q D : List (List (List (List ℕ × ℕ)))), vtPullOk P Q D = true →
      vtSideVal sels β W ev Q = vtSideVal sels β W ev P + vtDiffSum sels W ev D
  | [], _, _, _, _ => by simp [vtSideVal, vtDiffSum]
  | _ :: _, [], [], [], _ => by simp [vtSideVal, vtDiffSum]
  | s :: ss, p :: ps, q :: qs, d :: ds, h => by
    simp only [vtPullOk, Bool.and_eq_true] at h
    have ih := vtSideVal_pull β W ev ss ps qs ds h.2
    simp only [vtSideVal, vtDiffSum, List.zipWith_cons_cons, List.sum_cons] at ih ⊢
    rw [ih, vtBlockVal_eq, vtBlockVal_eq, vtSlots_pull W ev p q d 0 h.1]
    ring
  | _ :: _, [], [], _ :: _, h | _ :: _, [], _ :: _, _, h | _ :: _, _ :: _, [], _, h
  | _ :: _, _ :: _, _ :: _, [], h => by simp [vtPullOk] at h

