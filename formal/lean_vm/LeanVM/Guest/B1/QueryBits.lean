/-! ## Sums and bit runs -/

variable {C : CallRel} {rd : Reader} {σ : Val}

/-- The value of a folded accumulator: `0` while it is folded. -/
def optVal (σ : Val) : Option V → E
  | none => 0
  | some v => σ v

theorem optVal_none (σ : Val) : optVal σ none = 0 := rfl

/-- What one term of a sum asks. -/
def DqAddOk (σ : Val) (t : V) (c : E) (k : ℕ) : Option V → Prop
  | none => True
  | some a => σ (.n k) = c ∧ σ (.n (k + 1)) = σ t * σ (.n k) ∧ σ (.n (k + 2)) = σ a + σ (.n (k + 1))

theorem holds_dqAdd (t : V) (c : E) (k : ℕ) (acc : Option V) (next : Prop) (kret : List E → Prop) :
    Stmt.HoldsList C rd σ (dqAdd t c k acc).1 next kret ↔ DqAddOk σ t c k acc ∧ next := by
  cases acc <;> simp [dqAdd, DqAddOk, Stmt.HoldsList, Stmt.Holds, Atom.Holds, and_assoc]

theorem dqAdd_value {t : V} {c : E} {k : ℕ} {acc : Option V} (h : DqAddOk σ t c k acc)
    (h1 : acc = none → c = 1) : optVal σ (dqAdd t c k acc).2.2 = optVal σ acc + σ t * c := by
  cases acc with
  | none => simp [dqAdd, optVal, h1 rfl]
  | some a => obtain ⟨e0, e1, e2⟩ := h; simp [dqAdd, optVal, e2, e1, e0]

theorem dqAdd_isSome (t : V) (c : E) (k : ℕ) (acc : Option V) : (dqAdd t c k acc).2.2.isSome = true := by
  cases acc <;> rfl

theorem cbWord_zero : cbWord 0 = 1 := by
  rw [cbWord]; exact word_one


theorem cbWord_eq (i : ℕ) : cbWord i = coordBasis i := by
  simp only [cbWord, word, ofBits_mod]; rfl

/-- Basis vectors multiply without reduction while the degree stays inside a limb. -/
theorem coordBasis_mul {i j : ℕ} (hi : i < 192) (h : i % 64 + j < 64) :
    coordBasis i * coordBasis j = coordBasis (i + j) := by
  rw [coordBasis_of_lt (show j < 64 by omega), coordBasis_mul_eOfNat hi (by
    rw [← Nat.pow_add]; exact Nat.pow_lt_pow_right (by decide) h), ← Nat.pow_add]; rfl

/-- Bit `i` of the word, as its frame cell holds it. -/
def bitsOf (σ : Val) (i : ℕ) : E := σ (.n (3 + i))

/-- What the bits of a group ask. -/
def DqBitsOk (σ : Val) (base cut : ℕ) : ℕ → ℕ → ℕ → Option V → Option V → Prop
  | _, 0, _, _, _ => True
  | b, n + 1, k, lo, hi =>
    σ (.n (3 + (base + b))) = σ (.n (3 + (base + b))) * σ (.n (3 + (base + b))) ∧
    (if b < cut then DqAddOk σ (.n (3 + (base + b))) (cbWord b) k lo ∧
        DqBitsOk σ base cut (b + 1) n (dqAdd (.n (3 + (base + b))) (cbWord b) k lo).2.1
          (dqAdd (.n (3 + (base + b))) (cbWord b) k lo).2.2 hi
      else DqAddOk σ (.n (3 + (base + b))) (cbWord (b - cut)) k hi ∧
        DqBitsOk σ base cut (b + 1) n (dqAdd (.n (3 + (base + b))) (cbWord (b - cut)) k hi).2.1 lo
          (dqAdd (.n (3 + (base + b))) (cbWord (b - cut)) k hi).2.2)

theorem holds_dqBits (base cut : ℕ) (next : Prop) (kret : List E → Prop) :
    ∀ n b k lo hi, Stmt.HoldsList C rd σ (dqBits base cut b n k lo hi).1 next kret ↔
      DqBitsOk σ base cut b n k lo hi ∧ next
  | 0, _, _, _, _ => by simp [dqBits, DqBitsOk, Stmt.HoldsList]
  | n + 1, b, k, lo, hi => by
    by_cases hb : b < cut
    · simp only [dqBits, hb, ↓reduceIte, DqBitsOk, List.cons_append, Stmt.HoldsList, Stmt.Holds,
        Atom.Holds]
      rw [holdsList_append, holds_dqAdd, holds_dqBits base cut next kret n]
      tauto
    · simp only [dqBits, hb, ↓reduceIte, DqBitsOk, List.cons_append, Stmt.HoldsList, Stmt.Holds,
        Atom.Holds]
      rw [holdsList_append, holds_dqAdd, holds_dqBits base cut next kret n]
      tauto

/-- The term of bit `m` of a group in the low run (`m < cut`) or the high one. -/
def dqLoT (B : ℕ → E) (base cut m : ℕ) : E :=
  if m < cut then B (base + m) * cbWord m else 0

def dqHiT (B : ℕ → E) (base cut m : ℕ) : E :=
  if m < cut then 0 else B (base + m) * cbWord (m - cut)

theorem dqBits_value (base cut : ℕ) (hcut : 0 < cut) :
    ∀ n b k lo hi, (lo = none → b = 0) → (hi = none → b ≤ cut) →
      DqBitsOk σ base cut b n k lo hi →
      optVal σ (dqBits base cut b n k lo hi).2.2.1 =
          optVal σ lo + ∑ i ∈ Finset.range n, dqLoT (bitsOf σ) base cut (b + i) ∧
        optVal σ (dqBits base cut b n k lo hi).2.2.2 =
          optVal σ hi + ∑ i ∈ Finset.range n, dqHiT (bitsOf σ) base cut (b + i) ∧
        ∀ i < n, bitsOf σ (base + (b + i)) * bitsOf σ (base + (b + i)) = bitsOf σ (base + (b + i))
  | 0, _, _, _, _, _, _, _ => by simp [dqBits]
  | n + 1, b, k, lo, hi, hlo, hhi, ⟨hbool, hrest⟩ => by
    by_cases hb : b < cut
    · rw [ite_pos' hb] at hrest
      obtain ⟨ha, hr⟩ := hrest
      have hv := dqAdd_value ha (fun h => by rw [hlo h, cbWord_zero])
      obtain ⟨e1, e2, e3⟩ := dqBits_value base cut hcut n (b + 1) _ _ hi
        (fun h => by
          have := dqAdd_isSome (.n (3 + (base + b))) (cbWord b) k lo
          rw [h] at this; exact absurd this (by decide))
        (fun h => by have := hhi h; omega) hr
      simp only [dqBits, hb, ↓reduceIte]
      refine ⟨?_, ?_, fun i hi' => ?_⟩
      · rw [e1, hv, Finset.sum_range_succ' (n := n), dqLoT, ite_pos' (by omega), Nat.add_zero]
        simp only [show ∀ i, b + 1 + i = b + (i + 1) from fun i => by omega, Nat.add_zero, bitsOf]
        ring
      · rw [e2, Finset.sum_range_succ' (n := n), dqHiT, ite_pos' (by omega)]
        simp only [show ∀ i, b + 1 + i = b + (i + 1) from fun i => by omega, add_zero]
      · cases i with
        | zero => exact hbool.symm
        | succ i => rw [show b + (i + 1) = b + 1 + i by omega]; exact e3 i (by omega)
    · rw [ite_neg' hb] at hrest
      obtain ⟨ha, hr⟩ := hrest
      have hv := dqAdd_value ha (fun h => by rw [show b = cut by have := hhi h; omega, Nat.sub_self,
        cbWord_zero])
      have hlo' : lo.isSome = true := by
        cases lo with
        | some _ => rfl
        | none => have := hlo rfl; omega
      obtain ⟨e1, e2, e3⟩ := dqBits_value base cut hcut n (b + 1) _ lo _
        (fun h => by rw [h] at hlo'; exact absurd hlo' (by decide))
        (fun h => by
          have := dqAdd_isSome (.n (3 + (base + b))) (cbWord (b - cut)) k hi
          rw [h] at this; exact absurd this (by decide)) hr
      simp only [dqBits, hb, ↓reduceIte]
      refine ⟨?_, ?_, fun i hi' => ?_⟩
      · rw [e1, Finset.sum_range_succ' (n := n), dqLoT, ite_neg' (by omega)]
        simp only [show ∀ i, b + 1 + i = b + (i + 1) from fun i => by omega, add_zero]
      · rw [e2, hv, Finset.sum_range_succ' (n := n), dqHiT, ite_neg' (by omega)]
        simp only [show ∀ i, b + 1 + i = b + (i + 1) from fun i => by omega, Nat.add_zero, bitsOf]
        ring
      · cases i with
        | zero => exact hbool.symm
        | succ i => rw [show b + (i + 1) = b + 1 + i by omega]; exact e3 i (by omega)

theorem dqBits_lo_isSome (base cut : ℕ) :
    ∀ n b k lo hi, (lo.isSome = true ∨ (b < cut ∧ 0 < n)) →
      (dqBits base cut b n k lo hi).2.2.1.isSome = true
  | 0, _, _, lo, _, h => by
    rcases h with h | h
    · exact h
    · omega
  | n + 1, b, k, lo, hi, h => by
    by_cases hb : b < cut
    · simp only [dqBits, hb, ↓reduceIte]
      exact dqBits_lo_isSome base cut n _ _ _ _ (Or.inl (dqAdd_isSome _ _ _ _))
    · simp only [dqBits, hb, ↓reduceIte]
      exact dqBits_lo_isSome base cut n _ _ _ _ (Or.inl (by
        rcases h with h | h
        · exact h
        · omega))

theorem dqBits_hi_isSome (base cut : ℕ) :
    ∀ n b k lo hi, (hi.isSome = true ∨ (cut < b + n ∧ 0 < n)) →
      (dqBits base cut b n k lo hi).2.2.2.isSome = true
  | 0, _, _, _, hi, h => by
    rcases h with h | h
    · exact h
    · omega
  | n + 1, b, k, lo, hi, h => by
    by_cases hb : b < cut
    · simp only [dqBits, hb, ↓reduceIte]
      exact dqBits_hi_isSome base cut n _ _ _ _ (by
        rcases h with h | h
        · exact Or.inl h
        · right; omega)
    · simp only [dqBits, hb, ↓reduceIte]
      exact dqBits_hi_isSome base cut n _ _ _ _ (Or.inl (dqAdd_isSome _ _ _ _))

theorem optVal_getD {o : Option V} (h : o.isSome = true) (v : V) : σ (o.getD v) = optVal σ o := by
  cases o with
  | none => simp at h
  | some _ => rfl

/-- A group's position: its low run, the high one shifted past the limb boundary. -/
theorem dq_pos_term (B : ℕ → E) (base cut m : ℕ) (hc : cut ≤ 64) (hm : m < 64) :
    dqLoT B base cut m + cbWord cut * dqHiT B base cut m = B (base + m) * cbWord m := by
  unfold dqLoT dqHiT
  by_cases h : m < cut
  · rw [ite_pos' h, ite_pos' h, mul_zero, add_zero]
  · rw [ite_neg' h, ite_neg' h, zero_add, cbWord_eq, cbWord_eq, cbWord_eq, mul_left_comm,
      coordBasis_mul (by omega) (by rw [Nat.mod_eq_of_lt (show cut < 64 by omega)]; omega),
      Nat.add_sub_cancel' (by omega)]

/-- A group's reconstruction term: both runs shifted to their place in the word. -/
theorem dq_recon_term (B : ℕ → E) (base m : ℕ) (hm : base + m < 192) (hm64 : m < 64) :
    cbWord base * dqLoT B base (64 - base % 64) m +
        cbWord (base + (64 - base % 64)) * dqHiT B base (64 - base % 64) m =
      B (base + m) * cbWord (base + m) := by
  unfold dqLoT dqHiT
  simp only [cbWord_eq]
  by_cases h : m < 64 - base % 64
  · rw [ite_pos' h, ite_pos' h, mul_zero, add_zero, mul_left_comm,
      coordBasis_mul (by omega) (by omega)]
  · rw [ite_neg' h, ite_neg' h, mul_zero, zero_add, mul_left_comm,
      coordBasis_mul (by omega) (by omega),
      show base + (64 - base % 64) + (m - (64 - base % 64)) = base + m by omega]

theorem ofLimbs_gpowK {e : ℕ} (h : e < 2 ^ 128) : E.ofLimbs (gpowK e) 0 0 = gen ^ e := by
  rw [← ofK_eq_ofLimbs, gpowK_eq h, gen_pow_eq_ofK]

/-! ## Groups -/

/-- What a group's position and reconstruction ask. -/
def DqPrOk (rd : Reader) (σ : Val) (j base cut d k : ℕ) (lo hi : V) (recon : Option V) : Prop :=
  if cut < d then
    σ (.n k) = cbWord cut ∧ σ (.n (k + 1)) = σ (.n k) * σ hi ∧
      σ (.n (k + 2)) = σ lo + σ (.n (k + 1)) ∧ LoadHolds rd (σ (.n 1)) j (σ (.n (k + 2))) ∧
      σ (.n (k + 3)) = cbWord base ∧ σ (.n (k + 4)) = σ (.n (k + 3)) * σ lo ∧
      σ (.n (k + 5)) = cbWord (base + cut) ∧ σ (.n (k + 6)) = σ (.n (k + 5)) * σ hi ∧
      σ (.n (k + 7)) = σ (.n (k + 4)) + σ (.n (k + 6)) ∧
      σ (.n (k + 8)) = σ (recon.getD (.n 0)) + σ (.n (k + 7))
  else LoadHolds rd (σ (.n 1)) j (σ lo) ∧ ∀ rc, recon = some rc →
      σ (.n k) = cbWord base ∧ σ (.n (k + 1)) = σ (.n k) * σ lo ∧ σ (.n (k + 2)) = σ rc + σ (.n (k + 1))

theorem holds_dqPr (j base cut d k : ℕ) (lo hi : V) (recon : Option V) (next : Prop)
    (kret : List E → Prop) :
    Stmt.HoldsList C rd σ (dqPr j base cut d k lo hi recon).1 next kret ↔
      DqPrOk rd σ j base cut d k lo hi recon ∧ next := by
  unfold dqPr DqPrOk
  by_cases h : cut < d
  · simp [h, Stmt.HoldsList, Stmt.Holds, Atom.Holds, and_assoc]
  · cases recon <;> simp [h, Stmt.HoldsList, Stmt.Holds, Atom.Holds, and_assoc]

/-- What a group's bit pointer asks. -/
def DqBpOk (rd : Reader) (σ : Val) (j base k : ℕ) : Prop :=
  if j = 0 then LoadHolds rd (σ (.n 2)) 0 (σ (.n 195)) else
    σ (.n k) = E.ofLimbs (gpowK base) 0 0 ∧ σ (.n (k + 1)) = σ (.n 195) * σ (.n k) ∧
      LoadHolds rd (σ (.n 2)) j (σ (.n (k + 1)))

theorem holds_dqBp (j base k : ℕ) (next : Prop) (kret : List E → Prop) :
    Stmt.HoldsList C rd σ (dqBp j base k).1 next kret ↔ DqBpOk rd σ j base k ∧ next := by
  unfold dqBp DqBpOk
  by_cases h : j = 0 <;> simp [h, Stmt.HoldsList, Stmt.Holds, Atom.Holds, and_assoc]

/-- What group `j` asks. -/
def DqGroupOk (rd : Reader) (σ : Val) (d j k : ℕ) (recon : Option V) : Prop :=
  DqBitsOk σ (j * d) (64 - j * d % 64) 0 d k none none ∧
    DqPrOk rd σ j (j * d) (64 - j * d % 64) d (dqR d j k).2.1 ((dqR d j k).2.2.1.getD (.n 0))
      ((dqR d j k).2.2.2.getD (.n 0)) recon ∧
    DqBpOk rd σ j (j * d) (dqP d j k recon).2.1

theorem holds_dqGroup (d j k : ℕ) (recon : Option V) (next : Prop) (kret : List E → Prop) :
    Stmt.HoldsList C rd σ (dqGroup d j k recon).1 next kret ↔ DqGroupOk rd σ d j k recon ∧ next := by
  unfold dqGroup DqGroupOk
  rw [holdsList_append, holdsList_append, dqR, holds_dqBits, ← dqR, dqP, holds_dqPr, ← dqP, holds_dqBp]
  simp only [and_assoc]

/-- **A group** (G:668-691): its bits Boolean, its position their integer over the basis, its
pointer `bits·g^(j·d)`, and its term added to the reconstruction. -/
theorem dqGroup_facts {d j k : ℕ} {recon : Option V} (hd0 : 0 < d) (hd : d ≤ 26)
    (hj : j * d + d ≤ 192) (hrec : recon = none → j = 0) (h : DqGroupOk rd σ d j k recon) :
    (∀ m < d, bitsOf σ (j * d + m) * bitsOf σ (j * d + m) = bitsOf σ (j * d + m)) ∧
    LoadHolds rd (σ (.n 1)) j (∑ m ∈ Finset.range d, bitsOf σ (j * d + m) * cbWord m) ∧
    LoadHolds rd (σ (.n 2)) j (σ (.n 195) * gen ^ (j * d)) ∧
    (dqGroup d j k recon).2.2.isSome = true ∧
    optVal σ (dqGroup d j k recon).2.2 =
      optVal σ recon + ∑ m ∈ Finset.range d, bitsOf σ (j * d + m) * cbWord (j * d + m) := by
  obtain ⟨hb, hpr, hbp⟩ := h
  obtain ⟨e1, e2, e3⟩ := dqBits_value (j * d) (64 - j * d % 64) (by omega) d 0 k none none
    (fun _ => rfl) (fun _ => by omega) hb
  simp only [optVal_none σ, zero_add] at e1 e2 e3
  have hlo := dqBits_lo_isSome (j * d) (64 - j * d % 64) d 0 k none none (Or.inr ⟨by omega, hd0⟩)
  rw [← optVal_getD hlo (.n 0)] at e1
  have hhi := fun _ : 64 - j * d % 64 < d =>
    dqBits_hi_isSome (j * d) (64 - j * d % 64) d 0 k none none (Or.inr ⟨by omega, hd0⟩)
  simp only [dqGroup, dqP] at ⊢ hbp
  rw [dqR] at hpr ⊢ hbp
  generalize dqBits (j * d) (64 - j * d % 64) 0 d k none none = R at *
  have hpos : ∀ m < d, dqLoT (bitsOf σ) (j * d) (64 - j * d % 64) m +
      cbWord (64 - j * d % 64) * dqHiT (bitsOf σ) (j * d) (64 - j * d % 64) m =
        bitsOf σ (j * d + m) * cbWord m :=
    fun m hm => dq_pos_term _ _ _ _ (by omega) (by omega)
  have hrc : ∀ m < d, cbWord (j * d) * dqLoT (bitsOf σ) (j * d) (64 - j * d % 64) m +
      cbWord (j * d + (64 - j * d % 64)) * dqHiT (bitsOf σ) (j * d) (64 - j * d % 64) m =
        bitsOf σ (j * d + m) * cbWord (j * d + m) :=
    fun m hm => dq_recon_term _ _ _ (by omega) (by omega)
  have hbp' : LoadHolds rd (σ (.n 2)) j (σ (.n 195) * gen ^ (j * d)) := by
    unfold DqBpOk at hbp
    by_cases hj0 : j = 0
    · rw [ite_pos' hj0] at hbp
      subst hj0
      simpa using hbp
    · rw [ite_neg' hj0] at hbp
      obtain ⟨b0, b1, bl⟩ := hbp
      rwa [b1, b0, ofLimbs_gpowK (by omega)] at bl
  unfold DqPrOk at hpr
  unfold dqPr
  by_cases hs : 64 - j * d % 64 < d
  · rw [ite_pos' hs] at hpr
    rw [ite_pos' hs]
    obtain ⟨p0, p1, p2, pl, p3, p4, p5, p6, p7, p8⟩ := hpr
    rw [← optVal_getD (hhi hs) (.n 0)] at e2
    have hp : σ (.n (R.2.1 + 2)) = ∑ m ∈ Finset.range d, bitsOf σ (j * d + m) * cbWord m := by
      rw [p2, p1, p0, e1, e2, Finset.mul_sum, ← Finset.sum_add_distrib]
      exact Finset.sum_congr rfl fun m hm => hpos m (Finset.mem_range.mp hm)
    have hj0 : j ≠ 0 := fun h => by subst h; omega
    obtain ⟨rc, rfl⟩ : ∃ rc, recon = some rc := by
      cases recon with
      | none => exact absurd (hrec rfl) hj0
      | some rc => exact ⟨rc, rfl⟩
    refine ⟨e3, by rw [← hp]; exact pl, hbp', rfl, ?_⟩
    show σ (.n (R.2.1 + 8)) = σ rc + _
    rw [p8, p7, p6, p5, p4, p3, e1, e2]
    simp only [Option.getD_some]
    rw [Finset.mul_sum, Finset.mul_sum, ← Finset.sum_add_distrib]
    exact congrArg _ (Finset.sum_congr rfl fun m hm => hrc m (Finset.mem_range.mp hm))
  · rw [ite_neg' hs] at hpr
    rw [ite_neg' hs]
    obtain ⟨pl, pr⟩ := hpr
    have hp : σ (R.2.2.1.getD (.n 0)) = ∑ m ∈ Finset.range d, bitsOf σ (j * d + m) * cbWord m := by
      rw [e1]
      exact Finset.sum_congr rfl fun m hm => by
        rw [dqLoT, ite_pos' (by have := Finset.mem_range.mp hm; omega)]
    cases recon with
    | none =>
      have hj0 := hrec rfl
      subst hj0
      refine ⟨e3, by rw [← hp]; exact pl, hbp', rfl, ?_⟩
      show σ (R.2.2.1.getD (.n 0)) = 0 + _
      rw [hp]
      simp only [Nat.zero_mul, zero_add]
    | some rc =>
      obtain ⟨q0, q1, q2⟩ := pr rc rfl
      refine ⟨e3, by rw [← hp]; exact pl, hbp', rfl, ?_⟩
      show σ (.n (R.2.1 + 2)) = σ rc + _
      rw [q2, q1, q0, hp, Finset.mul_sum]
      refine congrArg _ (Finset.sum_congr rfl fun m hm => ?_)
      have hm' := Finset.mem_range.mp hm
      rw [← hrc m hm', dqHiT, ite_pos' (by omega), mul_zero, add_zero, dqLoT, ite_pos' (by omega)]

/-- What groups `j ..` ask. -/
def DqGroupsOk (rd : Reader) (σ : Val) (d : ℕ) : ℕ → ℕ → ℕ → Option V → Prop
  | _, 0, _, _ => True
  | j, n + 1, k, recon => DqGroupOk rd σ d j k recon ∧
      DqGroupsOk rd σ d (j + 1) n (dqGroup d j k recon).2.1 (dqGroup d j k recon).2.2

theorem holds_dqGroups (d : ℕ) (next : Prop) (kret : List E → Prop) :
    ∀ n j k recon, Stmt.HoldsList C rd σ (dqGroups d j n k recon).1 next kret ↔
      DqGroupsOk rd σ d j n k recon ∧ next
  | 0, _, _, _ => by simp [dqGroups, DqGroupsOk, Stmt.HoldsList]
  | n + 1, j, k, recon => by
    simp only [dqGroups, DqGroupsOk]
    rw [holdsList_append, holds_dqGroup, holds_dqGroups d next kret n, and_assoc]

theorem dqGroups_facts {d : ℕ} (hd0 : 0 < d) (hd : d ≤ 26) :
    ∀ n j k (recon : Option V), (j + n) * d ≤ 192 → (recon = none → j = 0) →
      (0 < n ∨ recon.isSome = true) → DqGroupsOk rd σ d j n k recon →
      (∀ i < n * d, bitsOf σ (j * d + i) * bitsOf σ (j * d + i) = bitsOf σ (j * d + i)) ∧
      (∀ c < n, LoadHolds rd (σ (.n 1)) (j + c)
          (∑ m ∈ Finset.range d, bitsOf σ ((j + c) * d + m) * cbWord m) ∧
        LoadHolds rd (σ (.n 2)) (j + c) (σ (.n 195) * gen ^ ((j + c) * d))) ∧
      (dqGroups d j n k recon).2.2.isSome = true ∧
      optVal σ (dqGroups d j n k recon).2.2 =
        optVal σ recon + ∑ i ∈ Finset.range (n * d), bitsOf σ (j * d + i) * cbWord (j * d + i)
  | 0, j, k, recon, _, _, hs, _ => by
    simp only [dqGroups, Nat.zero_mul, Finset.range_zero, Finset.sum_empty, add_zero]
    refine ⟨fun i hi => absurd hi (by omega), fun c hc => absurd hc (by omega), ?_, trivial⟩
    rcases hs with hs | hs
    · omega
    · exact hs
  | n + 1, j, k, recon, hj, hrec, _, ⟨hg, hr⟩ => by
    have e1 : (j + 1) * d = j * d + d := Nat.succ_mul j d
    have e2 : (j + (n + 1)) * d = (j + 1) * d + n * d := by ring
    obtain ⟨g1, g2, g3, g4, g5⟩ := dqGroup_facts hd0 hd (by omega) hrec hg
    obtain ⟨r1, r2, r3, r4⟩ := dqGroups_facts hd0 hd n (j + 1) _ _
      (by rw [show j + 1 + n = j + (n + 1) by omega]; exact hj)
      (fun h => by rw [h] at g4; exact absurd g4 (by decide)) (Or.inr g4) hr
    simp only [dqGroups]
    refine ⟨fun i hi => ?_, fun c hc => ?_, r3, ?_⟩
    · by_cases hid : i < d
      · exact g1 i hid
      · have := r1 (i - d) (by rw [Nat.succ_mul] at hi; omega)
        rwa [show (j + 1) * d + (i - d) = j * d + i by omega] at this
    · cases c with
      | zero => exact ⟨g2, g3⟩
      | succ c =>
        have := r2 c (by omega)
        rwa [show j + 1 + c = j + (c + 1) by omega] at this
    · rw [r4, g5, show (n + 1) * d = d + n * d by ring, Finset.sum_range_add, add_assoc]
      refine congrArg _ (congrArg _ (Finset.sum_congr rfl fun i _ => ?_))
      rw [show (j + 1) * d + i = j * d + (d + i) by omega]

/-- What the leftover bits ask. -/
def DqLeftOk (σ : Val) : ℕ → ℕ → ℕ → V → Prop
  | _, 0, _, _ => True
  | i, n + 1, k, recon => σ (.n (3 + i)) = σ (.n (3 + i)) * σ (.n (3 + i)) ∧ σ (.n k) = cbWord i ∧
      σ (.n (k + 1)) = σ (.n (3 + i)) * σ (.n k) ∧ σ (.n (k + 2)) = σ recon + σ (.n (k + 1)) ∧
      DqLeftOk σ (i + 1) n (k + 3) (.n (k + 2))

theorem holds_dqLeft (next : Prop) (kret : List E → Prop) :
    ∀ n i k recon, Stmt.HoldsList C rd σ (dqLeft i n k recon).1 next kret ↔
      DqLeftOk σ i n k recon ∧ next
  | 0, _, _, _ => by simp [dqLeft, DqLeftOk, Stmt.HoldsList]
  | n + 1, i, k, recon => by
    simp only [dqLeft, DqLeftOk, List.cons_append, List.nil_append, Stmt.HoldsList, Stmt.Holds,
      Atom.Holds]
    rw [holds_dqLeft next kret n]
    simp only [and_assoc]

theorem dqLeft_facts : ∀ n i k recon, DqLeftOk σ i n k recon →
    (∀ m < n, bitsOf σ (i + m) * bitsOf σ (i + m) = bitsOf σ (i + m)) ∧
    σ (dqLeft i n k recon).2 = σ recon + ∑ m ∈ Finset.range n, bitsOf σ (i + m) * cbWord (i + m)
  | 0, _, _, _, _ => by simp [dqLeft]
  | n + 1, i, k, recon, ⟨hb, h0, h1, h2, hr⟩ => by
    obtain ⟨r1, r2⟩ := dqLeft_facts n (i + 1) (k + 3) _ hr
    refine ⟨fun m hm => ?_, ?_⟩
    · cases m with
      | zero => exact hb.symm
      | succ m =>
        have := r1 m (by omega)
        rwa [show i + 1 + m = i + (m + 1) by omega] at this
    · simp only [dqLeft]
      rw [r2, h2, h1, h0, Finset.sum_range_succ', add_assoc]
      simp only [show ∀ m, i + 1 + m = i + (m + 1) from fun m => by omega, Nat.add_zero, bitsOf]
      ring

/-! ## The meaning -/

/-- A group's position: the word's `d` bits from `base`, over the basis. -/
theorem dq_position (W base d : ℕ) (hd : d ≤ 64) :
    ∑ m ∈ Finset.range d, bitE (W.testBit (base + m)) * cbWord m = eOfNat ((W >>> base) % 2 ^ d) := by
  have h := sum_bitE_coordBasis (fun m => W.testBit (base + m)) 0 d
  simp only [Nat.zero_add, pow_zero, one_mul] at h
  simp only [cbWord_eq]
  rw [h, bitsVal_congr (f' := ((W >>> base) % 2 ^ d).testBit) (fun i hi => by
      rw [Nat.testBit_mod_two_pow, Nat.testBit_shiftRight]; simp [hi]),
    bitsVal_testBit (Nat.mod_lt _ (Nat.two_pow_pos d)),
    eOfNat192_of_lt (lt_of_lt_of_le (Nat.mod_lt _ (Nat.two_pow_pos d))
      (Nat.pow_le_pow_right (by decide) hd))]

/-- `p` names a frame run holding the 192 bits of `W`: every readable word at `p·g^k`, `k < 192`,
is bit `k`. -/
def FrameBits192 (rd : Reader) (p : E) (W : ℕ) : Prop :=
  IsInK p ∧ ∀ k < 192, ∀ w, rd (p.limb 0 * Parameters.gpow k) = some w → w = bitE (W.testBit k)

/-- **`decode_query_bits(word, positions, bit_ptrs, d)`** (G:654-698; TRIAGE #17): the frame run
`p` of the word's 192 bits, and for each group `j < 192 / d` the position `j`, the word's `d` bits
from `j·d` (the chunk of `sampleQueriesAux`, V:1598), and the pointer `j`, `p·g^(j·d)`. -/
def MeaningDecodeQueryBits (d : ℕ) (rd : Reader) : List E → List E → Prop
  | [w, pos, ptrs], rets => rets = [] ∧ ∃ p, FrameBits192 rd p (eToNat w) ∧
      ∀ j < 192 / d, LoadHolds rd pos j (eOfNat ((eToNat w >>> (j * d)) % 2 ^ d)) ∧
        LoadHolds rd ptrs j (p * gen ^ (j * d))
  | _, _ => False

theorem dqRun_getElem (k : ℕ) (hk : k < dqRun.length) : dqRun[k] = .n (3 + k) := by
  simp [dqRun]

theorem length_dqRun : dqRun.length = 192 := by simp [dqRun]

theorem decode_query_bits_sound_aux {name : String} {f : Fn} (d : ℕ) (hd0 : 0 < d) (hd : d ≤ 26)
    (hfind : coreProgram.find? name = some f) (hparams : f.params = [.n 0, .n 1, .n 2])
    (hbody : f.body = dqBody d) (rd : Reader) (args rets : List E)
    (h : coreProgram.Rel rd name args rets) : MeaningDecodeQueryBits d rd args rets := by
  rw [rel_iff_sem hfind, hbody, hparams] at h
  obtain ⟨σ, hp, h⟩ := h
  subst hp
  unfold dqBody at h
  simp only [holdsList_append, List.cons_append, List.nil_append, Stmt.HoldsList, Stmt.Holds,
    Atom.Holds, true_and] at h
  rw [holds_dqGroups, holds_dqLeft] at h
  obtain ⟨⟨hK, hfr⟩, hG, hL, ha, hret⟩ := h
  simp only [List.map_cons, List.map_nil, MeaningDecodeQueryBits]
  have hq0 : 0 < 192 / d := Nat.div_pos (by omega) hd0
  have hqd : 192 / d * d ≤ 192 := Nat.div_mul_le_self 192 d
  generalize 192 / d = q at *
  obtain ⟨g1, g2, g3, g4⟩ := dqGroups_facts hd0 hd q 0 196 none (by simpa using hqd) (fun _ => rfl)
    (Or.inl hq0) hG
  obtain ⟨l1, l2⟩ := dqLeft_facts _ _ _ _ hL
  simp only [Nat.zero_mul, optVal_none σ, zero_add] at g1 g2 g4
  rw [optVal_getD (σ := σ) g3, g4] at l2
  have hsum : ∑ i ∈ Finset.range 192, bitsOf σ i * coordBasis i = σ (.n 0) := by
    rw [show 192 = q * d + (192 - q * d) by omega, Finset.sum_range_add, ← (e_add_eq_zero_iff.mp ha),
      l2]
    simp only [cbWord_eq]
  obtain ⟨-, hbits⟩ := bits_of_reconstruct_zero (n := 192) le_rfl (b := bitsOf σ) (fun i hi => by
    by_cases h : i < q * d
    · exact g1 i h
    · have := l1 (i - q * d) (by omega)
      rwa [show q * d + (i - q * d) = i by omega] at this) hsum
  refine ⟨hret.symm, σ (.n 195), ⟨hK, fun k hk w hw => ?_⟩, fun j hj => ⟨?_, (g2 j hj).2⟩⟩
  · rw [hfr k (by rw [length_dqRun]; exact hk) w hw, dqRun_getElem]
    exact hbits k hk
  · have := (g2 j hj).1
    rwa [Finset.sum_congr rfl fun m hm => by
      rw [hbits (j * d + m) (by
        have := Finset.mem_range.mp hm
        have : j * d + d ≤ q * d := by rw [← Nat.succ_mul]; exact Nat.mul_le_mul_right d hj
        omega)], dq_position _ _ _ (by omega)] at this

/-! ## Completeness -/

/-- `σ` holds the words `l` from value `k`. -/
def Agree (σ : Val) (k : ℕ) (l : List E) : Prop := ∀ i < l.length, σ (.n (k + i)) = l.getD i 0

theorem agree_append {k : ℕ} {l1 l2 : List E} :
    Agree σ k (l1 ++ l2) ↔ Agree σ k l1 ∧ Agree σ (k + l1.length) l2 := by
  constructor
  · intro h
    refine ⟨fun i hi => ?_, fun i hi => ?_⟩
    · rw [h i (by simp; omega), List.getD_append _ _ _ _ hi]
    · rw [Nat.add_assoc, h (l1.length + i) (by simp; omega),
        List.getD_append_right _ _ _ _ (by omega), Nat.add_sub_cancel_left]
  · rintro ⟨h1, h2⟩ i hi
    by_cases hi1 : i < l1.length
    · rw [h1 i hi1, List.getD_append _ _ _ _ hi1]
    · have := h2 (i - l1.length) (by simp at hi; omega)
      rw [show k + l1.length + (i - l1.length) = k + i by omega] at this
      rw [this, List.getD_append_right _ _ _ _ (by omega)]

/-- The honest words of one term of a sum, `x` the bit, `S` the sum so far. -/
def dqAddV (x c S : E) : Option V → List E
  | none => []
  | some _ => [c, x * c, S + x * c]

theorem dqAdd_of_agree {t : V} {c x S : E} {k : ℕ} {acc : Option V} (ht : σ t = x)
    (hacc : ∀ v, acc = some v → σ v = S) (hnone : acc = none → c = 1 ∧ S = 0)
    (hag : Agree σ k (dqAddV x c S acc)) :
    DqAddOk σ t c k acc ∧ (dqAdd t c k acc).2.1 = k + (dqAddV x c S acc).length ∧
      ∀ v, (dqAdd t c k acc).2.2 = some v → σ v = S + x * c := by
  cases acc with
  | none =>
    obtain ⟨hc, hS⟩ := hnone rfl
    refine ⟨trivial, rfl, fun v hv => ?_⟩
    simp only [dqAdd, Option.some.injEq] at hv
    rw [← hv, ht, hc, hS, zero_add, mul_one]
  | some a =>
    have h0 := hag 0 (by simp [dqAddV])
    have h1 := hag 1 (by simp [dqAddV])
    have h2 := hag 2 (by simp [dqAddV])
    simp only [dqAddV, List.getD_cons_zero, List.getD_cons_succ, Nat.add_zero] at h0 h1 h2
    refine ⟨⟨h0, by rw [h1, ht, h0], by rw [h2, hacc a rfl, h1]⟩, rfl, fun v hv => ?_⟩
    simp only [dqAdd, Option.some.injEq] at hv
    rw [← hv, h2]

/-- The honest words of a group's bits. -/
def dqBitsV (B : ℕ → E) (base cut : ℕ) : ℕ → ℕ → ℕ → Option V → Option V → List E
  | _, 0, _, _, _ => []
  | b, n + 1, k, lo, hi =>
    if b < cut then
      dqAddV (B (base + b)) (cbWord b) (∑ m ∈ Finset.range b, dqLoT B base cut m) lo ++
        dqBitsV B base cut (b + 1) n (dqAdd (.n (3 + (base + b))) (cbWord b) k lo).2.1
          (dqAdd (.n (3 + (base + b))) (cbWord b) k lo).2.2 hi
    else
      dqAddV (B (base + b)) (cbWord (b - cut)) (∑ m ∈ Finset.range b, dqHiT B base cut m) hi ++
        dqBitsV B base cut (b + 1) n (dqAdd (.n (3 + (base + b))) (cbWord (b - cut)) k hi).2.1 lo
          (dqAdd (.n (3 + (base + b))) (cbWord (b - cut)) k hi).2.2

theorem dqBits_of_agree (B : ℕ → E) (base cut : ℕ) (hcut : 0 < cut) :
    ∀ n b k lo hi, (∀ m < n, σ (.n (3 + (base + (b + m)))) = B (base + (b + m)) ∧
        B (base + (b + m)) * B (base + (b + m)) = B (base + (b + m))) →
      (lo = none → b = 0) → (hi = none → b ≤ cut) →
      (∀ v, lo = some v → σ v = ∑ m ∈ Finset.range b, dqLoT B base cut m) →
      (∀ v, hi = some v → σ v = ∑ m ∈ Finset.range b, dqHiT B base cut m) →
      Agree σ k (dqBitsV B base cut b n k lo hi) →
      DqBitsOk σ base cut b n k lo hi ∧
        (dqBits base cut b n k lo hi).2.1 = k + (dqBitsV B base cut b n k lo hi).length
  | 0, _, _, _, _, _, _, _, _, _, _ => ⟨trivial, rfl⟩
  | n + 1, b, k, lo, hi, hB, hlo0, hhi0, hlo, hhi, hag => by
    obtain ⟨hb0, hbb⟩ := hB 0 (by omega)
    simp only [Nat.add_zero] at hb0 hbb
    have hB' : ∀ m < n, σ (.n (3 + (base + (b + 1 + m)))) = B (base + (b + 1 + m)) ∧
        B (base + (b + 1 + m)) * B (base + (b + 1 + m)) = B (base + (b + 1 + m)) := fun m hm => by
      rw [show b + 1 + m = b + (m + 1) by omega]; exact hB (m + 1) (by omega)
    by_cases hb : b < cut
    · simp only [dqBitsV, hb, ↓reduceIte] at hag
      rw [agree_append] at hag
      obtain ⟨a1, a2, a3⟩ := dqAdd_of_agree hb0 hlo
        (fun h => by rw [hlo0 h]; exact ⟨cbWord_zero, Finset.sum_range_zero _⟩) hag.1
      rw [← a2] at hag
      obtain ⟨r1, r2⟩ := dqBits_of_agree B base cut hcut n (b + 1) _ _ hi hB'
        (fun h => by
          have := dqAdd_isSome (.n (3 + (base + b))) (cbWord b) k lo
          rw [h] at this; exact absurd this (by decide))
        (fun h => by have := hhi0 h; omega)
        (fun v hv => by rw [a3 v hv, Finset.sum_range_succ, dqLoT, ite_pos' hb])
        (fun v hv => by rw [hhi v hv, Finset.sum_range_succ, dqHiT, ite_pos' hb, add_zero])
        hag.2
      refine ⟨⟨by rw [hb0, hbb], ?_⟩, ?_⟩
      · rw [ite_pos' hb]; exact ⟨a1, r1⟩
      · simp only [dqBits, dqBitsV, hb, ↓reduceIte, List.length_append]
        rw [r2, a2, Nat.add_assoc]
    · simp only [dqBitsV, hb, ↓reduceIte] at hag
      rw [agree_append] at hag
      obtain ⟨a1, a2, a3⟩ := dqAdd_of_agree hb0 hhi
        (fun h => by
          have hbc : b = cut := by have := hhi0 h; omega
          refine ⟨by rw [hbc, Nat.sub_self, cbWord_zero], Finset.sum_eq_zero fun m hm => ?_⟩
          rw [dqHiT, ite_pos' (by have := Finset.mem_range.mp hm; omega)]) hag.1
      rw [← a2] at hag
      obtain ⟨r1, r2⟩ := dqBits_of_agree B base cut hcut n (b + 1) _ lo _ hB'
        (fun h => by have := hlo0 h; omega)
        (fun h => by
          have := dqAdd_isSome (.n (3 + (base + b))) (cbWord (b - cut)) k hi
          rw [h] at this; exact absurd this (by decide))
        (fun v hv => by rw [hlo v hv, Finset.sum_range_succ, dqLoT, ite_neg' hb, add_zero])
        (fun v hv => by rw [a3 v hv, Finset.sum_range_succ, dqHiT, ite_neg' hb])
        hag.2
      refine ⟨⟨by rw [hb0, hbb], ?_⟩, ?_⟩
      · rw [ite_neg' hb]; exact ⟨a1, r1⟩
      · simp only [dqBits, dqBitsV, hb, ↓reduceIte, List.length_append]
        rw [r2, a2, Nat.add_assoc]

/-- The honest words of a group's position and reconstruction: `L`, `H` the runs' sums, `R` the
reconstruction so far. -/
def dqPrV (base cut d : ℕ) (L H R : E) (recon : Option V) : List E :=
  if cut < d then [cbWord cut, cbWord cut * H, L + cbWord cut * H, cbWord base, cbWord base * L,
      cbWord (base + cut), cbWord (base + cut) * H, cbWord base * L + cbWord (base + cut) * H,
      R + (cbWord base * L + cbWord (base + cut) * H)]
  else match recon with
    | none => []
    | some _ => [cbWord base, cbWord base * L, R + cbWord base * L]

theorem dqPr_of_agree {j base cut d k : ℕ} {lo hi : V} {recon : Option V} {L H R : E}
    (hlo : σ lo = L) (hhi : cut < d → σ hi = H) (hrec : ∀ v, recon = some v → σ v = R)
    (hrec0 : cut < d → recon.isSome = true)
    (hl1 : cut < d → LoadHolds rd (σ (.n 1)) j (L + cbWord cut * H))
    (hl2 : ¬ cut < d → LoadHolds rd (σ (.n 1)) j L)
    (hag : Agree σ k (dqPrV base cut d L H R recon)) :
    DqPrOk rd σ j base cut d k lo hi recon ∧
      (dqPr j base cut d k lo hi recon).2.1 = k + (dqPrV base cut d L H R recon).length := by
  unfold DqPrOk dqPr
  unfold dqPrV at hag ⊢
  by_cases hs : cut < d
  · simp only [hs, ↓reduceIte] at hag ⊢
    obtain ⟨rc, rfl⟩ := Option.isSome_iff_exists.mp (hrec0 hs)
    have a0 := hag 0 (by simp)
    have a1 := hag 1 (by simp)
    have a2 := hag 2 (by simp)
    have a3 := hag 3 (by simp)
    have a4 := hag 4 (by simp)
    have a5 := hag 5 (by simp)
    have a6 := hag 6 (by simp)
    have a7 := hag 7 (by simp)
    have a8 := hag 8 (by simp)
    simp only [List.getD_cons_zero, List.getD_cons_succ, Nat.add_zero] at a0 a1 a2 a3 a4 a5 a6 a7 a8
    refine ⟨⟨a0, by rw [a1, a0, hhi hs], by rw [a2, a1, hlo], by rw [a2]; exact hl1 hs, a3,
      by rw [a4, a3, hlo], a5, by rw [a6, a5, hhi hs], by rw [a7, a4, a6],
      by rw [a8, Option.getD_some, hrec rc rfl, a7]⟩, rfl⟩
  · simp only [hs, ↓reduceIte] at hag ⊢
    cases recon with
    | none => exact ⟨⟨by rw [hlo]; exact hl2 hs, fun _ h => absurd h (by simp)⟩, rfl⟩
    | some rc =>
      have a0 := hag 0 (by simp)
      have a1 := hag 1 (by simp)
      have a2 := hag 2 (by simp)
      simp only [List.getD_cons_zero, List.getD_cons_succ, Nat.add_zero] at a0 a1 a2
      refine ⟨⟨by rw [hlo]; exact hl2 hs, fun rc' h => ?_⟩, rfl⟩
      cases h
      exact ⟨a0, by rw [a1, a0, hlo], by rw [a2, hrec rc rfl, a1]⟩

/-- The honest words of a group's bit pointer, `P` the run. -/
def dqBpV (j base : ℕ) (P : E) : List E :=
  if j = 0 then [] else [E.ofLimbs (gpowK base) 0 0, P * E.ofLimbs (gpowK base) 0 0]

theorem dqBp_of_agree {j base k : ℕ} {P : E} (hP : σ (.n 195) = P) (hb : base < 2 ^ 128)
    (hl : LoadHolds rd (σ (.n 2)) j (P * gen ^ base)) (h0 : j = 0 → base = 0)
    (hag : Agree σ k (dqBpV j base P)) :
    DqBpOk rd σ j base k ∧ (dqBp j base k).2 = k + (dqBpV j base P).length := by
  unfold DqBpOk dqBp
  unfold dqBpV at hag ⊢
  by_cases hj : j = 0
  · simp only [ite_pos' hj]
    refine ⟨?_, rfl⟩
    rw [h0 hj, pow_zero, mul_one, ← hP] at hl
    rw [← hj]
    exact hl
  · simp only [hj, ↓reduceIte] at hag ⊢
    have a0 := hag 0 (by simp)
    have a1 := hag 1 (by simp)
    simp only [List.getD_cons_zero, List.getD_cons_succ, Nat.add_zero] at a0 a1
    exact ⟨⟨a0, by rw [a1, a0, hP], by rw [a1, ofLimbs_gpowK hb]; exact hl⟩, rfl⟩

/-- The honest words of group `j`, `B` the word's bits and `P` their run. -/
def dqGroupV (B : ℕ → E) (P : E) (d j k : ℕ) (recon : Option V) : List E :=
  dqBitsV B (j * d) (64 - j * d % 64) 0 d k none none ++
    dqPrV (j * d) (64 - j * d % 64) d (∑ m ∈ Finset.range d, dqLoT B (j * d) (64 - j * d % 64) m)
      (∑ m ∈ Finset.range d, dqHiT B (j * d) (64 - j * d % 64) m)
      (∑ i ∈ Finset.range (j * d), B i * cbWord i) recon ++
    dqBpV j (j * d) P

/-- The bit cells hold `B`, Boolean words. -/
def BitsAre (σ : Val) (B : ℕ → E) : Prop := ∀ i < 192, bitsOf σ i = B i ∧ B i * B i = B i

theorem dqGroup_of_agree {B : ℕ → E} {P : E} {d j k : ℕ} {recon : Option V} (hd0 : 0 < d)
    (hd : d ≤ 26) (hj : j * d + d ≤ 192) (hB : BitsAre σ B) (hP : σ (.n 195) = P)
    (hrec : ∀ v, recon = some v → σ v = ∑ i ∈ Finset.range (j * d), B i * cbWord i)
    (hrec0 : recon = none ↔ j = 0)
    (hpos : LoadHolds rd (σ (.n 1)) j (∑ m ∈ Finset.range d, B (j * d + m) * cbWord m))
    (hptr : LoadHolds rd (σ (.n 2)) j (P * gen ^ (j * d)))
    (hag : Agree σ k (dqGroupV B P d j k recon)) :
    DqGroupOk rd σ d j k recon ∧
      (dqGroup d j k recon).2.1 = k + (dqGroupV B P d j k recon).length := by
  unfold dqGroupV at hag ⊢
  rw [agree_append, agree_append] at hag
  obtain ⟨⟨h1, h2⟩, h3⟩ := hag
  obtain ⟨b1, b2⟩ := dqBits_of_agree (σ := σ) B (j * d) (64 - j * d % 64) (by omega) d 0 k none none
    (fun m hm => by simpa [bitsOf] using hB (j * d + m) (by omega)) (fun _ => rfl) (fun _ => by omega)
    (fun _ h => absurd h (by simp)) (fun _ h => absurd h (by simp)) h1
  obtain ⟨e1, e2, -⟩ := dqBits_value (j * d) (64 - j * d % 64) (by omega) d 0 k none none
    (fun _ => rfl) (fun _ => by omega) b1
  simp only [optVal_none σ, zero_add] at e1 e2
  have hcg : ∀ m ∈ Finset.range d, bitsOf σ (j * d + m) = B (j * d + m) :=
    fun m hm => (hB _ (by have := Finset.mem_range.mp hm; omega)).1
  have eL : ∑ m ∈ Finset.range d, dqLoT (bitsOf σ) (j * d) (64 - j * d % 64) m =
      ∑ m ∈ Finset.range d, dqLoT B (j * d) (64 - j * d % 64) m :=
    Finset.sum_congr rfl fun m hm => by unfold dqLoT; rw [hcg m hm]
  have eH : ∑ m ∈ Finset.range d, dqHiT (bitsOf σ) (j * d) (64 - j * d % 64) m =
      ∑ m ∈ Finset.range d, dqHiT B (j * d) (64 - j * d % 64) m :=
    Finset.sum_congr rfl fun m hm => by unfold dqHiT; rw [hcg m hm]
  rw [eL] at e1
  rw [eH] at e2
  have hlo := dqBits_lo_isSome (j * d) (64 - j * d % 64) d 0 k none none (Or.inr ⟨by omega, hd0⟩)
  have hhi := fun _ : 64 - j * d % 64 < d =>
    dqBits_hi_isSome (j * d) (64 - j * d % 64) d 0 k none none (Or.inr ⟨by omega, hd0⟩)
  rw [← optVal_getD hlo (.n 0)] at e1
  rw [List.length_append, ← Nat.add_assoc, ← b2] at h3
  rw [← b2] at h2
  obtain ⟨p1, p2⟩ := dqPr_of_agree (rd := rd) (j := j)
    (hi := (dqBits (j * d) (64 - j * d % 64) 0 d k none none).2.2.2.getD (.n 0)) e1
    (fun hs => by rw [optVal_getD (σ := σ) (hhi hs), e2])
    hrec
    (fun hs => by
      cases recon with
      | none => exact absurd (hrec0.mp rfl) (fun h => by subst h; omega)
      | some _ => rfl)
    (fun hs => by
      rw [Finset.mul_sum, ← Finset.sum_add_distrib, Finset.sum_congr rfl fun m hm =>
        dq_pos_term B _ _ _ (by omega) (by have := Finset.mem_range.mp hm; omega)]
      exact hpos)
    (fun hs => by
      rw [Finset.sum_congr rfl fun m hm => by
        rw [dqLoT, ite_pos' (by have := Finset.mem_range.mp hm; omega)]]
      exact hpos) h2
  rw [← p2] at h3
  obtain ⟨q1, q2⟩ := dqBp_of_agree hP (by omega) hptr (fun h => by rw [h, Nat.zero_mul]) h3
  refine ⟨⟨b1, p1, q1⟩, ?_⟩
  simp only [dqGroup, dqP, dqR, List.length_append] at q2 p2 ⊢
  rw [q2, p2, b2]
  omega

/-- The honest words of groups `j ..`. -/
def dqGroupsV (B : ℕ → E) (P : E) (d : ℕ) : ℕ → ℕ → ℕ → Option V → List E
  | _, 0, _, _ => []
  | j, n + 1, k, recon => dqGroupV B P d j k recon ++
      dqGroupsV B P d (j + 1) n (dqGroup d j k recon).2.1 (dqGroup d j k recon).2.2

theorem dqGroups_of_agree {B : ℕ → E} {P : E} {d : ℕ} (hd0 : 0 < d) (hd : d ≤ 26)
    (hB : BitsAre σ B) (hP : σ (.n 195) = P) :
    ∀ n j k recon, (j + n) * d ≤ 192 →
      (∀ v, recon = some v → σ v = ∑ i ∈ Finset.range (j * d), B i * cbWord i) →
      (recon = none ↔ j = 0) →
      (∀ c < n, LoadHolds rd (σ (.n 1)) (j + c)
          (∑ m ∈ Finset.range d, B ((j + c) * d + m) * cbWord m) ∧
        LoadHolds rd (σ (.n 2)) (j + c) (P * gen ^ ((j + c) * d))) →
      Agree σ k (dqGroupsV B P d j n k recon) →
      DqGroupsOk rd σ d j n k recon ∧
        (dqGroups d j n k recon).2.1 = k + (dqGroupsV B P d j n k recon).length
  | 0, _, _, _, _, _, _, _, _ => ⟨trivial, rfl⟩
  | n + 1, j, k, recon, hj, hrec, hrec0, hl, hag => by
    have e1 : (j + 1) * d = j * d + d := Nat.succ_mul j d
    have e2 : (j + (n + 1)) * d = (j + 1) * d + n * d := by ring
    simp only [dqGroupsV] at hag
    rw [agree_append] at hag
    obtain ⟨g1, g2⟩ := dqGroup_of_agree hd0 hd (by omega) hB hP hrec hrec0 (hl 0 (by omega)).1
      (hl 0 (by omega)).2 hag.1
    rw [← g2] at hag
    obtain ⟨-, -, -, f4, f5⟩ := dqGroup_facts hd0 hd (by omega) (fun h => hrec0.mp h) g1
    have hR : optVal σ recon = ∑ i ∈ Finset.range (j * d), B i * cbWord i := by
      cases recon with
      | none => rw [optVal_none, hrec0.mp rfl, Nat.zero_mul, Finset.sum_range_zero]
      | some v => exact hrec v rfl
    obtain ⟨r1, r2⟩ := dqGroups_of_agree hd0 hd hB hP n (j + 1) _ _
      (by rw [show j + 1 + n = j + (n + 1) by omega]; exact hj)
      (fun v hv => by
        rw [hv] at f5
        have f5' : σ v = _ := f5
        rw [f5', hR, e1, Finset.sum_range_add]
        exact congrArg _ (Finset.sum_congr rfl fun m hm =>
          by rw [(hB _ (by have := Finset.mem_range.mp hm; omega)).1]))
      ⟨fun h => by rw [h] at f4; exact absurd f4 (by decide), fun h => by omega⟩
      (fun c hc => by
        have := hl (c + 1) (by omega)
        rwa [show j + (c + 1) = j + 1 + c by omega] at this) hag.2
    refine ⟨⟨g1, r1⟩, ?_⟩
    simp only [dqGroups, dqGroupsV, List.length_append]
    rw [r2, g2, Nat.add_assoc]

/-- The honest words of the leftover bits from `i`. -/
def dqLeftV (B : ℕ → E) : ℕ → ℕ → List E
  | _, 0 => []
  | i, n + 1 => [cbWord i, B i * cbWord i, (∑ m ∈ Finset.range i, B m * cbWord m) + B i * cbWord i] ++
      dqLeftV B (i + 1) n

theorem dqLeft_of_agree {B : ℕ → E} (hB : BitsAre σ B) :
    ∀ n i k recon, i + n ≤ 192 → σ recon = ∑ m ∈ Finset.range i, B m * cbWord m →
      Agree σ k (dqLeftV B i n) → DqLeftOk σ i n k recon
  | 0, _, _, _, _, _, _ => trivial
  | n + 1, i, k, recon, hi, hr, hag => by
    simp only [dqLeftV] at hag
    rw [agree_append] at hag
    have a0 := hag.1 0 (by simp)
    have a1 := hag.1 1 (by simp)
    have a2 := hag.1 2 (by simp)
    simp only [List.getD_cons_zero, List.getD_cons_succ, Nat.add_zero] at a0 a1 a2
    obtain ⟨hb, hbb⟩ := hB i (by omega)
    unfold bitsOf at hb
    refine ⟨by rw [hb, hbb], a0, by rw [a1, hb, a0], by rw [a2, hr, a1], ?_⟩
    exact dqLeft_of_agree hB n (i + 1) (k + 3) _ (by omega) (by rw [a2, Finset.sum_range_succ]) hag.2

theorem eToNat_lt (x : E) : eToNat x < 2 ^ 192 := by
  have h0 := (x.limb 0).toBitVec.isLt
  have h1 := (x.limb 1).toBitVec.isLt
  have h2 := (x.limb 2).toBitVec.isLt
  unfold eToNat kToNat
  omega

theorem decode_query_bits_complete_aux {name : String} {f : Fn} (d : ℕ) (hd0 : 0 < d) (hd : d ≤ 26)
    (hfind : coreProgram.find? name = some f) (hparams : f.params = [.n 0, .n 1, .n 2])
    (hbody : f.body = dqBody d) (rd : Reader) (args rets : List E)
    (h : MeaningDecodeQueryBits d rd args rets) : coreProgram.Rel rd name args rets := by
  obtain ⟨w, pos, ptrs, rfl⟩ : ∃ w pos ptrs, args = [w, pos, ptrs] := by
    match args, h with
    | [a, b, c], _ => exact ⟨a, b, c, rfl⟩
  obtain ⟨rfl, p, ⟨hpK, hfr⟩, hl⟩ := h
  have hq0 : 0 < 192 / d := Nat.div_pos (by omega) hd0
  have hqd : 192 / d * d ≤ 192 := Nat.div_mul_le_self 192 d
  rw [rel_iff_sem hfind, hbody, hparams]
  unfold dqBody
  generalize 192 / d = q at *
  obtain ⟨B, hB⟩ : ∃ B : ℕ → E, B = fun i => bitE ((eToNat w).testBit i) := ⟨_, rfl⟩
  have hBi : ∀ i, B i = bitE ((eToNat w).testBit i) := fun i => by rw [hB]
  obtain ⟨vals, hvals⟩ : ∃ l, l = dqGroupsV B p d 0 q 196 none ++ dqLeftV B (q * d) (192 - q * d) :=
    ⟨_, rfl⟩
  obtain ⟨τ, hτ⟩ : ∃ τ : Val, τ = setv (setv (setv (Val.ofArgs [w, pos, ptrs]) 3 192 B) 195 1
      (fun _ => p)) 196 vals.length (fun i => vals.getD i 0) := ⟨_, rfl⟩
  have t0 : τ (.n 0) = w := by rw [hτ]; b1_look
  have t1 : τ (.n 1) = pos := by rw [hτ]; b1_look
  have t2 : τ (.n 2) = ptrs := by rw [hτ]; b1_look
  have t195 : τ (.n 195) = p := by
    rw [hτ, set_n_lt (by omega), set_n_in (by omega) (by omega)]
  have tb : BitsAre τ B := fun i hi => ⟨by
    rw [bitsOf, hτ, set_n_lt (by omega), set_n_lt (by omega), set_n_in (by omega) (by omega),
      Nat.add_sub_cancel_left], by rw [hBi]; exact bitE_mul_self _⟩
  have tv : Agree τ 196 vals := fun i hi => by
    rw [hτ, set_n_in (by omega) (by omega), Nat.add_sub_cancel_left]
  rw [hvals, agree_append] at tv
  obtain ⟨G1, G2⟩ := dqGroups_of_agree (rd := rd) hd0 hd tb t195 q 0 196 none (by simpa using hqd)
    (fun _ h => absurd h (by simp)) ⟨fun _ => rfl, fun _ => rfl⟩ (fun c hc => by
      obtain ⟨l1, l2⟩ := hl c (by omega)
      rw [t1, t2, Nat.zero_add]
      refine ⟨?_, l2⟩
      simp only [hBi]
      rw [dq_position _ _ _ (by omega)]
      exact l1) tv.1
  obtain ⟨-, -, g3, g4⟩ := dqGroups_facts hd0 hd q 0 196 none (by simpa using hqd) (fun _ => rfl)
    (Or.inl hq0) G1
  simp only [Nat.zero_mul, optVal_none τ, zero_add] at g4
  rw [← optVal_getD (σ := τ) g3 (.n 0)] at g4
  have hrv : τ ((dqGroups d 0 q 196 none).2.2.getD (.n 0)) =
      ∑ m ∈ Finset.range (q * d), B m * cbWord m := by
    rw [g4]
    exact Finset.sum_congr rfl fun m hm => by
      rw [(tb m (by have := Finset.mem_range.mp hm; omega)).1]
  have L1 := dqLeft_of_agree tb (192 - q * d) (q * d) (dqGroups d 0 q 196 none).2.1 _ (by omega) hrv
    (by rw [G2]; exact tv.2)
  obtain ⟨-, l2⟩ := dqLeft_facts _ _ _ _ L1
  have hw : τ (dqLeft (q * d) (192 - q * d) (dqGroups d 0 q 196 none).2.1
      ((dqGroups d 0 q 196 none).2.2.getD (.n 0))).2 = w := by
    rw [l2, hrv]
    have hr := reconstruct_bits 0 (eToNat_lt w)
    simp only [Nat.zero_add, pow_zero, one_mul, eOfNat192_eToNat] at hr
    rw [← hr, show Finset.range 192 = Finset.range (q * d + (192 - q * d)) by congr 1; omega,
      Finset.sum_range_add]
    simp only [← hBi, cbWord_eq]
    exact congrArg _ (Finset.sum_congr rfl fun m hm => by
      rw [(tb _ (by have := Finset.mem_range.mp hm; omega)).1])
  refine ⟨τ, by simp [t0, t1, t2], ?_⟩
  simp only [holdsList_append, List.cons_append, List.nil_append, Stmt.HoldsList, Stmt.Holds,
    Atom.Holds, true_and]
  rw [holds_dqGroups, holds_dqLeft]
  refine ⟨⟨by rw [t195]; exact hpK, fun k hk w' hw' => ?_⟩, G1, L1, ?_, rfl⟩
  · rw [t195] at hw'
    rw [hfr k (by rw [length_dqRun] at hk; exact hk) w' hw', dqRun_getElem]
    exact ((tb k (by rw [length_dqRun] at hk; exact hk)).1.trans (hBi k)).symm
  · rw [hw, t0]
    exact e_add_self w

theorem decode_query_bits_iff {name : String} {f : Fn} (d : ℕ) (hd0 : 0 < d) (hd : d ≤ 26)
    (hfind : coreProgram.find? name = some f) (hparams : f.params = [.n 0, .n 1, .n 2])
    (hbody : f.body = dqBody d) (rd : Reader) (args rets : List E) :
    coreProgram.Rel rd name args rets ↔ MeaningDecodeQueryBits d rd args rets :=
  ⟨decode_query_bits_sound_aux d hd0 hd hfind hparams hbody rd args rets,
    decode_query_bits_complete_aux d hd0 hd hfind hparams hbody rd args rets⟩

