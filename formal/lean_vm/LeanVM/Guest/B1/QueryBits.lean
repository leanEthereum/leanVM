/-
  LeanVM.Guest.B1.QueryBits

  B1 for `decode_query_bits`: a squeezed word's bits as query positions and Merkle direction
  bits, at each of its 13 depths, one generic argument.
-/

module

public import LeanVM.Guest.B1.FoldFinal

/-!
# `decode_query_bits` (TRIAGE #17)

`decode_query_bits(word, positions, bit_ptrs, depth)` (G:654-698) hints the 192 bits of `word`
into a frame run, pins each by booleanity, and for each of the `192 / depth` groups `j` stores the
position `Σ_b bit_{j·depth + b} 2^b` (a group crossing a limb boundary as two runs joined by
`COORD_BASIS[cut]`) and the pointer `bits·g^(j·depth)` to its bits; the leftover bits and the
groups reconstruct the word. That is one step of `sampleQueriesAux` (V:1598): the positions
`(eToNat word >>> (j·depth)) mod 2^depth`. The expansion is generated by `dqBody depth`, with
the compiler's folding of zero sums and unit factors, equal to the 13 specializations by kernel
evaluation.
-/

namespace LeanVM.Guest.B1

open LeanVM.Parameters LeanVM.Semantics LeanVM.Guest.Core LeanVM.Guest.Value
open LeanVM.Protocol LeanVM.Protocol.Blake2sHash LeanVM.Protocol.Compile LeanVM.Protocol.Verifier

@[expose] public section

/-! ## The template -/

/-- `COORD_BASIS[i]` as the data writes it. -/
def cbWord (i : ℕ) : E := word (2 ^ i % 2 ^ 64) (2 ^ i / 2 ^ 64 % 2 ^ 64) (2 ^ i / 2 ^ 128)

/-- A runtime sum `acc + t·c` (`acc` `none` while it is the zero the compiler folds, `c = 1` then). -/
def dqAdd (t : V) (c : E) (k : ℕ) : Option V → List Stmt × ℕ × Option V
  | none => ([], k, some t)
  | some a => ([.atom (.const (.n k) c), .atom (.mul (.n (k + 1)) t (.n k)),
      .atom (.add (.n (k + 2)) a (.n (k + 1)))], k + 3, some (.n (k + 2)))

/-- The bits `b ..` of a group at `base`: booleanity, then the low or the high run's sum. -/
def dqBits (base cut : ℕ) : ℕ → ℕ → ℕ → Option V → Option V → List Stmt × ℕ × Option V × Option V
  | _, 0, k, lo, hi => ([], k, lo, hi)
  | b, n + 1, k, lo, hi =>
    let t : V := .n (3 + (base + b))
    let r := if b < cut then
        let s := dqAdd t (cbWord b) k lo; (s.1, s.2.1, s.2.2, hi)
      else let s := dqAdd t (cbWord (b - cut)) k hi; (s.1, s.2.1, lo, s.2.2)
    let rest := dqBits base cut (b + 1) n r.2.1 r.2.2.1 r.2.2.2
    (.atom (.mul t t t) :: r.1 ++ rest.1, rest.2)

/-- A group's position and reconstruction term from its runs' sums `lo`, `hi`, from value `k`. -/
def dqPr (j base cut d k : ℕ) (lo hi : V) (recon : Option V) : List Stmt × ℕ × Option V :=
  if cut < d then
    ([.atom (.const (.n k) (cbWord cut)), .atom (.mul (.n (k + 1)) (.n k) hi),
      .atom (.add (.n (k + 2)) lo (.n (k + 1))), .atom (.load (.n (k + 2)) (.n 1) j),
      .atom (.const (.n (k + 3)) (cbWord base)), .atom (.mul (.n (k + 4)) (.n (k + 3)) lo),
      .atom (.const (.n (k + 5)) (cbWord (base + cut))),
      .atom (.mul (.n (k + 6)) (.n (k + 5)) hi), .atom (.add (.n (k + 7)) (.n (k + 4)) (.n (k + 6))),
      .atom (.add (.n (k + 8)) (recon.getD (.n 0)) (.n (k + 7)))], k + 9, some (.n (k + 8)))
  else match recon with
    | none => ([.atom (.load lo (.n 1) j)], k, some lo)
    | some rc => ([.atom (.load lo (.n 1) j), .atom (.const (.n k) (cbWord base)),
        .atom (.mul (.n (k + 1)) (.n k) lo), .atom (.add (.n (k + 2)) rc (.n (k + 1)))],
        k + 3, some (.n (k + 2)))

/-- The pointer to a group's bits, from value `k`. -/
def dqBp (j base k : ℕ) : List Stmt × ℕ :=
  if j = 0 then ([.atom (.load (.n 195) (.n 2) 0)], k) else
    ([.atom (.const (.n k) (E.ofLimbs (gpowK base) 0 0)),
      .atom (.mul (.n (k + 1)) (.n 195) (.n k)), .atom (.load (.n (k + 1)) (.n 2) j)], k + 2)

/-- The bits of group `j` of depth `d` from value `k`. -/
def dqR (d j k : ℕ) : List Stmt × ℕ × Option V × Option V :=
  dqBits (j * d) (64 - j * d % 64) 0 d k none none

/-- Its position and reconstruction, `recon` the reconstruction so far. -/
def dqP (d j k : ℕ) (recon : Option V) : List Stmt × ℕ × Option V :=
  dqPr j (j * d) (64 - j * d % 64) d (dqR d j k).2.1 ((dqR d j k).2.2.1.getD (.n 0))
    ((dqR d j k).2.2.2.getD (.n 0)) recon

/-- Group `j` of depth `d` from the value `k`. -/
def dqGroup (d j k : ℕ) (recon : Option V) : List Stmt × ℕ × Option V :=
  ((dqR d j k).1 ++ (dqP d j k recon).1 ++ (dqBp j (j * d) (dqP d j k recon).2.1).1,
    (dqBp j (j * d) (dqP d j k recon).2.1).2, (dqP d j k recon).2.2)

/-- Groups `j ..` of depth `d`. -/
def dqGroups (d : ℕ) : ℕ → ℕ → ℕ → Option V → List Stmt × ℕ × Option V
  | _, 0, k, recon => ([], k, recon)
  | j, n + 1, k, recon =>
    let g := dqGroup d j k recon
    let rest := dqGroups d (j + 1) n g.2.1 g.2.2
    (g.1 ++ rest.1, rest.2)

/-- The leftover bits `i ..`. -/
def dqLeft : ℕ → ℕ → ℕ → V → List Stmt × V
  | _, 0, _, recon => ([], recon)
  | i, n + 1, k, recon =>
    let rest := dqLeft (i + 1) n (k + 3) (.n (k + 2))
    ([.atom (.mul (.n (3 + i)) (.n (3 + i)) (.n (3 + i))), .atom (.const (.n k) (cbWord i)),
      .atom (.mul (.n (k + 1)) (.n (3 + i)) (.n k)), .atom (.add (.n (k + 2)) recon (.n (k + 1)))] ++
      rest.1, rest.2)

/-- The 192 frame cells of the bits. -/
def dqRun : List V := (List.range 192).map fun i => .n (3 + i)

/-- The expansion of `decode_query_bits` at depth `d`. -/
def dqBody (d : ℕ) : List Stmt :=
  let g := dqGroups d 0 (192 / d) 196 none
  let l := dqLeft (192 / d * d) (192 - 192 / d * d) g.2.1 (g.2.2.getD (.n 0))
  [.atom (.hint (.bits (.n 0) 0 192 (.stack dqRun))), .atom (.frameAddr (.n 195) dqRun)] ++ g.1 ++
    l.1 ++ [.atom (.assertEq l.2 (.n 0)), .ret []]

theorem core980_body : Fn.body Data.core980 = dqBody 14 := stmtsEqb_sound (by decide +kernel)

theorem core971_body : Fn.body Data.core971 = dqBody 17 := stmtsEqb_sound (by decide +kernel)

theorem core974_body : Fn.body Data.core974 = dqBody 16 := stmtsEqb_sound (by decide +kernel)

theorem core977_body : Fn.body Data.core977 = dqBody 15 := stmtsEqb_sound (by decide +kernel)

theorem core982_body : Fn.body Data.core982 = dqBody 18 := stmtsEqb_sound (by decide +kernel)

theorem core986_body : Fn.body Data.core986 = dqBody 19 := stmtsEqb_sound (by decide +kernel)

theorem core990_body : Fn.body Data.core990 = dqBody 20 := stmtsEqb_sound (by decide +kernel)

theorem core994_body : Fn.body Data.core994 = dqBody 21 := stmtsEqb_sound (by decide +kernel)

theorem core998_body : Fn.body Data.core998 = dqBody 22 := stmtsEqb_sound (by decide +kernel)

theorem core1002_body : Fn.body Data.core1002 = dqBody 23 := stmtsEqb_sound (by decide +kernel)

