/-
  LeanVM.Guest.Bytecode

  The compiled aggregation guest as a `Program`, and the fetch lemma at every pc of its
  functions.
-/

module

public import LeanVM.Guest.Data.Bytecode

/-!
# The guest bytecode

`guest` is `rec_aggregation::unified_guest()`'s bytecode: the compiled functions of
`LeanVM.Guest.Data.functions` (generated by the `guest_bytecode_lean` test of
`crates/rec_aggregation`, which fails when they are stale), laid out from pc `0` and padded with
`SET fp[0] = 0` to `2^18` instructions. A run starts at `(g^0, 1)` in `__jump_tables`, the
function at pc `0`, which falls through into `main`.

The layout and the chunking are decided once here, over the function table only (`consecutive`,
`chunked`); `guest_fetch` then gives the instruction at pc `entry + i` of any function by
evaluating that one instruction, never the program.
-/

namespace LeanVM.Guest

open LeanVM.Parameters LeanVM.Semantics

@[expose] public section

/-- The aggregation guest's bytecode. -/
def guest : Program := assemble Data.functions 18 (by decide)

theorem guest_logSize : guest.logSize = 18 := rfl

/-- The exported size is the one `guest` is assembled at. -/
theorem logSize_eq : Data.logSize = 18 := rfl

/-- The functions lie one after another from pc `0` to `codeLen`. -/
theorem functions_consecutive : consecutive 0 Data.functions Data.codeLen = true := by
  decide +kernel

theorem codeLen_lt : Data.codeLen < 2 ^ 18 - 1 := by decide

/-- Every function's chunks hold exactly its instructions. -/
theorem functions_wellChunked : Data.functions.all (fun f ↦ chunked chunkSize f.chunks f.len) = true := by
  decide +kernel

theorem CompiledFn.wellChunked_of_mem {f : CompiledFn} (hf : f ∈ Data.functions) :
    f.WellChunked :=
  List.all_eq_true.mp functions_wellChunked f hf

/-- **The fetch lemma**: pc `entry + i` of a guest function holds its instruction `i`. -/
theorem guest_fetch {f : CompiledFn} (hf : f ∈ Data.functions) {i : ℕ} (hi : i < f.len) :
    guest.fetch (gpow (f.entry + i)) = some (f.instrAt i).toInstr :=
  assemble_fetch functions_consecutive (by have := codeLen_lt; omega) hf hi

/-- `guest_fetch` at a pc and an instruction given as literals: each side condition is one
small evaluation (`decide +kernel`). -/
theorem guest_fetch_of {f : CompiledFn} (hf : f ∈ Data.functions) {i pc : ℕ} {ins : OInstr}
    (hi : i < f.len) (hpc : f.entry + i = pc) (hins : f.instrAt i = ins) :
    guest.fetch (gpow pc) = some ins.toInstr :=
  assemble_fetch_of functions_consecutive (by have := codeLen_lt; omega) hf hi hpc hins

/-- Function `j` of the table is a guest function. -/
theorem mem_functions {j : ℕ} {f : CompiledFn} (h : Data.functions[j]? = some f) :
    f ∈ Data.functions :=
  List.mem_of_getElem? h

/-- Every pc of a guest function is before the last slot. -/
theorem guest_pc_lt {f : CompiledFn} (hf : f ∈ Data.functions) {i : ℕ} (hi : i < f.len) :
    f.entry + i < 2 ^ guest.logSize - 1 :=
  Nat.lt_of_lt_of_le (lookup_of_mem functions_consecutive hf hi).2.2 (Nat.le_of_lt codeLen_lt)

/-- Past the functions, the guest holds the padding. -/
theorem guest_fetch_pad {pc : ℕ} (hpc : Data.codeLen ≤ pc) (hpc' : pc < 2 ^ 18) :
    guest.fetch (gpow pc) = some OInstr.pad.toInstr :=
  assemble_fetch_pad functions_consecutive hpc hpc'

theorem guest_sentinelSafe : SentinelSafe guest :=
  assemble_sentinelSafe functions_consecutive (by have := codeLen_lt; omega)

end
end LeanVM.Guest
