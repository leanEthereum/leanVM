/-
  LeanVM.Guest.Frames

  The frame size of each compiled function, by index and by name.
-/

module

public import LeanVM.Guest.CoreNames
public import LeanVM.Guest.Data.FrameSizes

/-!
# Frame sizes

`Data.frameSizes` (generated by `lake exe guest-cert`) is the frame size of each compiled
function by index: a loop helper's is the offset `S` at which its tail call places the next
frame (`fp · g^S`), any other function's is one past every frame cell its code and its
certificate name. `fsAt j` reads it by compiled index, `fsOf f` by name, core function `j` being
compiled function `j + 1` (`fsOf_getElem`).
-/

namespace LeanVM.Guest

open Core

@[expose] public section

/-- The frame size of compiled function `j`. -/
def fsAt (j : ℕ) : ℕ := Data.frameSizes.getD j 0

/-- The frame size of a function, by name. -/
noncomputable def fsOf (f : String) : ℕ :=
  match coreProgram.indexOf? f with
  | some j => fsAt (j + 1)
  | none => 0

theorem frameSizes_length : Data.frameSizes.length = 1044 := by decide +kernel

/-- Core function `j` is the first of its name. -/
theorem coreProgram_indexOf?_getElem {j : ℕ} (h : j < coreProgram.length) :
    coreProgram.indexOf? coreProgram[j].name = some j := by
  unfold Program.indexOf?
  rw [List.findIdx?_eq_some_iff_getElem]
  refine ⟨h, by simp, fun i hij ↦ ?_⟩
  simp only [beq_iff_eq]
  intro he
  have := (List.Nodup.getElem_inj_iff coreProgram_names_nodup (i := i) (j := j)
    (hi := by simp; omega) (hj := by simp; omega)).mp (by simpa using he)
  omega

theorem fsOf_getElem {j : ℕ} (h : j < coreProgram.length) :
    fsOf coreProgram[j].name = fsAt (j + 1) := by
  unfold fsOf
  rw [coreProgram_indexOf?_getElem h]

end
end LeanVM.Guest
