  base : Nat
  I : Nat
  pd : Nat
  cd : Nat
  odd : Nat
  N : Nat
  fn : Nat
  loop : Nat
  walk : Nat
  depth : Nat
  args : List Nat
  rets : List Nat
  deriving DecidableEq

