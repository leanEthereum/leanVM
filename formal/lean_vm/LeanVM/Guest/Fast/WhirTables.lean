module

/-!
# `open_stacked`'s positions, as literal tables

What `verify_sub`'s child proof reader takes from `open_stacked`'s template (`B1/Whir/Template.lean`
at each size's configuration at a rate's levels, `osCfgR m (r - 1)`), precomputed and checked equal
to it by kernel evaluation (`Fast/WhirTablesCheck.lean`): each size and rate's stream words, and its
levels' `level_queries` dispatches (`osQCalls`), each with the `opening_queries` call inside the
callee, as an `OsCall` of numbers. Both are at the index `(r - 1) * 11 + m`.
-/

namespace LeanVM.Guest.Fast

@[expose] public section

/-- A level's `level_queries` dispatch and the `opening_queries` call in its callee, in numbers:
the queries' shape (`Oq`: `base`, `I`, `pd`, `cd`), its odd query and its loop's iterations, the
indices of the `level_queries` specialization, of the `opening_queries` one, of its loop and of the
`walk_path` specialization its queries call (`Fast/FunctionNames.lean`), the level's depth, the
cells of the dispatch's arguments and its first return (the four returns consecutive), and the cell
`pw` of `lam^n` in the callee (its `opening_queries` call on `[4, 6, 0, pw, 1, 2, pw + 1]`,
returning `pw + 2`). -/
structure OsCall where
  base : Nat
  I : Nat
  pd : Nat
  cd : Nat
  odd : Nat
  N : Nat
  lq : Nat
  fn : Nat
  loop : Nat
  walk : Nat
  depth : Nat
  args : List Nat
  ret0 : Nat
  pw : Nat
  deriving DecidableEq

/-- The dispatch's return cells. -/
def OsCall.rets (c : OsCall) : List Nat := [c.ret0, c.ret0 + 1, c.ret0 + 2, c.ret0 + 3]

/-- The `opening_queries` call's argument cells in the callee. -/
def OsCall.qargs (c : OsCall) : List Nat := [4, 6, 0, c.pw, 1, 2, c.pw + 1]

/-- The stream words each size and rate read (`osWordsLen (osCfgR m (r - 1))`), at
`(r - 1) * 11 + m`. -/
