/-
  LeanVM.Guest.B2C.Types

  The data of B2's completeness certificates: per compiled function, the frame cells its code
  holds beyond the core values (constants, frame pointers), its call sites and table jumps, and
  its range checks' temporaries and frame runs.
-/

module

public import Mathlib.Data.Nat.Basic

/-!
# Completeness certificate data

The honest memory of a call instance holds, besides the words of its core values at their
certificate cells, what the compiled code reads from cells no core value occupies: constants a
`SET` writes once (`PC.k`), the frame pointer and its products (`PC.fpg`), the callee frame of
each call site and the target of each table jump. `Plumb` lists them for one compiled function,
generated by `lake exe guest-cert` (`Data/Plumb*.lean`) and checked by the kernel.
-/

namespace LeanVM.Guest.B2C

@[expose] public section

/-- A cell's word, fixed for the function: a `SET` immediate's limbs, or `fp · g^e`. -/
inductive PC where
  | k (k0 k1 k2 : ℕ)
  | fpg (e : ℕ)
  deriving DecidableEq, Repr

/-- A call site: its argument and return values (by number), the cell holding the callee's
frame pointer, the return pc, and the cell a fused dispatch reads its target into (`0` if
none). -/
structure Site where
  args : List ℕ
  rets : List ℕ
  q : ℕ
  r : ℕ
  tgt : ℕ
  deriving DecidableEq, Repr

/-- What a function's frame holds beyond its core values: the fixed cells `stat`, the call sites,
the table jumps `(selector value, target cell, table base)`, the range checks' temporaries and
the frame runs' values with their cells `(value, cell)`, the most instructions of each opcode
(in `Opcode`'s order) a path through the function's code runs (`pmax`), and the cells holding
several values (`sh`). -/
structure Plumb where
  stat : List (ℕ × PC) := []
  sites : List Site := []
  arms : List (ℕ × ℕ × ℕ) := []
  tmps : List (ℕ × ℕ) := []
  runs : List (ℕ × ℕ) := []
  pmax : List ℕ := []
  sh : List ℕ := []
  deriving Repr

/-- What the sharing check's window `k + 1` starts from: its first statement, the soundness window
whose cells it reads, the occupied cells (a bit set), and the known values, the shared cells'
constants `(cell, limbs)` and keys `(cell, op, input cells)` handed on. -/
structure Snap where
  start : ℕ
  win : ℕ
  occ : ℕ
  named : List ℕ
  cst : List (ℕ × ℕ × ℕ × ℕ)
  keys : List (ℕ × ℕ × List ℕ)
  deriving Repr

end
end LeanVM.Guest.B2C
