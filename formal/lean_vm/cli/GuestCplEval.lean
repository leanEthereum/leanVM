import LeanVM.Guest.Compiled.Input
import LeanVM.Guest.Compiled.Cpl.Eval.Places

/-!
# `guest-cpleval`: the kernel's per-function completeness checks of the guest

Places the guest (the back end's input as `guest-traced` makes it, `GuestInput.input`) natively
and writes the modules in which the kernel decides `Cpl.cplOkAt i` for every entry `i`
(`Guest/Compiled/Cpl/Eval/`), and `Eval/All.lean`, which collects them into
`CplEval.cplOkAll : Cpl.CplOkAll`:

* `R{k}.lean`: runs of entries, each run of at most `maxDecl` instructions in one declaration;
  an entry larger than that by two declarations, each a group of the test's conjuncts
  (`CplEval.partsOk`); the entries `cutEntries`, which the pieces place in parts, on the placed
  function their walk's last state gives (`placedOf … cut{j}_end`, `CplEval.placedAt_cut`), with
  no placement run;
* `B{j}.lean`, `B{j}P{m}.lean`, `B{j}Pl{m}.lean`, `B{j}Ok.lean` for the entries `bigEntries`: the
  temporaries of each run of top-level statements, the scope walk's state after each run and the
  counts of the temporaries' cells after each chunk of instructions written out (`B{j}`), the run
  checks (`CplEval.segOk`), the walk's and the counts' steps (`B{j}P{m}`), the places conjunct by
  chunks of codes and runs of values (`B{j}Pl{m}`, `Eval/Places.lean`), and their assembly
  (`CplEval.cplOk_big`, `CplEval.places_big`, `B{j}Ok`).

`lake exe guest-cpleval --check` writes nothing and fails when a file differs. Every state written
out is computed here natively; the kernel checks each step.
-/

open LeanVM.Parameters LeanVM.Semantics LeanVM.Guest LeanVM.Guest.Core LeanVM.Guest.Memory
  LeanVM.Compiler LeanVM.Guest.Compiled LeanVM.Guest.Compiled.GuestInput

namespace GuestCplEval

def maxDecl : Nat := 1000
def maxModule : Nat := 9000
/-- Entries the pieces place in parts, tested on the last state of their walk. -/
def cutEntries : List Nat := [11, 19, 20, 36]
/-- Entries of `cutEntries` tested by runs of top-level statements. -/
def bigEntries : List Nat := [19, 36]
/-- A run's budget: values named, atoms and events, summed. -/
def maxSeg : Nat := 60000
/-- Instructions per counts step. -/
def maxChunk : Nat := 30000
/-- A big entry's part modules: their budget in runs' weight. -/
def maxPartModule : Nat := 150000
/-- A big entry's data modules: their budget in characters. -/
def maxData : Nat := 700000
/-- The depth of the subtrees of a big entry's places checked apart, and how many a module. -/
def nsDepth : Nat := 3
def nsPerModule : Nat := 2
/-- A big entry's place codes checked per declaration. -/
def maxCodes : Nat := 16384
/-- A big entry's values named per declaration of the places check. -/
def maxVals : Nat := 30000
/-- A big entry's places modules: their budget in codes and values named. -/
def maxPlModule : Nat := 70000

def evalDir : System.FilePath := "LeanVM/Guest/Compiled/Cpl/Eval"
def modBase : String := "LeanVM.Guest.Compiled.Cpl.Eval"

def header (m what : String) : String :=
  s!"/-\n  {modBase}.{m}\n\n  Generated by `lake exe guest-cpleval` (lean_vm/cli/GuestCplEval.lean); do not edit.\n  {what}\n-/\n\nmodule\n\n"

def opening : String :=
  "\nset_option Elab.async false\nset_option maxRecDepth 100000\n\nnamespace LeanVM.Guest.Compiled.CplEval\n\nopen LeanVM.Guest LeanVM.Guest.Core LeanVM.Guest.Memory LeanVM.Compiler LeanVM.Guest.Compiled.Cpl\n  GuestPiece Complete\n\n@[expose] public section\n"

def closing : String := "\nend\nend LeanVM.Guest.Compiled.CplEval\n"

def pV (v : V) : String := s!"⟨[], 0, {v.idx}⟩"

/-- A list literal: `::` past 31 items (the `[…]` notation then elaborates to `let`s). -/
def pList (items : List String) : String :=
  if items.length < 32 then s!"[{", ".intercalate items}]"
  else s!"({" :: ".intercalate items} :: [])"

def pVs (vs : List V) : String := pList (vs.map pV)

/-! Printers of `guest-pieces` (cli/GuestPieces.lean). -/

def pStrs (ss : List String) : String := pList (ss.map String.quote)

def pPair (x : Nat × Nat) : String := s!"({x.1}, {x.2})"

def pLoopInfo (li : LoopInfo) : String :=
  s!"⟨{li.registered}, {match li.hi with | some h => s!"some {h}" | none => "none"}⟩"

def pKVal : KVal → String
  | .frameSize => "KVal.frameSize"
  | .const a b => s!"(KVal.const {a} {b})"
  | .entry f => s!"(KVal.entry {f.quote})"
  | .endSentinel => "KVal.endSentinel"
  | .local i => s!"(KVal.local {i})"
  | .at f i => s!"(KVal.at {f.quote} {i})"

def pMode : DerefMode → String
  | .cell => ".cell" | .pc => ".pc" | .fp => ".fp"

def pCells : KeccakOutputCells → String
  | .one => ".one" | .two => ".two" | .all => ".all"

def pOpt {α : Type} (pa : α → String) : Option α → String
  | some a => s!"(some {pa a})"
  | none => "none"

def pLoc : Loc → String
  | .cell n => s!"(Loc.cell {n})"
  | .shifted n e => s!"(Loc.shifted {n} {e})"

def pBits : BitsDest → String
  | .stack b => s!"(BitsDest.stack {b})"
  | .heap p => s!"(BitsDest.heap {p})"

def pRHint : RHint → String
  | .frameAddress n => s!"(RHint.frameAddress {n})"
  | .allocFrames p sz b si t => s!"(RHint.allocFrames {p} {sz} {b} {si} {t})"
  | .alloc p sz => s!"(RHint.alloc {p} {sz})"
  | .allocDyn p sz => s!"(RHint.allocDyn {p} {sz})"
  | .witnessStack s b n => s!"(RHint.witnessStack {s.quote} {b} {n})"
  | .witnessHeap s p lo n => s!"(RHint.witnessHeap {s.quote} {p} {lo} {n})"
  | .log2Ceil b d nb fl => s!"(RHint.log2Ceil {pBits b} {d} {nb} {fl})"
  | .bitDecompose v b nb => s!"(RHint.bitDecompose {v} {pBits b} {nb})"
  | .bitDecomposeExp v b nb => s!"(RHint.bitDecomposeExp {v} {pBits b} {nb})"
  | .digitDecomposeExp v d nb nd db st sc =>
      s!"(RHint.digitDecomposeExp {v} {pBits d} {nb} {nd} {db} {st} {pOpt toString sc})"
  | .windowsExp v d sk st w c => s!"(RHint.windowsExp {v} {pBits d} {sk} {st} {w} {c})"
  | .fieldLimbs v b n => s!"(RHint.fieldLimbs {v} {b} {n})"
  | .inverse v d => s!"(RHint.inverse {v} {d})"

def pCount : LoopCount → String
  | .constant n => s!"(LoopCount.constant {n})"
  | .bound c st => s!"(LoopCount.bound {c} {st})"

def pLHint : LHint → String
  | .nextFrameAddress => "LHint.nextFrameAddress"
  | .allocLoopFrames p c n t => s!"(LHint.allocLoopFrames {p} {c.quote} {pCount n} {t})"
  | .allocFrame p c => s!"(LHint.allocFrame {p} {c.quote})"
  | .allocFrameMax p cs => s!"(LHint.allocFrameMax {p} {pStrs cs})"
  | .resolved h => s!"(LHint.resolved {pRHint h})"

def pHints (hs : List LHint) : String := pList (hs.map pLHint)

def pLOp : LOp → String
  | .mulNextFrame a b c => s!"(LOp.mulNextFrame {a} {b} {c})"
  | .set o k => s!"(LOp.set {o} {pKVal k})"
  | .xor a b c => s!"(LOp.xor {a} {b} {c})"
  | .mul a b c => s!"(LOp.mul {a} {b} {c})"
  | .deref a b c m => s!"(LOp.deref {a} {b} {c} {pMode m})"
  | .jump a b c => s!"(LOp.jump {a} {b} {c})"
  | .slot x f d => s!"(LOp.slot {x} {f} {d})"
  | .keccak m0 m1 m2 m3 tail b8 cap out inOdd outOdd cells =>
      s!"(LOp.keccak {m0} {m1} {m2} {m3} {tail} {b8} {cap} {out} {inOdd} {outOdd} {pCells cells})"

def pNats (ns : List Nat) : String := pList (ns.map toString)

partial def pPStmt : PStmt → String
  | .op hs o => s!"(PStmt.op {pHints hs} {pLOp o})"
  | .ite hs c bd sfp z he ed one nz =>
      s!"(PStmt.ite {pHints hs} {c} {bd} {sfp} {pList (z.map pPStmt)} {he} {ed} {one} {pList (nz.map pPStmt)})"
  | .chain hs join x entry one sfp firsts stages =>
      s!"(PStmt.chain {pHints hs} {join} {x} {entry} {one} {sfp} {pNats firsts} " ++
      s!"{pList (stages.map fun st => pList (st.map fun a => pList (a.map pPStmt)))})"
  | .call hs c =>
      s!"(PStmt.call {pHints hs} ⟨{c.callee.quote}, {c.nfp}, {c.entry}, {c.oc}, {pNats c.args}, " ++
      s!"{pNats c.rets}, {pOpt pCount c.loop}, {c.tail}⟩)"
  | .loopNext hs callee nfp entry oc one args =>
      s!"(PStmt.loopNext {pHints hs} {callee.quote} {nfp} {entry} {oc} {one} {pNats args})"
  | .dispatch hs callees nfp jc x entry one first args rets =>
      s!"(PStmt.dispatch {pHints hs} {pStrs callees} {nfp} {jc} {x} {entry} {one} {first} {pNats args} {pNats rets})"
  | .ret hs one => s!"(PStmt.ret {pHints hs} {one})"
  | .halt hs one dest => s!"(PStmt.halt {pHints hs} {one} {dest})"


/-- A trie's entries. -/
partial def trieEntries {α : Type} (t : Trie α) : List α :=
  match t with
  | .nil => []
  | .node v l r => v.toList ++ trieEntries l ++ trieEntries r

/-- A list split into definitions of at most `maxDef` characters, `name` their concatenation. -/
def chunkedDefs (doc name ty : String) (items : List String) : String := Id.run do
  let mut chunks : Array (List String) := #[]
  let mut cur : Array String := #[]
  let mut size := 0
  for it in items do
    if size + it.length + 4 > 24000 && !cur.isEmpty then
      chunks := chunks.push cur.toList
      cur := #[]
      size := 0
    cur := cur.push it
    size := size + it.length + 4
  if !cur.isEmpty || chunks.isEmpty then chunks := chunks.push cur.toList
  let names := (List.range chunks.size).map fun i => s!"{name}_c{i}"
  let parts := (chunks.toList.zip names).map fun (c, n) =>
    s!"\n/-- Part of `{name}`. -/\ndef {n} : List {ty} :=\n  {pList c}\n"
  return String.join parts ++ s!"\n/-- {doc} -/\ndef {name} : List {ty} :=\n  List.flatten {pList names}\n"

def tfOf (j : Nat) : String := s!"(guestTraced.getD {j} default)"

/-- The events a statement's scope walk consumes, its uses and atoms: its weight. -/
structure Seg where
  a : Nat
  m : Nat
  w : Nat

/-- Runs of items of weight at most `budget` (a heavier item alone). -/
def segsBy (budget : Nat) (ws : List Nat) : List Seg := Id.run do
  let mut out : Array Seg := #[]
  let mut a := 0
  let mut acc := 0
  for (w, k) in ws.zipIdx do
    if k > a && acc + w > budget then
      out := out.push ⟨a, k - a, acc⟩
      a := k
      acc := 0
    acc := acc + w
  out := out.push ⟨a, ws.length - a, acc⟩
  return out.toList

/-- Runs of statements of weight at most `maxSeg` (a heavier statement alone). -/
def segsOf (ws : List Nat) : List Seg := segsBy maxSeg ws

/-- A big entry's places check by parts (`CplEval.places_big`): its declarations with their
weights, and the proof of `partsOk [8] j pf{j}` from them. -/
def placesParts (j : Nat) (tf : TracedFn) : List (Nat × String) × String := Id.run do
  let tfs := tfOf j
  let body := tf.core.body
  let N := (LeanVM.Cost.Decoder.guestPlacesList.getD (j + 1) []).length
  let mut items : Array (Nat × String) := #[(1, s!"\n/-- The places of entry {j} are values `⟨[], 0, k⟩`. -/\ntheorem plk{j} : keysNumbered pf{j}.locs.t = true := by\n  decide +kernel\n\n/-- Entry {j}'s row of place codes. -/\ntheorem pln{j} : (placesRow {j}).length = {N} := by\n  decide +kernel\n\n/-- Entry {j}'s parameters have place codes. -/\ntheorem plp{j} : {tfs}.core.params.all (valBelow {N}) = true := by\n  decide +kernel\n")]
  let nc := (N + maxCodes - 1) / maxCodes
  for q in List.range nc do
    let a := q * maxCodes
    items := items.push (maxCodes, s!"\n/-- The codes of entry {j}'s values {a} to {min N (a + maxCodes) - 1}. -/\ntheorem plc{j}_{q} : codesFrom pf{j}.locs {a} (((placesRow {j}).drop {a}).take {maxCodes}) = true := by\n  decide +kernel\n")
  let codesChain := (List.range nc).foldr (fun q acc => s!"(codesFrom_part plc{j}_{q} {acc})")
    s!"(codesFrom_end (k := {nc * maxCodes}) (by rw [pln{j}]; decide))"
  let segs := segsBy maxVals (body.map fun st => (Stmt.valsList [st]).length)
  let mut steps : Array String := #[]
  for (g, k) in segs.zipIdx do
    let arms? : Option (List (List Stmt)) := match body[g.a]? with
      | some (.match_ _ arms) => if g.m == 1 && g.w > maxVals then some arms else none
      | _ => none
    match arms? with
    | none =>
      items := items.push (g.w, s!"\n/-- The values statements {g.a} to {g.a + g.m - 1} of entry {j} name have place codes. -/\ntheorem plv{j}_{k} : (Stmt.valsList (({tfs}.core.body.drop {g.a}).take {g.m})).all (valBelow {N}) = true := by\n  decide +kernel\n")
      steps := steps.push s!"plv{j}_{k}"
    | some arms =>
      let armsAt := s!"(armsOf ({tfs}.core.body.getD {g.a} default))"
      items := items.push (1, s!"\ntheorem plm{j}_{k} : isMatchAt {tfs}.core.body {g.a} = true := by\n  decide +kernel\n\ntheorem plx{j}_{k} : valBelow {N} (selOf ({tfs}.core.body.getD {g.a} default)) = true := by\n  decide +kernel\n")
      let runs := segsBy maxVals (arms.map fun a => (Stmt.valsList a).length)
      for (r, ri) in runs.zipIdx do
        items := items.push (r.w, s!"\n/-- The values arms {r.a} to {r.a + r.m - 1} of statement {g.a} of entry {j} name have place codes. -/\ntheorem pla{j}_{k}_{ri} : (Stmt.valsArms (({armsAt}.drop {r.a}).take {r.m})).all (valBelow {N}) = true := by\n  decide +kernel\n")
      let armsChain := runs.zipIdx.foldr (fun (_, ri) acc => s!"(valsArms_part pla{j}_{k}_{ri} {acc})")
        s!"(valsArms_end (k := {arms.length}) (by decide +kernel))"
      steps := steps.push s!"(vals_match plm{j}_{k} plx{j}_{k}\n      {armsChain})"
  let valsChain := steps.toList.foldr (fun s acc => s!"(all_part valsList_append {s}\n    {acc})")
    s!"(all_end (g := Stmt.valsList) rfl (k := {body.length}) (by decide +kernel))"
  return (items.toList, s!"places_big plk{j}\n    {codesChain}\n    pln{j} plp{j}\n    {valsChain}")

/-- The proof that the subtree `t` at depth `d`, number `q`, has no shift by `g^0`, from the leaves'. -/
def nsNode (j : Nat) (leafName : Nat → String) (d q : Nat) (t : String) : String :=
  if _ : d < nsDepth then
    s!"(trieVals_all (t := {t}) (by decide +kernel)\n      {nsNode j leafName (d + 1) (2 * q) s!"(Trie.left {t})"}\n      {nsNode j leafName (d + 1) (2 * q + 1) s!"(Trie.right {t})"})"
  else leafName q
termination_by nsDepth - d

/-- A big entry's modules. -/
def bigFiles (j : Nat) (tf : TracedFn) (pf : Placed) : Except String (List (String × String)) := do
  let tfs := tfOf j
  let body := tf.core.body
  let rc := tf.rets
  let S0 : Complete.SSt := ⟨tf.trace.toList, Complete.addLive {} tf.core.params, false⟩
  -- the weights: events of the scope walk, values named, atoms
  let mut ws : Array Nat := #[]
  let mut s := S0
  for st in body do
    let s' ← Complete.scopeBlock rc [st] s
    ws := ws.push (s.rest.length - s'.rest.length + (Stmt.usesList [st]).length +
      (Lift.blockAtoms [st]).length)
    s := s'
  let segs := segsOf ws.toList
  let TL := Stmt.tmpsList body
  let c : CplEval.BigC := ⟨tf.core.name, pf.locs, TL, if j = 0 then 0 else pf.fn.frameSize,
    tf.core.params.length⟩
  let allVals := (tf.core.params ++ tf.trace.toList.flatMap fun e => match e with
    | .alloc vs _ => vs
    | _ => [])
  let allVals := (allVals.foldl (fun (seen, acc) v =>
    if seen.contains v then (seen, acc) else (seen.insert v, acc.push v))
    ((∅ : Std.HashSet V), (#[] : Array V))).2.toList
  -- data: temporaries per run, states after each run, counts after each chunk
  let mut data := ""
  let mut prev := S0
  let mut dataParts : Array String := #[]
  let mut items : Array (Nat × String) := #[]
  let mut okItems := ""
  for (g, k) in segs.zipIdx do
    let seg := (body.drop g.a).take g.m
    let L := Stmt.tmpsList seg
    if !CplEval.segOk c seg L then throw s!"entry {j}: run {g.a}+{g.m} fails"
    let segT := s!"(({tfs}.core.body.drop {g.a}).take {g.m})"
    let Sexpr := if k = 0 then s!"⟨{tfs}.trace.toList, addLive \{} {tfs}.core.params, false⟩" else s!"sc{j}_{k}"
    let base := if k = 0 then "{}" else s!"sc{j}_{k}.live"
    let nxt ← Complete.scopeBlock rc seg prev
    let bigMatch : Option (List (List Stmt)) := match body[g.a]? with
      | some (.match_ _ arms) => if g.m == 1 && g.w > maxSeg then some arms else none
      | _ => none
    match bigMatch with
    | none =>
      data := data ++ s!"\n/-- The temporaries of statements {g.a} to {g.a + g.m - 1} of entry {j}. -/\ndef tl{j}_{k} : List V := {pVs L}\n"
      let ev := tf.trace.size - nxt.rest.length
      let added := allVals.filter fun v => nxt.live.contains v && !(k > 0 && prev.live.contains v)
      data := data ++ chunkedDefs s!"The values the scope walk of entry {j} puts in scope over statements {g.a} to {g.a + g.m - 1}." s!"sc{j}_{k + 1}_add" "(V × Unit)" (added.map fun v => s!"({pV v}, ())")
      data := data ++ s!"\n/-- The scope walk of entry {j} after statement {g.a + g.m - 1}. -/\nstate_lit sc{j}_{k + 1} : SSt :=\n  \{ rest := traceRest {tfs} {ev},\n    live := KMap.insertAll {base} sc{j}_{k + 1}_add,\n    retDone := {nxt.retDone} }\n"
      items := items.push (g.w, s!"\n/-- Statements {g.a} to {g.a + g.m - 1} of entry {j}. -/\ntheorem seg{j}_{k} : segOk big{j} {segT} tl{j}_{k} = true := by\n  decide +kernel\n\n/-- The scope walk of entry {j} over statements {g.a} to {g.a + g.m - 1}. -/\nkernel_rfl scope{j}_{k} :\n    scopeBlock {tfs}.rets {segT}\n      {Sexpr} = .ok sc{j}_{k + 1}\n")
    | some arms =>
      let S1 ← Complete.flushEdge rc prev
      let added := allVals.filter fun v => S1.live.contains v && !(k > 0 && prev.live.contains v)
      data := data ++ chunkedDefs s!"The values made before statement {g.a} of entry {j}." s!"scm{j}_{k}_0_add" "(V × Unit)" (added.map fun v => s!"({pV v}, ())")
      data := data ++ s!"\n/-- The scope walk of entry {j} at the `match` of statement {g.a}. -/\nstate_lit scm{j}_{k}_0 : SSt :=\n  \{ rest := traceRest {tfs} {tf.trace.size - S1.rest.length},\n    live := KMap.insertAll {base} scm{j}_{k}_0_add,\n    retDone := {S1.retDone} }\n"
      let mut aw : Array Nat := #[]
      let mut T := S1
      for arm in arms do
        let T1 ← Complete.scopeInner rc (fun s' => Complete.scopeBlock rc arm s') T
        aw := aw.push (T.rest.length - T1.rest.length + (Stmt.usesList arm).length + (Lift.blockAtoms arm).length)
        T := { T1 with retDone := T.retDone }
      let runs := segsOf aw.toList
      let armsAt := s!"(armsOf ({tfs}.core.body.getD {g.a} default))"
      let mut Tc := S1
      let mut acc := S1.retDone
      let mut tlms : Array String := #[]
      for (r, ri) in runs.zipIdx do
        let rarms := (arms.drop r.a).take r.m
        let Lr := Stmt.tmpsArms rarms
        if !CplEval.armsOk c rarms Lr then throw s!"entry {j}: arms {r.a}+{r.m} of statement {g.a} fail"
        data := data ++ s!"\n/-- The temporaries of arms {r.a} to {r.a + r.m - 1} of statement {g.a} of entry {j}. -/\ndef tlm{j}_{k}_{ri} : List V := {pVs Lr}\n"
        tlms := tlms.push s!"tlm{j}_{k}_{ri}"
        let (T', acc') ← CplEval.armsRun rc rarms Tc acc
        data := data ++ s!"\n/-- The scope walk of entry {j} after arm {r.a + r.m - 1} of statement {g.a}. -/\nstate_lit scm{j}_{k}_{ri + 1} : SSt :=\n  \{ rest := traceRest {tfs} {tf.trace.size - T'.rest.length},\n    live := KMap.insertAll scm{j}_{k}_0.live [],\n    retDone := {T'.retDone} }\n"
        let accS := if ri = 0 then s!"scm{j}_{k}_0.retDone" else toString acc
        let armsT := s!"(({armsAt}.drop {r.a}).take {r.m})"
        items := items.push (r.w, s!"\n/-- Arms {r.a} to {r.a + r.m - 1} of statement {g.a} of entry {j}. -/\ntheorem segm{j}_{k}_{ri} : armsOk big{j} {armsT} tlm{j}_{k}_{ri} = true := by\n  decide +kernel\n\n/-- The scope walk of entry {j} over arms {r.a} to {r.a + r.m - 1} of statement {g.a}. -/\nkernel_rfl scar{j}_{k}_{ri} :\n    armsRun {tfs}.rets {armsT}\n      scm{j}_{k}_{ri} {accS} = .ok (scm{j}_{k}_{ri + 1}, {acc'})\n")
        Tc := T'
        acc := acc'
      let S2 ← Complete.expectS isEmit "a match" { Tc with retDone := acc }
      if S2.rest.length != nxt.rest.length || S2.retDone != nxt.retDone then
        throw s!"entry {j}: statement {g.a} by arms differs"
      let tlDef := tlms.foldr (fun t a => s!"{t} ++ ({a})") "[]"
      data := data ++ s!"\n/-- The temporaries of statement {g.a} of entry {j}. -/\ndef tl{j}_{k} : List V := {tlDef}\n"
      let added2 := allVals.filter fun v => S2.live.contains v && !S1.live.contains v
      data := data ++ chunkedDefs s!"The values the `match` of statement {g.a} of entry {j} puts in scope." s!"sc{j}_{k + 1}_add" "(V × Unit)" (added2.map fun v => s!"({pV v}, ())")
      data := data ++ s!"\n/-- The scope walk of entry {j} after statement {g.a}. -/\nstate_lit sc{j}_{k + 1} : SSt :=\n  \{ rest := traceRest {tfs} {tf.trace.size - S2.rest.length},\n    live := KMap.insertAll scm{j}_{k}_0.live sc{j}_{k + 1}_add,\n    retDone := {S2.retDone} }\n"
      let R := runs.length
      let armsChain := runs.zipIdx.foldr (fun (_, ri) a => s!"(arms_part segm{j}_{k}_{ri} {a})")
        s!"(arms_end (k := {arms.length}) (by decide +kernel))"
      let scarChain := runs.zipIdx.foldr (fun (_, ri) a => s!"(armsRun_part scar{j}_{k}_{ri} {a})")
        s!"(armsRun_end (k := {arms.length}) (by decide +kernel))"
      items := items.push (1, s!"\ntheorem ism{j}_{k} : isMatchAt {tfs}.core.body {g.a} = true := by\n  decide +kernel\n\ntheorem selm{j}_{k} : useOk big{j} (selOf ({tfs}.core.body.getD {g.a} default)) = true := by\n  decide +kernel\n\nkernel_rfl scpre{j}_{k} :\n    flushEdge {tfs}.rets {Sexpr} = .ok scm{j}_{k}_0\n\nkernel_rfl scx{j}_{k} :\n    needScope scm{j}_{k}_0.live [selOf ({tfs}.core.body.getD {g.a} default)] \"a match\" = .ok ()\n\nkernel_rfl scpo{j}_{k} :\n    expectS isEmit \"a match\" \{ scm{j}_{k}_{R} with retDone := {acc} } = .ok sc{j}_{k + 1}\n")
      okItems := okItems ++ s!"\n/-- Statement {g.a} of entry {j}, by runs of arms. -/\ntheorem seg{j}_{k} : segOk big{j} {segT} tl{j}_{k} = true :=\n  seg_match ism{j}_{k} selm{j}_{k}\n    {armsChain}\n\n/-- The scope walk of entry {j} over statement {g.a}, by runs of arms. -/\ntheorem scope{j}_{k} : scopeBlock {tfs}.rets {segT} {Sexpr} = .ok sc{j}_{k + 1} :=\n  scope_match ism{j}_{k} scpre{j}_{k} scx{j}_{k}\n    {scarChain}\n    scpo{j}_{k}\n"
    let n := prev.rest.length - nxt.rest.length
    let made := Complete.allocsOf (prev.rest.take n)
    let seenBase := if k = 0 then "{}" else s!"sn{j}_{k}"
    let madeE := (if k = 0 then tf.core.params else []) ++ made
    data := data ++ chunkedDefs s!"The values the trace of entry {j} makes over statements {g.a} to {g.a + g.m - 1}." s!"sn{j}_{k + 1}_add" "(V × Unit)" (madeE.map fun v => s!"({pV v}, ())")
    data := data ++ s!"\n/-- The values made by the trace of entry {j} up to statement {g.a + g.m - 1}. -/\nstate_lit sn{j}_{k + 1} : VMap Unit := KMap.insertAll {seenBase} sn{j}_{k + 1}_add\n"
    let R := if k = 0 then s!"{tfs}.trace.toList" else s!"sc{j}_{k}.rest"
    let M0 := if k = 0 then s!"(addLive \{} {tfs}.core.params)" else s!"sn{j}_{k}"
    items := items.push (n, s!"\n/-- The values the trace of entry {j} makes over statements {g.a} to {g.a + g.m - 1} are new. -/\nkernel_rfl once{j}_{k} :\n    onceRun {M0} (allocsOf ({R}.take {n})) = some sn{j}_{k + 1}\n\nkernel_rfl rst{j}_{k} :\n    sc{j}_{k + 1}.rest = {R}.drop {n}\n")
    prev := nxt
    if data.length > maxData then
      dataParts := dataParts.push data
      data := ""
  let K := segs.length
  let lastMade := Complete.allocsOf prev.rest
  data := data ++ chunkedDefs s!"The values the trace of entry {j} makes after its last statement." s!"sn{j}_{K + 1}_add" "(V × Unit)" (lastMade.map fun v => s!"({pV v}, ())")
  data := data ++ s!"\n/-- The values made by the trace of entry {j}. -/\nstate_lit sn{j}_{K + 1} : VMap Unit := KMap.insertAll sn{j}_{K} sn{j}_{K + 1}_add\n"
  items := items.push (1, s!"\nkernel_rfl once{j}_{K} :\n    onceRun sn{j}_{K} (allocsOf sc{j}_{K}.rest) = some sn{j}_{K + 1}\n")
  let onceChain := segs.zipIdx.foldr (fun (_, k) a => s!"(once_part once{j}_{k} rst{j}_{k} {a})") s!"once{j}_{K}"
  match Complete.flushAt rc prev with
  | .ok fin => if !fin.rest.isEmpty then throw s!"entry {j}: trace left"
  | .error e => throw s!"entry {j}: {e}"
  let tlDef := segs.zipIdx.foldr (fun (_, k) acc => s!"tl{j}_{k} ++ ({acc})") "[]"
  data := data ++ s!"\n/-- The temporaries of entry {j}. -/\ndef TL{j} : List V := {tlDef}\n"
  data := data ++ s!"\n/-- The placed function of entry {j}. -/\nnoncomputable abbrev pf{j} : Placed := (placedOf {tfs} cut{j}_end).1\n"
  data := data ++ s!"\n/-- What the run checks of entry {j} read. -/\nnoncomputable abbrev big{j} : BigC :=\n  ⟨{tfs}.core.name, pf{j}.locs, TL{j}, fsWant {j}, {tfs}.core.params.length⟩\n"
  let ops := (blockOps pf.fn.body 0).toArray
  let TA := Complete.tmpCellSet pf.locs TL
  let tcells := TL.filterMap (Complete.cellP pf.locs ·)
  let mut M : NMap Nat := {}
  let mut k := 0
  let mut chunks : Array (Nat × Nat) := #[]
  let mut fps : Array Nat := #[]
  while k < ops.size do
    let sz := min maxChunk (ops.size - k)
    M := (ops.extract k (k + sz)).toList.foldl (CplEval.cntStep TA) M
    let es := tcells.filterMap fun c => (M.get? c).map fun n => s!"({c}, {n})"
    data := data ++ s!"\n/-- The counts of entry {j}'s temporaries' cells after {k + sz} instructions. -/\ndef cn{j}_{chunks.size + 1} : NMap ℕ := NMap.insertAll \{} {pList es}\n"
    for o in (ops.extract k (k + sz)).toList do
      if let .deref p _ _ .fp := o then
        if !fps.contains p then fps := fps.push p
    data := data ++ s!"\n/-- The frame pointers' cells of entry {j} after {k + sz} instructions. -/\ndef fp{j}_{chunks.size + 1} : NMap Unit := NMap.insertAll \{} {pList (fps.toList.map fun p => s!"({p}, ())")}\n"
    chunks := chunks.push (k, sz)
    k := k + sz
  let nC := chunks.size
  let F := ops.toList.foldl CplEval.fpStep {}
  if !ops.all (CplEval.tmpOpOk TA F) then throw s!"entry {j}: tmpOpsB fails"
  let dataImp (d : Nat) : String := if d = 0 then
      "public import LeanVM.Guest.Compiled.Cpl.Eval.Split\npublic import LeanVM.Guest.Compiled.Compiled\npublic import LeanVM.Compiler.StateLit\n"
    else s!"public import {modBase}.B{j}D{d - 1}\n"
  let mut files : List (String × String) := (dataParts.toList.zipIdx).map fun (t, d) =>
    (s!"B{j}D{d}", header s!"B{j}D{d}" s!"The data of entry {j}'s test by parts, part {d}." ++ dataImp d ++ opening ++ t ++ closing)
  let dataMod := header s!"B{j}" s!"The data of entry {j}'s test by parts: temporaries, scope states, counts." ++
    dataImp dataParts.size ++ opening ++ data ++ closing
  files := files ++ [(s!"B{j}", dataMod)]
  let mut cur := ""
  let mut curW := 0
  let mut nmod := 0
  let flush (nmod : Nat) (cur : String) : String × String :=
    (s!"B{j}P{nmod}", header s!"B{j}P{nmod}" s!"The kernel's checks of entry {j}'s test, by parts." ++
      s!"public import {modBase}.B{j}\npublic import LeanVM.Guest.KernelLit\n" ++ opening ++ cur ++ closing)
  for (w, thm) in items do
    if curW > 0 && curW + w > maxPartModule then
      files := files ++ [flush nmod cur]
      nmod := nmod + 1
      cur := ""
      curW := 0
    cur := cur ++ thm
    curW := curW + w
  for ((k0, sz), i) in chunks.toList.zipIdx do
    let M0 := if i = 0 then "{}" else s!"cn{j}_{i}"
    let F0 := if i = 0 then "{}" else s!"fp{j}_{i}"
    let ch := s!"((blockOpsFrom pf{j}.fn.body 0 {k0}).take {sz})"
    cur := cur ++ s!"\n/-- The counts over instructions {k0} to {k0 + sz - 1} of entry {j}. -/\nkernel_rfl cnt{j}_{i} :\n    {ch}.foldl (cntStep big{j}.TA) {M0} = cn{j}_{i + 1}\n\n/-- The frame pointers' cells over instructions {k0} to {k0 + sz - 1} of entry {j}. -/\nkernel_rfl fps{j}_{i} :\n    {ch}.foldl fpStep {F0} = fp{j}_{i + 1}\n\n/-- Instructions {k0} to {k0 + sz - 1} of entry {j} name the temporaries' cells only by their own `DEREF`s. -/\ntheorem tops{j}_{i} : {ch}.all (tmpOpOk big{j}.TA fp{j}_{nC}) = true := by\n  decide +kernel\n"
  files := files ++ [flush nmod cur]
  let nParts := nmod + 1
  -- assembly
  let segChain := segs.zipIdx.foldr (fun (_, i) acc => s!"(seg_part seg{j}_{i} {acc})")
    s!"(seg_end (k := {body.length}) (by decide +kernel))"
  let scChain := segs.zipIdx.foldr (fun (_, i) acc => s!"(scope_part scope{j}_{i} {acc})")
    s!"(scope_end (k := {body.length}) (by decide +kernel))"
  let opsChain (p : String) := chunks.toList.zipIdx.foldr (fun (_, i) acc => s!"(ops_part {p}{j}_{i} {acc})")
    s!"(ops_end (k := {ops.size}) (by decide +kernel))"
  let toChain := chunks.toList.zipIdx.foldr (fun (_, i) acc => s!"(opsAll_part tops{j}_{i} {acc})")
    s!"(opsAll_end (k := {ops.size}) (by decide +kernel))"
  -- no shift by `g^0`: the places' trie by subtrees of depth `nsDepth`
  let paths : List String := (List.range (2 ^ nsDepth)).map fun q =>
    (List.range nsDepth).foldl (fun t b => s!"(Trie.{if q.testBit (nsDepth - 1 - b) then "right" else "left"} {t})") s!"pf{j}.locs.t"
  let leafName (q : Nat) := s!"nsl{j}_{q}"
  let nsLeafMods : List (String × String) := (List.range (2 ^ nsDepth / nsPerModule)).map fun m =>
    (s!"B{j}Ns{m}", header s!"B{j}Ns{m}" s!"No place of entry {j} is a shift by `g^0`, by subtrees." ++
      s!"public import {modBase}.B{j}\n" ++ opening ++
      String.join ((List.range' (m * nsPerModule) nsPerModule).map fun q =>
        s!"\ntheorem {leafName q} : (trieVals {paths[q]!}).all shOk = true := by\n  decide +kernel\n") ++ closing)
  -- the inner nodes, from the leaves up
  let nsMod := header s!"B{j}Ns" s!"No place of entry {j} is a shift by `g^0`." ++
    String.join ((List.range nsLeafMods.length).map fun m => s!"public import {modBase}.B{j}Ns{m}\n") ++ opening ++
    s!"\n/-- No place of entry {j} is a shift by `g^0`. -/\ntheorem ns{j} : noShift0 pf{j}.locs = true := by\n  rw [noShift0_eq]\n  exact {nsNode j leafName 0 0 s!"pf{j}.locs.t"}\n" ++ closing
  -- the places conjunct by parts, in modules of at most `maxPlModule`
  let (plItems, plProof) := placesParts j tf
  let mut plMods : Array String := #[]
  let mut plCur := ""
  let mut plW := 0
  for (w, thm) in plItems do
    if plW > 0 && plW + w > maxPlModule then
      plMods := plMods.push plCur
      plCur := ""
      plW := 0
    plCur := plCur ++ thm
    plW := plW + w
  plMods := plMods.push plCur
  let plFiles := plMods.toList.zipIdx.map fun (t, m) =>
    (s!"B{j}Pl{m}", header s!"B{j}Pl{m}" s!"The kernel's places check of entry {j}, by parts." ++
      s!"public import {modBase}.B{j}\npublic import {modBase}.Places\n" ++ opening ++ t ++ closing)
  let okMod := header s!"B{j}Ok" s!"Entry {j}'s test, from its parts." ++
    s!"public import {modBase}.B{j}Ns\n" ++
    String.join ((List.range nParts).map fun m => s!"public import {modBase}.B{j}P{m}\n") ++
    String.join ((List.range plMods.size).map fun m => s!"public import {modBase}.B{j}Pl{m}\n") ++ opening ++ okItems ++
    s!"\n/-- The checks of entry {j} on its temporaries, parameters and frame. -/\ntheorem small{j} : smallOk {j} pf{j} TL{j} cn{j}_{nC} = true := by\n  decide +kernel\n" ++
    s!"\n/-- The scope walk of entry {j} ends with its trace. -/\ntheorem fin{j} : (match flushAt {tfs}.rets sc{j}_{segs.length} with\n    | .ok s => s.rest.isEmpty\n    | .error _ => false) = true := by\n  decide +kernel\n" ++
    String.join ([4, 5, 6, 7].map fun k => s!"\ntheorem rest{j}_{k} : partsOk [{k}] {j} pf{j} = true := by\n  decide +kernel\n") ++
    s!"\n/-- Entry {j}'s places, by parts. -/\ntheorem rest{j}_8 : partsOk [8] {j} pf{j} = true :=\n  {plProof}\n" ++
    s!"\n/-- **Entry {j}'s test.** -/\ntheorem cplOk_{j} : cplOkAt {j} = true :=\n  cplOk_big (pf := pf{j}) (TL := TL{j}) (C := cn{j}_{nC}) (F := fp{j}_{nC})\n    (S := sc{j}_{segs.length}) (M := sn{j}_{segs.length + 1})\n    (placedAt_cut cut{j}_walk cut{j}_tailOk cut{j}_head)\n    {segChain}\n    small{j}\n    {opsChain "cnt"}\n    {opsChain "fps"}\n    {toChain}\n    ns{j}\n    {onceChain}\n    {scChain}\n    fin{j}\n    (partsOk_45678 rest{j}_4 rest{j}_5 rest{j}_6 rest{j}_7 rest{j}_8)\n" ++ closing
  return files ++ nsLeafMods ++ plFiles ++ [(s!"B{j}Ns", nsMod), (s!"B{j}Ok", okMod)]

/-- Runs of entries `(a, b)`, each at most `maxDecl` instructions; cut and large entries alone. -/
def runsOf (sizes : Array Nat) : List (Nat × Nat) := Id.run do
  let mut out : Array (Nat × Nat) := #[]
  let mut a : Option Nat := none
  let mut acc := 0
  for i in [0:sizes.size] do
    let n := sizes[i]!
    if cutEntries.contains i || n > maxDecl then
      if let some a' := a then out := out.push (a', i)
      a := none
      acc := 0
      out := out.push (i, i + 1)
      continue
    if a.isSome && acc + n > maxDecl then
      out := out.push (a.get!, i)
      a := none
      acc := 0
    if a.isNone then a := some i
    acc := acc + n
  if let some a' := a then out := out.push (a', sizes.size)
  return out.toList

def runThm (pls : List Placed) (sizes : Array Nat) (names : Array String) (a b : Nat) : String :=
  let n := (List.range' a (b - a)).foldl (fun s i => s + sizes[i]!) 0
  let what := if b = a + 1 then s!"`{names[a]!}`" else s!"`{names[a]!}` to `{names[b - 1]!}`"
  let doc := s!"\n/-- The test of entries {a} to {b - 1} ({what}, {n} instructions). -/\n"
  if cutEntries.contains a then
    let pf := s!"(placedOf {tfOf a} cut{a}_end).1"
    let groups := ["[0]", "[1]", "[2]", "[3]", "[4, 5, 6, 7, 8]"]
    String.join (groups.zipIdx.map fun (g, q) =>
      s!"\ntheorem cplOkC_{a}_{q} : partsOk {g} {a} {pf} = true := by\n  decide +kernel\n") ++
      doc ++ s!"theorem cplOk_{a}_{b} : (List.range' {a} 1).all cplOkAt = true :=\n  range_one (f := cplOkAt) (cplOkAt_of_five (placedAt_cut cut{a}_walk cut{a}_tailOk cut{a}_head)\n    cplOkC_{a}_0 cplOkC_{a}_1 cplOkC_{a}_2 cplOkC_{a}_3 cplOkC_{a}_4)\n"
  else if b = a + 1 && n > maxDecl then
    let pf := (pls[a]?).getD ⟨⟨"", [], 0⟩, {}⟩
    let locs := (trieEntries pf.locs.t).flatten.map fun (v, l) => s!"({pV v}, {pLoc l})"
    chunkedDefs s!"The placed body of entry {a}." s!"plb{a}" "PStmt" (pf.fn.body.map pPStmt) ++
      chunkedDefs s!"The places of entry {a}." s!"pll{a}" "(V × Loc)" locs ++
      s!"\n/-- Entry {a} placed. -/\nstate_lit plc{a} : Placed :=\n  \{ fn := \{ name := {tfOf a}.core.name, body := plb{a}, frameSize := {pf.fn.frameSize} },\n    locs := KMap.insertAll \{} pll{a} }\n" ++
      s!"\n/-- The placement of entry {a}. -/\nkernel_rfl place{a} : placedAt {a} = some plc{a}\n" ++
      s!"\ntheorem cplOkL_{a}_0 : partsOk [0, 1, 2] {a} plc{a} = true := by\n  decide +kernel\n\ntheorem cplOkL_{a}_1 : partsOk [3, 4, 5, 6, 7, 8] {a} plc{a} = true := by\n  decide +kernel\n" ++
      doc ++ s!"theorem cplOk_{a}_{b} : (List.range' {a} 1).all cplOkAt = true :=\n  range_one (f := cplOkAt) (cplOkAt_of_with_two place{a} cplOkL_{a}_0 cplOkL_{a}_1)\n"
  else if false then
    s!"\ntheorem cplOkG_{a}_0 : (placedAt {a}).any (partsOk [0, 1, 2] {a}) = true := by\n  decide +kernel\n\ntheorem cplOkG_{a}_1 : (placedAt {a}).any (partsOk [3, 4, 5, 6, 7, 8] {a}) = true := by\n  decide +kernel\n" ++
      doc ++ s!"theorem cplOk_{a}_{b} : (List.range' {a} 1).all cplOkAt = true :=\n  range_one (f := cplOkAt) (cplOkAt_of_two cplOkG_{a}_0 cplOkG_{a}_1)\n"
  else
    doc ++ s!"theorem cplOk_{a}_{b} : (List.range' {a} {b - a}).all cplOkAt = true := by\n  decide +kernel\n"

end GuestCplEval

open GuestCplEval in
def main (args : List String) : IO UInt32 := do
  let check := args.contains "--check"
  let P ← input
  let (pls, _) ← orThrow (placeProgram P)
  let sizes := (pls.map fun pf => blockSize pf.fn.body).toArray
  let names := (P.map (·.core.name)).toArray
  let runs := runsOf sizes
  -- modules of runs
  let mut files : List (String × String) := []
  let mut mods : Array (List (Nat × Nat)) := #[]
  let mut cur : List (Nat × Nat) := []
  let mut acc := 0
  for (a, b) in runs do
    if bigEntries.contains a then
      if !cur.isEmpty then mods := mods.push cur
      cur := []
      acc := 0
      continue
    let n := (List.range' a (b - a)).foldl (fun s i => s + sizes[i]!) 0
    let cut := cutEntries.contains a
    if !cur.isEmpty && (acc + n > maxModule || cut || cur.any (cutEntries.contains ·.1)) then
      mods := mods.push cur
      cur := []
      acc := 0
    cur := cur ++ [(a, b)]
    acc := acc + n
  if !cur.isEmpty then mods := mods.push cur
  for (ms, k) in mods.toList.zipIdx do
    let cut := ms.any (cutEntries.contains ·.1)
    let imp := s!"public import {modBase}.Split\npublic import LeanVM.Compiler.StateLit\npublic import LeanVM.Guest.KernelLit\n" ++
      (if cut then "public import LeanVM.Guest.Compiled.Compiled\n" else "")
    let body := String.join (ms.map fun (a, b) => runThm pls sizes names a b)
    files := files ++ [(s!"R{k}", header s!"R{k}" "The kernel's per-function completeness test, by runs of entries." ++
      imp ++ opening ++ body ++ closing)]
  for j in bigEntries do
    let some tf := P[j]? | IO.eprintln s!"no entry {j}"; return 1
    let some pf := pls[j]? | IO.eprintln s!"no entry {j}"; return 1
    match bigFiles j tf pf with
    | .ok fs => files := files ++ fs
    | .error e => IO.eprintln e; return 1
  -- collection
  let mut parts : List (Nat × Nat × String) := runs.filterMap fun (a, b) =>
    if bigEntries.contains a then none else some (a, b, s!"cplOk_{a}_{b}")
  for j in bigEntries do
    parts := parts ++ [(j, j + 1, s!"(range_one (f := cplOkAt) cplOk_{j})")]
  parts := parts.mergeSort fun x y => x.1 ≤ y.1
  let n := P.length
  let some (la, lb, lt) := parts.getLast? | return 1
  let mut lines : Array String := #[s!"  have h := {lt}"]
  let mut tot := lb - la
  for (a, b, t) in parts.dropLast.reverse do
    lines := lines.push s!"  have h := range_step {t} (rfl : {a} + {b - a} = {b}) h (rfl : {b - a} + {tot} = {b - a + tot})"
    tot := tot + (b - a)
  if tot != n then IO.eprintln "runs do not cover the input"; return 1
  let imports := String.join ((List.range mods.size).map fun k => s!"public import {modBase}.R{k}\n") ++
    String.join (bigEntries.map fun j => s!"public import {modBase}.B{j}Ok\n")
  let allMod := header "All" "The per-function completeness test passes for every entry of the guest." ++ imports ++
    opening ++ s!"\n/-- **The per-function completeness test passes for every entry of the guest.** -/\ntheorem cplOkAll : CplOkAll := by\n  apply cplOkAll_of\n" ++
    "\n".intercalate lines.toList ++ "\n  exact h\n" ++
    "\n/--\ninfo: 'LeanVM.Guest.Compiled.CplEval.cplOkAll' depends on axioms: [propext, Classical.choice, Quot.sound]\n-/\n#guard_msgs in\n#print axioms cplOkAll\n" ++ closing
  files := files ++ [("All", allMod)]
  -- write or check
  let existing ← (System.FilePath.readDir evalDir).map fun es => es.filterMap fun e =>
    let s := e.fileName
    if s.endsWith ".lean" && s != "Split.lean" && s != "Places.lean" then some (String.ofList (s.toList.take (s.length - 5))) else none
  let mut bad : Array String := #[]
  for (m, t) in files do
    let p := evalDir / s!"{m}.lean"
    if check then
      if !(← p.pathExists) || (← IO.FS.readFile p) != t then bad := bad.push m
    else IO.FS.writeFile p t
  let stale := existing.filter fun m => !files.any (·.1 == m)
  for m in stale do
    if check then bad := bad.push m else IO.FS.removeFile (evalDir / s!"{m}.lean")
  if !bad.isEmpty then
    IO.eprintln s!"stale: {bad.toList}"
    return 1
  IO.println s!"{files.length} modules, {mods.size} run modules, {runs.length} runs, {n} entries, {sizes.foldl (· + ·) 0} instructions"
  return 0
