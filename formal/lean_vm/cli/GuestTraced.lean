import Statement.Data.Bytecode
import LeanVM.Guest.Backend.Guest.Input

/-!
# `guest-traced`: the guest as the back end's input, with `coreProgram`'s functions

Run from `lean_vm`.

`lake exe guest-traced` expands the guest's source with its allocation trace
(`Expand.expandProgramTraced Data.guest`) and writes, for each function `j`, its trace with
every value renamed as `coreProgram` names it: a value of the core function becomes its number in
`Fn.renumber` (`V.n i`), and a value only the trace names (a cell no statement reads) the next
number past them, in the order the trace makes it. The core functions themselves are not written:
`Backend/Guest/World.lean` pairs `coreProgram`'s function `j`, which `lake exe guest-core` wrote as
`Fn.renumber` of the same expansion, with entry `j` of `guestInfo`. So the back end's input for
the guest, `guestTraced`, has `coreProgram`'s functions by construction.

The traces are in `Backend/Guest/Trace/T{k}.lean` (`traceOf{j}`, a long one in parts
`traceOf{j}_c{i}`), the list `guestInfo` in `Backend/Guest/Traced.lean`.

`lake exe guest-traced --check` writes nothing and fails when a file is stale; then it compiles the
same input, natively, with the back end (`lowerProgram`, `assemble`) and compares the result with
the statement's program as `guest-backend check` does: `Data.functions` value for value, and every
slot of `assemble Data.functions 19`. `lake exe guest-traced identity` runs the comparison alone.
-/

open LeanVM.Parameters LeanVM.Semantics LeanVM.Guest LeanVM.Guest.Core LeanVM.Guest.Backend
  LeanVM.Guest.Backend.GuestInput

namespace GuestTraced

/-- A definition is split once its text is longer than this. -/
def maxDef : Nat := 24000

/-- A file is closed once longer than this. -/
def maxFile : Nat := 750000

def outDir : System.FilePath := "LeanVM/Guest/Backend/Guest"

/-! ## Text -/

def pList (items : List String) : String :=
  if items.length < 32 then s!"[{", ".intercalate items}]"
  else s!"({" :: ".intercalate items} :: [])"

def pN (v : V) : String := s!".n {v.idx}"

def pKind : Kind → String
  | .cell => ".cell" | .pooled => ".pooled" | .site => ".site" | .addr => ".addr"
  | .ret => ".ret" | .padRun => ".padRun" | .spongeRun => ".spongeRun"

def pEvent : Event → String
  | .alloc vs k => s!".alloc {pList (vs.map pN)} {pKind k}"
  | .emit => ".emit"
  | .enter => ".enter"
  | .leave => ".leave"
  | .use v => s!".use ({pN v})"
  | .shift v e => s!".shift ({pN v}) {e}"
  | .chain => ".chain"
  | .note n => s!".note {n}"

def header (mod what : String) : String :=
  s!"/-
  LeanVM.Guest.Backend.Guest.{mod}

  Generated by `lake exe guest-traced` (lean_vm/cli/GuestTraced.lean); do not edit.
  {what}
-/

module

"

/-- The definitions of function `j`'s trace, each with the names it defines and the names it
reads: its chunks, then the trace. -/
def traceDefs (j : Nat) (name : String) (trace : Array Event) :
    List (String × String × List String) := Id.run do
  let items := trace.toList.map pEvent
  let mut chunks : Array (List String) := #[]
  let mut cur : Array String := #[]
  let mut size := 0
  for it in items do
    if size + it.length + 4 > maxDef && !cur.isEmpty then
      chunks := chunks.push cur.toList
      cur := #[]
      size := 0
    cur := cur.push it
    size := size + it.length + 4
  if !cur.isEmpty || chunks.isEmpty then chunks := chunks.push cur.toList
  if chunks.size == 1 then
    return [(s!"/-- `{name}`: its trace. -/\ndef traceOf{j} : Array Event :=\n  {pList (chunks[0]!)}.toArray\n\n",
      s!"traceOf{j}", [])]
  let names := (List.range chunks.size).map fun i => s!"traceOf{j}_c{i}"
  let parts := (chunks.toList.zip names).zipIdx.map fun ((c, n), i) =>
    (s!"/-- `{name}`: part {i} of its trace. -/\ndef {n} : List Event :=\n  {pList c}\n\n", n, [])
  return parts ++ [(s!"/-- `{name}`: its trace. -/\ndef traceOf{j} : Array Event :=\n  (List.flatten {pList names}).toArray\n\n",
    s!"traceOf{j}", names)]

def traceFile (k : Nat) (deps : List Nat) (body : String) : String :=
  header s!"Trace.T{k}" "The traces of some of the guest's functions, renamed as `coreProgram` names their values." ++
  "public import LeanVM.Guest.Backend.Trace\npublic import LeanVM.Guest.Renumber\n" ++
  String.join (deps.map fun d => s!"public import LeanVM.Guest.Backend.Guest.Trace.T{d}\n") ++ "\n" ++
  "set_option maxRecDepth 20000\nset_option linter.all false\n\n" ++
  "namespace LeanVM.Guest.Backend.GuestData\n\nopen LeanVM.Guest.Core\n\n@[expose] public section\n\n" ++
  body ++ "end\nend LeanVM.Guest.Backend.GuestData\n"

def pLoop (l : Bool × Option Nat) : String :=
  s!"({l.1}, {match l.2 with | some h => s!"some {h}" | none => "none"})"

/-- Every file, by its path under `Backend/Guest`. -/
def files (P : List TracedFn) : List (String × String) := Id.run do
  let mut out : Array (String × String) := #[]
  let mut body := ""
  let mut deps : List Nat := []
  let mut k := 0
  let mut defined : Std.HashMap String Nat := {}
  for (tf, j) in P.zipIdx do
    for (d, n, refs) in traceDefs j tf.core.name tf.trace do
      if body.length + d.length > maxFile && !body.isEmpty then
        out := out.push (s!"Trace/T{k}.lean", traceFile k deps body)
        body := ""
        deps := []
        k := k + 1
      for r in refs do
        if let some f := defined[r]? then
          if f != k && !deps.contains f then deps := deps ++ [f]
      body := body ++ d
      defined := defined.insert n k
  out := out.push (s!"Trace/T{k}.lean", traceFile k deps body)
  let imports := (List.range (k + 1)).map fun i => s!"public import LeanVM.Guest.Backend.Guest.Trace.T{i}\n"
  let entries := P.zipIdx.map fun (tf, j) => s!"(traceOf{j}, {tf.rets}, {pLoop tf.loop})"
  let list := header "Traced" "The guest as the back end's input: the traces of `coreProgram`'s functions." ++
    "public import LeanVM.Guest.Backend.Trace\n" ++ String.join imports ++
    "\nset_option maxRecDepth 20000\nset_option linter.all false\n\n" ++
    "namespace LeanVM.Guest.Backend.GuestData\n\n@[expose] public section\n\n" ++
    "/-- What the back end takes of each of the guest's functions besides its core function, in the\n" ++
    "compiler's order: its trace, its return cells and its `loopSource`. -/\n" ++
    "def guestInfo : List (Array Event × Nat × Bool × Option Nat) :=\n  " ++ pList entries ++
    s!"\n\ntheorem guestInfo_length : guestInfo.length = {P.length} := by decide +kernel\n" ++
    "\nend\nend LeanVM.Guest.Backend.GuestData\n"
  out := out.push ("Traced.lean", list)
  return out.toList

/-! ## The comparison with the statement's program -/

/-- Whether the compiled functions are the statement's, value for value: names, entries, lengths
and chunks. -/
def sameFunctions (ours : Assembled) : Bool :=
  let fs := ours.toFunctions
  fs.length == Data.functions.length && (fs.zip Data.functions).all fun (a, b) =>
    a.name == b.name && a.entryPc == b.entryPc && a.instructionCount == b.instructionCount &&
      a.chunks == b.chunks

/-- The first slot at which the statement's program and the compiled one differ, the padding
included. -/
def firstDifference (ours : Assembled) : Option Nat :=
  (List.range (2 ^ Data.logSize)).find? fun pc =>
    instructionAtPc Data.functions pc != ours.code.getD pc .padding

/-- The back end on the renamed guest against `Data.functions` and `assemble Data.functions 19`. -/
def identity (P : List TracedFn) : IO Bool := do
  let (fns, slots) ← orThrow (lowerProgram P)
  let ours := assemble fns slots
  let same := sameFunctions ours && ours.size == 2 ^ Data.logSize
  let slotsSame := (firstDifference ours).isNone
  let n := (ours.toFunctions.map (·.instructionCount)).sum
  if same && slotsSame then
    IO.println s!"identical: `Data.functions` value for value ({ours.toFunctions.length} functions, \
      {n} instructions) and the {2 ^ Data.logSize} slots of `assemble Data.functions {Data.logSize}`"
  else
    IO.eprintln s!"the back end on the renamed guest differs from the statement's program \
      (functions {same}, slots {slotsSame})"
  return same && slotsSame

end GuestTraced

open GuestTraced in
def main (args : List String) : IO UInt32 := do
  let check := args == ["--check"]
  unless args.isEmpty || check || args == ["identity"] do
    IO.eprintln "usage: guest-traced [--check | identity]"
    return 2
  unless ← outDir.isDir do
    IO.eprintln s!"{outDir} not found: run from lean_vm"
    return 2
  let P ← input
  if args == ["identity"] then
    return if ← identity P then 0 else 1
  let fs := files P
  let traceDir := outDir / "Trace"
  let existing ← if ← traceDir.isDir then
      pure <| (← traceDir.readDir).toList.filterMap fun e =>
        if e.fileName.endsWith ".lean" then some s!"Trace/{e.fileName}" else none
    else pure []
  let names := fs.map (·.1)
  let mut bad := false
  for (n, text) in fs do
    let path := outDir / n
    let old ← if ← path.pathExists then IO.FS.readFile path else pure ""
    if old != text then
      if check then
        IO.eprintln s!"{path} is stale: run `lake exe guest-traced`"
        bad := true
      else
        if let some dir := path.parent then IO.FS.createDirAll dir
        IO.FS.writeFile path text
  for n in existing.filter (!names.contains ·) do
    if check then
      IO.eprintln s!"{outDir / n} is not generated"
      bad := true
    else
      IO.FS.removeFile (outDir / n)
  if check then
    unless ← identity P do bad := true
  else
    IO.println s!"wrote {fs.length} files, {P.length} functions"
  return if bad then 1 else 0
