/-- A split column's entry of a `Split` (`split_values`' `match`). -/
def splitEntry (s : Split) : SplitColumn → E
  | .count op => s.count.getD op 0
  | .slot op slot => (s.slots.getD op []).getD slot 0
  | .pc op slot => (s.pc.getD op []).getD slot 0

