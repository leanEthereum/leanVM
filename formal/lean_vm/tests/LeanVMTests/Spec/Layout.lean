-- `freshSplit` takes the child's values at its point, and rejects another point or a short claim.
#guard match freshSplit ⟨splitPoint, splitValues⟩ program16 splitPoint (pcSlots tables) with
  | .ret s => (splitColumns tables).map (splitEntry s) = splitValues
  | _ => false
