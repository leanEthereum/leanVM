#guard (List.range nTables).all fun op ↦ (List.range (2 ^ bytecodeSlotBits)).all fun slot ↦
  [SplitColumn.slot op slot, .pc op slot].all fun c ↦
    splitEntry (Split.ofColumns tables splitValues) c =
