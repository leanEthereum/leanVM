/-!
# The layout, the placements and the program's split, against the Rust

Known answers of the Rust verifier (`crates/verifier`, branch `hotwire-dense-int`), printed by a
test inside the crate that calls its private items, pin the transcriptions in
`Statement/Verifier/Layout.lean`:

* `tables()` (`layout.rs`): the widths, the global column bases, every table's columns, pointers
  (`Links::pointers`), largest shift, state and program links' columns, operand slots, the shape of
  every memory access (pointer, shift, gate, frame, read kinds), the value of every form and read
  scale at a random row (`Form::evaluate`), the constraints at that row, and the nonzero padding
  (`KECCAK`'s output lanes, `keccak_f` of zero);
* `qkeccak_slot` of every global column, `stack_blocks()`, `min_execution_stacked_log`, `pc_slots`;
* `stack_offsets` on random block sizes (three in full, the rest by a digest of the offsets);
* `build_layout` on random announced sizes, a third of them rejected: the stack's log-size, the
  tables' log-heights, `log_bytecode`, and a digest of every column's placement (two in full);
* `Placement::stack_point` and `eq_above` on placements of those layouts, `q_keccak`'s slots
  included, at random points;
* `Bytecode::split` at the pairs `pc_slots` names, on random programs of `1`, `4` and `16`
  instructions of every opcode, at a random point (`computedSplit`), and its rejection of a point
  of the wrong size.
-/

namespace LeanVMTests.Spec.Layout

open LeanVM.Parameters LeanVM.Protocol.Verifier LeanVM.Protocol.Compile

/-- An `E` element from its two limbs, `E::new(c0, c1)`. -/
def e (c0 c1 : ℕ) : E := E.ofLimbs (K.ofBits c0) (K.ofBits c1)

/-- The state link's columns. -/
def stateShape (t : Table) : ℕ × ℕ × ℕ :=
  (t.links.stateLink.cycle, t.links.stateLink.pc, t.links.stateLink.fp)

/-- The program link's columns, opcode and operand slots. -/
def bytecodeShape (t : Table) : ℕ × ℕ × ℕ × List (List ℕ) :=
  let b := t.links.bytecodeLink
  (b.pointer, b.pc, b.opcode, b.operands.map (·.1))

/-- A read's kind (`0` word, `1` slot, `2` frame, `3` pc) and its pointer or slot. -/
def readShape : Read → ℕ × ℕ
  | .word pointer _ => (0, pointer)
  | .slot slot _ => (1, slot)
  | .frame slot _ => (2, slot)
  | .pc slot _ => (3, slot)

/-- Every memory access's pointer, shift, gate, frame and reads. -/
def accessShapes (t : Table) : List (ℕ × ℕ × Option ℕ × Option (ℕ × ℕ) × List (ℕ × ℕ)) :=
  t.links.memory.map fun a ↦ (a.pointer, a.shift, a.gate, a.frame, a.reads.map readShape)

/-- Every form and read scale of a table at a row: the successor state, the operand equations, then
per access its address, its value and its reads' scales. -/
def formValues (t : Table) (row : List E) : List E :=
  let column := fun i ↦ row.getD i 0
  let s := t.links.stateLink
  [s.next.1.evaluate column, s.next.2.evaluate column] ++
    t.links.bytecodeLink.operands.map (·.2.evaluate column) ++
    t.links.memory.flatMap fun a ↦
      [a.address.evaluate column, a.value.evaluate column] ++ a.reads.map fun
        | .word _ scale => scale.evaluate column
        | .slot _ scale | .frame _ scale | .pc _ scale => scale

/-- A padding row's nonzero entries. -/
def nonzeroPadding (t : Table) : List (ℕ × E) :=
  t.padding.zipIdx.filterMap fun (p, i) ↦ if p = 0 then none else some (i, p)

/-- A polynomial hash of a list of naturals, modulo `2^61 - 1`. -/
def digest (xs : List ℕ) : ℕ := xs.foldl (fun h x ↦ (h * 1000003 + x) % (2 ^ 61 - 1)) 0

/-- The offsets' digest and the total's log-size, rounded up. -/
def offsetsDigest (sizes : List ℕ) : ℕ × ℕ :=
  let (offsets, log) := stackOffsets sizes
  (digest offsets, log)

/-- A placement as one natural, `0` for none. -/
def placementCode : Option Placement → ℕ
  | none => 0
  | some p => 1 + p.variableCount + 64 * p.index

/-- `buildLayout` on a program of `2^logLen` words: the placements' digest, the stack's log-size,
the tables' log-heights and the program's log-size. -/
def layoutDigest (logLen logMemory : ℕ) (rows : List ℕ) : Option (ℕ × ℕ × List ℕ × ℕ) :=
  (buildLayout (List.replicate (2 ^ logLen) 0) logMemory rows).map fun l ↦
    (digest (l.placements.map placementCode), l.stackLog, l.tableLogHeights, l.logBytecode)

/-- A column's placement in `buildLayout`'s layout. -/
def placementAt (logLen logMemory : ℕ) (rows : List ℕ) (column : ℕ) : Option Placement :=
  (buildLayout (List.replicate (2 ^ logLen) 0) logMemory rows).bind (·.placements.getD column none)

/-- `computedSplit` on a program's words at the pairs `pc_slots(tables())` reads times `pc`, `none`
where it fails. -/
def splitOf (words : List ℕ) (point : List E) : Option (List E × List (List E) × List (List E)) :=
  match computedSplit (words.map K.ofBits) point (pcSlots tables) with
  | .ret s => some (s.count, s.slots, s.pc)
  | _ => none

-- The `KECCAK` table's column constants, and the guard the Rust checks at compile time on the spare
-- slots of `q_keccak`: each carries a committed column of the table, distinct, not a value lane.
#guard (keccakIn, keccakOut, keccakIx, keccakIxBc, keccakCycle) = (8, 33, 58, 66, 67)
#guard (qkeccakSlots, qkeccakSpare, qkeccakSlotBits) = (50, 14, 6)
#guard (List.range qkeccakSpare).all fun k ↦
  (k == 0 || decide (spareLocal (k - 1) < spareLocal k)) &&
    (decide (spareLocal k < keccakIn) ||
      decide (keccakIx ≤ spareLocal k ∧ spareLocal k < tableWidths.getD opKeccak 0))

