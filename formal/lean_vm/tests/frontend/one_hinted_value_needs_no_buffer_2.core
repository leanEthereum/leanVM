def main []
  hint alloc %0 4
  const %1 1 0
  call __loop0 [%1 %0] []
  load %2 %0 1
  const %3 1 0
  load %2 %3 0
  const %4 1 0
  const %5 1 0
  const %6 2 0
  mul %7 %5 %6
  load %4 %7 0
  ret []
def __loop0 [%0 %1]
  hint witness w [%2]
  mul %3 %1 %0
  load %2 %3 0
  const %4 2 0
  mul %5 %0 %4
  const %6 8 0
  add %7 %5 %6
  const %8 2 0
  mul %9 %0 %8
  call_if %7 __loop0 [%9 %1]
  ret []
