def main []
  hint alloc %0 7
  const %1 1 0
  call __loop0 [%1 %0] []
  load %2 %0 6
  const %3 64 0
  assert_eq %2 %3
  load %4 %0 1
  const %5 2 0
  assert_eq %4 %5
  ret []
def bump [%0]
  const %1 1 0
  add %2 %0 %1
  if_zero %2
    const %3 32 0
    ret [%3]
  else
  end
  const %4 64 0
  add %5 %0 %4
  if_zero %5
    const %6 1 0
    ret [%6]
  else
  end
  copy %7 %0
  ret [%7]
def __loop0 [%0 %1]
  mul %2 %1 %0
  load %0 %2 0
  call bump [%0] [%3]
  const %4 2 0
  mul %5 %3 %4
  const %6 4 0
  add %7 %5 %6
  const %8 2 0
  mul %9 %3 %8
  call_if %7 __loop0 [%9 %1]
  ret []
