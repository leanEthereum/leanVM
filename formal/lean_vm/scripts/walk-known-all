#!/usr/bin/env python3
"""Write `LeanVM/Guest/WalkKnownAll.lean`: `walkKnown_of_gkr`, one conjunct per function of `Checked.oblFns`
(`Guest/Checked.lean`, by `guest-cert`), each the walk theorem `walk_{j}` its generator writes
(`WalkOq*`, `WalkLq*`, `WalkOs*`, `WalkWp`), but `main` and `verify_sub`, excluded by `WalkKnown`, and
`verify_bus_gkr` and its layer loop, whose obligations are hypotheses (`WalkGkr.lean`). Function `j` is core
function `j - 1` (the core IR, through `scripts/coredata.py`). Run from `lean_vm` after `guest-cert`
(`scripts/regen-guest.sh` does):

    python3 -I scripts/walk-known-all [--check]
"""
import re
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import coredata

OUT = Path("LeanVM/Guest/WalkKnownAll.lean")


def core():
    fns, bodies = {}, {}
    for t in coredata.legacy_texts("LeanVM/Guest/Data"):
        for m in re.finditer(r'noncomputable def core(\d+) : Core\.Fn where\n  name := "([^"]+)"', t):
            fns[int(m.group(1))] = m.group(2)
        for m in re.finditer(r"^namespace core(\d+)\n(.*?)^end core\1$", t, re.M | re.S):
            bodies[int(m.group(1))] = bodies.get(int(m.group(1)), "") + m.group(2)
    return fns, bodies


def main():
    fns, bodies = core()
    obl = [int(x) for x in re.search(r"def oblFns : List ℕ := \[(.*?)\]",
                                     Path("LeanVM/Guest/Checked.lean").read_text(encoding="utf-8")).group(1).split(",")]
    idx = {n: j + 1 for j, n in fns.items()}
    bus = idx["verify_bus_gkr"]
    loops = [idx[l] for l in dict.fromkeys(re.findall(r'"(__loop\d+)"', bodies.get(bus - 1, ""))) if idx[l] in obl]
    if len(loops) != 1:
        sys.exit(f"walk-known-all: verify_bus_gkr's loops in oblFns are {loops}, not one")
    layer = loops[0]
    main_j, vs_j = idx["main"], idx["verify_sub"]
    terms = []
    for j in obl:
        terms.append({main_j: "fun h _ ↦ absurd rfl h", vs_j: "fun _ h ↦ absurd rfl h", bus: "fun _ _ ↦ hBus",
                      layer: "fun _ _ ↦ hLayer"}.get(j, f"fun _ _ ↦ walk_{j}"))
    rows, row = [], ""
    for k, t in enumerate(terms):
        piece = t + ("," if k + 1 < len(terms) else "⟩")
        if len(row) + len(piece) + 1 > 104:
            rows.append(row)
            row = ""
        row += (" " if row else "") + piece
    rows.append(row)
    key = "\n".join(("    ⟨" if i == 0 else "      ") + r for i, r in enumerate(rows))
    text = f"""/-
  LeanVM.Guest.WalkKnownAll

  The walks' obligations, proved: every function the certificates hand something on at its cuts,
  but `main` and `verify_sub`. Generated by `scripts/walk-known-all`; do not edit.
-/

module

public import LeanVM.Guest.WalkOq0
public import LeanVM.Guest.WalkOq1
public import LeanVM.Guest.WalkOq2
public import LeanVM.Guest.WalkOq3
public import LeanVM.Guest.WalkWp
public import LeanVM.Guest.WalkLq0
public import LeanVM.Guest.WalkLq1
public import LeanVM.Guest.WalkLq2
public import LeanVM.Guest.WalkLq3
public import LeanVM.Guest.WalkOs0
public import LeanVM.Guest.WalkOs1
public import LeanVM.Guest.WalkOs2
public import LeanVM.Guest.WalkOs3
public import LeanVM.Guest.WalkGkr

/-!
# `WalkKnown`, proved

`walkKnown_proved : WalkKnown`: the cut obligations (`CutsKnown`) of every function of
`Checked.oblFns` but `main` (`{main_j}`) and `verify_sub` (`{vs_j}`): `opening_queries`' specializations and
loops (`WalkOq0.lean` to `WalkOq3.lean`), `open_stacked`'s arms (`WalkOs0.lean` to `WalkOs3.lean`),
`level_queries`' specializations (`WalkLq0.lean` to `WalkLq3.lean`) and `walk_path`'s (`WalkWp.lean`), from
their windows' tags, and `verify_bus_gkr` (`{bus}`) and its layer loop (`{layer}`), whose obligations the gkr
track proves (`WalkGkr.lean`; `walkKnown_of_gkr`).
-/

namespace LeanVM.Guest.End

@[expose] public section

set_option maxRecDepth 4000 in
/-- **The walks' obligations**, given `verify_bus_gkr`'s and its layer loop's. -/
theorem walkKnown_of_gkr (hBus : CutsKnown {bus}) (hLayer : CutsKnown {layer}) : WalkKnown := by
  -- One conjunct per function of `Checked.oblFns`, in order: linear, where `rcases` over the
  -- membership disjunction is quadratic.
  have key : List.Forall (fun j ↦ j ≠ {main_j} → j ≠ {vs_j} → CutsKnown j) Checked.oblFns :=
{key}
  exact List.forall_iff_forall_mem.mp key

/-- **The walks' obligations, proved.** -/
theorem walkKnown_proved : WalkKnown := walkKnown_of_gkr gkrBus_cutsKnown gkrLoop_cutsKnown

end
end LeanVM.Guest.End
"""
    if "--check" in sys.argv[1:]:
        if OUT.read_text(encoding="utf-8") != text:
            sys.exit(f"{OUT} is stale; rerun scripts/walk-known-all")
        return
    OUT.write_text(text, encoding="utf-8")


main()
