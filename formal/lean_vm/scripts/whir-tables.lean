/-
  Writes LeanVM/Guest/Fast/WhirTables.lean: `open_stacked`'s template's stream words and
  `level_queries` dispatches at every size and rate (`osQCalls`, `Fast/WhirTemplate.lean`), each
  function a dispatch names by its index, read off `Data.nameT` (`Memory/GuestCallees.lean`).
  `Fast/WhirCalls.lean` checks the tables against the template in the kernel.

  Run from lean_vm after `lake build LeanVM.Guest.Fast.WhirTemplate LeanVM.Guest.Memory.GuestCallees`:
  `lake env lean --run scripts/whir-tables.lean [--check]`; `--check` writes nothing and fails when
  the file differs (`scripts/regen-guest.sh` runs it).
-/
import LeanVM.Guest.Fast.WhirTemplate
import LeanVM.Guest.B1.Opening.QueriesT
import LeanVM.Guest.Memory.GuestCallees

open LeanVM.Guest LeanVM.Guest.Core LeanVM.Guest.Memory LeanVM.Guest.B1 LeanVM.Guest.B1.Whir
  LeanVM.Guest.Fast

def out : System.FilePath := "LeanVM/Guest/Fast/WhirTables.lean"

/-- The entries of a search tree. -/
def entries {α : Type} : NTree α → List (ℕ × α)
  | .leaf => []
  | .node k v l r => entries l ++ (k, v) :: entries r

def text : String := Id.run do
  -- a function's index is one past its core index
  let idx : Std.HashMap String Nat :=
    (entries Data.nameT).foldl (fun m (k, n) => m.insert n (k + 1)) {}
  let ix := fun (n : String) => idx.getD n 0
  let words := (List.range 44).map fun j => osWordsLen (osCfgAt j)
  let wl := (List.range 4).map fun ri =>
    ", ".intercalate (((words.drop (11 * ri)).take 11).map toString)
  let ns := fun (l : List V) => s!"[{", ".intercalate (l.map fun v => toString v.idx)}]"
  let call := fun (c : OsCfg) (q : ℕ × OsLv × List V × List V) =>
    let (lvl, lv, args, rets) := q
    let nm := osOqName c lvl lv
    let sh := openingQueriesLoops.findIdx (·.1 == nm)
    let e := openingQueriesLoops.getD sh ("", "", oqShapeZero)
    s!"⟨{sh}, {ix (osQueriesName c lvl lv)}, {ix nm}, {ix e.2.1}, {ix (oqWalkOf e.2.2.oq)}, " ++
      s!"{lv.queries / (1 + lvBase lvl)}, {lv.depth}, {lv.capDepth}, {ns args}, {ns rets}⟩"
  let cfgs := (List.range 44).map fun j =>
    let c := osCfgAt j
    s!"  -- size {j % 11}, rate index {j / 11}\n  [{",\n    ".intercalate ((osQCalls c).map (call c))}]"
  return "/-
  LeanVM.Guest.Fast.WhirTables

  Generated by `scripts/whir-tables.lean`; do not edit.
  `open_stacked`'s positions, as literal tables.
-/

module

/-!
# `open_stacked`'s positions, as literal tables

What `verify_sub`'s child proof reader takes from `open_stacked`'s template (`B1/Whir/Template.lean`
at the configurations `osCfgR m ri` of the `LIG_*` tables), precomputed and checked equal to it by
kernel evaluation (`Fast/WhirTablesCheck.lean`): each size and rate's stream words, and its
levels' `level_queries` dispatches (`osQCalls`), each as an `OsCall` of numbers. Entry
`j = ri · 11 + m` is the size `m` at the rate index `ri`.
-/

namespace LeanVM.Guest.Fast

@[expose] public section

/-- A level's `level_queries` dispatch, in numbers: its `opening_queries` callee's entry of
`openingQueriesLoops` (its shape), the indices of the `level_queries` specialization, of its
`opening_queries` callee, of that callee's loop and of the `walk_path` specialization its queries
call (`Fast/FunctionNames.lean`), the loop's iterations, the level's depth and cap depth, the
cells of the dispatch's arguments and of its returns. -/
structure OsCall where
  sh : Nat
  lq : Nat
  fn : Nat
  loop : Nat
  walk : Nat
  N : Nat
  depth : Nat
  cd : Nat
  args : List Nat
  rets : List Nat
  deriving DecidableEq

/-- The stream words each size and rate reads (`osWordsLen (osCfgR m ri)`, entry `ri · 11 + m`). -/
def osWordsTab : List Nat := [
    " ++ ",\n    ".intercalate wl ++ "]

/-- Each size and rate's `level_queries` dispatches (`osQCalls`, entry `ri · 11 + m`). -/
def osCallsTab : List (List OsCall) := [
" ++ ",\n".intercalate cfgs ++ "]

end
end LeanVM.Guest.Fast
"

def main (args : List String) : IO UInt32 := do
  let s := text
  if args.contains "--check" then
    let same ← if ← out.pathExists then pure ((← IO.FS.readFile out) == s) else pure false
    if !same then
      IO.eprintln s!"stale: {out}"
      return 1
    return 0
  IO.FS.writeFile out s
  IO.println s!"wrote {out}"
  return 0
