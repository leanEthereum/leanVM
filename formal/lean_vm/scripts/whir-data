#!/usr/bin/env python3
"""Write `LeanVM/Guest/B1/Whir/Data{m}.lean` and `DataAll.lean` (every size's `open_stacked__L{m}`
is its template, `OsData m`, `Whir/DataSpec.lean`), and `HelperData{k}.lean`, `HelperFind{c}.lean`,
`HelperTables.lean` and `HelperAll.lean` (every specialization of `level_positions`,
`level_queries`, `level_residual` and of their loops is its template, `Whir/HelperT.lean`, and the
helpers' tables), by kernel evaluation. `Data{m}` reads only its function's core pack, and
`HelperData{k}` the helpers in core pack `k` (`Guest/Pack/P{k}/Core.lean`) and that pack only;
they hold for any program that finds the functions (`FnIsP`, `OsDataP`, `Whir/DataSpecP.lean`), and
`DataAll` and `HelperFind{c}` (eight chunks of packs) find them in `coreProgram`. The sizes are `ligNSizes`
(`LIG_N_LOG_SIZES`, `Data/Source.lean`); the functions' keys, indices and packs are read from the core IR
(`Guest/Data/Core.lean`, `Guest/Pack`, `scripts/coredata.py`), the loops a helper calls and the body lengths from
`guest-core --show`; the kernel checks them. Run from `lean_vm` after `lake build guest-core`:

    python3 -I scripts/whir-data [--check]
"""
import re, subprocess, sys
from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parent))
import coredata

FIND_CHUNKS = 8  # the glue modules finding the helpers in `coreProgram`
RUN = 1100  # statements a kernel evaluation of the body compares
WHIR = Path("LeanVM/Guest/B1/Whir")


def res_batch():
    """`RES_BATCH`, as the templates read it: `resBatch` in `Whir/Template.lean`, a literal or the
    guest's constant (`guest_const%`) exported to `Guest/Data/Source.lean`."""
    t = (WHIR / "Template.lean").read_text()
    m = re.search(r"^abbrev resBatch : ℕ := (\d+)$", t, re.M)
    if m:
        return int(m.group(1))
    c = re.search(r"^abbrev resBatch : ℕ := guest_const% (\w+)$", t, re.M).group(1)
    src = Path("LeanVM/Guest/Data/Source.lean").read_text()
    return int(re.search(rf"^def const_{c} : Nat := (\d+)$", src, re.M).group(1))


RES_BATCH = res_batch()


def core_indices():
    out = {}
    for t in coredata.legacy_texts("LeanVM/Guest/Data"):
        for m in re.finditer(r'noncomputable def core(\d+) : Core\.Fn where\n  name := "([^"]+)"', t):
            out[m.group(2)] = int(m.group(1))
    return out


def show(name):
    return subprocess.run(["./.lake/build/bin/guest-core", "--show", name], check=True, capture_output=True,
                          text=True).stdout


def body_len(name):
    return len([ln for ln in show(name).split("\n") if ln.startswith("  ")])


BODIES = {}


def loops(name):
    """The loops a function calls, in order, read off its core IR's text."""
    if not BODIES:
        for t in coredata.legacy_texts("LeanVM/Guest/Data"):
            for m in re.finditer(r'^namespace core(\d+)\n(.*?)^end core\1$', t, re.M | re.S):
                BODIES[int(m.group(1))] = BODIES.get(int(m.group(1)), "") + m.group(2)
            for m in re.finditer(r'noncomputable def core(\d+) : Core\.Fn where\n(.*?)(?=\n\n)', t, re.S):
                BODIES[int(m.group(1))] = BODIES.get(int(m.group(1)), "") + m.group(2)
    seen = []
    for l in re.findall(r'"(__loop\d+)"', BODIES[IDX[name]]):
        if l not in seen:
            seen.append(l)
    return seen


HDR = """/-
  LeanVM.Guest.B1.Whir.{mod}

  {doc} Generated by `scripts/whir-data`; do not edit.
-/

module

{imports}
namespace LeanVM.Guest.B1.Whir

open LeanVM.Guest.Core LeanVM.Guest

@[expose] public section
"""
FTR = "\nend\nend LeanVM.Guest.B1.Whir\n"


def fn_import(key):
    return f"public import {coredata.fn_module('LeanVM/Guest/Data', key)}\n"


def pack_num(fname):
    """The core pack of function `fname`: a helper is small, so in a numbered pack."""
    mod = coredata.fn_module('LeanVM/Guest/Data', KEY[fname])
    k = mod.split('.')[3]
    assert k[0] == 'P' and k[1:].isdigit(), (fname, mod)
    return int(k[1:])


def found(name):
    """`coreProgram` finds function `name`, by its position."""
    return f"⟨coreProgram_find?_at (j := {IDX[name]}) rfl⟩"


def data(m):
    name = f"open_stacked__L{m}"
    key = KEY[name]
    fn = f"(Fn.«{key}».core)"
    n = body_len(name)
    runs = (n + RUN - 1) // RUN
    out = [HDR.format(mod=f"Data{m}", doc=f"`open_stacked__L{m}` is its template, by kernel evaluation.",
                      imports="public import LeanVM.Guest.B1.Whir.DataSpecP\n" + fn_import(key))]
    out.append(f"""
/-!
# Size {m}

`osData_{m} P : OsDataP P {m}` for every `P` that finds the function: its body equal to the
template (`stmtsEqb_sound`), the body in runs of {RUN} statements, each its own kernel evaluation
(`run_step`), to bound the kernel's memory.
-/
""")
    for r in range(runs):  # the last run compares the rest, so no length is evaluated
        take = (lambda x: f"(({x}).take {RUN})") if r < runs - 1 else (lambda x: f"({x})")
        out.append(f"""
set_option maxRecDepth 100000 in
theorem os_run_{m}_{r} : stmtsEqb {take(f"{fn}.body.drop {r * RUN}")}
    {take(f"(osBody (osCfg {m})).drop {r * RUN}")} = true := by decide +kernel
""")
    steps = "".join(f"    run_step {RUN} {r * RUN} os_run_{m}_{r} <|\n" for r in range(runs - 1))
    out.append(f"""
set_option maxRecDepth 100000 in
theorem osData_{m} (P : Program) [Finds P "{name}" Fn.«{key}».core] : OsDataP P {m} := by
  have hb : {fn}.body.drop 0 = (osBody (osCfg {m})).drop 0 :=
{steps}    stmtsEqb_sound os_run_{m}_{runs - 1}
  rw [List.drop_zero, List.drop_zero] at hb
  exact fnIsP_of P "{name}" Fn.«{key}».core (by decide +kernel) hb
""")
    out.append(FTR)
    return "".join(out)


def data_all(arms):
    imports = ("public import LeanVM.Guest.B1.Whir.DataSpec\n"
               + "".join(f"public import LeanVM.Guest.B1.Whir.Data{m}\n" for m in range(arms))
               + "public import Mathlib.Tactic.IntervalCases\n")
    cases = "".join(f"\n  · exact @osData_{m} coreProgram {found(f'open_stacked__L{m}')}" for m in range(arms))
    return (HDR.format(mod="DataAll", doc="Every size's core IR is its template.", imports=imports) + f"""
/-- **Every size's core IR is its template.** -/
theorem osData_all (m : Nat) (h : m < ligNSizes) : OsData m := by
  interval_cases m{cases}
""" + FTR)


def nums(name, pre):
    return [int(x) for x in name[len(pre):].split("_L")]


def thm(fname, nparams, body):
    """Function `fname`'s data theorem, for any program that finds it, and its instance at
    `coreProgram`, each its own declaration."""
    key = KEY[fname]
    return (f'\nset_option maxRecDepth 100000 in\n/-- `{fname}`. -/\n'
            f'theorem {tname(fname)} (P : Program) [Finds P "{fname}" Fn.«{key}».core] :\n'
            f'    FnIsP P "{fname}" (osParams {nparams}) ({body}) :=\n'
            f'  fnIsP_of P "{fname}" Fn.«{key}».core (by decide +kernel) (stmtsEqb_sound (by decide +kernel))\n',
            f'\nset_option maxRecDepth 100000 in\n/-- `{fname}`. -/\n'
            f'theorem {inst(fname)} : FnIs "{fname}" (osParams {nparams}) ({body}) :=\n'
            f'  @{tname(fname)} coreProgram {found(fname)}\n')


def tname(fname):
    """The data theorem of function `fname`, by its stable name (no `__`, for the naming linter)."""
    return "fnIs_" + re.sub(r"_+", "_", KEY[fname])


def inst(fname):
    """The data theorem of function `fname`, at `coreProgram`."""
    return tname(fname) + "_core"


def nest(items):
    items = list(items)
    return "".join(f"\n  List.forall_mem_cons.2 ⟨{x}," for x in items) + "\n  List.forall_mem_nil _" + "⟩" * len(items)


def helpers(idx):
    thms, lp, lq, lr = [], [], [], []
    for name in sorted(idx, key=lambda n: idx[n]):
        if name.startswith("level_positions__L"):
            sq, d, cd = nums(name, "level_positions__L")
            (loop,) = loops(name)
            thms.append((name, thm(name, 9, f'lpBody {sq} {d} {cd} "{loop}"')))
            thms.append((loop, thm(loop, 6, f'lpLoopBody {d} {cd} "{loop}"')))
            lp.append((name, sq, loop, d, cd, inst(name), inst(loop)))
        elif name.startswith("level_queries__L"):
            ps = nums(name, "level_queries__L")
            thms.append((name, thm(name, 6, "lqBody " + " ".join(map(str, ps)))))
            lq.append((name, ps, inst(name)))
        elif name.startswith("level_residual__L"):
            q, cols, nhs, hbits = nums(name, "level_residual__L")
            ls = loops(name)
            assert len(ls) == (2 if q % RES_BATCH != 0 else 1), (name, ls)
            l1, l2 = ls[0], (ls[1] if q % RES_BATCH != 0 else "")
            thms.append((name, thm(name, 4, f'lrBody {q} "{l1}" "{l2}"')))
            thms.append((l1, thm(l1, 7, f'lrLoop1Body {cols} {nhs} {hbits} "{l1}"')))
            t2 = None
            if l2:
                thms.append((l2, thm(l2, 7, f'lrLoop2Body {cols} {nhs} {hbits} "{l2}"')))
                t2 = inst(l2)
            lr.append((name, q, cols, nhs, hbits, l1, l2, inst(name), inst(l1), t2))
    byPack = {}
    for f, x in thms:
        byPack.setdefault(pack_num(f), []).append((f, x))
    files = sorted(byPack)
    out = {}
    for k in files:
        chunk = byPack[k]
        out[f"HelperData{k}"] = (HDR.format(
            mod=f"HelperData{k}", doc="Specializations of `open_stacked`'s helpers are their templates, by kernel evaluation.",
            imports="public import LeanVM.Guest.B1.Whir.HelperT\npublic import LeanVM.Guest.B1.Whir.DataSpecP\n"
            + "".join(dict.fromkeys(fn_import(KEY[f]) for f, _ in chunk)))
            + "".join(x for _, (x, _) in chunk) + FTR)
    # the finds are glue, cheap: FIND_CHUNKS modules, pack `k` in chunk `k % FIND_CHUNKS`
    finds = sorted({k % FIND_CHUNKS for k in files})
    for c in finds:
        ks = [k for k in files if k % FIND_CHUNKS == c]
        out[f"HelperFind{c}"] = (HDR.format(
            mod=f"HelperFind{c}",
            doc=f"The functions of `HelperData{{k}}.lean`, `k % {FIND_CHUNKS} = {c}`, found in `coreProgram`.",
            imports="".join(f"public import LeanVM.Guest.B1.Whir.HelperData{k}\n" for k in ks)
            + "public import LeanVM.Guest.B1.Whir.DataSpec\n")
            + "".join(y for k in ks for _, (_, y) in byPack[k]) + FTR)
    s = lambda x: f'"{x}"'
    lpT = ",\n".join(f"  ({s(n)}, {sq}, {s(l)}, {d}, {cd})" for n, sq, l, d, cd, *_ in lp)
    lqT = ",\n".join(f"  ({s(n)}, {', '.join(map(str, ps))})" for n, ps, _ in lq)
    lrT = ",\n".join(f"  ({s(n)}, {q}, {c}, {h}, {b}, {s(l1)}, {s(l2)})" for n, q, c, h, b, l1, l2, *_ in lr)
    lpOk = nest(f"⟨{a}, {b}⟩" for *_, a, b in lp)
    lqOk = nest(t for *_, t in lq)
    lrOk = nest(f"⟨{a}, {b}, {'(fun _ ↦ ' + c + ')' if c else '(fun h ↦ (h (by decide)).elim)'}⟩"
                for *_, a, b, c in lr)
    out["HelperTables"] = HDR.format(
        mod="HelperTables", doc="The specializations of `open_stacked`'s helpers, in tables.",
        imports="public import LeanVM.Guest.B1.Whir.DataSpecP\n") + f"""
/-!
# The helpers' tables

`lpTable` (`level_positions`: name, squeezes, loop, depth, cap depth), `lqTable`
(`level_queries`: name, queries, base, folds, leaf cells, depth, cap depth, the final level's
message log, lane length and index bits, and whether final), `lrTable` (`level_residual`: name,
queries, columns, high part's length and index bits, its two loops). `Whir/HelperAll.lean` proves
every entry its template's instance.
-/

/-- The `lpTable` table. -/
def lpTable : List (String × ℕ × String × ℕ × ℕ) := [
{lpT}]

/-- The `lqTable` table. -/
def lqTable : List (String × ℕ × ℕ × ℕ × ℕ × ℕ × ℕ × ℕ × ℕ × ℕ × ℕ) := [
{lqT}]

/-- The `lrTable` table. -/
def lrTable : List (String × ℕ × ℕ × ℕ × ℕ × String × String) := [
{lrT}]

/-- `level_positions`' loop, by the specialization's name. -/
def lpLoopOf (name : String) : String := ((lpTable.find? (·.1 = name)).map (·.2.2.1)).getD ""

/-- `level_residual`'s loops, by the specialization's name. -/
def lrLoopsOf (name : String) : String × String :=
  ((lrTable.find? (·.1 = name)).map (·.2.2.2.2.2)).getD ("", "")
""" + FTR
    imports = ("public import LeanVM.Guest.B1.Whir.HelperTables\npublic import LeanVM.Guest.B1.Whir.DataSpec\n"
               + "".join(f"public import LeanVM.Guest.B1.Whir.HelperFind{c}\n" for c in finds))
    out["HelperAll"] = HDR.format(
        mod="HelperAll", doc="Every entry of the helpers' tables is its template's instance.",
        imports=imports) + f"""
/-!
# The helpers' tables, checked

`*_ok`: every entry of `Whir/HelperTables.lean`'s tables is its template's instance in
`coreProgram` (`Whir/HelperData*.lean`, each function found by its position in
`Whir/HelperFind*.lean`).
-/

set_option maxRecDepth 100000 in
theorem lpTable_ok : ∀ e ∈ lpTable, FnIs e.1 (osParams 9) (lpBody e.2.1 e.2.2.2.1 e.2.2.2.2 e.2.2.1) ∧
    FnIs e.2.2.1 (osParams 6) (lpLoopBody e.2.2.2.1 e.2.2.2.2 e.2.2.1) :={lpOk}

set_option maxRecDepth 100000 in
theorem lqTable_ok : ∀ e ∈ lqTable, FnIs e.1 (osParams 6)
    (lqBody e.2.1 e.2.2.1 e.2.2.2.1 e.2.2.2.2.1 e.2.2.2.2.2.1 e.2.2.2.2.2.2.1 e.2.2.2.2.2.2.2.1
      e.2.2.2.2.2.2.2.2.1 e.2.2.2.2.2.2.2.2.2.1 e.2.2.2.2.2.2.2.2.2.2) :={lqOk}

set_option maxRecDepth 100000 in
theorem lrTable_ok : ∀ e ∈ lrTable, FnIs e.1 (osParams 4) (lrBody e.2.1 e.2.2.2.2.2.1 e.2.2.2.2.2.2) ∧
    FnIs e.2.2.2.2.2.1 (osParams 7) (lrLoop1Body e.2.2.1 e.2.2.2.1 e.2.2.2.2.1 e.2.2.2.2.2.1) ∧
    (e.2.1 % resBatch ≠ 0 →
      FnIs e.2.2.2.2.2.2 (osParams 7) (lrLoop2Body e.2.2.1 e.2.2.2.1 e.2.2.2.2.1 e.2.2.2.2.2.2)) :={lrOk}
""" + FTR
    return out, len(thms), (len(lp), len(lq), len(lr))


def main():
    arms = int(re.search(r"def const_LIG_N_LOG_SIZES : Nat := (\d+)",
                         Path("LeanVM/Guest/Data/Source.lean").read_text()).group(1))
    global IDX, KEY
    idx = core_indices()
    IDX = idx
    ks = coredata.keys("LeanVM/Guest/Data")
    KEY = {name: ks[j] for name, j in idx.items()}
    assert all(re.fullmatch(r"[A-Za-z0-9_]+", k) for k in ks)
    assert len({re.sub(r"_+", "_", k) for k in ks}) == len(ks)
    out = {f"Data{m}": data(m) for m in range(arms)}
    out["DataAll"] = data_all(arms)
    hs, n, counts = helpers(idx)
    out.update(hs)
    check = "--check" in sys.argv
    stale = 0
    gen = re.compile(r"(Data|HelperData|HelperFind)\d+\.lean$")
    for p in WHIR.glob("*.lean"):
        if gen.match(p.name) and p.stem not in out:
            if check:
                print(f"{p} is stale")
                stale = 1
            else:
                p.unlink()
    for mod, text in out.items():
        path = WHIR / f"{mod}.lean"
        if check:
            if not path.exists() or path.read_text() != text:
                print(f"{path} is stale")
                stale = 1
        else:
            path.write_text(text)
    if not check:
        print(arms, "sizes;", n, "helper theorems; lp, lq, lr:", counts)
    return stale


sys.exit(main())
