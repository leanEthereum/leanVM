#!/usr/bin/env python3
"""Write `LeanVM/Guest/B1/Whir/Data{0..27}.lean`: each candidate's `open_stacked__L{m}`, its squeeze
loops and its residual loops are their templates (`OsData m`, `Whir/DataSpec.lean`), by kernel
evaluation. The functions' indices and body lengths are read from the core IR (`guest-core
--show`, `Guest/Data/Core*.lean`); the kernel checks them. Run from `lean_vm` after
`lake build guest-core`:

    python3 -I scripts/whir-data [--check]
"""
import re, subprocess, sys
from pathlib import Path

RUN = 1100  # statements a kernel evaluation of the body compares
NLEVELS_RE = re.compile(r"def arr_LIG_N_LEVELS : List \(Nat × Nat\) :=\s*\n\s*\[(.*?)\]\n", re.S)


def core_indices():
    out = {}
    for p in sorted(Path("LeanVM/Guest/Data").glob("Core[0-9]*.lean")):
        cur = None
        for ln in p.read_text().split("\n"):
            m = re.match(r"namespace core(\d+)$", ln)
            if m:
                cur = int(m.group(1))
                continue
            m = re.match(r"/-- `([^`]+)`\. -/$", ln)
            if m and cur is not None:
                out[m.group(1)] = cur
    return out


def body_len(name):
    out = subprocess.run(["./.lake/build/bin/guest-core", "--show", name], check=True, capture_output=True,
                         text=True).stdout
    return len([ln for ln in out.split("\n") if ln.startswith("  ")])


def fn_is(idx, name):
    j = idx[name]
    return (f"⟨Data.core{j}, Program.find?_of_indexOf? (j := {j}) (by decide +kernel) rfl,\n"
            f"    by decide +kernel, stmtsEqb_sound (by decide +kernel)⟩")


def data(m, nlev, idx):
    base = 41 + sum(2 * n - 1 for n in NLEV[:m])
    name = f"open_stacked__L{m}"
    j = idx[name]
    n = body_len(name)
    runs = (n + RUN - 1) // RUN
    out = [f"""/-
  LeanVM.Guest.B1.Whir.Data{m}

  `open_stacked__L{m}` and its loop helpers are their templates, by kernel evaluation.
  Generated by `scripts/whir-data`; do not edit.
-/

module

public import LeanVM.Guest.B1.Whir.DataSpec

/-!
# Candidate {m}

`osData_{m} : OsData {m}`: the function and its loops found by name (their indices in the core IR
checked by the kernel), their bodies equal to the templates (`stmtsEqb_sound`), the body in runs
of {RUN} statements, each its own kernel evaluation (`run_step`), to bound the kernel's memory.
-/

namespace LeanVM.Guest.B1.Whir

open LeanVM.Guest.Core LeanVM.Guest

@[expose] public section
"""]
    for r in range(runs):
        out.append(f"""set_option maxRecDepth 100000 in
theorem os_run_{m}_{r} : stmtsEqb ((Data.core{j}.body.drop {r * RUN}).take {RUN})
    (((osBody (osCfg {m})).drop {r * RUN}).take {RUN}) = true := by decide +kernel
""")
    for lvl in range(nlev):
        out.append(f"""set_option maxRecDepth 100000 in
theorem osSq_{m}_{lvl} : FnIs ((osCfg {m}).sqLoop {lvl}) (osParams 6)
    (sqLoopBody (osLv {m} {lvl}) ((osCfg {m}).sqLoop {lvl})) :=
  {fn_is(idx, f"__loop{base + lvl}")}
""")
    for lvl in range(nlev - 1):
        out.append(f"""set_option maxRecDepth 100000 in
theorem osRes_{m}_{lvl} : FnIs ((osCfg {m}).resLoop {lvl}) (osParams 7)
    (resLoopBody {lvl} (osLv {m} {lvl}) ((osCfg {m}).resLoop {lvl})) :=
  {fn_is(idx, f"__loop{base + nlev + lvl}")}
""")
    steps = "".join(f"    run_step {RUN} {r * RUN} os_run_{m}_{r} <|\n" for r in range(runs))
    sq = "\n".join(f"    · exact osSq_{m}_{lvl}" for lvl in range(nlev))
    res = "\n".join(f"    · exact osRes_{m}_{lvl}" for lvl in range(nlev - 1))
    out.append(f"""set_option maxRecDepth 100000 in
theorem osData_{m} : OsData {m} := by
  have hl : (osCfg {m}).levels.length = {nlev} := by decide +kernel
  have hy : (osCfg {m}).yrLevel = {nlev - 1} := by decide +kernel
  have hb : Data.core{j}.body.drop 0 = (osBody (osCfg {m})).drop 0 :=
{steps}    drop_end (o := {runs * RUN}) (by decide +kernel) (by decide +kernel)
  rw [List.drop_zero, List.drop_zero] at hb
  refine ⟨⟨Data.core{j}, Program.find?_of_indexOf? (j := {j}) (by decide +kernel) rfl,
    by decide +kernel, hb⟩, fun lvl h => ?_, fun lvl h => ?_⟩
  · rw [hl] at h
    interval_cases lvl
{sq}
  · rw [hy] at h
    interval_cases lvl
{res}

end
end LeanVM.Guest.B1.Whir
""")
    return "\n".join(out)


def main():
    global NLEV
    src = Path("LeanVM/Guest/Data/Source.lean").read_text()
    NLEV = [int(a) for a, _ in re.findall(r"\((\d+), (\d+)\)", NLEVELS_RE.search(src).group(1))]
    idx = core_indices()
    stale = 0
    for m in range(28):
        text = data(m, NLEV[m], idx)
        path = Path(f"LeanVM/Guest/B1/Whir/Data{m}.lean")
        if "--check" in sys.argv:
            if not path.exists() or path.read_text() != text:
                print(f"{path} is stale")
                stale = 1
        else:
            path.write_text(text)
    return stale


sys.exit(main())
