#!/usr/bin/env python3
"""Write `LeanVM/Guest/B1/Whir/Data{m}.lean` and `DataAll.lean` (every size's `open_stacked__L{m}`
is its template, `OsData m`, `Whir/DataSpec.lean`), and `HelperData{k}.lean`, `HelperFind{c}.lean`,
`HelperTables.lean` and `HelperAll.lean` (every specialization of `level_positions`,
`level_queries`, `level_residual`, `level_residual_slow`, `level_residual_sum`, `residual_query_slow` and of their loops is its template,
`Whir/HelperT.lean`, `Whir/SlowT.lean`, and the helpers' tables), by the kernel (`Data{m}` by
`kernel_rfl`, the helpers' bodies too). `Data{m}` reads only its function's core pack, and
`HelperData{k}` the helpers in core pack `k` (`Guest/Pack/P{k}/Core.lean`) and that pack only;
they hold for any program that finds the functions (`FnIsP`, `OsDataP`, `Whir/DataSpecP.lean`), and
`DataAll` and `HelperFind{c}` (eight chunks of packs) find them in `coreProgram`. The sizes are `ligNSizes`
(`LIG_N_LOG_SIZES`, `Data/Consts.lean`); the functions' keys, indices and packs are read from the core IR
(`Guest/Data/Core.lean`, `Guest/Pack`, `scripts/coredata.py`), with the loops a helper calls; the
kernel checks them. Run from `lean_vm`:

    python3 -I scripts/whir-data [--check]
"""
import re, sys
from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parent))
import coredata

FIND_CHUNKS = 8  # the glue modules finding the helpers in `coreProgram`
WHIR = Path("LeanVM/Guest/B1/Whir")


def core_indices():
    out = {}
    for t in coredata.legacy_texts("LeanVM/Guest/Data"):
        for m in re.finditer(r'noncomputable def core(\d+) : Core\.Fn where\n  name := "([^"]+)"', t):
            out[m.group(2)] = int(m.group(1))
    return out


BODIES = {}


def loops(name):
    """The loops a function calls, in order, read off its core IR's text."""
    if not BODIES:
        for t in coredata.legacy_texts("LeanVM/Guest/Data"):
            for m in re.finditer(r'^namespace core(\d+)\n(.*?)^end core\1$', t, re.M | re.S):
                BODIES[int(m.group(1))] = BODIES.get(int(m.group(1)), "") + m.group(2)
            for m in re.finditer(r'noncomputable def core(\d+) : Core\.Fn where\n(.*?)(?=\n\n)', t, re.S):
                BODIES[int(m.group(1))] = BODIES.get(int(m.group(1)), "") + m.group(2)
    seen = []
    for l in re.findall(r'"(__loop[^"]*)"', BODIES[IDX[name]]):
        if l not in seen:
            seen.append(l)
    return seen


HDR = """/-
  LeanVM.Guest.B1.Whir.{mod}

  {doc} Generated by `scripts/whir-data`; do not edit.
-/

module

{imports}
namespace LeanVM.Guest.B1.Whir

open LeanVM.Guest.Core LeanVM.Guest

@[expose] public section
"""
FTR = "\nend\nend LeanVM.Guest.B1.Whir\n"


def fn_import(key):
    return f"public import {coredata.fn_module('LeanVM/Guest/Data', key)}\n"


def pack_num(fname):
    """The core pack of function `fname`: a helper is small, so in a numbered pack."""
    mod = coredata.fn_module('LeanVM/Guest/Data', KEY[fname])
    k = mod.split('.')[3]
    assert k[0] == 'P' and k[1:].isdigit(), (fname, mod)
    return int(k[1:])


def found(name):
    """`coreProgram` finds function `name`, by its position."""
    return f"⟨coreProgram_find?_at (j := {IDX[name]}) rfl⟩"


def data(m):
    name = f"open_stacked__L{m}"
    key = KEY[name]
    fn = f"(Fn.«{key}».core)"
    out = [HDR.format(mod=f"Data{m}", doc=f"`open_stacked__L{m}` is its template, by the kernel.",
                      imports="public import LeanVM.Guest.B1.Whir.DataSpecP\n" + fn_import(key)
                      + "import LeanVM.Guest.KernelLit\n")]
    out.append(f"""
/-!
# Size {m}

`osData_{m} P : OsDataP P {m}` for every `P` that finds the function: its body is the template
(`kernel_rfl`).
-/

open LeanVM.Guest.KernelLit in
private kernel_rfl os_body_{m} : {fn}.body = osBody (osCfg {m})

theorem osData_{m} (P : Program) [Finds P "{name}" Fn.«{key}».core] : OsDataP P {m} :=
  fnIsP_of P "{name}" Fn.«{key}».core (by decide +kernel) os_body_{m}
""")
    out.append(FTR)
    return "".join(out)


def data_all(arms):
    imports = ("public import LeanVM.Guest.B1.Whir.DataSpec\n"
               + "".join(f"public import LeanVM.Guest.B1.Whir.Data{m}\n" for m in range(arms))
               + "public import Mathlib.Tactic.IntervalCases\n")
    cases = "".join(f"\n  · exact @osData_{m} coreProgram {found(f'open_stacked__L{m}')}" for m in range(arms))
    return (HDR.format(mod="DataAll", doc="Every size's core IR is its template.", imports=imports) + f"""
/-- **Every size's core IR is its template.** -/
theorem osData_all (m : Nat) (h : m < ligNSizes) : OsData m := by
  interval_cases m{cases}
""" + FTR)


def nums(name, pre):
    return [int(x) for x in name[len(pre):].split("_L")]


def thm(fname, nparams, body):
    """Function `fname`'s data theorem, for any program that finds it, and its instance at
    `coreProgram`, each its own declaration."""
    key, t = KEY[fname], tname(fname)
    return (f'\nprivate kernel_rfl {t}_body : (Fn.«{key}».core).body = {body}\n\n/-- `{fname}`. -/\n'
            f'theorem {t} (P : Program) [Finds P "{fname}" Fn.«{key}».core] :\n'
            f'    FnIsP P "{fname}" (osParams {nparams}) ({body}) :=\n'
            f'  fnIsP_of P "{fname}" Fn.«{key}».core (by decide +kernel) {t}_body\n',
            f'\nset_option maxRecDepth 100000 in\n/-- `{fname}`. -/\n'
            f'theorem {inst(fname)} : FnIs "{fname}" (osParams {nparams}) ({body}) :=\n'
            f'  @{tname(fname)} coreProgram {found(fname)}\n')


def tname(fname):
    """The data theorem of function `fname`, by its stable name (no `__`, for the naming linter)."""
    return "fnIs_" + re.sub(r"_+", "_", KEY[fname])


def inst(fname):
    """The data theorem of function `fname`, at `coreProgram`."""
    return tname(fname) + "_core"


CHUNK = 16  # the entries a table's chunk checks in one term, within the default recursion depth


def chunked(name, ty, rows, oks, prop):
    """A table as the flatten of its chunks of `CHUNK` entries (`{name}{k}`), and its check
    `{name}_ok`: each chunk's by its entries' theorems, the table's by its chunks'."""
    ks = range(0, len(rows), CHUNK)
    defs = "".join(f"/-- The `{name}` table, entries {k} on. -/\ndef {name}{k // CHUNK} : List ({ty}) := [\n"
                   + ",\n".join(rows[k:k + CHUNK]) + "]\n\n" for k in ks)
    defs += (f"/-- The `{name}` table. -/\ndef {name} : List ({ty}) :=\n  ["
             + ", ".join(f"{name}{k // CHUNK}" for k in ks) + "].flatten\n")
    oks_ = "".join(f"\ntheorem {name}{k // CHUNK}_ok : ∀ e ∈ {name}{k // CHUNK}, {prop} :="
                   + nest(oks[k:k + CHUNK]) + "\n" for k in ks)
    oks_ += (f"\ntheorem {name}_ok : ∀ e ∈ {name}, {prop} := fun e he ↦ by\n"
             f"  obtain ⟨l, hl, hel⟩ := List.mem_flatten.mp he\n"
             f"  have h : ∀ l ∈ [" + ", ".join(f"{name}{k // CHUNK}" for k in ks) + f"], ∀ e ∈ l, {prop} :="
             + nest(f"{name}{k // CHUNK}_ok" for k in ks) + "\n"
             f"  exact h l hl e hel\n")
    return defs, oks_


def nest(items):
    items = list(items)
    return "".join(f"\n  List.forall_mem_cons.2 ⟨{x}," for x in items) + "\n  List.forall_mem_nil _" + "⟩" * len(items)


def helpers(idx):
    thms, lp, lq, lr, lrs, rs = [], [], [], [], [], []
    for name in sorted(idx, key=lambda n: idx[n]):
        if name.startswith("level_residual_slow__L"):
            q, pre, yr, vo = nums(name, "level_residual_slow__L")
            sm = f"level_residual_sum__L{q}_L{pre}_L{yr}_L{vo}"
            (loop,) = loops(sm)
            rq = f"residual_query_slow__L{pre}_L{yr}_L{vo}"
            thms.append((name, thm(name, 5, f'lrsBody "{sm}"')))
            thms.append((sm, thm(sm, 4, f'lsumBody {q} "{loop}"')))
            thms.append((loop, thm(loop, 8, f'lrsLoopBody "{rq}" "{loop}"')))
            lrs.append((name, q, pre, yr, vo, sm, loop, rq, inst(name), inst(sm), inst(loop)))
        elif name.startswith("residual_query_slow__L"):
            pre, yr, vo = nums(name, "residual_query_slow__L")
            thms.append((name, thm(name, 3, f"rqsBody {pre} {yr} {vo}")))
            rs.append((name, pre, yr, vo, inst(name)))
        elif name.startswith("level_positions__L"):
            d, cd = nums(name, "level_positions__L")
            (loop,) = loops(name)
            thms.append((name, thm(name, 10, f'lpBody {d} {cd} "{loop}"')))
            thms.append((loop, thm(loop, 6, f'lpLoopBody {d} {cd} "{loop}"')))
            lp.append((name, loop, d, cd, inst(name), inst(loop)))
        elif name.startswith("level_queries__L"):
            ps = nums(name, "level_queries__L")
            thms.append((name, thm(name, 6, "lqBody " + " ".join(map(str, ps)))))
            lq.append((name, ps, inst(name)))
        elif name.startswith("level_residual__L"):
            cols, nhs, hbits = nums(name, "level_residual__L")
            l1, l2 = loops(name)
            thms.append((name, thm(name, 6, f'lrBody "{l1}" "{l2}"')))
            thms.append((l1, thm(l1, 7, f'lrLoop1Body {cols} {nhs} {hbits} "{l1}"')))
            thms.append((l2, thm(l2, 7, f'lrLoop2Body {cols} {nhs} {hbits} "{l2}"')))
            lr.append((name, cols, nhs, hbits, l1, l2, inst(name), inst(l1), inst(l2)))
    byPack = {}
    for f, x in thms:
        byPack.setdefault(pack_num(f), []).append((f, x))
    files = sorted(byPack)
    out = {}
    for k in files:
        chunk = byPack[k]
        out[f"HelperData{k}"] = (HDR.format(
            mod=f"HelperData{k}", doc="Specializations of `open_stacked`'s helpers are their templates, by the kernel.",
            imports="public import LeanVM.Guest.B1.Whir.HelperT\npublic import LeanVM.Guest.B1.Whir.SlowT\n"
            "public import LeanVM.Guest.B1.Whir.DataSpecP\n"
            + "".join(dict.fromkeys(fn_import(KEY[f]) for f, _ in chunk)) + "meta import LeanVM.Guest.KernelLit\n")
            + "".join(x for _, (x, _) in chunk) + FTR)
    # the finds are glue, cheap: FIND_CHUNKS modules, pack `k` in chunk `k % FIND_CHUNKS`
    finds = sorted({k % FIND_CHUNKS for k in files})
    for c in finds:
        ks = [k for k in files if k % FIND_CHUNKS == c]
        out[f"HelperFind{c}"] = (HDR.format(
            mod=f"HelperFind{c}",
            doc=f"The functions of `HelperData{{k}}.lean`, `k % {FIND_CHUNKS} = {c}`, found in `coreProgram`.",
            imports="".join(f"public import LeanVM.Guest.B1.Whir.HelperData{k}\n" for k in ks)
            + "public import LeanVM.Guest.B1.Whir.DataSpec\n")
            + "".join(y for k in ks for _, (_, y) in byPack[k]) + FTR)
    s = lambda x: f'"{x}"'
    lpT = ",\n".join(f"  ({s(n)}, {s(l)}, {d}, {cd})" for n, l, d, cd, *_ in lp)
    lqT = ",\n".join(f"  ({s(n)}, {', '.join(map(str, ps))})" for n, ps, _ in lq)
    lrT = ",\n".join(f"  ({s(n)}, {c}, {h}, {b}, {s(l1)}, {s(l2)})" for n, c, h, b, l1, l2, *_ in lr)
    lsTy = "String × ℕ × ℕ × ℕ × ℕ × String × String × String"
    lsT, lsOk = chunked("lrsTable", lsTy, [f"  ({s(n)}, {q}, {p}, {y}, {v}, {s(m)}, {s(l)}, {s(r)})"
                                          for n, q, p, y, v, m, l, r, *_ in lrs],
                        [f"⟨{a}, {b}, {c}⟩" for *_, a, b, c in lrs],
                        "FnIs e.1 (osParams 5) (lrsBody e.2.2.2.2.2.1) ∧\n"
                        "    FnIs e.2.2.2.2.2.1 (osParams 4) (lsumBody e.2.1 e.2.2.2.2.2.2.1) ∧\n"
                        "    FnIs e.2.2.2.2.2.2.1 (osParams 8) (lrsLoopBody e.2.2.2.2.2.2.2 e.2.2.2.2.2.2.1)")
    rsT, rsOk = chunked("rqsTable", "String × ℕ × ℕ × ℕ", [f"  ({s(n)}, {p}, {y}, {v})" for n, p, y, v, _ in rs],
                        [t for *_, t in rs], "FnIs e.1 (osParams 3) (rqsBody e.2.1 e.2.2.1 e.2.2.2)")
    lpOk = nest(f"⟨{a}, {b}⟩" for *_, a, b in lp)
    lqOk = nest(t for *_, t in lq)
    lrOk = nest(f"⟨{a}, {b}, {c}⟩" for *_, a, b, c in lr)
    out["HelperTables"] = HDR.format(
        mod="HelperTables", doc="The specializations of `open_stacked`'s helpers, in tables.",
        imports="public import LeanVM.Guest.B1.Whir.DataSpecP\n") + f"""
/-!
# The helpers' tables

`lpTable` (`level_positions`: name, loop, depth, cap depth), `lqTable`
(`level_queries`: name, queries, base, folds, leaf cells, depth, cap depth, the final level's
message log, lane length and index bits, and whether final), `lrTable` (`level_residual`: name,
columns, high part's length and index bits, its two loops), `lrsTable`
(`level_residual_slow`: name, queries, prefix, tail rounds, vanishing offset, its
`level_residual_sum`, that one's loop, their `residual_query_slow`), `rqsTable` (`residual_query_slow`: name, prefix, tail rounds, vanishing
offset). `Whir/HelperAll.lean` proves every entry its template's instance.
-/

/-- The `lpTable` table. -/
def lpTable : List (String × String × ℕ × ℕ) := [
{lpT}]

/-- The `lqTable` table. -/
def lqTable : List (String × ℕ × ℕ × ℕ × ℕ × ℕ × ℕ × ℕ × ℕ × ℕ × ℕ) := [
{lqT}]

/-- The `lrTable` table. -/
def lrTable : List (String × ℕ × ℕ × ℕ × String × String) := [
{lrT}]

{lsT}
{rsT}

/-- `level_positions`' loop, by the specialization's name. -/
def lpLoopOf (name : String) : String := ((lpTable.find? (·.1 = name)).map (·.2.1)).getD ""

/-- `level_residual`'s loops, by the specialization's name. -/
def lrLoopsOf (name : String) : String × String :=
  ((lrTable.find? (·.1 = name)).map (·.2.2.2.2)).getD ("", "")
""" + FTR
    imports = ("public import LeanVM.Guest.B1.Whir.HelperTables\npublic import LeanVM.Guest.B1.Whir.DataSpec\n"
               + "".join(f"public import LeanVM.Guest.B1.Whir.HelperFind{c}\n" for c in finds))
    out["HelperAll"] = HDR.format(
        mod="HelperAll", doc="Every entry of the helpers' tables is its template's instance.",
        imports=imports) + f"""
/-!
# The helpers' tables, checked

`*_ok`: every entry of `Whir/HelperTables.lean`'s tables is its template's instance in
`coreProgram` (`Whir/HelperData*.lean`, each function found by its position in
`Whir/HelperFind*.lean`).
-/

set_option maxRecDepth 100000 in
theorem lpTable_ok : ∀ e ∈ lpTable, FnIs e.1 (osParams 10) (lpBody e.2.2.1 e.2.2.2 e.2.1) ∧
    FnIs e.2.1 (osParams 6) (lpLoopBody e.2.2.1 e.2.2.2 e.2.1) :={lpOk}

set_option maxRecDepth 100000 in
theorem lqTable_ok : ∀ e ∈ lqTable, FnIs e.1 (osParams 6)
    (lqBody e.2.1 e.2.2.1 e.2.2.2.1 e.2.2.2.2.1 e.2.2.2.2.2.1 e.2.2.2.2.2.2.1 e.2.2.2.2.2.2.2.1
      e.2.2.2.2.2.2.2.2.1 e.2.2.2.2.2.2.2.2.2.1 e.2.2.2.2.2.2.2.2.2.2) :={lqOk}

set_option maxRecDepth 100000 in
theorem lrTable_ok : ∀ e ∈ lrTable, FnIs e.1 (osParams 6) (lrBody e.2.2.2.2.1 e.2.2.2.2.2) ∧
    FnIs e.2.2.2.2.1 (osParams 7) (lrLoop1Body e.2.1 e.2.2.1 e.2.2.2.1 e.2.2.2.2.1) ∧
    FnIs e.2.2.2.2.2 (osParams 7) (lrLoop2Body e.2.1 e.2.2.1 e.2.2.2.1 e.2.2.2.2.2) :={lrOk}
{lsOk}{rsOk}""" + FTR
    return out, len(thms), (len(lp), len(lq), len(lr), len(lrs), len(rs))


def main():
    arms = int(re.search(r"def const_LIG_N_LOG_SIZES : Nat := (\d+)",
                         Path("LeanVM/Guest/Data/Consts.lean").read_text()).group(1))
    global IDX, KEY
    idx = core_indices()
    IDX = idx
    ks = coredata.keys("LeanVM/Guest/Data")
    KEY = {name: ks[j] for name, j in idx.items()}
    assert all(re.fullmatch(r"[A-Za-z0-9_]+", k) for k in ks)
    assert len({re.sub(r"_+", "_", k) for k in ks}) == len(ks)
    out = {f"Data{m}": data(m) for m in range(arms)}
    out["DataAll"] = data_all(arms)
    hs, n, counts = helpers(idx)
    out.update(hs)
    check = "--check" in sys.argv
    stale = 0
    gen = re.compile(r"(Data|HelperData|HelperFind)\d+\.lean$")
    for p in WHIR.glob("*.lean"):
        if gen.match(p.name) and p.stem not in out:
            if check:
                print(f"{p} is stale")
                stale = 1
            else:
                p.unlink()
    for mod, text in out.items():
        path = WHIR / f"{mod}.lean"
        if check:
            if not path.exists() or path.read_text() != text:
                print(f"{path} is stale")
                stale = 1
        else:
            path.write_text(text)
    if not check:
        print(arms, "sizes;", n, "helper theorems; lp, lq, lr, lrs, rqs:", counts)
    return stale


sys.exit(main())
