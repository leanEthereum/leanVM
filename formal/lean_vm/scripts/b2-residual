#!/usr/bin/env python3
"""Write lean_vm/LeanVM/Guest/Backend/Guest/B2/Residual.lean: the guest's values whose certificate
cell the core semantics does not justify against the back end's place.

For each function, the certificate's cells (`(certOf j).locs`, read off `Guest/Pack/*`: the window
lists `cert_w{i}_{k}` of `Fn.«ns».cert`, a list's tail named by its last element) are compared with
the back end's places of the guest (`placeProgram` of the traced guest, `scripts/b2-residual.lean`,
run with `lake env lean --run`) by `B2.Agree.fnOk`. A function it rejects gets residual entries:
a pointer placed shifted whose cell differs (`.addr`), a constant no earlier constant on its path
sets the cell of (`.konst`, its limbs). The helper fails if a function is still rejected with them.
Needs the back end and `B2.Agree` built (`lake build LeanVM.Guest.Backend.Guest.B2.Agree`).
`python3 -I scripts/b2-residual`, from any directory (the paths are lean_vm's); `--check` fails
when the file differs.
"""
import argparse, glob, os, re, subprocess, sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
OUT = "LeanVM/Guest/Backend/Guest/B2/Residual.lean"
PACK = "LeanVM/Guest/Pack"


def cert_cells():
    """Each function's certificate cells, by the name its signature gives it."""
    defs, cells, names = {}, {}, {}
    for f in glob.glob(PACK + "/**/*.lean", recursive=True):
        for blk in re.split(r"\nnamespace ", open(f).read()):
            m = re.match(r"LeanVM\.Guest\.Fn\.«([^»]*)»", blk)
            if not m:
                continue
            ns = m.group(1)
            for d in re.finditer(r"\ndef (cert_\w+) : List ℕ := (.*?)\n(?=\n|/--|def |end|noncomputable)",
                                 blk, re.S):
                defs[(ns, d.group(1))] = d.group(2)
            c = re.search(r"noncomputable def cert : Check\.Cert where\n.*?\n  cells := (.*?)\n  ins", blk, re.S)
            if c:
                cells[ns] = c.group(1).strip()
            s = re.search(r'def sig : Check\.Sig :=\s*⟨"([^"]*)"', blk)
            if s:
                names[ns] = s.group(1)

    def resolve(ns, name):
        t = defs[(ns, name)].strip()
        tail = re.search(r"::\s*(cert_\w+)\)\s*$", t)
        body = t[:tail.start()] if tail else t
        out = [int(x) for x in re.findall(r"\b\d+\b", body)]
        return out + (resolve(ns, tail.group(1)) if tail else [])

    out = {}
    for ns, cl in cells.items():
        locs = []
        for item in cl[1:-1].split(","):
            for part in item.split("++"):
                part = part.strip()
                if not part or part == "[]":
                    continue
                if part.startswith("["):
                    locs += [int(x) for x in re.findall(r"\d+", part)]
                else:
                    locs += resolve(ns, part)
        out[names[ns]] = locs
    return out


def render(rows):
    lines = []
    for name, items in rows:
        lines.append(f'    ("{name}", [{", ".join(items)}])')
    body = ",\n".join(lines)
    return f'''/-
  LeanVM.Guest.Backend.Guest.B2.Residual

  Generated by `scripts/b2-residual`; do not edit.
  The guest's values whose certificate cell the core semantics does not justify against the back
  end's place: by function, the value and what its cell holds.
-/

module

public import LeanVM.Guest.Backend.Guest.B2.Agree

namespace LeanVM.Guest.Backend.B2

open LeanVM.Guest.Core

@[expose] public section

/-- **The residual table**: function, then each value whose cell holds a constant (`.konst`) or
its word by place (`.addr`) by a fact about the run (`ResidualFacts`). -/
def residual : List (String × List (V × Res)) := [
{body}]

end
end LeanVM.Guest.Backend.B2
'''


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--check", action="store_true")
    a = ap.parse_args()
    os.chdir(ROOT)
    cells = cert_cells()
    tmp = Path(".lake/b2-residual-cells.txt")
    tmp.write_text("\n".join(f"{n} {' '.join(map(str, l))}" for n, l in cells.items()) + "\n")
    r = subprocess.run(["lake", "env", "lean", "--run", "scripts/b2-residual.lean", str(tmp)],
                       capture_output=True, text=True)
    if r.returncode != 0:
        sys.stderr.write(r.stdout + r.stderr)
        sys.exit(1)
    rows = []
    for line in r.stdout.splitlines():
        if line.startswith("res "):
            _, name, rest = line.split(" ", 2)
            rows.append((name, [x.strip() for x in rest.split(";") if x.strip()]))
        elif line.startswith("stats: "):
            print(line)
    text = render(rows)
    if a.check:
        if open(OUT).read() != text:
            sys.exit(f"{OUT} is stale")
        return
    open(OUT, "w").write(text)


if __name__ == "__main__":
    main()
