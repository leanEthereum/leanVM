#!/usr/bin/env python3
"""Write `LeanVM/Guest/Data/GTab.lean`: the digit tables of powers of `g` (`Guest/Pow.lean`), the same for
every program. Run from `lean_vm`:

    python3 -I scripts/gtab [--check]
"""
import os, sys

POLY = (1 << 64) | 0b11011  # x^64 + x^4 + x^3 + x + 1 (Statement/Field.lean)
G = 2  # g = x


def mulk(a, b):
    r = 0
    while b:
        if b & 1:
            r ^= a
        b >>= 1
        a <<= 1
        if a >> 64:
            a ^= POLY
    return r


def rows(table):
    return "[" + ",\n  ".join("[" + ", ".join(str(y) for y in row) + "]" for row in table) + "]"


def digits():
    out, x = [], G
    for _ in range(5):
        row, y = [], 1
        for _ in range(16):
            row.append(y)
            y = mulk(y, x)
        out.append(row)
        x = y
    return out


def runs(s):
    out, y = [], 1
    for _ in range(32):
        row = []
        for _ in range(32):
            row.append(y)
            y = mulk(y, s)
        out.append(row)
    return out


def g1024():
    y = 1
    for _ in range(1024):
        y = mulk(y, G)
    return y


TEXT = f"""/-
  LeanVM.Guest.Data.GTab

  Generated by `scripts/gtab`; do not edit.
  The digit tables of powers of `g`, the same for every program.
-/

module

public import LeanVM.Guest.ExecCore

namespace LeanVM.Guest.Data

open LeanVM.Guest LeanVM.Guest.Exec

set_option maxRecDepth 100000
set_option linter.all false

@[expose] public section

/-- `g^(d·16^w)` at row `w`, column `d`, as bits. -/
def gtab : List (List ℕ) := {rows(digits())}

/-- `g^d` for `d < 1024`, at row `d / 32`, column `d % 32`, as bits. -/
def gtabLo : List (List ℕ) := {rows(runs(G))}

/-- `g^(1024·d)` for `d < 1024`, at row `d / 32`, column `d % 32`, as bits. -/
def gtabHi : List (List ℕ) := {rows(runs(g1024()))}

end
end LeanVM.Guest.Data
"""

path = os.path.join("LeanVM", "Guest", "Data", "GTab.lean")
if "--check" in sys.argv[1:]:
    old = open(path, encoding="utf-8").read() if os.path.exists(path) else None
    if old != TEXT:
        sys.exit(f"{path} is stale: run scripts/gtab")
else:
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        f.write(TEXT)
