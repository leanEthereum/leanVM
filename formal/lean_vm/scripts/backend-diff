#!/usr/bin/env bash
# The compiler's back end in Lean (`LeanVM/Compiler`): its outputs current, by compiled execution,
# and its front end (`Expand`) against the Rust one. Run from anywhere; needs `lake` and `cargo`.
#
#   scripts/backend-diff
#
# 1. `lake exe guest-backend check`: the guest's source, through `Expand` and the back end, is the
#    statement's program (`Data.functions`, and every slot of `assemble Data.functions`), and the
#    back end's invariants hold of it.
# 2. `lake exe guest-backend export programs … --check` and `export snippets … --check`: the
#    checked-in compilations of the test programs (`crates/zkdsl/tests/compiled/`) and of the
#    aggregation tests' guest snippets (`crates/aggregation/snippets/`) are current;
#    `lake exe guest-traced --check`: the guest's traced input (`Guest/Compiled/`) is current, and
#    the back end compiles it to the statement's program; `lake exe guest-pieces --check` and
#    `test --check`: the kernel's checks of the guest's compilation (`Guest/Compiled/Piece/`,
#    `Compiled.lean`) and of a test program are current, each evaluated natively.
# 3. `scripts/guest-artifact --check`: the compiled guest the Rust prover loads
#    (`guests/lean_ethereum.compiled`) is the back end's output at the fixed point.
# 4. `scripts/frontend-diff`: `Expand` gives the guest and every test program the core IR the Rust
#    front end (`crates/zkdsl/src/expand.rs`) gives, function by function.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

lake build guest-backend
lake exe guest-backend check
lake exe guest-backend export programs ../../crates/zkdsl/tests/compiled --check
lake exe guest-backend export snippets ../../crates/aggregation/snippets --check
lake build guest-traced
lake exe guest-traced --check
lake build guest-pieces
lake exe guest-pieces --check
lake exe guest-pieces test --check
scripts/guest-artifact --check
scripts/frontend-diff
