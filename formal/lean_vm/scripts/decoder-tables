#!/usr/bin/env python3
"""Write lean_vm/LeanVM/Cost/Decoder/GuestTables.lean: the guest decoder's literal tables.

For each compiled function `j < nFns`: its entry pc (`(fnOf j).entryPc`), its number of arguments
(`(coreOf j).params.length`), of return words (`(certOf j).nret`), and its certificate's frame
cells (`(certOf j).locs`, by reference to the certificate data `Data.cert{j}_w{i}_{k}`). Read off
the generated sources (`LeanVM/Guest/Data/Core*.lean`, `Cert*.lean`) and an entry list
(`--entries FILE`, `(List.range nFns).map fun j ↦ (fnOf j).entryPc`, the line `entries: …` that
`lake env lean scripts/decoder-tables-inputs.lean` prints after `lake build`);
`Cost/Decoder/GuestTablesCheck.lean` proves the tables equal to their definitions by kernel
evaluation. `python3 -I scripts/decoder-tables --entries FILE`, from any directory (the paths are
lean_vm's); `--check` fails when the file differs (`check-all.sh` and the CI run it).
"""
import argparse, glob, os, re, sys
from pathlib import Path

N = 992
PART = 512  # rows per part of `guestLocsList`
OUT = "LeanVM/Cost/Decoder/GuestTables.lean"


def cores():
    out = {}
    for f in sorted(glob.glob("LeanVM/Guest/Data/Core*.lean")):
        s = open(f).read()
        for m in re.finditer(r"noncomputable def core(\d+) : Core\.Fn where\n  name := \"[^\"]*\"\n"
                             r"  params := (.*?)\n  body", s, re.S):
            p = m.group(2).strip()
            out[int(m.group(1))] = 0 if p == "[]" else p.count(".n ")
    return out


def certs():
    out = {}
    for f in sorted(glob.glob("LeanVM/Guest/Data/Cert*.lean")):
        s = open(f).read()
        for m in re.finditer(r"noncomputable def cert(\d+) : Check\.Cert where\n(.*?)(?=\n\n|\Z)", s, re.S):
            body = m.group(2)
            cells = re.search(r"  cells := \[(.*?)\]\n  ins :=", body, re.S).group(1)
            names = [c.strip() for c in cells.split(",") if c.strip()]
            nret = int(re.search(r"  nret := (\d+)", body).group(1))
            out[int(m.group(1))] = (names, nret)
    return out


def ref(n):
    """A window's cells: its data list, or an empty window's literal `[]`."""
    return "[]" if n == "[]" else f"Data.{n}"


def chunks(xs, n):
    return [xs[i:i + n] for i in range(0, len(xs), n)]


def nat_array(name, doc, xs):
    rows = ",\n    ".join(", ".join(str(x) for x in c) for c in chunks(xs, 10))
    return (f"/-- {doc} -/\ndef {name}List : List ℕ := [\n    {rows}]\n\n"
            f"/-- {doc} An array (reducible: the compiler's literal rule reads its list). -/\n"
            f"abbrev {name} : Array ℕ := {name}List.toArray\n")


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--entries", required=True)
    ap.add_argument("--check", action="store_true")
    ap.add_argument("--split-rows", default="37",
                    help="rows whose cells' lists get a name of their own (checked by chunks)")
    a = ap.parse_args()
    entries = [int(x) for x in re.findall(r"\d+", open(a.entries).read())]
    os.chdir(Path(__file__).resolve().parent.parent)
    assert len(entries) == N, len(entries)
    co, ce = cores(), certs()
    args = [co[max(j - 1, 0)] for j in range(N)]
    rets = [ce[j][1] for j in range(N)]
    split = [int(x) for x in a.split_rows.split(",") if x]
    locs = []
    rowdefs = ""
    for j in range(N):
        names = ce[j][0]
        if j in split:
            rowdefs += (f"/-- Function {j}'s certificate's cells, list by list. -/\n"
                        f"def guestLocsRow{j} : List (List ℕ) := [\n    "
                        + ",\n    ".join(ref(n) for n in names) + "]\n\n")
            locs.append(f"guestLocsRow{j}.flatten")
        else:
            locs.append("[]" if not names else
                        "[" + ", ".join(ref(n) for n in names) + "].flatten")
    parts = chunks(locs, PART)
    locs_parts = "".join(
        f"/-- Functions {i * PART} to {i * PART + len(p) - 1}'s frame cells. -/\n"
        f"def guestLocsList{i} : List (List ℕ) := [\n    " + ",\n    ".join(p) + "]\n\n"
        for i, p in enumerate(parts))
    text = f'''/-
  LeanVM.Cost.Decoder.GuestTables

  Generated by `scripts/decoder-tables` from the guest's generated data; do not edit.
-/

module

public import LeanVM.Guest.Data.Cert

/-!
# The guest decoder's tables

For each of the guest's {N} compiled functions `j`: its entry pc, its number of arguments and of
return words, and its certificate's frame cells. Literals of the decoder program
(`Rule.literalNats`, `Rule.literalNatArrays`); `GuestTablesCheck.lean` proves them equal to `(glob.sig j).entry`,
`(glob.sig j).nargs`, `(glob.sig j).nret` and `(certOf j).locs`.
-/

namespace LeanVM.Cost.Decoder

open LeanVM.Guest

@[expose] public section

{nat_array("guestEntries", "Each function's entry pc (`(fnOf j).entryPc`).", entries)}
{nat_array("guestArgCounts", "Each function's number of arguments (`(coreOf j).params.length`).", args)}
{nat_array("guestRetCounts", "Each function's number of return words (`(certOf j).nret`).", rets)}
{rowdefs}{locs_parts}/-- Each function's frame cells (`(certOf j).locs`), as lists: the parts' (a list literal of
{N} rows exceeds the code generator's recursion depth). -/
def guestLocsList : List (List ℕ) :=
    {" ++ ".join(f"guestLocsList{i}" for i in range(len(parts)))}

/-- Each function's frame cells, as arrays: the decoder's literal (reducible: the compiler's
literal rule reads its list). -/
abbrev guestLocsLit : Array (Array ℕ) := (guestLocsList.map List.toArray).toArray

/-- Each function's frame cells, as arrays (`Cost/Decoder/Witness.lean` compiles its uses as calls
of one function holding the literal). -/
def guestLocs : Array (Array ℕ) := guestLocsLit

end

end LeanVM.Cost.Decoder
'''
    if a.check:
        if open(OUT).read() != text:
            sys.exit(f"{OUT} is stale: run scripts/decoder-tables")
        return
    open(OUT, "w").write(text)


main()
