#!/usr/bin/env python3
"""Write `LeanVM/Guest/Backend/ExpandTrace.lean`: `LeanVM/Guest/Expand.lean` recording its allocation trace.

  python3 -I scripts/expand-trace [--check]

Run from `lean_vm`. The generated module is `Expand.lean` with the edits below and nothing else: `fresh` and
`freshRun` take the `Kind` of the value they make and record it, a statement's emission and the bounds of a branch
or an arm are recorded, and five places say what the core IR does not (an address used as a value, an address
shifted, a chained `match`, a hint's offset, the trace returned). No edit changes a statement the expansion emits:
`guest-backend check` compares the two expansions' core functions. `--check` writes nothing and fails when the
module is stale.

Each edit is a literal replacement that must match `Expand.lean` exactly the stated number of times, so a change to
`Expand.lean` that moves one fails here rather than silently dropping it. The same edits made in `Expand.lean`
itself, with `expandFn` returning the trace, would make this script and its output unnecessary.
"""

import sys
from pathlib import Path

SRC = Path("LeanVM/Guest/Expand.lean")
DST = Path("LeanVM/Guest/Backend/ExpandTrace.lean")

HEADER = """/-
  LeanVM.Guest.Backend.ExpandTrace

  Generated by `scripts/expand-trace` from `LeanVM/Guest/Expand.lean`; do not edit.
  The zkDSL front end recording its allocation trace (`LeanVM.Guest.Backend.Trace`).
-/

module

public import LeanVM.Guest.Source
public import LeanVM.Guest.Core
public import LeanVM.Guest.Backend.Trace

/-!
# Expansion, traced

`LeanVM.Guest.Expand`, definition for definition, with the state's `trace` recording each value
made, each statement emitted and each branch entered (`Backend.Event`). `expandFn` returns the
trace beside the core function, which is `Expand.expandFn`'s.
-/

namespace LeanVM.Guest.Backend.ExpandTrace

open LeanVM.Parameters LeanVM.Guest.Source
open LeanVM.Guest.Core (V Seg Atom Hint Dest)
open LeanVM.Guest.Backend (Kind Event)
"""

# (old, new, occurrences)
EDITS = [
    # the state and the two allocators
    ("  queue : Array Func\n  loopCtr : Nat\n  deriving Inhabited",
     "  queue : Array Func\n  loopCtr : Nat\n  /-- The allocation trace. -/\n  trace : Array Event := #[]\n  deriving Inhabited", 1),
    ("def fresh : M V := do\n  let st ← get\n  set { st with tag := st.tag + 1 }\n",
     "def fresh (kind : Kind := .cell) : M V := do\n  let st ← get\n"
     "  set { st with tag := st.tag + 1, trace := st.trace.push (.alloc [⟨st.path, st.tag, 0⟩] kind) }\n", 1),
    ("def freshRun (n : Nat) : M (List V) := do\n  let st ← get\n  set { st with tag := st.tag + 1 }\n",
     "def freshRun (n : Nat) (kind : Kind := .cell) : M (List V) := do\n  let st ← get\n"
     "  set { st with\n    tag := st.tag + 1\n"
     "    trace := st.trace.push (.alloc ((List.range n).map fun k => ⟨st.path, st.tag, k⟩) kind) }\n", 1),
    # emissions
    ("  modify fun st => { st with out := st.out.push s, pending := false }",
     "  modify fun st => { st with out := st.out.push s, pending := false, trace := st.trace.push .emit }", 1),
    ("  modify fun st => { st with out := st.out.push (.atom (.hint h)), pending := true }",
     "  modify fun st => { st with out := st.out.push (.atom (.hint h)), pending := true,\n"
     "                             trace := st.trace.push .emit }", 1),
    ("  modify fun st => { st with out := st.out.push (.atom (.frameAddr p run)) }",
     "  modify fun st => { st with out := st.out.push (.atom (.frameAddr p run)), trace := st.trace.push .emit }", 1),
    ("/-- Run `m` at the position `seg` below the current one. -/",
     "/-- Record a step of the expansion. -/\ndef logEvent (e : Event) : M Unit :=\n"
     "  modify fun st => { st with trace := st.trace.push e }\n\n"
     "/-- Run `m` at the position `seg` below the current one. -/", 1),
    # pooled results
    ("  let o ← fresh\n  emitAtom (.const o c)\n  poolConst c", "  let o ← fresh .pooled\n  emitAtom (.const o c)\n  poolConst c", 1),
    ("  let o ← fresh\n  emitAtom (.add o a b)", "  let o ← fresh .pooled\n  emitAtom (.add o a b)", 1),
    ("  let o ← fresh\n  emitAtom (.mul o a b)", "  let o ← fresh .pooled\n  emitAtom (.mul o a b)", 1),
    ("        let dst ← fresh\n        emitAtom (.load dst ptr o2)\n        return dst",
     "        let dst ← fresh .pooled\n        emitAtom (.load dst ptr o2)\n        return dst", 1),
    ("              let c ← fresh\n              emitAtom (.mul c bcell inv)",
     "              let c ← fresh .pooled\n              emitAtom (.mul c bcell inv)", 1),
    # addresses
    ("  | some c, 0 => return c\n", "  | some c, 0 => do\n      logEvent (.use c)\n      return c\n", 1),
    ("        let p ← fresh\n        emitFrameAddr p (cells.drop exp)",
     "        logEvent (.shift c exp)\n        let p ← fresh .pooled\n        emitFrameAddr p (cells.drop exp)", 1),
    ("      let p ← fresh\n      emitFrameAddr p cells\n", "      let p ← fresh .addr\n      emitFrameAddr p cells\n", 1),
    # values that are no cell of their own
    ("    let site ← fresh\n", "    let site ← fresh .site\n", 1),
    ("    let rets ← freshRun (c.returnShapes.map Shape.cells).sum",
     "    let rets ← freshRun (c.returnShapes.map Shape.cells).sum .ret", 1),
    ("  let o ← freshRun 5\n", "  let o ← freshRun 5 .padRun\n", 1),
    ("  let t ← freshRun cells.length\n  for (c, d) in cells.zip t do",
     "  let t ← freshRun cells.length .spongeRun\n  for (c, d) in cells.zip t do", 1),
    # branches and arms
    ("    let ((), _, blk) ← capture <| withSeg seg do\n      stmts n body\n      if (← get).pending then anchor\n",
     "    logEvent .enter\n    let ((), _, blk) ← capture <| withSeg seg do\n      stmts n body\n"
     "      if (← get).pending then anchor\n    logEvent .leave\n", 1),
    ("      let ((), _, blk) ← capture do\n        withSeg (.a j) do",
     "      logEvent .enter\n      let ((), _, blk) ← capture do\n        withSeg (.a j) do", 1),
    ("          if (← get).pending then anchor\n      modify fun st => { st with names := saved, keccakPad := pad, consts, mats }\n"
     "      blocks := blocks.push blk",
     "          if (← get).pending then anchor\n      logEvent .leave\n"
     "      modify fun st => { st with names := saved, keccakPad := pad, consts, mats }\n      blocks := blocks.push blk", 1),
    ("    let (rcells, binds) ← retTargets targets\n    -- Arms that are all `@inline` calls",
     "    let (rcells, binds) ← retTargets targets\n    if chainNext.isSome then logEvent .chain\n"
     "    -- Arms that are all `@inline` calls", 1),
    # a hint's offset
    ("        emitHint (.windowsExp value start width count dest)",
     "        logEvent (.note skip)\n        emitHint (.windowsExp value start width count dest)", 1),
    # the trace returned
    ("    Except String (Core.Fn × Array Func × Nat) := do", "    Except String (Core.Fn × Array Func × Nat × Array Event) := do", 1),
    ("  return (⟨f.name, (paramBindings f).2, st.out.toList⟩, st.queue, st.loopCtr)",
     "  return (⟨f.name, (paramBindings f).2, st.out.toList⟩, st.queue, st.loopCtr, st.trace)", 1),
    ("/-- The compiler's queue (`compile`), at most `fuel` functions. -/\n"
     "def expandQueue (p : Program) : Nat → Nat → Array Func → Nat → Array Core.Fn →\n"
     "    Except String (Array Core.Fn)",
     "/-- The compiler's queue (`compile`), at most `fuel` functions. -/\n"
     "def expandQueue (p : Program) : Nat → Nat → Array Func → Nat → Array Backend.TracedFn →\n"
     "    Except String (Array Backend.TracedFn)", 1),
    ("            let (fn, queue, loopCtr) ← expandFn p f queue loopCtr\n"
     "            expandQueue p budget (i + 1) queue loopCtr (out.push fn)",
     "            let (fn, queue, loopCtr, trace) ← expandFn p f queue loopCtr\n"
     "            expandQueue p budget (i + 1) queue loopCtr (out.push\n"
     "              ⟨fn, trace, (f.returnShapes.map Shape.cells).sum, Backend.loopSource f⟩)", 1),
    ("/-- Every function the compiler lowers, in its order: `main` first. -/\n"
     "def expandProgram (p : Program) : Except String Core.Program := do",
     "/-- Every function the compiler lowers, in its order, `main` first: its core function, its trace\n"
     "and what the back end reads of its source as queued. -/\ndef expandProgram (p : Program) : Except String (List Backend.TracedFn) := do", 1),
    ("\nend\nend LeanVM.Guest.Expand\n", "\nend\nend LeanVM.Guest.Backend.ExpandTrace\n", 1),
]


def generate() -> str:
    text = SRC.read_text()
    start = text.index("namespace LeanVM.Guest.Expand\n")
    body = text[start:]
    body = body[body.index("@[expose] public section"):]
    for old, new, count in EDITS:
        found = body.count(old)
        if found != count:
            sys.exit(f"expand-trace: expected {count} of this text in {SRC}, found {found}:\n{old}")
        body = body.replace(old, new)
    return HEADER + "\n" + body


def main() -> None:
    check = sys.argv[1:] == ["--check"]
    if sys.argv[1:] and not check:
        sys.exit(__doc__)
    text = generate()
    if check:
        if not DST.exists() or DST.read_text() != text:
            sys.exit(f"{DST} is stale: run `python3 -I scripts/expand-trace`")
    else:
        DST.write_text(text)


if __name__ == "__main__":
    main()
