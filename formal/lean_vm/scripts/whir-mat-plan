#!/usr/bin/env python3
"""Write `LeanVM/Guest/B1/Whir/MatPlan.lean`: the compiler's choice of source for each shifted
pointer `open_stacked__L{m}` materializes from an earlier one (`materialize`, Guest/Expand.lean:
from the nearest earlier materialization whose distance is a constant already set). Read from the
core IR (`guest-core --show`), run from `lean_vm` after `lake build guest-core`:

    python3 -I scripts/whir-mat-plan [--check]

The plan is checked by the kernel with the template (`Whir/Data*.lean`): a wrong plan fails there.
"""
import re, subprocess, sys

POLY = (1 << 64) | 0b11011  # x^64 + x^4 + x^3 + x + 1 (Statement/Field.lean)


def gpow(d):
    r, b = 1, 2
    while d:
        if d & 1:
            r = mulk(r, b)
        b = mulk(b, b)
        d >>= 1
    return r


def mulk(a, b):
    r = 0
    while b:
        if b & 1:
            r ^= a
        b >>= 1
        a <<= 1
        if a >> 64:
            a ^= POLY
    return r


GWINV = {}
for d in range(6000):
    GWINV.setdefault(str(gpow(d)), d)
BASES = {13: "caps", 15: "flags", 21: "fold_challenges", 29: "query_win_ptrs", 161: "ood_z"}
MUL = re.compile(r"\s*%#0(?:\[(\d+)\])? = %#0(?:\[(\d+)\])? \* %#0(?:\[(\d+)\])?$")
CST = re.compile(r"\s*%#0(?:\[(\d+)\])? = (\d+)$")


def plan(m):
    out = subprocess.run(["./.lake/build/bin/guest-core", "--show", f"open_stacked__L{m}"],
                         check=True, capture_output=True, text=True).stdout
    consts, rec, res, seen = {}, {}, [], set()
    for ln in out.split("\n"):
        a = CST.match(ln)
        if a:
            consts[int(a.group(1) or 0)] = a.group(2)
            continue
        b = MUL.match(ln)
        if not b:
            continue
        A, B, C = (int(b.group(i) or 0) for i in (1, 2, 3))
        if C not in consts or consts[C] not in GWINV:
            continue
        d = GWINV[consts[C]]
        if B in BASES:
            rec[A] = (B, d)
            seen.add((B, d))
        elif B in rec:
            base, e0 = rec[B]
            rec[A] = (base, e0 + d)
            if (base, e0 + d) not in seen:
                seen.add((base, e0 + d))
                res.append((base, e0 + d, e0))
    return res


def main():
    rows = [plan(m) for m in range(28)]
    body = "\n".join(
        f"  | {m} => [{', '.join(f'({b}, {e}, {s})' for b, e, s in r)}]" for m, r in enumerate(rows))
    text = f'''/-
  LeanVM.Guest.B1.Whir.MatPlan

  Generated by `scripts/whir-mat-plan` from the core IR; do not edit.
-/

module

/-!
# The shifted pointers `open_stacked` materializes from earlier ones

`osMatPlan m`: the triples `(base, exp, src)` of candidate `m`: the compiler materializes the
pointer `base·g^exp` (the value `base` one of `merkle_caps` 13, `merkle_cap_active` 15,
`fold_challenges` 21, `query_win_ptrs` 29, `ood_z` 161) from its materialization `base·g^src`
(`materialize`, `Guest/Expand.lean`: from the nearest earlier one whose distance is a constant
already set). The template (`osMatP`) follows it; `Whir/Data*.lean` check the result.
-/

namespace LeanVM.Guest.B1.Whir

@[expose] public section

/-- Candidate `m`'s materializations from earlier ones. -/
def osMatPlan : Nat → List (Nat × Nat × Nat)
{body}
  | _ => []

end
end LeanVM.Guest.B1.Whir
'''
    path = "LeanVM/Guest/B1/Whir/MatPlan.lean"
    if "--check" in sys.argv:
        if open(path).read() != text:
            print(f"{path} is stale")
            return 1
        return 0
    open(path, "w").write(text)
    return 0


sys.exit(main())
