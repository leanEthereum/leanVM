#!/usr/bin/env python3
"""Write `LeanVM/Guest/VsAt.lean`: where `verify_sub`'s obligations (`Guest/Sound.lean`) sit in its body,
its statements' indices and values' numbers, read off the core IR (`Data/Core*.lean`) and the callees'
parameters (`Data/Source.lean`). Run from `lean_vm` after `guest-core` (`scripts/regen-guest.sh` does):

    python3 -I scripts/vs-at [--check]
"""
import re
import sys
from pathlib import Path

OUT = Path("LeanVM/Guest/VsAt.lean")
D = Path("LeanVM/Guest/Data")


def body(name):
    for p in sorted(D.glob("Core[0-9]*.lean")):
        t = p.read_text(encoding="utf-8")
        m = re.search(r'noncomputable def core(\d+) : Core\.Fn where\n  name := "%s"' % re.escape(name), t)
        if m:
            b = re.search(r"^namespace core%s\n(.*?)^end core%s$" % (m.group(1), m.group(1)), t, re.M | re.S)
            return [l for l in b.group(1).split("\n") if l.startswith("  .")]
    sys.exit(f"vs-at: no core function {name}")


def runtime_param(fn, param):
    """The index of `param` among `fn`'s runtime parameters, the arguments a call or dispatch passes."""
    m = re.search(r'def fn_%s : Func :=\n  \{ name := "%s", params := \[(.*?)\], returnShapes' % (fn, fn),
                  (D / "Source.lean").read_text(encoding="utf-8"))
    ps = [n for n, k in re.findall(r'⟨"([^"]+)", \(\.(\w+)', m.group(1)) if k == "runtime"]
    return ps.index(param)


def args(stmt):
    return [int(x) for x in re.findall(r"\.n (\d+)", stmt.split("] [")[-2] if stmt.startswith("  .dispatch")
                                       else stmt.split('" [', 1)[1].split("] [")[0])]


st = body("verify_sub")


def at(pred, what):
    ks = [k for k, s in enumerate(st) if pred(s)]
    if len(ks) != 1:
        sys.exit(f"vs-at: verify_sub has {len(ks)} {what}, not one")
    return ks[0]


dims_at = at(lambda s: s.startswith('  .call "verify_tables" '), "calls of verify_tables")
kb_at = at(lambda s: s.startswith('  .call "check_opening_terminal" '), "calls of check_opening_terminal")
tabs_at = at(lambda s: s.startswith("  .dispatch ") and '["open_stacked__L' in s, "dispatches to open_stacked")
dims = args(st[dims_at])[runtime_param("verify_tables", "dims_g")]
kb = args(st[kb_at])[runtime_param("check_opening_terminal", "kappa_base")]
tabs = args(st[tabs_at])[runtime_param("open_stacked", "tabs")]
m = re.fullmatch(r"  \.atom \(\.mul \(\.n %d\) \(\.n 4\) \(\.n (\d+)\)\) ::" % tabs, st[tabs_at - 1])
if not m or not st[tabs_at - 2].startswith("  .atom (.const (.n %s) " % m.group(1)):
    sys.exit("vs-at: verify_sub's two statements before its dispatch to open_stacked are not `tabs = g_squares·c`")
text = f"""/-
  LeanVM.Guest.VsAt

  Where `verify_sub`'s obligations (`Sound.lean`) sit in its body: statement indices and value numbers
  of its core IR. Generated by `scripts/vs-at`; do not edit.
-/

module

namespace LeanVM.Guest.End

@[expose] public section

/-- `verify_sub`'s call of `verify_tables`. -/
abbrev vsDimsAt : Nat := {dims_at}

/-- That call's argument `dims_g`. -/
abbrev vsDims : Nat := {dims}

/-- `verify_sub`'s dispatch to `open_stacked`, after the two statements `tabs = g_squares·c`. -/
abbrev vsTabsAt : Nat := {tabs_at}

/-- That dispatch's argument `tabs`. -/
abbrev vsTabs : Nat := {tabs}

/-- The constant `c` of `tabs = g_squares·c`. -/
abbrev vsTabsC : Nat := {m.group(1)}

/-- `verify_sub`'s call of `check_opening_terminal`. -/
abbrev vsKbAt : Nat := {kb_at}

/-- That call's argument `kappa_base`. -/
abbrev vsKb : Nat := {kb}

end
end LeanVM.Guest.End
"""
if "--check" in sys.argv[1:]:
    if not OUT.exists() or OUT.read_text(encoding="utf-8") != text:
        sys.exit(f"{OUT} is stale; rerun scripts/vs-at")
else:
    OUT.write_text(text, encoding="utf-8")
