#!/usr/bin/env python3
"""Keep `namesMod` (`LeanVM/Guest/CoreNamesMod.lean`, which `CoreNames.lean` reads) a modulus under which the core
functions' name codes (`encS`) are pairwise distinct, read from the core IR (`LeanVM/Guest/Data/Core*.lean`): a modulus that still
works is kept (no rebuild), else the smallest that works is written. With `--check`, write nothing and fail
unless the file's modulus works. Run from `lean_vm` after the guest's data changes (`scripts/regen-guest.sh`):

    python3 -I scripts/core-names-modulus [--check]

The kernel checks the modulus (`coreProgram_codes_nodup`): a wrong one fails there.
"""
import re, sys
from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parent))
import coredata


def names():
    out = {}
    for t in coredata.legacy_texts("LeanVM/Guest/Data"):
        for m in re.finditer(r'noncomputable def core(\d+) : Core\.Fn where\n  name := "([^"]+)"', t):
            out[int(m.group(1))] = m.group(2)
    return [out[j] for j in range(len(out))]


def enc(s):
    return sum((b + 1) << (9 * k) for k, b in enumerate(s.encode()))


def distinct(codes, m):
    return len({c % m for c in codes}) == len(codes)


TEMPLATE = "/-\n  LeanVM.Guest.CoreNamesMod\n\n  Generated by `scripts/core-names-modulus`; do not edit.\n  The modulus under which the core functions' name codes differ (`CoreNames.lean`).\n-/\n\nmodule\n\nnamespace LeanVM.Guest\n\n@[expose] public section\n\n/-- The modulus under which the names' encodings differ. -/\ndef namesMod : Nat := %d\n\nend\n\nend LeanVM.Guest\n"

codes = [enc(s) for s in names()]
assert len(set(codes)) == len(codes), "two core functions share a name"
path = Path("LeanVM/Guest/CoreNamesMod.lean")
if path.exists():
    text = path.read_text(encoding="utf-8")
    old = int(re.search(r"def namesMod : Nat := (\d+)", text).group(1))
    if distinct(codes, old):
        sys.exit(0)
    if "--check" in sys.argv:
        sys.exit(f"namesMod = {old} maps two names to one code; rerun without --check")
elif "--check" in sys.argv:
    sys.exit(f"{path} is missing; rerun without --check")
m = len(codes)
while not distinct(codes, m):
    m += 1
path.write_text(TEMPLATE % m, encoding="utf-8")
print(f"namesMod: {m}")
