#!/usr/bin/env python3
"""Run a generator that has no check mode of its own as one: run it in place, list every module under
`LeanVM/` and `tests/` it changed, created or deleted, put them back, and fail if there were any. Run from
`lean_vm` (`scripts/regen-guest.sh --check` does):

    python3 -I scripts/check-in-place NAME CMD...
"""
import subprocess
import sys
from pathlib import Path

name, cmd = sys.argv[1], sys.argv[2:]


def snapshot():
    return {p: p.read_bytes() for d in ("LeanVM", "tests") for p in Path(d).rglob("*.lean")}


before = snapshot()
stale = []
try:
    subprocess.run(cmd, check=True, stdout=subprocess.DEVNULL)
finally:
    after = snapshot()
    for p, b in before.items():
        if after.get(p) != b:
            stale.append(p)
            p.write_bytes(b)
    for p in after.keys() - before.keys():
        stale.append(p)
        p.unlink()
if stale:
    sys.exit(f"{name}: stale, rerun it: " + " ".join(sorted(map(str, stale))))
