#!/usr/bin/env python3
"""Write the chunked kernel checks of the guest decoder's tables (each module under ~3.5 GB).

The guest's table of frame cells (`Cost/Decoder/GuestTables.lean`) is ~750k numbers: one kernel
evaluation of its size, or of its equality with the certificates, takes 10-19 GB. Written here:

* `LeanVM/Cost/Decoder/GuestLanes.lean`: the packed table's layout (`Cost/Decoder/Lanes.lean`): the
  functions by decreasing number of frame cells, four to a group (`guestLaneGroups`), and each
  function's slot (`guestSlotsList`, `4·(g + 1) + k` for lane `k` of group `g`);
* `LeanVM/Cost/DecoderSize/Rows{k}.lean`: `groupsSize a n = S`, the groups `a … a + n - 1`, each
  group's longest row and one, by `decide +kernel` on at most `--limit` cells and `GROUPS` groups;
* `LeanVM/Cost/DecoderSize/Locs.lean`: their sum and the slots' row's size, `guestLanesRowSize`;
* `LeanVM/Cost/DecoderTablesFirewall.lean`: the guard that the chunks and the tables' equality with
  the certificates (`Decoder/GuestTablesCheck.lean`, written by hand) import the tables alone;
* `LeanVM/Cost/Bounds/Decoder/GuestLocs/Chunk{k}.lean`: the frame cells of rows `a … a + n - 1`
  below `2^16`, each by `decide +kernel` on at most `--bound-limit` cells, `GuestLocs.lean`
  combining them (`guestLocsList_lt`), and `Bounds/Decoder/GuestTablesFirewall.lean`, the guard that
  they import the tables alone.

Input: the rows' lengths (`--row-lengths FILE`, `guestLocsList.map List.length`), the line
`rows: …` that `lake env lean scripts/decoder-tables-inputs.lean` prints after `lake build` (a
plain `#eval` elides a long list, and `lake env` does not rebuild a stale `GuestTables`). Every
packed number is below `2^64` (one limb), so a group's size is its longest row's length and one.
Run after `scripts/decoder-tables`, from any directory (the paths are lean_vm's);
`--check` fails when a file differs, is missing, or is a chunk the tables no longer have
(`check-all.sh` and the CI run it).
"""
import argparse, os, re, sys, textwrap
from pathlib import Path

N = None  # the number of compiled functions: the rows' count
SIZE_DIR = Path("LeanVM/Cost/DecoderSize")
CHECK_DIR = Path("LeanVM/Cost/Decoder/GuestTablesCheck")
HEADER = "Generated by `scripts/decoder-table-chunks`; do not edit."


def nums(path):
    return [int(x) for x in re.findall(r"\d+", Path(path).read_text())]


def chunks(sizes, limit, skip=None):
    """Consecutive ranges `(a, n, total)` of `sizes`, each of total at most `limit` (or one
    entry), `skip` a range of its own."""
    out, a, acc = [], 0, 0
    for i, s in enumerate(sizes):
        if i == skip:
            if i > a:
                out.append((a, i - a, acc))
            out.append((i, 1, None))
            a, acc = i + 1, 0
            continue
        if i > a and acc + s > limit:
            out.append((a, i - a, acc))
            a, acc = i, 0
        acc += s
    if len(sizes) > a:
        out.append((a, len(sizes) - a, acc))
    return out


def wrap(text, first="/-! "):
    return "\n".join(textwrap.wrap(first + text + " -/", 100, break_on_hyphens=False))


def module(imports, doc, body, ns="LeanVM.Cost.Decoder"):
    imp = "".join(f"public import {m}\n" for m in imports)
    return (f"/-\n  {HEADER}\n-/\n\nmodule\n\n{imp}\n{wrap(doc)}\n\nnamespace {ns}\n\n"
            f"@[expose] public section\n\n{body}\nend\n\nend {ns}\n")


LANES = Path("LeanVM/Cost/Decoder/GuestLanes.lean")
GROUPS = 40  # groups a size chunk


def lane_groups(rows):
    """The functions by decreasing number of frame cells (ties by index), four to a group: lane `k`
    of group `g` is function `groups[g][k]`, its slot `4·(g + 1) + k` (row `0` of the packed table
    holds the slots)."""
    order = sorted(range(len(rows)), key=lambda j: (-rows[j], j))
    groups = [order[i:i + 4] for i in range(0, len(order), 4)]
    slots = [0] * len(rows)
    for g, grp in enumerate(groups):
        for k, j in enumerate(grp):
            slots[j] = 4 * (g + 1) + k
    return groups, slots


def list_def(name, ty, doc, lines, per, part):
    """`def name : ty` of the entries `lines` (`per` entries a line), in parts of `part` entries
    joined by `++` when longer: a longer literal exceeds the elaborator's recursion depth."""
    lit = lambda ls: "[\n    " + ",\n    ".join(ls) + "]"
    pl = part // per
    parts = [lines[i:i + pl] for i in range(0, len(lines), pl)]
    if len(parts) <= 1:
        return f"/-- {doc} -/\ndef {name} : {ty} := {lit(lines)}\n\n"
    return ("".join(f"/-- Part {i} of `{name}`. -/\ndef {name}{i} : {ty} := {lit(p)}\n\n"
                    for i, p in enumerate(parts))
            + f"/-- {doc} -/\ndef {name} : {ty} :=\n    "
            + " ++ ".join(f"{name}{i}" for i in range(len(parts))) + "\n\n")


def lanes_file(groups, slots):
    lines = [", ".join(map(str, slots[i:i + 16])) for i in range(0, len(slots), 16)]
    return (f"/-\n  {HEADER}\n-/\n\nmodule\n\n"
            + wrap("The guest's frame cells' lanes (`Cost/Decoder/Lanes.lean`): the functions by "
                   "decreasing number of frame cells, four to a group, each function's cells a lane "
                   "of `16` bits of its group's numbers.")
            + "\n\nnamespace LeanVM.Cost.Decoder\n\n@[expose] public section\n\n"
            + list_def("guestSlotsList", "List Nat", "Each function's slot, `4·(g + 1) + k`: lane `k` of group `g`.",
                       lines, 16, 512)
            + list_def("guestLaneGroups", "List (List Nat)", "The groups' functions, lane by lane.",
                       ["[" + ", ".join(map(str, g)) + "]" for g in groups], 1, 256)
            + "end\n\nend LeanVM.Cost.Decoder\n")


def size_files(rows, limit):
    files = {}
    groups, slots = lane_groups(rows)
    work = [sum(rows[j] for j in g) + 1 for g in groups]
    gsize = [max(rows[j] for j in g) + 1 for g in groups]
    # each function's row is looked up by its index, a walk of the table's spine: so at most
    # `GROUPS` groups a chunk, whatever their cells
    ch = []
    for a, n, _ in chunks(work, limit):
        for b in range(a, a + n, GROUPS):
            m = min(GROUPS, a + n - b)
            ch.append((b, m, sum(gsize[b:b + m])))
    mods = []
    for k, (a, n, s) in enumerate(ch):
        name = f"Rows{k}"
        mods.append(name)
        files[SIZE_DIR / f"{name}.lean"] = module(
            ["LeanVM.Cost.DecoderSize.Rows"],
            f"The sizes of the guest's frame cells' lane groups `{a} … {a + n - 1}`, by evaluation.",
            f"set_option maxRecDepth 100000 in\ntheorem groupsSize_{a}_{n} : groupsSize {a} {n} = {s} := by\n"
            f"  decide +kernel\n")
    G = len(groups)
    ssize = len(slots) + 1  # every slot one limb
    total = ssize + sum(gsize)
    lines = ["theorem guestLanes_rowSize :",
             "    rowSize guestSlotsList + (guestLaneGroups.map fun g ↦ groupLen g + 1).sum = guestLanesRowSize := by",
             f"  show _ = {total}",
             f"  have hs : rowSize guestSlotsList = {ssize} := by decide +kernel",
             f"  have hl : guestLaneGroups.length = {G} := by decide +kernel",
             "  rw [sum_groupSize_eq_groupsSize, hl, hs]"]
    for i, (a, n, s) in enumerate(ch):
        rest = G - a - n
        lines.append(f"  have s{i} := groupsSize_split {a} {n} {rest} {a + n} {n + rest} rfl rfl")
        lines.append(f"  have c{i} := groupsSize_{a}_{n}")
    lines.append(f"  have e := groupsSize_zero {G}")
    lines.append("  omega")
    files[SIZE_DIR / "Locs.lean"] = module(
        ["LeanVM.Cost.DecoderSize.Rows"] + [f"LeanVM.Cost.DecoderSize.{m}" for m in mods],
        "The size of the guest's packed frame cells, the chunks' sizes summed "
        "(`DecoderSize/Rows*.lean`): the slots' row and every group's, the table's literal less its "
        "array and `Term.literal` (`Cost/DecoderSize.lean`).",
        f"/-- The rows' sizes' sum. -/\nabbrev guestLanesRowSize : Nat := {total}\n\n"
        "set_option maxRecDepth 100000 in\n/-- **The rows' "
        "sizes**, summed. -/\n" + "\n".join(lines) + "\n")
    files[LANES] = lanes_file(groups, slots)
    return files


BOUND_DIR = Path("LeanVM/Cost/Bounds/Decoder/GuestLocs")
BOUND_TOP = Path("LeanVM/Cost/Bounds/Decoder/GuestLocs.lean")
BOUND_FIREWALL = Path("LeanVM/Cost/Bounds/Decoder/GuestTablesFirewall.lean")


def bound_files(rows, limit):
    """The frame cells below `2^20`, by chunks of rows of at most `limit` cells."""
    files = {}
    ch = chunks(rows, limit)
    for k, (a, n, s) in enumerate(ch):
        files[BOUND_DIR / f"Chunk{k}.lean"] = (
            f"/-\n  {HEADER}\n-/\n\nmodule\n\npublic import LeanVM.Cost.Decoder.GuestTables\n\n"
            + wrap(f"Bound: the guest's frame cells of functions `{a}` to `{a + n - 1}` (`{s}` cells) below "
                   "`2^16`, a kernel evaluation of their certificates' cells in a module of its own "
                   "(`GuestTablesFirewall.lean` checks that it imports the tables alone).")
            + "\n\nnamespace LeanVM.Cost.Bounds\n\nopen LeanVM.Cost.Decoder\n\npublic section\n\n"
            f"theorem guestLocsChunk{k}_lt :\n    ((guestLocsList.drop {a}).take {n}).all "
            "(fun l ↦ l.all (· < 2 ^ 16)) = true := by\n  decide +kernel\n\nend\n\n"
            "end LeanVM.Cost.Bounds\n")
    steps = "\n".join(f"  refine all_of_drop _ _ {a} {n} guestLocsChunk{k}_lt ?_" for k, (a, n, s) in enumerate(ch))
    imports = "".join(f"public import LeanVM.Cost.Bounds.Decoder.GuestLocs.Chunk{k}\n" for k in range(len(ch)))
    files[BOUND_TOP] = (
        f"/-\n  {HEADER}\n-/\n\nmodule\n\npublic import LeanVM.Cost.Decoder.GuestTables\n{imports}\n"
        + wrap(f"Bound: the guest's frame cells below `2^16`, the evaluations of `{len(ch)}` chunks of "
               f"functions of at most `{limit}` cells each (`GuestLocs/Chunk*.lean`, a module each: the "
               "whole table at once peaks over `12 GB` in the kernel), combined.")
        + "\n\nnamespace LeanVM.Cost.Bounds\n\nopen LeanVM.Cost.Decoder\n\npublic section\n\n"
        "/-- A list holds a test from `a` on if it holds the `n` entries from `a` and the rest. -/\n"
        "theorem all_of_drop {α : Type} (p : α → Bool) (l : List α) (a n : ℕ)\n"
        "    (h1 : ((l.drop a).take n).all p = true) (h2 : (l.drop (a + n)).all p = true) :\n"
        "    (l.drop a).all p = true := by\n"
        "  rw [← List.take_append_drop n (l.drop a), List.all_append, Bool.and_eq_true, List.drop_drop]\n"
        "  exact ⟨h1, h2⟩\n\n"
        f"set_option maxRecDepth 100000 in\n/-- The table of frame cells ends after `{N}` functions. -/\n"
        f"theorem guestLocsList_drop_end : guestLocsList.drop {N} = [] := rfl\n\n"
        "/-- Every frame cell is below `2^16`: the chunks' evaluations combined. -/\n"
        "theorem guestLocsList_lt : guestLocsList.all (fun l ↦ l.all (· < 2 ^ 16)) = true := by\n"
        "  rw [← List.drop_zero (l := guestLocsList)]\n"
        f"{steps}\n  show (guestLocsList.drop {N}).all _ = true\n  rw [guestLocsList_drop_end]\n  rfl\n\n"
        "end\n\nend LeanVM.Cost.Bounds\n")
    names = ", ".join(f'"Chunk{k}"' for k in range(len(ch)))
    files[BOUND_FIREWALL] = (
        f"/-\n  {HEADER}\n-/\n\n"
        + "".join(f"import LeanVM.Cost.Bounds.Decoder.GuestLocs.Chunk{k}\n" for k in range(len(ch)))
        + "\n/-! **The guest tables' chunk evaluations read the tables alone.** Each chunk of the frame cells'\n"
        "bound (`Bounds/Decoder/GuestLocs/*.lean`) is a kernel evaluation of some functions' certificates,\n"
        "and a module is rebuilt whenever anything it imports changes. So they import only the tables\n"
        "(`Cost/Decoder/GuestTables.lean`), none of the cost compiler, the compiled decoder or the bounds'\n"
        "proofs: an edit there rebuilds no chunk. This module, which imports the chunks alone, fails to\n"
        "build if their imports reach any other `LeanVM.Cost` module. -/\n\n"
        "open Lean Elab Command in\n#eval show CommandElabM Unit from do\n"
        f"  let chunks := [{names}]\n"
        "  let allowed := [`LeanVM.Cost.Decoder.GuestTables] ++\n"
        "    chunks.map fun c ↦ (`LeanVM.Cost.Bounds.Decoder.GuestLocs).str c\n"
        "  let reached := (← getEnv).header.moduleNames.filter fun m ↦\n"
        "    (`LeanVM.Cost).isPrefixOf m && !allowed.contains m\n"
        "  unless reached.isEmpty do\n"
        "    throwError m!\"the guest tables' chunk evaluations import {reached.toList}: keep them on the \\\n"
        "      tables alone (see `Bounds/Decoder/GuestTablesFirewall.lean`)\"\n")
    return files


FIREWALL = Path("LeanVM/Cost/DecoderTablesFirewall.lean")
FIREWALL_BODY = '\n/-! **The decoder\'s table checks read the tables alone.** The kernel evaluations of the guest\ndecoder\'s tables\' sizes (`DecoderSize/Rows*.lean`) are split into chunks, each\nunder the memory a module may take, and with the tables\' equality with the guest\'s signatures and\ncertificates (`Decoder/GuestTablesCheck.lean`), a module is rebuilt whenever anything it imports\nchanges. So they import only the tables (`Decoder/GuestTables.lean`), the definitions of the sizes\n(`DecoderSize/Rows.lean`) and the statement, and, for the equality, the guest\'s signatures and\ncertificates (`Guest/Glob.lean`): none of the cost compiler, the compiled decoder or the guest\'s\nproofs. This module, which imports them alone, fails to build if their imports reach any other\n`LeanVM.Cost` module, or the guest\'s proofs (`LeanVM.Guest.B1`, `LeanVM.Guest.Located`,\n`LeanVM.Protocol`). -/\n\nopen Lean Elab Command in\n#eval show CommandElabM Unit from do\n  let allowed := [`LeanVM.Cost.Decoder.GuestTables, `LeanVM.Cost.Decoder.GuestLanes,\n    `LeanVM.Cost.DecoderSize.Rows, `LeanVM.Cost.Decoder.GuestTablesCheck]\n  let chunk (m : Name) : Bool :=\n    m.getPrefix == `LeanVM.Cost.DecoderSize && m != `LeanVM.Cost.DecoderSize.Locs\n  let forbidden := [`LeanVM.Guest.B1, `LeanVM.Guest.Located, `LeanVM.Protocol]\n  let reached := (← getEnv).header.moduleNames.filter fun m ↦\n    ((`LeanVM.Cost).isPrefixOf m && !allowed.contains m && !chunk m &&\n        m != `LeanVM.Cost.DecoderTablesFirewall) ||\n      forbidden.any (·.isPrefixOf m)\n  unless reached.isEmpty do\n    throwError m!"the decoder\'s table checks import {reached.toList}: keep the definitions they \\\n      evaluate in modules that do not (see `Cost/DecoderTablesFirewall.lean`)"\n'

def firewall(size_mods):
    imports = "".join(f"import LeanVM.Cost.DecoderSize.{m}\n" for m in size_mods)
    imports += "import LeanVM.Cost.Decoder.GuestTablesCheck\n"
    return f"/-\n  {HEADER}\n-/\n\n" + imports + FIREWALL_BODY


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--row-lengths", required=True)
    ap.add_argument("--limit", type=int, default=160000)
    ap.add_argument("--bound-limit", type=int, default=40000)
    ap.add_argument("--check", action="store_true")
    a = ap.parse_args()
    global N
    rows = nums(a.row_lengths)
    N = len(rows)
    os.chdir(Path(__file__).resolve().parent.parent)
    files = {**size_files(rows, a.limit), **bound_files(rows, a.bound_limit)}
    size_mods = [p.stem for p in files if p.parent == SIZE_DIR and p.stem != "Locs"]
    files[FIREWALL] = firewall(size_mods)
    stale = [str(p) for p, t in files.items() if not p.exists() or p.read_text() != t]
    # The chunks of an earlier table: `Rows<k>.lean`, `Names<k>.lean`, `Chunk<k>.lean` not written
    # here, and the equality's former chunks, `GuestTablesCheck/C*.lean`.
    extra = sorted(p for d, pat in ((CHECK_DIR, "C*.lean"), (SIZE_DIR, "Rows[0-9]*.lean"),
                                    (SIZE_DIR, "Names[0-9]*.lean"), (BOUND_DIR, "Chunk[0-9]*.lean"))
                   for p in d.glob(pat) if p not in files)
    if a.check:
        if stale or extra:
            sys.exit(f"stale: {stale}, extra: {[str(p) for p in extra]}: run scripts/decoder-table-chunks")
        return
    for p, t in files.items():
        p.parent.mkdir(parents=True, exist_ok=True)
        p.write_text(t)
    for p in extra:
        p.unlink()


main()
