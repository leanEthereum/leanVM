#!/usr/bin/env python3
"""Write the chunked kernel checks of the guest decoder's tables (each module under ~3.5 GB).

The guest's table of frame cells (`Cost/Decoder/GuestTables.lean`) is ~750k numbers: one kernel
evaluation of its size, or of its equality with the certificates, takes 10-19 GB. Written here:

* `LeanVM/Cost/DecoderSize/Rows{k}.lean`: `rowsSize a n = S`, rows `a … a + n - 1` (function
  `37`'s row excluded), and `Names{k}.lean`: `namesSize guestLocsRow37 a n = S`, function `37`'s
  lists `a … a + n - 1`, each by `decide +kernel` on at most `--limit` numbers;
* `LeanVM/Cost/DecoderSize/Locs.lean`: their sum, `(guestLocsList.map rowSize).sum`;
* `LeanVM/Cost/Decoder/GuestTablesCheck/C{k}.lean`: the tables' entries for functions
  `a … a + n - 1` (`glob.sig`, `certOf`), `--functions` per module, and
  `GuestTablesCheck.lean`, combining them;
* `LeanVM/Cost/DecoderTablesFirewall.lean`: the guard that the chunks import the tables alone;
* `LeanVM/Cost/Bounds/Decoder/GuestLocs/Chunk{k}.lean`: the frame cells of rows `a … a + n - 1`
  below `2^20`, each by `decide +kernel` on at most `--bound-limit` cells, `GuestLocs.lean`
  combining them (`guestLocsList_lt`), and `Bounds/Decoder/GuestTablesFirewall.lean`, the guard that
  they import the tables alone.

Inputs: the rows' lengths (`--row-lengths FILE`, `guestLocsList.map List.length`) and function
`37`'s lists' lengths (`--split-lengths FILE`, `guestLocsRow37.map List.length`), the lines
`rows: …` and `split: …` that `lake env lean scripts/decoder-tables-inputs.lean` prints after
`lake build` (a plain `#eval` elides a long list, and `lake env` does not rebuild a stale
`GuestTables`). Every number of the table is below `2^64` (one limb), so a row's size is its
length and one. Run after `scripts/decoder-tables`, from any directory (the paths are lean_vm's);
`--check` fails when a file differs, is missing, or is a chunk the tables no longer have
(`check-all.sh` and the CI run it).
"""
import argparse, os, re, sys, textwrap
from pathlib import Path

N = None  # the number of compiled functions: the rows' count
SPLIT = 37  # `__loop2`, leanXMSS's check inline (its 41 windows' cells)
SIZE_DIR = Path("LeanVM/Cost/DecoderSize")
CHECK_DIR = Path("LeanVM/Cost/Decoder/GuestTablesCheck")
CHECK_TOP = Path("LeanVM/Cost/Decoder/GuestTablesCheck.lean")
HEADER = "Generated by `scripts/decoder-table-chunks`; do not edit."


def nums(path):
    return [int(x) for x in re.findall(r"\d+", Path(path).read_text())]


def chunks(sizes, limit, skip=None):
    """Consecutive ranges `(a, n, total)` of `sizes`, each of total at most `limit` (or one
    entry), `skip` a range of its own."""
    out, a, acc = [], 0, 0
    for i, s in enumerate(sizes):
        if i == skip:
            if i > a:
                out.append((a, i - a, acc))
            out.append((i, 1, None))
            a, acc = i + 1, 0
            continue
        if i > a and acc + s > limit:
            out.append((a, i - a, acc))
            a, acc = i, 0
        acc += s
    if len(sizes) > a:
        out.append((a, len(sizes) - a, acc))
    return out


def wrap(text, first="/-! "):
    return "\n".join(textwrap.wrap(first + text + " -/", 100, break_on_hyphens=False))


def module(imports, doc, body, ns="LeanVM.Cost.Decoder"):
    imp = "".join(f"public import {m}\n" for m in imports)
    return (f"/-\n  {HEADER}\n-/\n\nmodule\n\n{imp}\n{wrap(doc)}\n\nnamespace {ns}\n\n"
            f"@[expose] public section\n\n{body}\nend\n\nend {ns}\n")


def size_files(rows, names, limit):
    files = {}
    rsizes = [l + 1 for l in rows]
    rch = chunks(rsizes, limit, skip=SPLIT)
    nch = chunks(names, limit)
    mods = []
    for k, (a, n, s) in enumerate(c for c in rch if c[2] is not None):
        name = f"Rows{k}"
        mods.append(name)
        files[SIZE_DIR / f"{name}.lean"] = module(
            ["LeanVM.Cost.DecoderSize.Rows"],
            f"The sizes of the guest's frame cells' rows `{a} … {a + n - 1}`, by evaluation.",
            f"set_option maxRecDepth 100000 in\ntheorem rowsSize_{a}_{n} : rowsSize {a} {n} = {s} := by\n"
            f"  decide +kernel\n")
    for k, (a, n, s) in enumerate(nch):
        name = f"Names{k}"
        mods.append(name)
        files[SIZE_DIR / f"{name}.lean"] = module(
            ["LeanVM.Cost.DecoderSize.Rows"],
            f"The sizes of function `{SPLIT}`'s frame cells' lists `{a} … {a + n - 1}`, by "
            "evaluation.",
            f"set_option maxRecDepth 100000 in\ntheorem namesSize_{a}_{n} : "
            f"namesSize guestLocsRow{SPLIT} {a} {n} = {s} := by\n  decide +kernel\n")
    total = sum(rsizes)
    lines = [f"theorem guestLocsList_rowSize : (guestLocsList.map rowSize).sum = {total} := by",
             f"  have hl : guestLocsList.length = {N} := by decide +kernel",
             f"  have hn : guestLocsRow{SPLIT}.length = {len(names)} := by decide +kernel",
             "  rw [sum_rowSize_eq_rowsSize, hl]"]
    for i, (a, n, s) in enumerate(rch):
        rest = N - a - n
        lines.append(f"  have s{i} := rowsSize_split {a} {n} {rest} {a + n} {n + rest} rfl rfl")
        if s is not None:
            lines.append(f"  have c{i} := rowsSize_{a}_{n}")
    lines.append(f"  have e := rowsSize_zero {N}")
    lines.append(f"  have g : guestLocsList.getD {SPLIT} [] = guestLocsRow{SPLIT}.flatten := rfl")
    lines.append(f"  have r := rowsSize_one (a := {SPLIT}) (by omega)")
    lines.append(f"  rw [g] at r")
    lines.append(f"  rw [rowSize_flatten, hn] at r")
    for i, (a, n, s) in enumerate(nch):
        rest = len(names) - a - n
        lines.append(f"  have t{i} := namesSize_split guestLocsRow{SPLIT} {a} {n} {rest} {a + n} {n + rest} "
                     "rfl rfl")
        lines.append(f"  have d{i} := namesSize_{a}_{n}")
    lines.append(f"  have f := namesSize_zero guestLocsRow{SPLIT} {len(names)}")
    lines.append("  omega")
    files[SIZE_DIR / "Locs.lean"] = module(
        ["LeanVM.Cost.DecoderSize.Rows"] + [f"LeanVM.Cost.DecoderSize.{m}" for m in mods],
        "The size of the guest's frame cells, the chunks' sizes summed (`DecoderSize/Rows*.lean`, "
        "`Names*.lean`): every row's encoding's size, the table's literal less its array and "
        "`Term.literal` (`Cost/DecoderSize.lean`).",
        "set_option maxRecDepth 100000 in\n/-- **The rows' "
        "sizes**, summed. -/\n" + "\n".join(lines) + "\n")
    return files


def check_files(per):
    files = {}
    ranges = [(a, min(per, N - a)) for a in range(0, N, per)]
    sig = ("guestEntries.getD (a + i) 0 = (glob.sig (a + i)).entry ∧ "
           "guestArgCounts.getD (a + i) 0 = (glob.sig (a + i)).nargs ∧\n      "
           "guestRetCounts.getD (a + i) 0 = (glob.sig (a + i)).nret")
    for k, (a, n) in enumerate(ranges):
        s = sig.replace("a + i", f"{a} + i")
        body = (f"theorem guestSig_eq_{k} : ∀ i < {n},\n    {s} := by\n  decide +kernel\n\n"
                f"set_option maxRecDepth 100000 in\ntheorem guestLocsList_eq_{k} : ∀ i < {n},\n"
                f"    guestLocsList.getD ({a} + i) [] = (certOf ({a} + i)).locs := by\n"
                "  intro i hi\n  interval_cases i <;> rfl\n")
        files[CHECK_DIR / f"C{k}.lean"] = (
            f"/-\n  {HEADER}\n-/\n\nmodule\n\npublic import LeanVM.Cost.Decoder.GuestTables\n"
            "public import LeanVM.Guest.Glob\nimport all LeanVM.Guest.Glob\n\n"
            + wrap(f"The guest decoder's tables, functions `{a} … {a + n - 1}`, checked: the entries, "
                   "argument and return counts by evaluation (`glob.sig`), the frame cells by "
                   "unfolding (`certOf`).") + "\n\nnamespace LeanVM.Cost.Decoder\n\nopen LeanVM.Guest\n\n"
            f"@[expose] public section\n\n{body}\nend\n\nend LeanVM.Cost.Decoder\n")

    def chain(thm):
        out = []
        for k, (a, n) in enumerate(ranges):
            step = (f"have := {thm}_{k} (j - {a}) (by omega)\n"
                    f"{{ind}}rw [show {a} + (j - {a}) = j by omega] at this\n{{ind}}exact this")
            if k == len(ranges) - 1:
                out.append("  " + step.format(ind="  "))
            else:
                out.append(f"  by_cases h{k} : j < {a + n}\n  · " + step.format(ind="    "))
        return "\n".join(out)

    sig_stmt = sig.replace("(a + i)", "j")
    body = (
        "/-- The entries, argument and return counts, for every function. -/\n"
        f"theorem guestSig_eq : ∀ j < nFns,\n    {sig_stmt} := by\n  intro j hj\n"
        "  unfold nFns at hj\n" + chain("guestSig_eq") + "\n\n"
        "theorem guestEntries_eq : ∀ j < nFns, guestEntries.getD j 0 = (glob.sig j).entry :=\n"
        "  fun j hj ↦ (guestSig_eq j hj).1\n\n"
        "theorem guestArgCounts_eq : ∀ j < nFns, guestArgCounts.getD j 0 = (glob.sig j).nargs :=\n"
        "  fun j hj ↦ (guestSig_eq j hj).2.1\n\n"
        "theorem guestRetCounts_eq : ∀ j < nFns, guestRetCounts.getD j 0 = (glob.sig j).nret :=\n"
        "  fun j hj ↦ (guestSig_eq j hj).2.2\n\n"
        "/-- The cells' lists are the certificates', function by function, by unfolding: no list "
        "is\nevaluated, the certificates' cells being the same constants. -/\n"
        "theorem guestLocsList_eq : ∀ j < nFns, guestLocsList.getD j [] = (certOf j).locs := by\n"
        "  intro j hj\n  unfold nFns at hj\n" + chain("guestLocsList_eq") + "\n\n"
        "set_option maxRecDepth 100000 in\n"
        "theorem guestLocsList_length : guestLocsList.length = nFns := by decide +kernel\n\n"
        "set_option maxRecDepth 100000 in\n"
        "theorem guestLocs_eq {j : ℕ} (hj : j < nFns) : (guestLocs.getD j #[]).toList = "
        "(certOf j).locs := by\n"
        "  rw [← guestLocsList_eq j hj, guestLocs, guestLocsLit]\n"
        "  have hl : j < guestLocsList.length := guestLocsList_length ▸ hj\n"
        "  simp [Array.getD_eq_getD_getElem?, List.getD_eq_getElem?_getD, hl]\n")
    imports = "".join(f"public import LeanVM.Cost.Decoder.GuestTablesCheck.C{k}\n"
                      for k in range(len(ranges)))
    files[CHECK_TOP] = (
        f"/-\n  {HEADER}\n-/\n\nmodule\n\n{imports}\n"
        "/-!\n# The guest decoder's tables, checked\n\n"
        "The literal tables of `GuestTables.lean` are the guest's: for every function `j < nFns`, "
        "its entry pc,\nits numbers of arguments and of return words (`(glob.sig j).entry`, "
        "`nargs`, `nret`), and its\ncertificate's frame cells (`(certOf j).locs`), from the "
        f"checks of `{len(ranges)}` chunks of functions\n(`GuestTablesCheck/C*.lean`, each "
        "evaluation in a module of its own, under the memory a module\nmay take).\n-/\n\n"
        "namespace LeanVM.Cost.Decoder\n\nopen LeanVM.Guest\n\n@[expose] public section\n\n"
        f"{body}\nend\n\nend LeanVM.Cost.Decoder\n")
    return files


BOUND_DIR = Path("LeanVM/Cost/Bounds/Decoder/GuestLocs")
BOUND_TOP = Path("LeanVM/Cost/Bounds/Decoder/GuestLocs.lean")
BOUND_FIREWALL = Path("LeanVM/Cost/Bounds/Decoder/GuestTablesFirewall.lean")


def bound_files(rows, limit):
    """The frame cells below `2^20`, by chunks of rows of at most `limit` cells."""
    files = {}
    ch = chunks(rows, limit)
    for k, (a, n, s) in enumerate(ch):
        files[BOUND_DIR / f"Chunk{k}.lean"] = (
            f"/-\n  {HEADER}\n-/\n\nmodule\n\npublic import LeanVM.Cost.Decoder.GuestTables\n\n"
            + wrap(f"Bound: the guest's frame cells of functions `{a}` to `{a + n - 1}` (`{s}` cells) below "
                   "`2^20`, a kernel evaluation of their certificates' cells in a module of its own "
                   "(`GuestTablesFirewall.lean` checks that it imports the tables alone).")
            + "\n\nnamespace LeanVM.Cost.Bounds\n\nopen LeanVM.Cost.Decoder\n\npublic section\n\n"
            f"theorem guestLocsChunk{k}_lt :\n    ((guestLocsList.drop {a}).take {n}).all "
            "(fun l ↦ l.all (· < 2 ^ 20)) = true := by\n  decide +kernel\n\nend\n\n"
            "end LeanVM.Cost.Bounds\n")
    steps = "\n".join(f"  refine all_of_drop _ _ {a} {n} guestLocsChunk{k}_lt ?_" for k, (a, n, s) in enumerate(ch))
    imports = "".join(f"public import LeanVM.Cost.Bounds.Decoder.GuestLocs.Chunk{k}\n" for k in range(len(ch)))
    files[BOUND_TOP] = (
        f"/-\n  {HEADER}\n-/\n\nmodule\n\npublic import LeanVM.Cost.Decoder.GuestTables\n{imports}\n"
        + wrap(f"Bound: the guest's frame cells below `2^20`, the evaluations of `{len(ch)}` chunks of "
               f"functions of at most `{limit}` cells each (`GuestLocs/Chunk*.lean`, a module each: the "
               "whole table at once peaks over `12 GB` in the kernel), combined.")
        + "\n\nnamespace LeanVM.Cost.Bounds\n\nopen LeanVM.Cost.Decoder\n\npublic section\n\n"
        "/-- A list holds a test from `a` on if it holds the `n` entries from `a` and the rest. -/\n"
        "theorem all_of_drop {α : Type} (p : α → Bool) (l : List α) (a n : ℕ)\n"
        "    (h1 : ((l.drop a).take n).all p = true) (h2 : (l.drop (a + n)).all p = true) :\n"
        "    (l.drop a).all p = true := by\n"
        "  rw [← List.take_append_drop n (l.drop a), List.all_append, Bool.and_eq_true, List.drop_drop]\n"
        "  exact ⟨h1, h2⟩\n\n"
        f"set_option maxRecDepth 100000 in\n/-- The table of frame cells ends after `{N}` functions. -/\n"
        f"theorem guestLocsList_drop_end : guestLocsList.drop {N} = [] := rfl\n\n"
        "/-- Every frame cell is below `2^20`: the chunks' evaluations combined. -/\n"
        "theorem guestLocsList_lt : guestLocsList.all (fun l ↦ l.all (· < 2 ^ 20)) = true := by\n"
        "  rw [← List.drop_zero (l := guestLocsList)]\n"
        f"{steps}\n  show (guestLocsList.drop {N}).all _ = true\n  rw [guestLocsList_drop_end]\n  rfl\n\n"
        "end\n\nend LeanVM.Cost.Bounds\n")
    names = ", ".join(f'"Chunk{k}"' for k in range(len(ch)))
    files[BOUND_FIREWALL] = (
        f"/-\n  {HEADER}\n-/\n\n"
        + "".join(f"import LeanVM.Cost.Bounds.Decoder.GuestLocs.Chunk{k}\n" for k in range(len(ch)))
        + "\n/-! **The guest tables' chunk evaluations read the tables alone.** Each chunk of the frame cells'\n"
        "bound (`Bounds/Decoder/GuestLocs/*.lean`) is a kernel evaluation of some functions' certificates,\n"
        "and a module is rebuilt whenever anything it imports changes. So they import only the tables\n"
        "(`Cost/Decoder/GuestTables.lean`), none of the cost compiler, the compiled decoder or the bounds'\n"
        "proofs: an edit there rebuilds no chunk. This module, which imports the chunks alone, fails to\n"
        "build if their imports reach any other `LeanVM.Cost` module. -/\n\n"
        "open Lean Elab Command in\n#eval show CommandElabM Unit from do\n"
        f"  let chunks := [{names}]\n"
        "  let allowed := [`LeanVM.Cost.Decoder.GuestTables] ++\n"
        "    chunks.map fun c ↦ (`LeanVM.Cost.Bounds.Decoder.GuestLocs).str c\n"
        "  let reached := (← getEnv).header.moduleNames.filter fun m ↦\n"
        "    (`LeanVM.Cost).isPrefixOf m && !allowed.contains m\n"
        "  unless reached.isEmpty do\n"
        "    throwError m!\"the guest tables' chunk evaluations import {reached.toList}: keep them on the \\\n"
        "      tables alone (see `Bounds/Decoder/GuestTablesFirewall.lean`)\"\n")
    return files


FIREWALL = Path("LeanVM/Cost/DecoderTablesFirewall.lean")
FIREWALL_BODY = '\n/-! **The decoder\'s table checks read the tables alone.** The kernel evaluations of the guest\ndecoder\'s tables (their size, `DecoderSize/Rows*.lean`, `Names*.lean`; their equality with the\nguest\'s signatures and certificates, `Decoder/GuestTablesCheck/C*.lean`) are split into chunks,\neach under the memory a module may take, and a module is rebuilt whenever anything it imports\nchanges. So they import only the tables (`Decoder/GuestTables.lean`), the definitions of the\nsizes (`DecoderSize/Rows.lean`) and the statement, and, for the equalities, the guest\'s\nsignatures and certificates (`Guest/Glob.lean`): none of the cost compiler, the compiled decoder\nor the guest\'s proofs. This module, which imports the chunks alone, fails to build if their\nimports reach any other `LeanVM.Cost` module, or the guest\'s proofs (`LeanVM.Guest.B1`,\n`LeanVM.Guest.Located`, `LeanVM.Protocol`). -/\n\nopen Lean Elab Command in\n#eval show CommandElabM Unit from do\n  let allowed := [`LeanVM.Cost.Decoder.GuestTables, `LeanVM.Cost.DecoderSize.Rows]\n  let chunk (m : Name) : Bool :=\n    (m.getPrefix == `LeanVM.Cost.DecoderSize && m != `LeanVM.Cost.DecoderSize.Locs) ||\n      m.getPrefix == `LeanVM.Cost.Decoder.GuestTablesCheck\n  let forbidden := [`LeanVM.Guest.B1, `LeanVM.Guest.Located, `LeanVM.Protocol]\n  let reached := (← getEnv).header.moduleNames.filter fun m ↦\n    ((`LeanVM.Cost).isPrefixOf m && !allowed.contains m && !chunk m &&\n        m != `LeanVM.Cost.DecoderTablesFirewall) ||\n      forbidden.any (·.isPrefixOf m)\n  unless reached.isEmpty do\n    throwError m!"the decoder\'s table checks import {reached.toList}: keep the definitions they \\\n      evaluate in modules that do not (see `Cost/DecoderTablesFirewall.lean`)"\n'


def firewall(size_mods, check_mods):
    imports = "".join(f"import LeanVM.Cost.DecoderSize.{m}\n" for m in size_mods)
    imports += "".join(f"import LeanVM.Cost.Decoder.GuestTablesCheck.{m}\n" for m in check_mods)
    return f"/-\n  {HEADER}\n-/\n\n" + imports + FIREWALL_BODY


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--row-lengths", required=True)
    ap.add_argument("--split-lengths", required=True)
    ap.add_argument("--limit", type=int, default=70000)
    ap.add_argument("--functions", type=int, default=40)
    ap.add_argument("--bound-limit", type=int, default=40000)
    ap.add_argument("--check", action="store_true")
    a = ap.parse_args()
    global N
    rows, names = nums(a.row_lengths), nums(a.split_lengths)
    N = len(rows)
    os.chdir(Path(__file__).resolve().parent.parent)
    assert sum(names) == rows[SPLIT], (sum(names), rows[SPLIT])
    files = {**size_files(rows, names, a.limit), **check_files(a.functions), **bound_files(rows, a.bound_limit)}
    size_mods = [p.stem for p in files if p.parent == SIZE_DIR and p.stem != "Locs"]
    check_mods = [p.stem for p in files if p.parent == CHECK_DIR]
    files[FIREWALL] = firewall(size_mods, check_mods)
    stale = [str(p) for p, t in files.items() if not p.exists() or p.read_text() != t]
    # The chunks of an earlier table: `C*.lean`, `Rows<k>.lean`, `Names<k>.lean`, `Chunk<k>.lean` not
    # written here.
    extra = sorted(p for d, pat in ((CHECK_DIR, "C*.lean"), (SIZE_DIR, "Rows[0-9]*.lean"),
                                    (SIZE_DIR, "Names[0-9]*.lean"), (BOUND_DIR, "Chunk[0-9]*.lean"))
                   for p in d.glob(pat) if p not in files)
    if a.check:
        if stale or extra:
            sys.exit(f"stale: {stale}, extra: {[str(p) for p in extra]}: run scripts/decoder-table-chunks")
        return
    for p, t in files.items():
        p.parent.mkdir(parents=True, exist_ok=True)
        p.write_text(t)
    for p in extra:
        p.unlink()


main()
