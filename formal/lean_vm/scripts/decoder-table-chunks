#!/usr/bin/env python3
"""Write the chunked kernel checks of the guest decoder's table of places (each module under ~3.5 GB).

The guest's table of place codes (`Cost/Decoder/GuestPlaces.lean`) is ~516k numbers: one kernel
evaluation of its size, or of a bound on every code, takes too much memory. Written here:

* `LeanVM/Cost/DecoderSize/Rows{k}.lean`: `rowsSize a n = S`, rows `a … a + n - 1` (function
  `j`'s row excluded, `j` the row `guestPlacesSplit` names), and `Names{k}.lean`:
  `namesSize guestPlacesRow{j} a n = S`, function `j`'s runs `a … a + n - 1`, each by
  `decide +kernel` on at most `--limit` numbers;
* `LeanVM/Cost/DecoderSize/Places.lean`: their sum, `(guestPlacesList.map rowSize).sum`;
* `LeanVM/Cost/DecoderTablesFirewall.lean`: the guard that the chunks and the tables' equalities
  (`Decoder/GuestTablesCheck.lean`, written by hand) import the tables alone;
* `LeanVM/Cost/Bounds/Decoder/GuestPlacesOk/Chunk{k}.lean`: the codes of rows `a … a + n - 1`
  (the split row excluded) and `Split{k}.lean`: the split row's runs `a … a + n - 1`, each code's
  cell below `2^13` and the code below `9·2^20` (a shift by at most `g^7`), each by
  `decide +kernel` on at most `--bound-limit` codes, `GuestPlacesOk.lean` combining them
  (`guestPlacesList_ok`), and `Bounds/Decoder/GuestTablesFirewall.lean`, the guard that they
  import the tables alone.

Inputs: the rows' lengths (`--row-lengths FILE`, `guestPlacesList.map List.length`) and the split
row's runs' lengths (`--split-lengths FILE`, `guestPlacesSplit.map List.length`), the lines
`rows: …` and `split: …` that `lake env lean scripts/decoder-tables-inputs.lean` prints after
`lake build` (a plain `#eval` elides a long list, and `lake env` does not rebuild a stale
`GuestPlaces`). Every number of the table is below `2^64` (one limb), so a row's size is its
length and one. Run after `scripts/decoder-tables`, from any directory (the paths are lean_vm's);
`--check` fails when a file differs, is missing, or is a chunk the tables no longer have
(`check-all.sh` and the CI run it).
"""
import argparse, os, re, sys, textwrap
from pathlib import Path

N = None  # the number of compiled functions: the rows' count
SPLIT = None  # the row `guestPlacesSplit` names (`decoder-tables`: the function with the most codes)
SIZE_DIR = Path("LeanVM/Cost/DecoderSize")
HEADER = "Generated by `scripts/decoder-table-chunks`; do not edit."
OK = "(fun l ↦ l.all fun c ↦ decide (c % 2 ^ 20 < 2 ^ 13) && decide (c < 9 * 2 ^ 20))"


def nums(path):
    return [int(x) for x in re.findall(r"\d+", Path(path).read_text())]


def chunks(sizes, limit, skip=None):
    """Consecutive ranges `(a, n, total)` of `sizes`, each of total at most `limit` (or one
    entry), `skip` a range of its own (total `None`)."""
    out, a, acc = [], 0, 0
    for i, s in enumerate(sizes):
        if i == skip:
            if i > a:
                out.append((a, i - a, acc))
            out.append((i, 1, None))
            a, acc = i + 1, 0
            continue
        if i > a and acc + s > limit:
            out.append((a, i - a, acc))
            a, acc = i, 0
        acc += s
    if len(sizes) > a:
        out.append((a, len(sizes) - a, acc))
    return out


def wrap(text, first="/-! "):
    return "\n".join(textwrap.wrap(first + text + " -/", 100, break_on_hyphens=False))


def module(imports, doc, body, ns="LeanVM.Cost.Decoder"):
    imp = "".join(f"public import {m}\n" for m in imports)
    return (f"/-\n  {HEADER}\n-/\n\nmodule\n\n{imp}\n{wrap(doc)}\n\nnamespace {ns}\n\n"
            f"@[expose] public section\n\n{body}\nend\n\nend {ns}\n")


def size_files(rows, names, limit):
    files = {}
    rsizes = [l + 1 for l in rows]
    rch = chunks(rsizes, limit, skip=SPLIT)
    nch = chunks(names, limit)
    mods = []
    for k, (a, n, s) in enumerate(c for c in rch if c[2] is not None):
        name = f"Rows{k}"
        mods.append(name)
        files[SIZE_DIR / f"{name}.lean"] = module(
            ["LeanVM.Cost.DecoderSize.Rows"],
            f"The sizes of the guest's place codes' rows `{a} … {a + n - 1}`, by evaluation.",
            f"set_option maxRecDepth 100000 in\ntheorem rowsSize_{a}_{n} : rowsSize {a} {n} = {s} := by\n"
            f"  decide +kernel\n")
    for k, (a, n, s) in enumerate(nch):
        name = f"Names{k}"
        mods.append(name)
        files[SIZE_DIR / f"{name}.lean"] = module(
            ["LeanVM.Cost.DecoderSize.Rows"],
            f"The sizes of function `{SPLIT}`'s place codes' runs `{a} … {a + n - 1}`, by "
            "evaluation.",
            f"set_option maxRecDepth 100000 in\ntheorem namesSize_{a}_{n} : "
            f"namesSize guestPlacesRow{SPLIT} {a} {n} = {s} := by\n  decide +kernel\n")
    total = sum(rsizes)
    lines = [f"theorem guestPlacesList_rowSize : (guestPlacesList.map rowSize).sum = {total} := by",
             f"  have hl : guestPlacesList.length = {N} := by decide +kernel",
             f"  have hn : guestPlacesRow{SPLIT}.length = {len(names)} := by decide +kernel",
             "  rw [sum_rowSize_eq_rowsSize, hl]"]
    for i, (a, n, s) in enumerate(rch):
        rest = N - a - n
        lines.append(f"  have s{i} := rowsSize_split {a} {n} {rest} {a + n} {n + rest} rfl rfl")
        if s is not None:
            lines.append(f"  have c{i} := rowsSize_{a}_{n}")
    lines.append(f"  have e := rowsSize_zero {N}")
    lines.append(f"  have g : guestPlacesList.getD {SPLIT} [] = guestPlacesRow{SPLIT}.flatten := rfl")
    lines.append(f"  have r := rowsSize_one (a := {SPLIT}) (by omega)")
    lines.append(f"  rw [g] at r")
    lines.append(f"  rw [rowSize_flatten, hn] at r")
    for i, (a, n, s) in enumerate(nch):
        rest = len(names) - a - n
        lines.append(f"  have t{i} := namesSize_split guestPlacesRow{SPLIT} {a} {n} {rest} {a + n} {n + rest} "
                     "rfl rfl")
        lines.append(f"  have d{i} := namesSize_{a}_{n}")
    lines.append(f"  have f := namesSize_zero guestPlacesRow{SPLIT} {len(names)}")
    lines.append("  omega")
    files[SIZE_DIR / "Places.lean"] = module(
        ["LeanVM.Cost.DecoderSize.Rows"] + [f"LeanVM.Cost.DecoderSize.{m}" for m in mods],
        "The size of the guest's place codes, the chunks' sizes summed (`DecoderSize/Rows*.lean`, "
        "`Names*.lean`): every row's encoding's size, the table's literal less its array and "
        "`Term.literal` (`Cost/DecoderSize.lean`).",
        "set_option maxRecDepth 100000 in\n/-- **The rows' "
        "sizes**, summed. -/\n" + "\n".join(lines) + "\n")
    return files, mods


BOUND_DIR = Path("LeanVM/Cost/Bounds/Decoder/GuestPlacesOk")
BOUND_TOP = Path("LeanVM/Cost/Bounds/Decoder/GuestPlacesOk.lean")
BOUND_FIREWALL = Path("LeanVM/Cost/Bounds/Decoder/GuestTablesFirewall.lean")
BOUND_NS = "\n\nnamespace LeanVM.Cost.Bounds\n\nopen LeanVM.Cost.Decoder\n\npublic section\n\n"
BOUND_END = "\n\nend\n\nend LeanVM.Cost.Bounds\n"


def bound_module(doc, body):
    return (f"/-\n  {HEADER}\n-/\n\nmodule\n\npublic import LeanVM.Cost.Decoder.GuestPlaces\n\n"
            + wrap(doc) + BOUND_NS + body + BOUND_END)


def bound_files(rows, names, limit):
    """Every place code's cell below `2^13` and code below `9·2^20`, by chunks of at most `limit`
    codes: of rows, the split row by chunks of its runs."""
    files = {}
    rch = chunks(rows, limit, skip=SPLIT)
    nch = chunks(names, limit)
    mods = []
    steps = []
    for k, (a, n, s) in enumerate(c for c in rch if c[2] is not None):
        mods.append(f"Chunk{k}")
        files[BOUND_DIR / f"Chunk{k}.lean"] = bound_module(
            f"Bound: the guest's place codes of functions `{a}` to `{a + n - 1}` (`{s}` codes), each "
            "cell below `2^13` and each code below `9·2^20`, a kernel evaluation in a module of its "
            "own (`GuestTablesFirewall.lean` checks that it imports the tables alone).",
            f"theorem guestPlacesChunk{k}_ok :\n    ((guestPlacesList.drop {a}).take {n}).all\n"
            f"      {OK} = true := by\n  decide +kernel")
    k = 0
    for (a, n, s) in rch:
        if s is None:
            steps.append(f"  refine all_of_drop _ _ {a} {n} guestPlacesSplit_ok ?_")
        else:
            steps.append(f"  refine all_of_drop _ _ {a} {n} guestPlacesChunk{k}_ok ?_")
            k += 1
    split_steps = []
    for k, (a, n, s) in enumerate(nch):
        mods.append(f"Split{k}")
        files[BOUND_DIR / f"Split{k}.lean"] = bound_module(
            f"Bound: function `{SPLIT}`'s place codes, runs `{a}` to `{a + n - 1}` (`{s}` codes), each "
            "cell below `2^13` and each code below `9·2^20`, a kernel evaluation in a module of its own.",
            f"theorem guestPlacesSplit{k}_ok :\n    ((guestPlacesRow{SPLIT}.drop {a}).take {n}).all\n"
            f"      {OK} = true := by\n  decide +kernel")
        split_steps.append(f"  refine all_of_drop _ _ {a} {n} guestPlacesSplit{k}_ok ?_")
    imports = "".join(f"public import LeanVM.Cost.Bounds.Decoder.GuestPlacesOk.{m}\n" for m in mods)
    files[BOUND_TOP] = (
        f"/-\n  {HEADER}\n-/\n\nmodule\n\npublic import LeanVM.Cost.Decoder.GuestPlaces\n{imports}\n"
        + wrap(f"Bound: every code of the guest's table of places names a cell below `2^13` and is "
               f"below `9·2^20` (a shift by at most `g^7`): the evaluations of chunks of at most "
               f"`{limit}` codes (`GuestPlacesOk/*.lean`, a module each), combined.")
        + BOUND_NS +
        "/-- A list holds a test from `a` on if it holds the `n` entries from `a` and the rest. -/\n"
        "theorem all_of_drop {α : Type} (p : α → Bool) (l : List α) (a n : ℕ)\n"
        "    (h1 : ((l.drop a).take n).all p = true) (h2 : (l.drop (a + n)).all p = true) :\n"
        "    (l.drop a).all p = true := by\n"
        "  rw [← List.take_append_drop n (l.drop a), List.all_append, Bool.and_eq_true, List.drop_drop]\n"
        "  exact ⟨h1, h2⟩\n\n"
        f"set_option maxRecDepth 100000 in\n/-- Function `{SPLIT}`'s runs hold the bound: the chunks' evaluations combined. -/\n"
        f"theorem guestPlacesRow{SPLIT}_ok : guestPlacesRow{SPLIT}.all\n      {OK} = true := by\n"
        f"  rw [← List.drop_zero (l := guestPlacesRow{SPLIT})]\n"
        + "\n".join(split_steps) +
        f"\n  show (guestPlacesRow{SPLIT}.drop {len(names)}).all _ = true\n"
        f"  rw [show guestPlacesRow{SPLIT}.drop {len(names)} = [] from rfl]\n  rfl\n\n"
        f"set_option maxRecDepth 100000 in\n/-- Function `{SPLIT}`'s row, as a chunk. -/\n"
        f"theorem guestPlacesSplit_ok :\n    ((guestPlacesList.drop {SPLIT}).take 1).all\n      {OK} = true := by\n"
        f"  rw [show (guestPlacesList.drop {SPLIT}).take 1 = [guestPlacesRow{SPLIT}.flatten] from rfl]\n"
        f"  have h := guestPlacesRow{SPLIT}_ok\n"
        "  rw [List.all_eq_true] at h ⊢\n"
        "  intro l hl\n"
        "  rw [List.mem_singleton] at hl\n"
        "  subst hl\n"
        "  rw [List.all_eq_true]\n"
        "  intro c hc\n"
        "  obtain ⟨r, hr, hc⟩ := List.mem_flatten.mp hc\n"
        "  exact List.all_eq_true.mp (h r hr) c hc\n\n"
        f"set_option maxRecDepth 100000 in\n/-- The table of place codes ends after `{N}` functions. -/\n"
        f"theorem guestPlacesList_drop_end : guestPlacesList.drop {N} = [] := rfl\n\n"
        "set_option maxRecDepth 100000 in\n"
        "/-- **Every place code** names a cell below `2^13` and is below `9·2^20`: the chunks' "
        "evaluations combined. -/\n"
        f"theorem guestPlacesList_ok : guestPlacesList.all\n      {OK} = true := by\n"
        "  rw [← List.drop_zero (l := guestPlacesList)]\n"
        + "\n".join(steps) +
        f"\n  show (guestPlacesList.drop {N}).all _ = true\n  rw [guestPlacesList_drop_end]\n  rfl"
        + BOUND_END)
    names_l = ", ".join(f'"{m}"' for m in mods)
    files[BOUND_FIREWALL] = (
        f"/-\n  {HEADER}\n-/\n\n"
        + "".join(f"import LeanVM.Cost.Bounds.Decoder.GuestPlacesOk.{m}\n" for m in mods)
        + "\n/-! **The guest tables' chunk evaluations read the tables alone.** Each chunk of the place codes'\n"
        "bound (`Bounds/Decoder/GuestPlacesOk/*.lean`) is a kernel evaluation of some functions' codes,\n"
        "and a module is rebuilt whenever anything it imports changes. So they import only the table\n"
        "(`Cost/Decoder/GuestPlaces.lean` and its rows), none of the cost compiler, the compiled decoder or\n"
        "the bounds' proofs: an edit there rebuilds no chunk. This module, which imports the chunks alone,\n"
        "fails to build if their imports reach any other `LeanVM.Cost` module. -/\n\n"
        "open Lean Elab Command in\n#eval show CommandElabM Unit from do\n"
        f"  let chunks := [{names_l}]\n"
        "  let allowed := [`LeanVM.Cost.Decoder.GuestPlaces] ++\n"
        "    chunks.map fun c ↦ (`LeanVM.Cost.Bounds.Decoder.GuestPlacesOk).str c\n"
        "  let reached := (← getEnv).header.moduleNames.filter fun m ↦\n"
        "    (`LeanVM.Cost).isPrefixOf m && !allowed.contains m &&\n"
        "      m.getPrefix != `LeanVM.Cost.Decoder.GuestPlaces\n"
        "  unless reached.isEmpty do\n"
        "    throwError m!\"the guest tables' chunk evaluations import {reached.toList}: keep them on the \\\n"
        "      tables alone (see `Bounds/Decoder/GuestTablesFirewall.lean`)\"\n")
    return files


FIREWALL = Path("LeanVM/Cost/DecoderTablesFirewall.lean")
FIREWALL_BODY = '''
/-! **The decoder's table checks read the tables alone.** The kernel evaluations of the guest
decoder's table of places' size (`DecoderSize/Rows*.lean`, `Names*.lean`) are split into chunks,
each under the memory a module may take, and with the tables' equalities with the guest's entries
and arguments (`Decoder/GuestTablesCheck.lean`), a module is rebuilt whenever anything it imports
changes. So they import only the tables (`Decoder/GuestTables.lean`, `Decoder/GuestPlaces.lean`
and its rows), the definitions of the sizes (`DecoderSize/Rows.lean`) and the statement, and, for
the equalities, the guest's core data (`Guest/CoreData.lean`): none of the cost compiler, the
compiled decoder or the guest's proofs. This module, which imports them alone, fails to build if
their imports reach any other `LeanVM.Cost` module, or the guest's proofs (`LeanVM.Guest.B1`,
`LeanVM.Guest.Located`, `LeanVM.Protocol`). -/

open Lean Elab Command in
#eval show CommandElabM Unit from do
  let allowed := [`LeanVM.Cost.Decoder.GuestTables, `LeanVM.Cost.Decoder.GuestPlaces,
    `LeanVM.Cost.DecoderSize.Rows, `LeanVM.Cost.Decoder.GuestTablesCheck]
  let chunk (m : Name) : Bool :=
    (m.getPrefix == `LeanVM.Cost.DecoderSize && m != `LeanVM.Cost.DecoderSize.Places) ||
      m.getPrefix == `LeanVM.Cost.Decoder.GuestPlaces
  let forbidden := [`LeanVM.Guest.B1, `LeanVM.Guest.Located, `LeanVM.Protocol]
  let reached := (← getEnv).header.moduleNames.filter fun m ↦
    ((`LeanVM.Cost).isPrefixOf m && !allowed.contains m && !chunk m &&
        m != `LeanVM.Cost.DecoderTablesFirewall) ||
      forbidden.any (·.isPrefixOf m)
  unless reached.isEmpty do
    throwError m!"the decoder's table checks import {reached.toList}: keep the definitions they \\
      evaluate in modules that do not (see `Cost/DecoderTablesFirewall.lean`)"
'''


def firewall(size_mods):
    imports = "".join(f"import LeanVM.Cost.DecoderSize.{m}\n" for m in size_mods)
    imports += "import LeanVM.Cost.Decoder.GuestTablesCheck\n"
    return f"/-\n  {HEADER}\n-/\n\n" + imports + FIREWALL_BODY


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--row-lengths", required=True)
    ap.add_argument("--split-lengths", required=True)
    ap.add_argument("--limit", type=int, default=70000)
    ap.add_argument("--bound-limit", type=int, default=40000)
    ap.add_argument("--check", action="store_true")
    a = ap.parse_args()
    global N, SPLIT
    rows, names = nums(a.row_lengths), nums(a.split_lengths)
    N = len(rows)
    os.chdir(Path(__file__).resolve().parent.parent)
    m = re.search(r"^def guestPlacesSplit : List \(List Nat\) := guestPlacesRow(\d+)$",
                  Path("LeanVM/Cost/Decoder/GuestPlaces.lean").read_text(), re.M)
    if not m:
        sys.exit("decoder-table-chunks: no guestPlacesSplit in GuestPlaces.lean; run scripts/decoder-tables first")
    SPLIT = int(m.group(1))
    assert sum(names) == rows[SPLIT], (sum(names), rows[SPLIT])
    sfiles, size_mods = size_files(rows, names, a.limit)
    files = {**sfiles, **bound_files(rows, names, a.bound_limit)}
    files[FIREWALL] = firewall(size_mods)
    stale = [str(p) for p, t in files.items() if not p.exists() or p.read_text() != t]
    # The chunks of an earlier table: `Rows<k>.lean`, `Names<k>.lean`, `Chunk<k>.lean`,
    # `Split<k>.lean` not written here, and the former frame cells' modules.
    extra = sorted(p for d, pat in ((SIZE_DIR, "Rows[0-9]*.lean"), (SIZE_DIR, "Names[0-9]*.lean"),
                                    (SIZE_DIR, "Locs.lean"), (BOUND_DIR, "Chunk[0-9]*.lean"),
                                    (BOUND_DIR, "Split[0-9]*.lean"),
                                    (Path("LeanVM/Cost/Bounds/Decoder/GuestLocs"), "Chunk[0-9]*.lean"),
                                    (Path("LeanVM/Cost/Bounds/Decoder"), "GuestLocs.lean"))
                   for p in d.glob(pat) if p not in files)
    if a.check:
        if stale or extra:
            sys.exit(f"stale: {stale}, extra: {[str(p) for p in extra]}: run scripts/decoder-table-chunks")
        return
    for p, t in files.items():
        p.parent.mkdir(parents=True, exist_ok=True)
        p.write_text(t)
    for p in extra:
        p.unlink()


main()
