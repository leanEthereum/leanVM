#!/usr/bin/env python3
"""Write `LeanVM/Guest/B1/Stack/ColSelData{n}.lean` (`n = 4 .. 8`: every `column_selector__L{n}_L{κ}`, `κ ≤ 30`,
is its template `cselBody n κ`, by kernel evaluation) and `ColSelAll.lean` (`column_selector_holds`: every
specialization gives `MeaningColumnSelector`, found in `coreProgram` by its position). The specializations are
the guest's: `stack_selectors__L{n}` dispatches on a block's kappa to `column_selector__L{n}_L{κ}`. Run from
`lean_vm` after the guest's core IR is written:

    python3 -I scripts/stack-data [--check]
"""
import os, sys

D = os.path.join("LeanVM", "Guest", "B1", "Stack")
NS = range(4, 9)
KS = range(31)

HDR = """/-
  LeanVM.Guest.B1.Stack.{mod}

  {doc} Generated by `scripts/stack-data`; do not edit.
-/

module

{imports}
namespace LeanVM.Guest.B1.Stack

open LeanVM.Parameters LeanVM.Semantics LeanVM.Guest.Core LeanVM.Guest

@[expose] public section
"""
FTR = "\nend\nend LeanVM.Guest.B1.Stack\n"


def data(n):
    out = [HDR.format(mod=f"ColSelData{n}", doc=f"`column_selector__L{n}_L{{κ}}` is its template, `κ ≤ 30`.",
                      imports="public import LeanVM.Guest.B1.Stack.ColSel\n")]
    for k in KS:
        out.append(f"""
set_option maxRecDepth 100000 in
theorem csel_body_L{n}_L{k} : Fn.body fn% «column_selector__L{n}_L{k}» = cselBody {n} {k} :=
  stmtsEqb_sound (by decide +kernel)
""")
    out.append(FTR)
    return "".join(out)


def data_all():
    imports = "".join(f"public import LeanVM.Guest.B1.Stack.ColSelData{n}\n" for n in NS) + \
        "public import Mathlib.Tactic.IntervalCases\n"
    cases = []
    for n in NS:
        for k in KS:
            cases.append(f"  · exact csel_sound hm hm6 L {n} {k} (by decide)\n"
                         f"      (coreProgram_find?_at (j := idx% «column_selector__L{n}_L{k}») rfl) rfl\n"
                         f"      csel_body_L{n}_L{k} args rets h\n")
    return (HDR.format(mod="ColSelAll", doc="Every `column_selector` specialization gives its meaning.",
                       imports=imports) + """
set_option maxRecDepth 100000 in
/-- **`column_selector` gives its meaning**, every specialization `__L{n}_L{κ}`, `4 ≤ n ≤ 8`, `κ ≤ 30`. -/
theorem column_selector_holds {m : ℕ} (hm : m ≤ 32) (hm6 : 6 ≤ m) (L : MemoryImage m) :
    ∀ n κ, 4 ≤ n → n ≤ 8 → κ ≤ 30 → ∀ (args rets : List E),
      coreProgram.Rel L.read (cselName n κ) args rets → MeaningColumnSelector n κ L.read args rets := by
  intro n κ h4 h8 h30 args rets h
  interval_cases n <;> interval_cases κ
""" + "".join(cases) + FTR)


def main():
    check = "--check" in sys.argv[1:]
    files = {os.path.join(D, f"ColSelData{n}.lean"): data(n) for n in NS}
    files[os.path.join(D, "ColSelAll.lean")] = data_all()
    stale = []
    for path, text in files.items():
        old = open(path, encoding="utf-8").read() if os.path.exists(path) else None
        if old != text:
            if check:
                stale.append(path)
            else:
                with open(path, "w", encoding="utf-8") as f:
                    f.write(text)
    if stale:
        sys.exit("stale: " + ", ".join(stale) + " (run scripts/stack-data)")


main()
