namespace LeanVM.Guest

open LeanVM.Parameters LeanVM.Semantics Core Memory Data

@[expose] public section

@TREES@
/-- The functions the certificates counting instructions cover, by core index (each its own
value): the closure of `main`'s statically bounded callees. -/
def kcST : NTree ℕ := @KCST@

/-- Function `j` is covered. -/
def kcIn (j : ℕ) : Prop := kcST.find j = some j

instance (j : ℕ) : Decidable (kcIn j) := inferInstanceAs (Decidable (_ = _))

/-- `B2C.xmssArmC` at function `j`, by `Opcode`'s index. -/
def kcArmJ (j i : ℕ) : ℕ := if j = @XJ@ then @ARMS@.getD i 0 else 0

theorem kc_name_xmss {j : ℕ} (hj : j < coreProgram.length) :
    coreProgram[j].name = "__loop2" ↔ j = @XJ@ := by
  have hx : (coreProgram[@XJ@]?).map Fn.name = some "__loop2" := by decide +kernel
  constructor
  · intro h
    have := coreIdx_getElem hj
    rw [h, coreIdx_of_name hx] at this
    exact this.symm
  · rintro rfl
    rw [List.getElem?_eq_getElem hj] at hx
    simpa using hx

/-- The families' frame weights at function `j` are its `pathMax` and arms. -/
noncomputable def kcPmAt (j : ℕ) : Bool :=
  @PMAT@

theorem kcPm_all : kcST.all kcPmAt = true := by decide +kernel

theorem kcPm_eq {j : ℕ} (hS : kcIn j) :
    @PMEQ@ := by
  have h := NTree.find_all kcPm_all hS
  simp only [kcPmAt, Bool.and_eq_true, beq_iff_eq] at h
  obtain ⟨⟨⟨⟨⟨h0, h1⟩, h2⟩, h3⟩, h4⟩, h5⟩ := h
  exact ⟨h0, h1, h2, h3, h4, h5⟩

theorem kc_idxOf {j : ℕ} (hj : j < coreProgram.length) :
    B2C.idxOf coreProgram[j].name = some (j + 1) := by
  unfold B2C.idxOf
  rw [coreProgram_indexOf?_getElem hj]
  rfl

/-- `kcArmJ` is `B2C.xmssArmC` at `__loop2`. -/
theorem kcArmJ_eq {j : ℕ} (hj : j < coreProgram.length) (op : Opcode) :
    kcArmJ j (B2C.opIdx op) = if coreProgram[j].name = "__loop2" then B2C.xmssArmC op else 0 := by
  by_cases hx : j = @XJ@
  · subst hx
    have hn := (kc_name_xmss hj).mpr rfl
    simp only [hn, ↓reduceIte]
    cases op <;> rfl
  · have hn : ¬ coreProgram[j].name = "__loop2" := fun h => hx ((kc_name_xmss hj).mp h)
    simp [kcArmJ, hx, hn]

end
