/-
  LeanVM.Guest.Memory.GuestCnt@P@

  The guest's static certificates counting `@OP@` instructions (`B2C.ωArm B2C.xmssArmC .@OP@`),
  checked (`kw@p@_checked`), and the weight bounds they give (`kw@p@_weightLe`, `kw@p@_weight_le_of_stat`,
  `kw@p@_weight_le_of_loop`). Generated by `scripts/count/gen.py`; do not edit.
-/

module

public import LeanVM.Guest.Memory.GuestCnt@P@.All
public import LeanVM.Guest.Memory.GuestCntPm

namespace LeanVM.Guest

open LeanVM.Parameters LeanVM.Semantics Core Memory Data

@[expose] public section

/-- The certificates counting `@OP@` instructions, by name. -/
noncomputable def kw@p@certOf (g : String) : Cert := kw@p@certJ (coreIdx g)

theorem kw@p@certOf_of_idx {j : ℕ} {g : String} (h : (coreProgram[j]?).map Fn.name = some g) :
    kw@p@certOf g = kw@p@certJ j := by
  rw [kw@p@certOf, coreIdx_of_name h]

/-- Only the covered functions have certificates. -/
theorem kw@p@certJ_list : (List.range coreProgram.length).all
    (fun j => decide (kcIn j) || match kw@p@certJ j with | .none => true | _ => false) = true := by
  rw [coreProgram_length]; decide +kernel

/-- The covered functions call only covered functions. -/
theorem kw@p@lnk_list : kcST.all (fun j => (kw@p@lnkJ j).all fun q => decide (kcIn q.2)) = true := by
  decide +kernel

theorem kw@p@certJ_none {j : ℕ} (hj : j < coreProgram.length) (hS : ¬ kcIn j) : kw@p@certJ j = .none := by
  have h := List.all_eq_true.mp kw@p@certJ_list j (List.mem_range.mpr hj)
  simp only [hS, decide_false, Bool.false_or] at h
  split at h
  · assumption
  · exact absurd h (by simp)

/-- The certificates were made at the frame weights `B2C.ωArm B2C.xmssArmC .@OP@`. -/
theorem kw@p@omegaJ_eq {j : ℕ} (hS : kcIn j) (hj : j < coreProgram.length) :
    kw@p@omegaJ j = B2C.ωArm B2C.xmssArmC .@OP@ coreProgram[j].name := by
  have h := (kcPm_eq hS).@H@
  have e := kcArmJ_eq hj .@OP@
  rw [show B2C.opIdx .@OP@ = @K@ from rfl] at e
  rw [e] at h
  unfold B2C.ωArm B2C.pathMax
  rw [kc_idxOf hj]
  exact h

theorem kw@p@lookJ_ok {j : ℕ}
    (hl : (kw@p@lnkJ j).all (fun q => decide ((coreProgram[q.2]?).map Fn.name = some q.1)) = true) :
    LookOk (kw@p@lookJ j) kw@p@certOf := by
  intro g hg
  unfold kw@p@lookJ at hg ⊢
  rcases hf : (kw@p@lnkJ j).find (nameKey g) with _ | q
  · rw [hf] at hg; exact absurd rfl hg
  · rw [hf] at hg
    dsimp only at hg ⊢
    by_cases hq : g = q.1
    · have hp := NTree.find_all hl hf
      simp only [decide_eq_true_eq] at hp
      rw [ite_eq_left (c := g = q.1) hq, kw@p@certOf_of_idx (hq ▸ hp)]
    · rw [ite_eq_right (c := g = q.1) hq] at hg; exact absurd rfl hg

theorem kw@p@omLookJ_ok {j : ℕ} (hS : kcIn j)
    (hl : (kw@p@lnkJ j).all (fun q => decide ((coreProgram[q.2]?).map Fn.name = some q.1)) = true) :
    WlOk (kw@p@omLookJ j) (B2C.ωArm B2C.xmssArmC .@OP@) := by
  intro g n hg
  unfold kw@p@omLookJ at hg
  rcases hf : (kw@p@lnkJ j).find (nameKey g) with _ | q
  · rw [hf] at hg; cases hg
  · rw [hf] at hg
    dsimp only at hg
    by_cases hq : g = q.1
    · rw [ite_eq_left (c := g = q.1) hq, Option.some.injEq] at hg
      have hp := NTree.find_all hl hf
      simp only [decide_eq_true_eq] at hp
      have hqS : kcIn q.2 := by
        have h1 := NTree.find_all (p := fun j => (kw@p@lnkJ j).all fun q => decide (kcIn q.2))
          kw@p@lnk_list hS
        have := NTree.find_all h1 hf
        simpa using this
      rcases hj : coreProgram[q.2]? with _ | fn
      · rw [hj] at hp; exact absurd hp (by simp)
      · rw [hj] at hp
        obtain ⟨hlt, hfn⟩ := List.getElem?_eq_some_iff.mp hj
        simp only [Option.map_some, Option.some.injEq] at hp
        show B2C.ωArm B2C.xmssArmC .@OP@ g ≤ n
        rw [hq, ← hp, ← hfn, ← kw@p@omegaJ_eq hqS hlt, hg]
    · rw [ite_eq_right (c := g = q.1) hq] at hg; cases hg

/-- **The certificates counting `@OP@` instructions check.** -/
theorem kw@p@_checked : Checked coreProgram false kw@p@certOf (B2C.ωArm B2C.xmssArmC .@OP@) := by
  intro fn hfn _
  obtain ⟨j, hj, rfl⟩ := List.mem_iff_getElem.mp hfn
  have hc := kw@p@chkIdx_all j (by rw [coreProgram_length] at hj; exact hj)
  unfold kw@p@chkIdx at hc
  rw [List.getElem?_eq_getElem hj] at hc
  simp only [kw@p@handJ, List.any_nil, Bool.false_or, Bool.and_eq_true] at hc
  by_cases hS : kcIn j
  · refine ⟨kw@p@lookJ j, kw@p@omLookJ j, kw@p@lookJ_ok hc.1, kw@p@omLookJ_ok hS hc.1, ?_⟩
    show chkFn _ _ false (kw@p@certOf coreProgram[j].name) (B2C.ωArm B2C.xmssArmC .@OP@ coreProgram[j].name) _ = true
    rw [kw@p@certOf, coreIdx_getElem hj, ← kw@p@omegaJ_eq hS hj]
    exact hc.2
  · refine ⟨fun _ => .none, fun _ => none, fun _ h => absurd rfl h, fun _ _ h => (by cases h), ?_⟩
    rw [kw@p@certOf, coreIdx_getElem hj, kw@p@certJ_none hj hS]
    rfl

/-- A function with a constant certificate counting `@OP@` instructions. -/
theorem kw@p@_weightLe {f : String} {B : ℕ} {ks : List (V × ℕ)}
    (hcf : kw@p@certOf f = .stat [] ⟨B, []⟩ ks) : WeightLe coreProgram (B2C.ωArm B2C.xmssArmC .@OP@) f fun _ => B :=
  weightLe_of_stat kw@p@_checked hcf

/-- A function with a certificate counting `@OP@` instructions, under its preconditions. -/
theorem kw@p@_weight_le_of_stat {f : String} {pre : List (ℕ × ℕ)} {b : Aff} {ks : List (V × ℕ)}
    (hcf : kw@p@certOf f = .stat pre b ks) {rd : Reader} {t : Tree} {args rets : List E}
    (hn : t.name = f) (hv : t.Valid coreProgram rd args rets) (hb : t.BufsOk coreProgram)
    (hpre : ArgsPre pre args) : t.weight (B2C.ωArm B2C.xmssArmC .@OP@) ≤ b.eval args :=
  weight_le_of_stat kw@p@_checked hcf hn hv hb hpre

/-- A loop helper's `@OP@` instructions, from `g^a` to `g^e`. -/
theorem kw@p@_weight_le_of_loop {f : String} {endc : Option ℕ} {pre : List (ℕ × ℕ)} {b : Aff}
    {ks : List (V × ℕ)} (hcf : kw@p@certOf f = .loop endc pre b ks) {rd : Reader} {t : Tree}
    {args rets : List E} (hn : t.name = f) (hv : t.Valid coreProgram rd args rets)
    (hb : t.BufsOk coreProgram) {a e : ℕ} (ha : args.getD 0 0 = ofK (addressOfIndex a))
    (he : endOf endc args = ofK (addressOfIndex e)) (hae : a < e) (heo : e < 2 ^ 64 - 1)
    (hpre : ArgsPre pre args) : t.weight (B2C.ωArm B2C.xmssArmC .@OP@) ≤ (e - a) * b.eval args :=
  weight_le_of_loop kw@p@_checked hcf hn hv hb ha he hae heo hpre

end
