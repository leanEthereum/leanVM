/-
  LeanVM.Guest.Memory.GuestCnt

  Generated by `scripts/count/gen.py`; do not edit.
  The guest's static certificates counting each opcode's instructions at
  `B2C.ωArm B2C.xmssArmC op`, one vector family (`Memory/GuestCnt/`, a coordinate per opcode),
  checked (`cnt_checked`), and the weight bounds they give (`cnt_weightLe`, `cnt_weight_le_of_stat`,
  `cnt_weight_le_of_loop`).
-/

module

public import LeanVM.Guest.Memory.GuestCnt.All
public import LeanVM.Guest.Memory.FamilySound
public import LeanVM.Guest.B2C.ArmBound
public import LeanVM.Guest.Frames

namespace LeanVM.Guest

open LeanVM.Parameters LeanVM.Semantics Core Memory

@[expose] public section

/-- `B2C.xmssArmC` at function `j`, by `Opcode`'s index. -/
def cntArmJ (j : ℕ) : Vec := if j = @XJ@ then @ARMS@ else []

/-- Function `j`'s frame weights, if certified, are its `pathMax` and arms, `pl` its plumbing. -/
def cntOmOk (j : ℕ) (pl : B2C.Plumb) : Bool :=
  match Data.cntT.find j with
  | some q => Vec.le q.2 (Vec.add pl.pmax (cntArmJ j)) && Vec.le (Vec.add pl.pmax (cntArmJ j)) q.2
  | none => true

theorem cntOm_walk : walkOk cntOmOk 0 (Data.plumbs.drop 1) = true := by decide +kernel

theorem cnt_plumbs_length : Data.plumbs.length = coreProgram.length + 1 := by
  rw [coreProgram_length]; decide +kernel

theorem cnt_name_xmss {j : ℕ} (hj : j < coreProgram.length) :
    coreProgram[j].name = "__loop2" ↔ j = @XJ@ := by
  have hx : (coreProgram[@XJ@]?).map Fn.name = some "__loop2" := by decide +kernel
  constructor
  · intro h
    have := coreIdx_getElem hj
    rw [h, coreIdx_of_name hx] at this
    exact this.symm
  · rintro rfl
    rw [List.getElem?_eq_getElem hj] at hx
    simpa using hx

theorem cnt_idxOf {j : ℕ} (hj : j < coreProgram.length) :
    B2C.idxOf coreProgram[j].name = some (j + 1) := by
  unfold B2C.idxOf
  rw [coreProgram_indexOf?_getElem hj]
  rfl

theorem cnt_nth {α : Type} : ∀ (l : List α) (n : ℕ) (d : α), listElementOrDefault l n d = l[n]?.getD d
  | [], _, _ => rfl
  | _ :: _, 0, _ => rfl
  | _ :: as, n + 1, d => cnt_nth as n d

/-- **The family's frame weights are `B2C.ωArm B2C.xmssArmC`** where it certifies. -/
theorem cntOm_eq {j : ℕ} (hj : j < coreProgram.length) (hc : Data.cntJ j ≠ .none) (op : Opcode) :
    B2C.ωArm B2C.xmssArmC op coreProgram[j].name = (Data.cntOmJ j).getD (B2C.opIdx op) 0 := by
  have hl : 1 + j < Data.plumbs.length := by rw [cnt_plumbs_length]; omega
  have hp : (Data.plumbs.drop 1)[j]? = some (B2C.plumbOf (j + 1)) := by
    rw [List.getElem?_drop, B2C.plumbOf, cnt_nth, Nat.add_comm 1 j,
      List.getElem?_eq_getElem (by omega : j + 1 < Data.plumbs.length)]
    rfl
  have hw := walkOk_get cntOm_walk hp
  rw [Nat.zero_add] at hw
  unfold Data.cntJ at hc
  rcases hf : Data.cntT.find j with _ | ⟨c, w⟩
  · rw [hf] at hc; exact absurd rfl hc
  · simp only [cntOmOk, hf, Bool.and_eq_true] at hw
    have hom : Data.cntOmJ j = w := by unfold Data.cntOmJ; rw [hf]; rfl
    rw [hom, Nat.le_antisymm (Vec.getD_le hw.1 _) (Vec.getD_le hw.2 _), Vec.getD_add]
    unfold B2C.ωArm B2C.pathMax
    rw [cnt_idxOf hj]
    dsimp only
    by_cases hx : j = @XJ@
    · subst hx
      simp only [(cnt_name_xmss hj).mpr rfl, ↓reduceIte]
      cases op <;> rfl
    · have hn : ¬ coreProgram[j].name = "__loop2" := fun h => hx ((cnt_name_xmss hj).mp h)
      simp [hn, cntArmJ, hx]

/-- The certificates counting `op`'s instructions, by name. -/
noncomputable def cntCert (op : Opcode) (g : String) : Cert := (Data.cntJ (coreIdx g)).proj (B2C.opIdx op)

/-- The certificates counting `op`'s instructions, by core index. -/
noncomputable def cntCertJ (op : Opcode) (j : ℕ) : Cert := (Data.cntJ j).proj (B2C.opIdx op)

theorem cntCert_idx {op : Opcode} {j : ℕ} {g : String} (h : (coreProgram[j]?).map Fn.name = some g) :
    cntCert op g = cntCertJ op j := by
  rw [cntCert, coreIdx_of_name h]; rfl

/-- **The certificates counting `op`'s instructions check.** -/
theorem cnt_checked (op : Opcode) : Checked coreProgram false (cntCert op) (B2C.ωArm B2C.xmssArmC op) :=
  checked_of_chkV cnt_all (B2C.opIdx op) fun _ hj hc => cntOm_eq hj hc op

/-- A function with a constant certificate counting `op`'s instructions. -/
theorem cnt_weightLe {op : Opcode} {f : String} {B : ℕ} {ks : List (V × ℕ)}
    (hcf : cntCert op f = .stat [] ⟨B, []⟩ ks) :
    WeightLe coreProgram (B2C.ωArm B2C.xmssArmC op) f fun _ => B :=
  weightLe_of_stat (cnt_checked op) hcf

/-- A function with a certificate counting `op`'s instructions, under its preconditions. -/
theorem cnt_weight_le_of_stat {op : Opcode} {f : String} {pre : List (ℕ × ℕ)} {b : Aff}
    {ks : List (V × ℕ)} (hcf : cntCert op f = .stat pre b ks) {rd : Reader} {t : Tree} {args rets : List E}
    (hn : t.name = f) (hv : t.Valid coreProgram rd args rets) (hb : t.BufsOk coreProgram)
    (hpre : ArgsPre pre args) : t.weight (B2C.ωArm B2C.xmssArmC op) ≤ b.eval args :=
  weight_le_of_stat (cnt_checked op) hcf hn hv hb hpre

/-- A loop helper's `op` instructions, from `g^a` to `g^e`. -/
theorem cnt_weight_le_of_loop {op : Opcode} {f : String} {endc : Option ℕ} {pre : List (ℕ × ℕ)}
    {b : Aff} {ks : List (V × ℕ)} (hcf : cntCert op f = .loop endc pre b ks) {rd : Reader} {t : Tree}
    {args rets : List E} (hn : t.name = f) (hv : t.Valid coreProgram rd args rets)
    (hb : t.BufsOk coreProgram) {a e : ℕ} (ha : args.getD 0 0 = ofK (addressOfIndex a))
    (he : endOf endc args = ofK (addressOfIndex e)) (hae : a < e) (heo : e < 2 ^ 64 - 1)
    (hpre : ArgsPre pre args) : t.weight (B2C.ωArm B2C.xmssArmC op) ≤ (e - a) * b.eval args :=
  weight_le_of_loop (cnt_checked op) hcf hn hv hb ha he hae heo hpre

end
end LeanVM.Guest
