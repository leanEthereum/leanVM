#!/usr/bin/env python3
"""Write `LeanVM/Guest/B1/VsC/ColSelCAll.lean` (`column_selector_complete` and `csel_spec`: every specialization
`column_selector__L{n}_L{κ}`, `4 ≤ n ≤ 8`, `κ ≤ 30`, completes, by `csel_complete0` on its template,
`scripts/stack-data`'s `csel_body_L{n}_L{κ}`). Run from `lean_vm` after `scripts/stack-data`:

    python3 -I scripts/stack-data-complete [--check]
"""
import os, sys

PATH = os.path.join("LeanVM", "Guest", "B1", "VsC", "ColSelCAll.lean")
NS = range(4, 9)
KS = range(31)


def text():
    imports = "".join(f"public import LeanVM.Guest.B1.Stack.ColSelData{n}\n" for n in NS)
    cases = "".join(
        f"  · exact csel_complete0 hk (by decide)\n"
        f"      (coreProgram_find?_at (j := idx% «column_selector__L{n}_L{k}») rfl) rfl csel_body_L{n}_L{k}\n"
        f"      (cselOk_all {n} (by decide) (by decide) {k} (by decide)) hidx hal p p1 se sg\n"
        for n in NS for k in KS)
    specs = "".join(
        f"  · exact ⟨_, coreProgram_find?_at (j := idx% «column_selector__L{n}_L{k}») rfl, rfl, csel_body_L{n}_L{k}⟩\n"
        for n in NS for k in KS)
    return f"""/-
  LeanVM.Guest.B1.VsC.ColSelCAll

  Every `column_selector` specialization completes. Generated by `scripts/stack-data-complete`; do not edit.
-/

module

{imports}public import LeanVM.Guest.B1.VsC.ColSelC
public import Mathlib.Tactic.IntervalCases

namespace LeanVM.Guest.B1.VsC

open LeanVM.Parameters LeanVM.Semantics LeanVM.Guest.Core LeanVM.Guest LeanVM.Guest.B1.Stack
open LeanVM.Guest.Complete LeanVM.Protocol.Verifier

@[expose] public section

set_option maxRecDepth 100000 in
/-- **`column_selector` completes**, every specialization `__L{{n}}_L{{κ}}`, `4 ≤ n ≤ 8`, `κ ≤ 30`. -/
theorem column_selector_complete {{k : ℕ}} (hk : 4 ≤ k) (n κ : ℕ) (h4 : 4 ≤ n) (h8 : n ≤ 8)
    (h30 : κ ≤ 30) {{idx : ℕ}} (hidx : idx < 2 ^ (4 * n)) (hal : 2 ^ κ ∣ idx) (p p1 : ℕ → E)
    (se sg : E) :
    CallCompletes0 k (cselName n κ) [gen ^ idx, se, sg] [∏ t ∈ Finset.Ico κ (4 * n), selBit p p1 idx t]
      (CselPre n p p1 se sg) PostQuiet := by
  interval_cases n <;> interval_cases κ
{cases}
set_option maxRecDepth 100000 in
/-- **`column_selector`'s specializations**: each `__L{{n}}_L{{κ}}` is in the program, on three
parameters, its body the template. -/
theorem csel_spec (n κ : ℕ) (h4 : 4 ≤ n) (h8 : n ≤ 8) (h30 : κ ≤ 30) :
    ∃ f, coreProgram.find? (cselName n κ) = some f ∧ f.params = [.n 0, .n 1, .n 2] ∧ f.body = cselBody n κ := by
  interval_cases n <;> interval_cases κ
{specs}
end
end LeanVM.Guest.B1.VsC
"""


def main():
    check = "--check" in sys.argv[1:]
    new = text()
    old = open(PATH, encoding="utf-8").read() if os.path.exists(PATH) else None
    if old != new:
        if check:
            sys.exit(f"stale: {PATH} (run scripts/stack-data-complete)")
        with open(PATH, "w", encoding="utf-8") as f:
            f.write(new)


main()
