#!/usr/bin/env python3
"""Write the kernel's checks that the back end's places of the guest's values agree with the
certificates' cells: lean_vm/LeanVM/Guest/Backend/Guest/B2/Eval/L{k}.lean and
lean_vm/LeanVM/Guest/Backend/Guest/B2/LocsAll.lean.

Entry `i` of the back end's input (`guestTraced`, function `i + 1` of `Data.functions`) passes
`B2.locsOkAt i (placedLocs i)` (`B2/Locs.lean`, `Guest/Piece/Layout.lean`); the kernel decides it
for a run of entries in one declaration of at most `MAX_DECL` instructions (the placement is run
again, so the cost follows the instructions), `MAX_MODULE` instructions a module. The entries `BIG`
(`sp_wots`, `__loop2`: their placement is past what one module may take) are not written: their
checks are the hypothesis `BigLocs`. The entries `CUT`, which the kernel places in parts, are
checked on their cut walk's last state (`B2/Cuts.lean`), each alone in a module. `LocsAll.lean` composes the runs: `locsOk_all (hb : BigLocs)`.

The instruction counts are read from `Statement/Data/Bytecode.lean`. `python3 -I scripts/b2-locs`,
from any directory; `--check` fails when a file differs.
"""
import argparse
import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
BYTECODE = ROOT.parent / "Statement" / "Data" / "Bytecode.lean"
B2 = ROOT / "LeanVM" / "Guest" / "Backend" / "Guest" / "B2"
MOD = "LeanVM.Guest.Backend.Guest.B2"
MAX_DECL = 2000
MAX_MODULE = 16000
BIG = [19, 36]
# Entries the kernel places in parts (`Guest/Piece/C{j}*`): their check reads the last state of
# the cut walk (`B2/Cuts.lean`, `placedLocs_{j}`), alone in a module.
CUT = [11, 20]


def sizes():
    """The instruction counts of the guest's functions after `__jump_tables`."""
    fs = re.findall(r'⟨"([^"]*)", (\d+), (\d+), \[', BYTECODE.read_text())
    if not fs or fs[0][0] != "__jump_tables":
        sys.exit("unexpected Bytecode.lean")
    return [(name, int(n)) for name, _, n in fs[1:]]


def runs(fs):
    """Runs `(a, b)` of entries, at most `MAX_DECL` instructions each, none crossing a `BIG` entry."""
    out, a, acc = [], None, 0
    for i, (_, n) in enumerate(fs):
        if i in BIG or i in CUT:
            if a is not None:
                out.append((a, i))
            a, acc = None, 0
            if i in CUT:
                out.append((i, i + 1))
            continue
        if a is not None and acc + n > MAX_DECL:
            out.append((a, i))
            a, acc = None, 0
        if a is None:
            a = i
        acc += n
    if a is not None:
        out.append((a, len(fs)))
    return out


def modules(fs, rs):
    """The runs grouped into modules of at most `MAX_MODULE` instructions."""
    out, cur, acc = [], [], 0
    for a, b in rs:
        n = sum(x for _, x in fs[a:b])
        if a in CUT:
            if cur:
                out.append(cur)
            out.append([(a, b)])
            cur, acc = [], 0
            continue
        if cur and acc + n > MAX_MODULE:
            out.append(cur)
            cur, acc = [], 0
        cur.append((a, b))
        acc += n
    if cur:
        out.append(cur)
    return out


HEAD = """/-
  {mod}

  Generated by `scripts/b2-locs`; do not edit.
  {what}
-/

module

"""


def eval_file(k, ms, fs):
    body = HEAD.format(mod=f"{MOD}.Eval.L{k:02d}",
                       what="The kernel's checks that the guest's places agree with the certificates' cells.")
    cut = len(ms) == 1 and ms[0][0] in CUT
    body += f"public import {MOD}.Locs\npublic import " + (f"{MOD}.Cuts" if cut else "LeanVM.Guest.Backend.Guest.Piece.Layout") + "\n\n"
    body += "set_option Elab.async false\nset_option maxRecDepth 100000\n\nnamespace LeanVM.Guest.Backend.B2\n\nopen GuestPiece\n\n@[expose] public section\n"
    for a, b in ms:
        n = sum(x for _, x in fs[a:b])
        what = f"`{fs[a][0]}`" if b == a + 1 else f"`{fs[a][0]}` to `{fs[b - 1][0]}`"
        body += (f"\n/-- The places of entries {a} to {b - 1} ({what}, {n} instructions) agree with the cells. -/\n"
                 f"theorem locsOk_{a}_{b} : (List.range' {a} {b - a}).all (fun i => locsOkAt i (placedLocs i)) = true := by\n"
                 + (f"  refine range_one (f := fun i => locsOkAt i (placedLocs i)) ?_\n  show locsOkAt {a} (placedLocs {a}) = true\n"
                    f"  rw [placedLocs_{a}]\n  decide +kernel\n" if a in CUT else "  decide +kernel\n"))
    body += "\nend\nend LeanVM.Guest.Backend.B2\n"
    return body


def all_file(mods, fs):
    n = len(fs)
    body = HEAD.format(mod=f"{MOD}.LocsAll",
                       what="Every entry's places agree with its certificate's cells, but the `BIG` entries'.")
    body += "".join(f"public import {MOD}.Eval.L{k:02d}\n" for k in range(len(mods)))
    body += "\nnamespace LeanVM.Guest.Backend.B2\n\nopen GuestPiece\n\n@[expose] public section\n\n"
    big = " ∧ ".join(f"locsOkAt {j} (placedLocs {j}) = true" for j in BIG)
    names = ", ".join(f"`{fs[j][0]}`" for j in BIG)
    body += (f"/-- **The checks of the entries whose placement one module cannot run** ({names}). -/\n"
             f"def BigLocs : Prop := {big}\n\n")
    parts = []
    for ms in mods:
        parts += [(a, b, f"locsOk_{a}_{b}") for a, b in ms]
    for idx, j in enumerate(BIG):
        hb = "hb" + ".2" * idx + (".1" if idx < len(BIG) - 1 else "")
        parts.append((j, j + 1, f"(range_one (f := fun i => locsOkAt i (placedLocs i)) {hb})"))
    parts.sort()
    pos = 0
    for a, b, _ in parts:
        if a != pos:
            sys.exit(f"gap at {pos}")
        pos = b
    if pos != n:
        sys.exit("runs do not cover the input")
    lines = []
    a, b, t = parts[-1]
    lines.append(f"  have h := {t}")
    tot = b - a
    for a, b, t in reversed(parts[:-1]):
        lines.append(f"  have h := range_step {t} (rfl : {a} + {b - a} = {b}) h (rfl : {b - a} + {tot} = {b - a + tot})")
        tot += b - a
    body += (f"/-- **Every entry's places agree with its certificate's cells**, given `BigLocs`. -/\n"
             f"theorem locsOk_all (hb : BigLocs) : (List.range' 0 {n}).all (fun i => locsOkAt i (placedLocs i)) = true := by\n"
             + "\n".join(lines) + "\n  exact h\n\nend\nend LeanVM.Guest.Backend.B2\n")
    return body


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--check", action="store_true")
    a = ap.parse_args()
    fs = sizes()
    mods = modules(fs, runs(fs))
    files = {B2 / "Eval" / f"L{k:02d}.lean": eval_file(k, ms, fs) for k, ms in enumerate(mods)}
    files[B2 / "LocsAll.lean"] = all_file(mods, fs)
    stale = sorted(p for p in (B2 / "Eval").glob("L[0-9]*.lean") if p not in files)
    if a.check:
        bad = [str(p) for p, t in files.items() if not p.exists() or p.read_text() != t] + [str(p) for p in stale]
        if bad:
            sys.exit("stale: " + ", ".join(bad))
        return
    for p in stale:
        p.unlink()
    for p, t in files.items():
        p.write_text(t)
    print(f"{len(mods)} modules, {sum(len(m) for m in mods)} declarations, {sum(n for _, n in fs)} instructions "
          f"({sum(fs[j][1] for j in BIG)} in BigLocs)")


if __name__ == "__main__":
    main()
