#!/usr/bin/env python3
"""Write the kernel's checks that the back end's places of the guest's values agree with the
certificates' cells: lean_vm/LeanVM/Guest/Backend/Guest/B2/Eval/L{k}.lean and
lean_vm/LeanVM/Guest/Backend/Guest/B2/LocsAll.lean.

Entry `i` of the back end's input (`guestTraced`, function `i + 1` of `Data.functions`) passes
`B2.locsOkAt i (placedLocs i)` (`B2/Locs.lean`, `Guest/Piece/Layout.lean`); the kernel decides it
for a run of entries in one declaration of at most `MAX_DECL` instructions (the placement is run
again, so the cost follows the instructions), `MAX_MODULE` instructions a module. The entries `BIG`
(`__loop2`: its placement is past what one module may take, and not yet cut) are not written: their
checks are the hypothesis `BigLocs`. The entries `CUT`, which the kernel places in parts, are
checked on their cut walk's last state (`placedLocs_j`, `Guest/Compiled.lean`), each alone in a
module. `LocsAll.lean` composes the runs: `locsOk_all (hb : BigLocs)`.

The instruction counts are read from `Statement/Data/Bytecode.lean`; the entries `SPLIT` are checked
by runs of top-level statements, their sizes from `scripts/b2-locs.lean` (`lake env lean --run`,
needs `LeanVM.Guest.Backend.ExpandTrace` built). `python3 -I scripts/b2-locs`,
from any directory; `--check` fails when a file differs.
"""
import argparse
import re
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
BYTECODE = ROOT.parent / "Statement" / "Data" / "Bytecode.lean"
B2 = ROOT / "LeanVM" / "Guest" / "Backend" / "Guest" / "B2"
MOD = "LeanVM.Guest.Backend.Guest.B2"
MAX_DECL = 2000
MAX_MODULE = 16000
BIG = [36]
# Entries the kernel places in parts (`Guest/Piece/C{j}*`): their check reads the last state of
# the cut walk (`placedLocs_{j}`, `Guest/Compiled.lean`), alone in a module.
CUT = [11, 19, 20]
# Entries of `CUT` whose check is also too large for one declaration: checked as its parameters
# (`locsHeadAt`) and runs of top-level statements (`locsSegAt`) of at most `MAX_SEG` instructions,
# counted in proportion to the values each statement names (`scripts/b2-locs.lean`).
SPLIT = [19]
MAX_SEG = 6000


def sizes():
    """The instruction counts of the guest's functions after `__jump_tables`."""
    fs = re.findall(r'⟨"([^"]*)", (\d+), (\d+), \[', BYTECODE.read_text())
    if not fs or fs[0][0] != "__jump_tables":
        sys.exit("unexpected Bytecode.lean")
    return [(name, int(n)) for name, _, n in fs[1:]]


def runs(fs):
    """Runs `(a, b)` of entries, at most `MAX_DECL` instructions each, none crossing a `BIG` entry."""
    out, a, acc = [], None, 0
    for i, (_, n) in enumerate(fs):
        if i in BIG or i in CUT:
            if a is not None:
                out.append((a, i))
            a, acc = None, 0
            if i in CUT:
                out.append((i, i + 1))
            continue
        if a is not None and acc + n > MAX_DECL:
            out.append((a, i))
            a, acc = None, 0
        if a is None:
            a = i
        acc += n
    if a is not None:
        out.append((a, len(fs)))
    return out


def weights():
    """For each `SPLIT` entry, the number of values of each top-level statement of its body."""
    if not SPLIT:
        return {}
    r = subprocess.run(["lake", "env", "lean", "--run", "scripts/b2-locs.lean"] + [str(j) for j in SPLIT],
                       cwd=ROOT, capture_output=True, text=True)
    if r.returncode != 0:
        sys.exit(r.stdout + r.stderr)
    out = {}
    for line in r.stdout.splitlines():
        p = line.split()
        if p and p[0] == "entry":
            out[int(p[1])] = [int(x) for x in p[3:]]
    return out


def segments(n, ws):
    """Runs `(a, m)` of statements, each at most `MAX_SEG` instructions in proportion to `ws`."""
    budget = MAX_SEG * sum(ws) / n
    out, a, acc = [], 0, 0
    for k, w in enumerate(ws):
        if k > a and acc + w > budget:
            out.append((a, k - a))
            a, acc = k, 0
        acc += w
    out.append((a, len(ws) - a))
    return out


def split_file(k, j, name, n, segs, last, total):
    body = HEAD.format(mod=f"{MOD}.Eval.L{k:02d}",
                       what=f"The kernel's check that `{name}`'s places agree with its certificate's cells, by parts.")
    body += f"public import {MOD}.Locs\npublic import LeanVM.Guest.Backend.Guest.Compiled\n"
    if k > 0 and segs and segs[0][0] > 0:
        body += f"public import {MOD}.Eval.L{k - 1:02d}\n"
    body += "\nset_option Elab.async false\nset_option maxRecDepth 100000\n\nnamespace LeanVM.Guest.Backend.B2\n\nopen GuestPiece\n\n@[expose] public section\n"
    if segs and segs[0][0] == 0:
        body += (f"\n/-- The parameters of entry {j} (`{name}`) agree with the cells. -/\n"
                 f"theorem locsHead_{j} : locsHeadAt {j} (placedLocs {j}) = true := by\n"
                 f"  rw [placedLocs_{j}]\n  decide +kernel\n")
    for a, m in segs:
        body += (f"\n/-- Statements {a} to {a + m - 1} of entry {j} (`{name}`) agree with the cells. -/\n"
                 f"theorem locsSeg_{j}_{a}_{m} : locsSegAt {j} {a} {m} (placedLocs {j}) = true := by\n"
                 f"  rw [placedLocs_{j}]\n  decide +kernel\n")
    if last:
        h = f"locsSeg_{j}_{total[-1][0]}_{total[-1][1]}"
        rest = total[-1][1]
        for a, m in reversed(total[:-1]):
            h = f"(locsSeg_glue locsSeg_{j}_{a}_{m} (rfl : {a} + {m} = {a + m}) {h} (rfl : {m} + {rest} = {m + rest}))"
            rest += m
        L = sum(m for _, m in total)
        body += (f"\n/-- **The places of entry {j} (`{name}`, {n} instructions) agree with the cells**, from its parts. -/\n"
                 f"theorem locsOk_{j}_{j + 1} : (List.range' {j} 1).all (fun i => locsOkAt i (placedLocs i)) = true :=\n"
                 f"  range_one (f := fun i => locsOkAt i (placedLocs i))\n"
                 f"    (locsOk_of_segs (L := {L}) locsHead_{j}\n      {h}\n"
                 f"      (by decide +kernel))\n")
    body += "\nend\nend LeanVM.Guest.Backend.B2\n"
    return body


def modules(fs, rs):
    """The runs grouped into modules of at most `MAX_MODULE` instructions."""
    out, cur, acc = [], [], 0
    for a, b in rs:
        n = sum(x for _, x in fs[a:b])
        if a in CUT:
            if cur:
                out.append(cur)
            out.append([(a, b)])
            cur, acc = [], 0
            continue
        if cur and acc + n > MAX_MODULE:
            out.append(cur)
            cur, acc = [], 0
        cur.append((a, b))
        acc += n
    if cur:
        out.append(cur)
    return out


HEAD = """/-
  {mod}

  Generated by `scripts/b2-locs`; do not edit.
  {what}
-/

module

"""


def eval_file(k, ms, fs):
    body = HEAD.format(mod=f"{MOD}.Eval.L{k:02d}",
                       what="The kernel's checks that the guest's places agree with the certificates' cells.")
    cut = len(ms) == 1 and ms[0][0] in CUT
    body += f"public import {MOD}.Locs\npublic import " + ("LeanVM.Guest.Backend.Guest.Compiled" if cut else "LeanVM.Guest.Backend.Guest.Piece.Layout") + "\n\n"
    body += "set_option Elab.async false\nset_option maxRecDepth 100000\n\nnamespace LeanVM.Guest.Backend.B2\n\nopen GuestPiece\n\n@[expose] public section\n"
    for a, b in ms:
        n = sum(x for _, x in fs[a:b])
        what = f"`{fs[a][0]}`" if b == a + 1 else f"`{fs[a][0]}` to `{fs[b - 1][0]}`"
        body += (f"\n/-- The places of entries {a} to {b - 1} ({what}, {n} instructions) agree with the cells. -/\n"
                 f"theorem locsOk_{a}_{b} : (List.range' {a} {b - a}).all (fun i => locsOkAt i (placedLocs i)) = true := by\n"
                 + (f"  refine range_one (f := fun i => locsOkAt i (placedLocs i)) ?_\n  show locsOkAt {a} (placedLocs {a}) = true\n"
                    f"  rw [placedLocs_{a}]\n  decide +kernel\n" if a in CUT else "  decide +kernel\n"))
    body += "\nend\nend LeanVM.Guest.Backend.B2\n"
    return body


def all_file(nmods, mods, fs):
    n = len(fs)
    body = HEAD.format(mod=f"{MOD}.LocsAll",
                       what="Every entry's places agree with its certificate's cells, but the `BIG` entries'.")
    body += "".join(f"public import {MOD}.Eval.L{k:02d}\n" for k in range(nmods))
    body += "\nnamespace LeanVM.Guest.Backend.B2\n\nopen GuestPiece\n\n@[expose] public section\n\n"
    big = " ∧ ".join(f"locsOkAt {j} (placedLocs {j}) = true" for j in BIG)
    names = ", ".join(f"`{fs[j][0]}`" for j in BIG)
    body += (f"/-- **The checks of the entries whose placement one module cannot run** ({names}). -/\n"
             f"def BigLocs : Prop := {big}\n\n")
    parts = []
    for ms in mods:
        parts += [(a, b, f"locsOk_{a}_{b}") for a, b in ms]
    for idx, j in enumerate(BIG):
        hb = "hb" + ".2" * idx + (".1" if idx < len(BIG) - 1 else "")
        parts.append((j, j + 1, f"(range_one (f := fun i => locsOkAt i (placedLocs i)) {hb})"))
    parts.sort()
    pos = 0
    for a, b, _ in parts:
        if a != pos:
            sys.exit(f"gap at {pos}")
        pos = b
    if pos != n:
        sys.exit("runs do not cover the input")
    lines = []
    a, b, t = parts[-1]
    lines.append(f"  have h := {t}")
    tot = b - a
    for a, b, t in reversed(parts[:-1]):
        lines.append(f"  have h := range_step {t} (rfl : {a} + {b - a} = {b}) h (rfl : {b - a} + {tot} = {b - a + tot})")
        tot += b - a
    body += (f"/-- **Every entry's places agree with its certificate's cells**, given `BigLocs`. -/\n"
             f"theorem locsOk_all (hb : BigLocs) : (List.range' 0 {n}).all (fun i => locsOkAt i (placedLocs i)) = true := by\n"
             + "\n".join(lines) + "\n  exact h\n\nend\nend LeanVM.Guest.Backend.B2\n")
    return body


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--check", action="store_true")
    args = ap.parse_args()
    fs = sizes()
    ws = weights()
    mods = modules(fs, runs(fs))
    files = {}
    k = 0
    for ms in mods:
        j = ms[0][0]
        if len(ms) == 1 and j in SPLIT:
            segs = segments(fs[j][1], ws[j])
            groups, cur, acc = [], [], 0
            for a, m in segs:
                w = fs[j][1] * sum(ws[j][a:a + m]) / sum(ws[j])
                if cur and acc + w > MAX_MODULE:
                    groups.append(cur)
                    cur, acc = [], 0
                cur.append((a, m))
                acc += w
            groups.append(cur)
            for g, part in enumerate(groups):
                files[B2 / "Eval" / f"L{k:02d}.lean"] = split_file(k, j, fs[j][0], fs[j][1], part,
                                                                   g == len(groups) - 1, segs)
                k += 1
        else:
            files[B2 / "Eval" / f"L{k:02d}.lean"] = eval_file(k, ms, fs)
            k += 1
    nmods = k
    files[B2 / "LocsAll.lean"] = all_file(nmods, mods, fs)
    stale = sorted(p for p in (B2 / "Eval").glob("L[0-9]*.lean") if p not in files)
    if args.check:
        bad = [str(p) for p, t in files.items() if not p.exists() or p.read_text() != t] + [str(p) for p in stale]
        if bad:
            sys.exit("stale: " + ", ".join(bad))
        return
    for p in stale:
        p.unlink()
    for p, t in files.items():
        p.write_text(t)
    print(f"{nmods} modules, {sum(len(m) for m in mods)} declarations, {sum(n for _, n in fs)} instructions "
          f"({sum(fs[j][1] for j in BIG)} in BigLocs)")


if __name__ == "__main__":
    main()
