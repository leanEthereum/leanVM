#!/usr/bin/env python3
"""The completeness cross-check of the Lean back end against the certificate tables.

Reads, as text, what the completeness proof takes from the per-function certificates (the
certificate cells `(certOf j).locs` and self frame pointer cells `facts.env`, each function's
`plumb`, `fs`, and the jump table `Data.jtTrie`), without building the packs, writes them to
`.lake/cpl-crosscheck-tables.txt`, and runs `lake exe guest-cplcheck` on it, which places, emits
and walks the guest with the back end and compares (`cli/GuestCplCheck.lean`). `Data.frameSizes`
and `Data.cplArms` the executable imports as Lean values.

`python3 -I scripts/cpl-crosscheck [--tables-only] [--detail]`, from any directory (the paths are
lean_vm's); `--detail` lists every disagreement. Needs `lake build guest-cplcheck`.
"""
import argparse
import glob
import importlib.machinery
import importlib.util
import os
import re
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
PACK = "LeanVM/Guest/Pack"
OUT = Path(".lake/cpl-crosscheck-tables.txt")


def b2_residual():
    """`scripts/b2-residual`, for its reading of the certificates' cells."""
    loader = importlib.machinery.SourceFileLoader("b2_residual", str(ROOT / "scripts/b2-residual"))
    spec = importlib.util.spec_from_loader("b2_residual", loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


TOKEN = re.compile(r"\s*(0x[0-9a-fA-F]+|\d+|::|\.k|\.fpg|[\[\]()⟨⟩,])")


def parse(text):
    """A Lean literal of lists, tuples, anonymous constructors and `PC`s as Python values."""
    toks = [m.group(1) for m in TOKEN.finditer(text)]
    pos = 0

    def value():
        nonlocal pos
        t = toks[pos]
        pos += 1
        if t.startswith("0x"):
            return int(t, 16)
        if t.isdigit():
            return int(t)
        if t == ".k":
            a = value()
            b = value()
            return ("k", a, b)
        if t == ".fpg":
            return ("f", value())
        if t == "[":
            out = []
            while toks[pos] != "]":
                out.append(value())
                if toks[pos] == ",":
                    pos += 1
            pos += 1
            return out
        if t in "(⟨":
            close = ")" if t == "(" else "⟩"
            items = [value()]
            if toks[pos] == "::":
                while toks[pos] == "::":
                    pos += 1
                    items.append(value())
                pos += 1
                return items[:-1] + items[-1]
            while toks[pos] == ",":
                pos += 1
                items.append(value())
            pos += 1
            return items[0] if len(items) == 1 and close == ")" else tuple(items)
        raise ValueError(f"unexpected token {t!r}")

    v = value()
    return v


def bundles():
    """Each function's name, plumbing, frame size and self frame pointer cells, by name."""
    out = {}
    for f in sorted(glob.glob(PACK + "/*/Bundle.lean")):
        text = open(f).read()
        for blk in re.split(r"\nnamespace ", text):
            m = re.match(r"LeanVM\.Guest\.Fn\.«([^»]*)»", blk)
            if not m:
                continue
            code = re.search(r'def code : CompiledFunction :=\s*⟨"([^"]*)", (\d+), (\d+)', blk)
            pl = re.search(r"noncomputable def plumb : B2C\.Plumb where\n(.*?)\n\n", blk, re.S)
            fs = re.search(r"\ndef fs : ℕ := (\d+)", blk)
            env = re.search(r"facts := \{ env := (\[.*?\]), fpOne", blk)
            if not (code and pl and fs and env):
                continue
            fields = {}
            for line in pl.group(1).splitlines():
                fm = re.match(r"  (\w+) := (.*)$", line)
                if fm:
                    fields[fm.group(1)] = parse(fm.group(2))
            out[code.group(1)] = {
                "key": m.group(1), "entry": int(code.group(2)), "len": int(code.group(3)),
                "plumb": fields, "fs": int(fs.group(1)), "env": [p[0] for p in parse(env.group(1))]}
    return out


def plumb_order():
    """The namespace keys of `Data.plumbs`, by compiled index from 1."""
    text = open("LeanVM/Guest/Data/Plumb.lean").read()
    text = text[text.index("def plumbs : List B2C.Plumb"):]
    return re.findall(r"Fn\.«([^»]*)»\.plumb", text)


def jt_trie():
    """`Data.jtTrie`'s entries: key `0` at the root, `2m+1` left, `2m+2` right."""
    text = open("LeanVM/Guest/Data/Pows.lean").read()
    start = text.index("noncomputable def jtTrie : Trie ℕ :=")
    body = text[start + len("noncomputable def jtTrie : Trie ℕ :="):]
    toks = re.findall(r"\.node|\.nil|none|\(some \d+\)|[()]", body)
    pos = 0
    entries = []

    def node(key, step):
        nonlocal pos
        while toks[pos] == "(":
            pos += 1
            inner = node(key, step)
            assert toks[pos] == ")"
            pos += 1
            return inner
        t = toks[pos]
        pos += 1
        if t == ".nil":
            return
        assert t == ".node", t
        v = toks[pos]
        pos += 1
        if v != "none":
            entries.append((key, int(v[6:-1])))
        node(key + step, 2 * step)
        node(key + 2 * step, 2 * step)

    node(0, 1)
    return entries


def pinned(by_key):
    """Frame sizes the proofs state as literals: `B2C.fs f = n`, or a sum of them, `name% «k»` the
    function of key `k` (`Data.N`)."""
    term = r'(?:LeanVM\.Guest\.)?B2C\.fs\s+(?:name%\s*«[^»]+»|"[^"]+")'
    pat = re.compile(r"(" + term + r"(?:\s*\+\s*" + term + r")*)\s*=\s*(\d+)")
    one = re.compile(r'name%\s*«([^»]+)»|"([^"]+)"')
    out = []
    for f in sorted(glob.glob("LeanVM/Guest/**/*.lean", recursive=True)):
        if "/Pack/" in f:
            continue
        text = open(f).read()
        for m in pat.finditer(text):
            names = [by_key[a] if a else b for a, b in one.findall(m.group(1))]
            line = text.count("\n", 0, m.start()) + 1
            out.append(("+".join(names), int(m.group(2)), f"{f}:{line}"))
    return out


def residual():
    """`Backend/Guest/B2/Residual.lean`: the values the soundness bridge leaves to a fact of the run."""
    out = []
    text = open("LeanVM/Guest/Backend/Guest/B2/Residual.lean").read()
    for m in re.finditer(r'\("([^"]+)", (\d+), \[(.*?)\]\)', text):
        for v, kind in re.findall(r"\(\.n (\d+), \.(konst|addr)", m.group(3)):
            out.append((m.group(1), int(v), kind))
    return out


def write_tables():
    cells = b2_residual().cert_cells()
    bs = bundles()
    order = plumb_order()
    by_key = {b["key"]: name for name, b in bs.items()}
    lines = []
    for j, key in enumerate(order, 1):
        name = by_key[key]
        b = bs[name]
        p = b["plumb"]
        lines.append(f"F {j} {name} {key} {b['entry']} {b['len']} {b['fs']}")
        lines.append("L " + " ".join(map(str, cells.get(name, []))))
        lines.append("E " + " ".join(map(str, b["env"])))
        for o, pc in p.get("stat", []):
            lines.append(f"S {o} k {pc[1]} {pc[2]}" if pc[0] == "k" else f"S {o} f {pc[1]}")
        for a, r, q, rp, tg in p.get("sites", []):
            lines.append(f"T {q} {rp} {tg} | {' '.join(map(str, a))} | {' '.join(map(str, r))}")
        for x, t, base in p.get("arms", []):
            lines.append(f"A {x} {t} {base}")
        for v, c in p.get("tmps", []):
            lines.append(f"P {v} {c}")
        for v, c in p.get("runs", []):
            lines.append(f"R {v} {c}")
        lines.append("M " + " ".join(map(str, p.get("pmax", []))))
        lines.append("H " + " ".join(map(str, p.get("sh", []))))
        for (pi, x, ts, y, base) in p.get("chains", []):
            lines.append(f"C {pi} {x} {y} {base} | {' '.join(map(str, ts))}")
    for s, t in jt_trie():
        lines.append(f"J {s} {t}")
    for name, n, where in pinned(by_key):
        lines.append(f"X {name} {n} {where}")
    for name, v, kind in residual():
        lines.append(f"Q {name} {v} {kind}")
    OUT.write_text("\n".join(lines) + "\n")
    return len(order)


def coverage(prof):
    """What real executions of the guest ran: the per-pc counts the machine writes under
    `DBG_PROF=1 DBG_PROF_DUMP=PATH` and the per-function cycle tables it prints, in `prof`."""
    fns = {}
    for line in OUT.read_text().splitlines():
        if line.startswith("F "):
            _, j, name, key, entry, length, fs = line.split()
            fns[name] = (int(entry), int(length))
    ran_fns, ran_pcs, execs, layout_ok, dumps = set(), set(), 0, True, 0
    for f in sorted(glob.glob(os.path.join(prof, "*"))):
        text = open(f, errors="replace").read()
        if f.endswith(".err"):
            for blk in text.split("== DBG_PROF: cycles by function")[1:]:
                execs += 1
                for row in blk.splitlines()[1:]:
                    m = re.match(r"\s+[\d,_ ]+\s+[\d.]+%\s+(\S+)$", row)
                    if not m:
                        break
                    ran_fns.add(m.group(1))
        elif text.startswith("# steps"):
            dumps += 1
            for line in text.splitlines()[1:]:
                w = line.split()
                if w[0] == "F":
                    if fns.get(w[1], (int(w[2]), int(w[3]))) != (int(w[2]), int(w[3])):
                        layout_ok = False
                else:
                    ran_pcs.add(int(w[0]))
    total = sum(n for _, n in fns.values())
    by_fn = {name: sum(1 for pc in range(e, e + n) if pc in ran_pcs) for name, (e, n) in fns.items()}
    full = sum(1 for name, (e, n) in fns.items() if by_fn[name] == n)
    print(f"executions: {execs} (function tables), {dumps} per-pc dumps; the dumps' function ranges "
          f"{'equal' if layout_ok else 'DIFFER from'} the statement's")
    print(f"functions run: {len(ran_fns & set(fns))} of {len(fns)}; in the dumps, {sum(1 for v in by_fn.values() if v)} "
          f"functions, {full} with every instruction run; instructions run {len(ran_pcs & set().union(*[range(e, e + n) for e, n in fns.values()]))} of {total}")
    for name in sorted(fns, key=lambda n: fns[n][0]):
        print(f"  {name} {by_fn[name]}/{fns[name][1]} {'ran' if name in ran_fns else '-'}")


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--tables-only", action="store_true")
    ap.add_argument("--detail", action="store_true")
    ap.add_argument("--selftest", action="store_true")
    ap.add_argument("--coverage", metavar="DIR")
    a = ap.parse_args()
    os.chdir(ROOT)
    n = write_tables()
    print(f"tables: {n} functions -> {OUT}", flush=True)
    if a.coverage:
        coverage(a.coverage)
        return
    if a.tables_only:
        return
    args = ["lake", "exe", "guest-cplcheck", str(OUT)] + (["--detail"] if a.detail else []) + \
        (["--selftest"] if a.selftest else [])
    sys.exit(subprocess.run(args).returncode)


if __name__ == "__main__":
    main()
