#!/usr/bin/env bash
# The front end in Lean (`LeanVM/Guest/Expand.lean`) against the one in Rust (`crates/zkdsl_compiler/src/expand.rs`),
# on the guest and on every test program: the core IR each expands the program to, every function renumbered
# (`Fn.renumber`), in one canonical text (`lake exe guest-backend core-text`, `cli/GuestBackend.lean`; `core_ir::render`
# in Rust), compared line for line. Run from anywhere; needs `lake` and `cargo`, and the guest's artefact current
# (`scripts/guest-artifact --check`), whose size the Rust side reads the placeholders at.
#
#   scripts/frontend-diff [--jobs N] [--keep DIR]
#
# `--keep DIR` writes the two texts to `DIR/lean` and `DIR/rust` and leaves them there.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."
jobs=() keep=
while [ $# -gt 0 ]; do
  case $1 in
    --jobs) jobs=(--jobs "$2"); shift ;;
    --keep) keep=$2; shift ;;
    *) echo "usage: scripts/frontend-diff [--jobs N] [--keep DIR]" >&2; exit 2 ;;
  esac
  shift
done
if [ -n "$keep" ]; then
  out=$keep
  rm -rf "$out/lean" "$out/rust"
else
  out=$(mktemp -d)
  trap 'rm -rf "$out"' EXIT
fi

python3 -I ../lake-build.py . guest-backend "${jobs[@]}"
.lake/build/bin/guest-backend core-text "$out/lean"
cargo build --release --manifest-path scripts/guest-export/Cargo.toml
scripts/guest-export/target/release/guest-export . --core "$out/rust"

status=0
for lean in "$out"/lean/*.core; do
  name=$(basename "$lean")
  rust=$out/rust/$name
  if [ ! -f "$rust" ]; then
    echo "$name: no Rust expansion" >&2
    status=1
  elif cmp -s "$lean" "$rust"; then
    echo "$name: identical, $(grep -c '^def ' "$lean") functions, $(wc -l < "$lean") lines"
  else
    echo "$name: the two front ends differ (Lean <, Rust >):" >&2
    diff "$lean" "$rust" | head -n 40 >&2 || true
    line=$(cmp "$lean" "$rust" | sed -n 's/.* line \([0-9]*\)$/\1/p')
    if [ -n "$line" ]; then
      echo "  in $(head -n "$line" "$lean" | grep '^def ' | tail -n 1)" >&2
    fi
    status=1
  fi
done
for rust in "$out"/rust/*.core; do
  [ -f "$out/lean/$(basename "$rust")" ] || { echo "$(basename "$rust"): no Lean expansion" >&2; status=1; }
done
exit $status
