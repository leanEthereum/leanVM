#!/usr/bin/env python3
"""Which proofs a guest change reaches: the core IR's functions whose bodies changed, were added or were
removed, each with the hand-written modules that state its body or name it.

    python3 -I scripts/guest-changes BEFORE

`BEFORE` holds the core IR before the change: `scripts/regen-guest.sh` copies `LeanVM/Guest/Data/Core*.lean`
to `.lake/guest-before/Data` and `LeanVM/Guest/Pack` to `.lake/guest-before/Pack` before it exports, and runs
this after `guest-core` (a snapshot of the packed `Data/Core{k}.lean`, directly in `BEFORE`, is read too). Functions are matched by name, a loop helper (`__loop{k}`, named by the compiler's counter)
by its first caller and its rank among that caller's loops, so a renumbering or a loop renamed is no
change. A changed body is what `--dev` cannot show: its template's `decide +kernel` passes there, so
build the modules listed under `states its body` with the kernel first (formal/AGENTS.md, Changing
the spec). Run from `lean_vm`.
"""
import hashlib
import re
import sys
from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parent))
import coredata

ROOTS = [Path("LeanVM"), Path("tests")]


def read_core(data):
    """The core IR's functions, in order: (name, body text)."""
    fns, parts = {}, {}
    # A long body's parts (`namespace core{j}`) may sit in modules before its definition's.
    if (Path(data) / "Data").is_dir():
        data = Path(data) / "Data"
    for text in coredata.legacy_texts(data):
        for m in re.finditer(r"^namespace core(\d+)\n(.*?)^end core\1$", text, re.M | re.S):
            parts[int(m.group(1))] = parts.get(int(m.group(1)), "") + m.group(2)
        for m in re.finditer(r"^noncomputable def core(\d+) : Core\.Fn where\n  name := \"([^\"]+)\"\n(.*?)(?=\n\n|\Z)",
                             text, re.M | re.S):
            fns[int(m.group(1))] = (m.group(2), m.group(3))
    if not fns:
        sys.exit(f"guest-changes: no core IR in {data} (regen-guest.sh's export step writes .lake/guest-before)")
    if sorted(fns) != list(range(len(fns))):
        sys.exit(f"guest-changes: {data}'s functions are not numbered 0 .. n - 1")
    return [(fns[j][0], parts.get(j, "") + fns[j][1]) for j in range(len(fns))]


def table(fns):
    """Each function by its key (its name; a loop's first caller's key and rank): its index, name and hash."""
    keys = [None if n.startswith("__loop") else n for n, _ in fns]
    by_name = {n: j for j, (n, _) in enumerate(fns)}
    changed = True
    while changed:
        changed = False
        for j, (_, body) in enumerate(fns):
            if keys[j] is None:
                continue
            seen = []
            for l in re.findall(r'"(__loop\d+)"', body):
                if l not in seen:
                    seen.append(l)
            for k, l in enumerate(seen):
                if keys[by_name[l]] is None:
                    keys[by_name[l]] = f"{keys[j]}/{k}"
                    changed = True
    key_of = {n: keys[j] or n for j, (n, _) in enumerate(fns)}
    out = {}
    for j, (n, body) in enumerate(fns):
        norm = re.sub(rf"\bcore{j}\b", "core@", body)
        norm = re.sub(r'"(__loop\d+)"', lambda m: f'"{key_of[m.group(1)]}"', norm)
        out[key_of[n]] = (j, n, hashlib.sha256(norm.encode()).hexdigest())
    return out


def hand_written():
    for root in ROOTS:
        for p in sorted(root.rglob("*.lean")):
            if "Guest/Data/" in str(p) or "/Checked/" in str(p):
                continue
            text = p.read_text(encoding="utf-8")
            if "do not edit" not in text[:600] and "Generated by" not in text[:600]:
                yield p, text


def main():
    if len(sys.argv) != 2:
        sys.exit("usage: python3 -I scripts/guest-changes BEFORE")
    old, new = table(read_core(sys.argv[1])), table(read_core("LeanVM/Guest/Data"))
    rows = ([("changed", k, {old[k][0], new[k][0]}) for k in new if k in old and old[k][2] != new[k][2]] +
            [("added", k, {new[k][0]}) for k in new if k not in old] +
            [("removed", k, {old[k][0]}) for k in old if k not in new])
    count = {t: sum(1 for r in rows if r[0] == t) for t in ("changed", "added", "removed")}
    print(f"guest-changes: {len(new)} functions, {count['changed']} changed, {count['added']} added, "
          f"{count['removed']} removed")
    # Each module read once: the core indices whose bodies it states, those it names, the words it holds.
    bodies, cores, words = {}, {}, {}
    for p, text in hand_written():
        for m in re.finditer(r"\bData\.core(\d+)\.body\b|\bFn\.body Data\.core(\d+)\b|\(coreOf (\d+)\)\.body\b", text):
            j = int(m.group(1) or m.group(2)) if not m.group(3) else int(m.group(3)) - 1
            bodies.setdefault(j, set()).add(p)
        for j in re.findall(r"\bData\.core(\d+)\b", text):
            cores.setdefault(int(j), set()).add(p)
        for w in set(re.findall(r"(?<![\w.])[A-Za-z_][\w]*", text)):
            words.setdefault(w, set()).add(p)
    for title, key, idxs in rows:
        print(f"{title}: {(new.get(key) or old[key])[1]}")
        # The modules may still use the old index, or the old loop name, until they follow the new IR.
        names = {x[1] for x in (old.get(key), new.get(key)) if x}
        body = set().union(*(bodies.get(j, set()) for j in idxs))
        named = set().union(*(cores.get(j, set()) for j in idxs), *(words.get(n, set()) for n in names)) - body
        for p in sorted(body):
            print(f"    states its body: {p}")
        for p in sorted(named):
            print(f"    names it: {p}")


main()
