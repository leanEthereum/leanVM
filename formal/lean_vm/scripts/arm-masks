#!/usr/bin/env python3
"""Write the masks of `open_stacked`'s arms' callees (`Place/FreeMask.lean`) and their checks, each
distinct callee once, from the generated callee table (`Guest/Memory/GuestCallees.lean`). Run from
`lean_vm`:

    python3 -I scripts/arm-masks [--check]

`Place/FreeMaskData.lean`: the callees' indices by what the arms need of them, in chunks, and the
masks. `Place/FreeNoWit{i}.lean`, `Place/FreeExact{i}.lean`: the subtree checks (`noWitJ 8`, `exactJ 8`)
of arm `i`'s callees not an earlier arm's, a module each so that they build at once. `Place/FreeLq.lean`,
`Place/FreeLp.lean`: the names of the `level_queries`, `is_zero` and `level_positions` callees.
`Place/FreeNoWitOk.lean`, `Place/FreeExactOk.lean`: the chunks joined. Nothing here is trusted: a wrong index fails its kernel
check.
"""
import re, sys
from pathlib import Path

CALLEES = Path('LeanVM/Guest/Memory/GuestCallees.lean')
PLACE = Path('LeanVM/Guest/B1/Place')
ARMS = 11
HEAD = '''/-
  LeanVM.Guest.B1.Place.{name}

  {what} Generated by `scripts/arm-masks`; do not edit.
-/

module

{imports}
namespace LeanVM.Guest.B1.Arm

open LeanVM.Guest.Core LeanVM.Guest.Memory

@[expose] public section

'''
TAIL = '\nend\nend LeanVM.Guest.B1.Arm\n'


def tables():
    t = CALLEES.read_text(encoding='utf-8')
    i = t.find('def calleeT')
    names = {int(a): b for a, b in re.findall(r'\.node (\d+) \("([^"]*)"\)', t[:i])}
    cal = {int(a): [int(x) for x in b.split(',') if x.strip()]
           for a, b in re.findall(r'\.node (\d+) \(\[([\d, ]*)\]\)', t[i:])}
    return names, cal


def lit(ks):
    rows = [', '.join(map(str, ks[i:i + 20])) for i in range(0, len(ks), 20)]
    return '[\n    ' + ',\n    '.join(rows) + ']' if rows else '[]'


def module(name, what, imports, body):
    imp = ''.join(f'public import {m}\n' for m in imports)
    return HEAD.format(name=name, what=what, imports=imp) + body + TAIL


def files():
    names, cal = tables()
    idx = {v: k for k, v in names.items()}
    by_arm = [[k for k in cal[idx[f'open_stacked__L{m}']] if k != idx[f'open_stacked__L{m}']] for m in range(ARMS)]
    callees = sorted({k for ks in by_arm for k in ks})
    is_lq = lambda k: names[k].startswith('level_queries__')
    is_lp = lambda k: names[k] == 'is_zero' or names[k].startswith('level_positions__')
    need = {'NoWit': [k for k in callees if not is_lq(k)], 'Exact': [k for k in callees if not is_lp(k)]}
    lq, lp = [k for k in callees if is_lq(k)], [k for k in callees if is_lp(k)]
    # A chunk an arm's callees not in an earlier arm's: one kernel check shares the subtrees an arm's callees share.
    parts = {}
    for f in need:
        seen, parts[f] = set(), []
        for ks in by_arm:
            c = [k for k in ks if k in set(need[f]) and k not in seen]
            seen.update(c)
            if c:
                parts[f].append(c)
        need[f] = [k for c in parts[f] for k in c]
    out = {}
    body = ''
    for f, cs in parts.items():
        for i, c in enumerate(cs):
            body += f'/-- Chunk {i} of the arms\' callees that must pass `{f[0].lower() + f[1:]}J 8`. -/\n'
            body += f'def arm{f}Need{i} : List ℕ := {lit(c)}\n\n'
        body += f'def arm{f}Need : List ℕ := ' + ' ++ '.join(f'arm{f}Need{i}' for i in range(len(cs))) + '\n\n'
    body += f'/-- The arms\' `level_queries` callees. -/\ndef armLqNeed : List ℕ := {lit(lq)}\n\n'
    body += f'/-- The arms\' `is_zero` and `level_positions` callees. -/\ndef armLpNeed : List ℕ := {lit(lp)}\n\n'
    body += '/-- The mask of the arms\' callees. -/\n'
    body += f'def armCalleeMask : ℕ := {sum(1 << k for k in callees)}\n\n'
    for nm, a, b in (('mute', 'armNoWitNeed', 'armLqNeed'), ('exact', 'armExactNeed', 'armLpNeed')):
        body += f'theorem armCalleeMask_{nm} : armCalleeMask = listMask ({a} ++ {b}) := by decide +kernel\n\n'
    out['FreeMaskData'] = module('FreeMaskData', 'The arms\' callees by what the arms need of them, and their masks.',
                                 ['LeanVM.Guest.B1.Place.FreeMask'], body.rstrip('\n') + '\n')
    for f, cs in parts.items():
        j = 'noWitJ' if f == 'NoWit' else 'exactJ'
        for i in range(len(cs)):
            out[f'Free{f}{i}'] = module(
                f'Free{f}{i}', f'Chunk {i} of the arms\' callees passes `{j} 8`, by the kernel.',
                ['LeanVM.Guest.B1.Place.FreeMaskData'],
                f'theorem arm{f}Need{i}_ok : ∀ k ∈ arm{f}Need{i}, {j} 8 k = true := by decide +kernel\n')
    out['FreeLq'] = module('FreeLq', 'The arms\' `level_queries` callees are entries of `lqTable`, by the kernel.',
                           ['LeanVM.Guest.B1.Place.FreeMaskData', 'LeanVM.Guest.B1.Place.ArmMuteDef'],
                           'theorem armLqNeed_ok : ∀ k ∈ armLqNeed, (Data.nameT.find k).all lqNameB = true := by\n'
                           '  decide +kernel\n')
    out['FreeLp'] = module('FreeLp', 'The arms\' `is_zero` and `level_positions` callees pass `armExactS`, by the kernel.',
                           ['LeanVM.Guest.B1.Place.FreeMaskData', 'LeanVM.Guest.B1.Place.ArmExactDef'],
                           'theorem armLpNeed_ok : ∀ k ∈ armLpNeed, (Data.nameT.find k).all armExactS = true := by\n'
                           '  decide +kernel\n')
    for f, cs in parts.items():
        j = 'noWitJ' if f == 'NoWit' else 'exactJ'
        body = f'theorem arm{f}Need_ok : ∀ k ∈ arm{f}Need, {j} 8 k = true := by\n'
        body += f'  simp only [arm{f}Need, List.append_assoc, List.mem_append]\n'
        body += '  intro k hk\n'
        body += '  rcases hk with ' + ' | '.join('h' for _ in cs) + '\n'
        body += ''.join(f'  · exact arm{f}Need{i}_ok k h\n' for i in range(len(cs)))
        out[f'Free{f}Ok'] = module(f'Free{f}Ok', f'The arms\' callees pass `{j} 8`, the chunks joined.',
                                   [f'LeanVM.Guest.B1.Place.Free{f}{i}' for i in range(len(cs))], body)
    return out


def main():
    check = sys.argv[1:] == ['--check']
    stale = []
    for name, text in files().items():
        p = PLACE / f'{name}.lean'
        if check:
            if not p.exists() or p.read_text(encoding='utf-8') != text:
                stale.append(str(p))
        else:
            p.write_text(text, encoding='utf-8')
    if stale:
        sys.exit('stale, run scripts/arm-masks: ' + ' '.join(stale))


if __name__ == '__main__':
    main()
