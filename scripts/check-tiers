#!/bin/sh
# Fails unless each library, archive or wheel holds the CPU tiers' code (scripts/tier-rustc): GFNI instructions on
# x86_64, the AES extension's PMULL on aarch64, which the portable baselines lack (not SHA3's EOR3: keccak256's
# batched hashes hold it in any build with `std`, for CPUs that have it). objdump must read the file's architecture.
set -eu
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
for file in "$@"; do
    libs=$file
    case "$file" in
    *.whl)
        unzip -q -o -d "$work" "$file" '*.so'
        libs=$(find "$work" -name '*.so')
        ;;
    esac
    for lib in $libs; do
        if ! objdump -d "$lib" | grep -qE 'gf2p8|pmull'; then
            echo "$file: built without the CPU tiers" >&2
            exit 1
        fi
    done
    rm -rf "${work:?}"/*
done
