"""Python bindings for leanXMSS and leanSPHINCS signatures, their aggregation, and the consensus VRF."""

import os
from collections.abc import Sequence
from typing import final

__all__ = [
    "__version__",
    "LeanPqError",
    "XmssSecretKey",
    "SphincsSecretKey",
    "VrfKey",
    "Aggregate",
    "Sidecar",
    "xmss_verify",
    "sphincs_verify",
    "vrf_verify",
]

__version__: str

class LeanPqError(Exception): ...

@final
class XmssSecretKey:
    @classmethod
    def generate(cls) -> "XmssSecretKey": ...
    @classmethod
    def from_seed(cls, seed: bytes) -> "XmssSecretKey": ...
    @classmethod
    def from_bytes(cls, data: bytes) -> "XmssSecretKey": ...
    @classmethod
    def from_cache_bytes(cls, seed: bytes, public_key: bytes, cache: bytes) -> "XmssSecretKey": ...
    def to_bytes(self) -> bytes: ...
    def cache_to_bytes(self) -> bytes: ...
    @property
    def public_key(self) -> bytes: ...
    def prepare(self, leaf_index: int) -> None: ...
    def sign(self, message: bytes, leaf_index: int) -> bytes: ...

@final
class SphincsSecretKey:
    @classmethod
    def generate(cls) -> "SphincsSecretKey": ...
    @classmethod
    def from_seed(cls, seed: bytes) -> "SphincsSecretKey": ...
    @classmethod
    def from_bytes(cls, data: bytes) -> "SphincsSecretKey": ...
    def to_bytes(self) -> bytes: ...
    @property
    def public_key(self) -> bytes: ...
    def sign(self, message: bytes) -> bytes: ...

@final
class VrfKey:
    @classmethod
    def from_seed(cls, seed: bytes, start: int, end: int) -> "VrfKey": ...
    @classmethod
    def from_cache_bytes(cls, seed: bytes, root: bytes, cache: bytes) -> "VrfKey": ...
    def cache_to_bytes(self) -> bytes: ...
    def root(self) -> bytes: ...
    def proof(self, slot: int) -> bytes: ...

@final
class Aggregate:
    def to_bytes(self) -> bytes: ...
    @property
    def xmss_claims(self) -> list[tuple[bytes, bytes]]: ...
    @property
    def sphincs_claims(self) -> list[tuple[bytes, bytes]]: ...

@final
class Sidecar:
    @classmethod
    def connect(cls, socket: str | os.PathLike[str]) -> "Sidecar": ...
    @classmethod
    def start(
        cls, binary: str | os.PathLike[str], socket: str | os.PathLike[str], threads: int = 0
    ) -> "Sidecar": ...
    @property
    def prover(self) -> str: ...
    def aggregate(
        self,
        children: Sequence[Aggregate] = (),
        xmss: Sequence[tuple[bytes, bytes, bytes]] = (),
        sphincs: Sequence[tuple[bytes, bytes, bytes]] = (),
    ) -> Aggregate: ...
    def verify(
        self,
        data: bytes,
        xmss_claims: Sequence[tuple[bytes, bytes]] = (),
        sphincs_claims: Sequence[tuple[bytes, bytes]] = (),
    ) -> Aggregate: ...
    def close(self) -> None: ...
    def __enter__(self) -> "Sidecar": ...
    def __exit__(self, *args: object) -> None: ...

def xmss_verify(public_key: bytes, message: bytes, signature: bytes) -> None: ...
def sphincs_verify(public_key: bytes, message: bytes, signature: bytes) -> None: ...
def vrf_verify(root: bytes, slot: int, proof: bytes) -> None: ...
