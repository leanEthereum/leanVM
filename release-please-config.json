{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-component-in-tag": true,
  "tag-separator": "-",
  "bump-minor-pre-major": true,
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "bindings",
      "changelog-path": "bindings/CHANGELOG.md",
      "extra-files": [
        {
          "type": "toml",
          "path": "bindings/Cargo.toml",
          "jsonpath": "$.workspace.package.version"
        },
        {
          "type": "generic",
          "path": "bindings/README.md"
        },
        {
          "type": "generic",
          "path": "bindings/python/README.md"
        },
        {
          "type": "generic",
          "path": "bindings/node/README.md"
        },
        {
          "type": "generic",
          "path": "bindings/java/README.md"
        },
        {
          "type": "generic",
          "path": "bindings/dotnet/README.md"
        },
        {
          "type": "generic",
          "path": "bindings/go/README.md"
        },
        {
          "type": "generic",
          "path": "bindings/zig/README.md"
        },
        {
          "type": "generic",
          "path": "bindings/nim/README.md"
        },
        {
          "type": "generic",
          "path": "bindings/nim/lean_pq.nimble"
        },
        {
          "type": "generic",
          "path": "bindings/nim/lean_pq/abi.nim"
        },
        {
          "type": "toml",
          "path": "bindings/Cargo.lock",
          "jsonpath": "$.package[?(@.name==='lean-pq' || @.name.value==='lean-pq')].version"
        },
        {
          "type": "toml",
          "path": "bindings/Cargo.lock",
          "jsonpath": "$.package[?(@.name==='lean-pq-native' || @.name.value==='lean-pq-native')].version"
        },
        {
          "type": "toml",
          "path": "bindings/Cargo.lock",
          "jsonpath": "$.package[?(@.name==='lean-pq-node' || @.name.value==='lean-pq-node')].version"
        },
        {
          "type": "toml",
          "path": "bindings/Cargo.lock",
          "jsonpath": "$.package[?(@.name==='py-lean-pq' || @.name.value==='py-lean-pq')].version"
        }
      ],
      "component": "bindings",
      "exclude-paths": [
        ".github",
        "bench",
        "doc",
        "formal"
      ]
    }
  }
}
