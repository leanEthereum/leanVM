+    /// `tree_root` against `tree_fold` with a visitor: the same root, the visitor called once a level, on every layer,
+    /// for a path of its tree's height and for shorter ones down to none, with a left and a right child at every level.
+    #[test]
+    fn tree_root_matches_tree_fold() {
+        let pk_seed: PkSeed = core::array::from_fn(|i| (i * 11 + 3) as u8);
+        let digest = |x: u64| -> Digest {
+            u128::from(x + 1)
+                .wrapping_mul(0x9E37_79B9_7F4A_7C15_F39C_C060)
+                .to_le_bytes()
+        };
+        for layer in 0..LAYERS {
+            for height in [0, 1, LAYER_HEIGHTS[layer]] {
+                let path: Vec<Digest> = (0..height as u64).map(digest).collect();
+                for leaf in [0, 1, 0x155, 0x2aa, (1 << LAYER_HEIGHTS[layer]) - 1] {
+                    let key = OtsKey {
+                        layer,
+                        tree: 0x12_3456_789a ^ u64::from(leaf),
+                        leaf,
+                    };
+                    let mut seen = 0;
+                    let want = tree_fold(&pk_seed, &key, digest(99), &path, |_| seen += 1);
+                    assert_eq!(
+                        tree_root(&pk_seed, &key, digest(99), &path),
+                        want,
+                        "layer {layer}, leaf {leaf}"
+                    );
+                    assert_eq!(seen, height);
+                }
+            }
+        }
+    }
