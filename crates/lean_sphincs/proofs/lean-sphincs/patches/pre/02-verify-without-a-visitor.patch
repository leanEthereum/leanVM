+/// [`fors_recover`] with nothing watching.
+pub(crate) fn fors_root(pk_seed: &PkSeed, idx: u64, leaves: &[usize; FORS_TREES], opening: &ForsOpening) -> Digest {
+    let mut roots = [[0; N]; FORS_TREES];
+    for c in 0..FORS_TREES {
+        let (s, tree) = (leaves[c], &opening[c]);
+        let leaf = fors_leaf(pk_seed, idx, c, s, &tree.secret);
+        roots[c] = keccak256::path_root(leaf, s, &tree.path, |z, j, pair| fors_node(pk_seed, idx, c, z, j, pair));
+    }
+    fors_key(pk_seed, idx, &roots)
+}
