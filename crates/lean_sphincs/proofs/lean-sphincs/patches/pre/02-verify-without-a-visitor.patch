+/// [`fors_recover`] with nothing watching.
+pub(crate) fn fors_root(pk_seed: &PkSeed, idx: u64, leaves: &[usize; FORS_TREES], opening: &ForsOpening) -> Digest {
+    let mut roots = [[0; N]; FORS_TREES];
+    for c in 0..FORS_TREES {
+        let (s, tree) = (leaves[c], &opening[c]);
+        let leaf = fors_leaf(pk_seed, idx, c, s, &tree.secret);
+        roots[c] = keccak256::path_root(leaf, s, &tree.path, |z, j, pair| fors_node(pk_seed, idx, c, z, j, pair));
+    }
+    fors_key(pk_seed, idx, &roots)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// `fors_root` against `fors_recover` with a visitor: the same key, the visitor called once a level of every tree,
+    /// at leaves that give every tree a left and a right child at every level.
+    #[test]
+    fn fors_root_matches_fors_recover() {
+        let pk_seed: PkSeed = core::array::from_fn(|i| (i * 11 + 3) as u8);
+        let digest = |x: usize| -> Digest {
+            (x as u128 + 1)
+                .wrapping_mul(0x9E37_79B9_7F4A_7C15_F39C_C060)
+                .to_le_bytes()
+        };
+        let opening: ForsOpening = core::array::from_fn(|c| ForsTreeOpening {
+            secret: digest(c),
+            path: core::array::from_fn(|z| digest(100 + 16 * c + z)),
+        });
+        let last = (1 << FORS_HEIGHT) - 1;
+        let cases: [(u64, [usize; FORS_TREES]); 4] = [
+            (0, [0; FORS_TREES]),
+            (0x2aa_aaaa, [last; FORS_TREES]),
+            (0x155_5555, core::array::from_fn(|c| (c * 0x2f + 0x155) & last)),
+            ((1 << H) - 1, core::array::from_fn(|c| (c * 0x6b + 0x2aa) & last)),
+        ];
+        for (idx, leaves) in cases {
+            let mut seen = 0;
+            let want = fors_recover(&pk_seed, idx, &leaves, &opening, |_| seen += 1);
+            assert_eq!(fors_root(&pk_seed, idx, &leaves, &opening), want, "index {idx:#x}");
+            assert_eq!(seen, FORS_TREES * FORS_HEIGHT);
+        }
+    }
+}
