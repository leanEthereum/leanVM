+    /// A node for the path tests, which tells apart the height, the index and the order of the two children.
+    fn mix(z: usize, j: usize, children: &[[u8; 8]; 2]) -> [u8; 8] {
+        let [left, right] = children.map(u64::from_le_bytes);
+        (left.wrapping_mul(0x9E37_79B9_7F4A_7C15) ^ right.rotate_left(17))
+            .wrapping_add((z as u64) << 48 | j as u64)
+            .wrapping_mul(0xBF58_476D_1CE4_E5B9)
+            .to_le_bytes()
+    }
+
+    /// A leaf and a path of `height` siblings.
+    fn leaf_and_path(height: usize) -> ([u8; 8], Vec<[u8; 8]>) {
+        let word = |i: u64| (i + 1).wrapping_mul(0xD6E8_FEB8_6659_FD93).to_le_bytes();
+        (word(1000), (0..height as u64).map(word).collect())
+    }
+
+    /// The leaf indices the path tests fold at: both values of every bit a path of `height` reads, and bits above it.
+    fn indices(height: usize) -> Vec<usize> {
+        let top = (1usize << height) - 1;
+        vec![0, 1, 2, 5, top, top ^ 1, top / 3, top + 1, 0x2aa, 0x555, usize::MAX]
+    }
+
+    /// `path_fold` as the source has it: a fold over the path.
+    fn path_fold_as_a_fold<const N: usize>(
+        leaf: [u8; N],
+        e: usize,
+        path: &[[u8; N]],
+        mut visit: impl FnMut(&[[u8; N]; 2]),
+        node: impl Fn(usize, usize, &[[u8; N]; 2]) -> [u8; N],
+    ) -> [u8; N] {
+        path.iter().enumerate().fold(leaf, |current, (z, &sibling)| {
+            let children = if (e >> z) & 1 == 0 {
+                [current, sibling]
+            } else {
+                [sibling, current]
+            };
+            visit(&children);
+            node(z + 1, e >> (z + 1), &children)
+        })
+    }
+
+    /// `path_fold` by index against the fold it replaces: the same root, and the same children shown in the same
+    /// order, at every height from none up and with a left and a right child at every level.
+    #[test]
+    fn path_fold_by_index_matches_the_fold() {
+        for height in [0, 1, 2, 3, 8, 11] {
+            let (leaf, path) = leaf_and_path(height);
+            for e in indices(height) {
+                let (mut got_seen, mut want_seen) = (vec![], vec![]);
+                let got = path_fold(leaf, e, &path, |pair| got_seen.push(*pair), mix);
+                let want = path_fold_as_a_fold(leaf, e, &path, |pair| want_seen.push(*pair), mix);
+                assert_eq!(got, want, "height {height}, index {e}");
+                assert_eq!(got_seen, want_seen, "height {height}, index {e}");
+                assert_eq!(got_seen.len(), height);
+            }
+        }
+    }
