+    /// `path_root` against `path_fold` with a visitor: the same root, the visitor called once a level, at every height
+    /// from none up and with a left and a right child at every level.
+    #[test]
+    fn path_root_matches_path_fold() {
+        for height in [0, 1, 2, 3, 8, 11] {
+            let (leaf, path) = leaf_and_path(height);
+            for e in indices(height) {
+                let mut seen = 0;
+                let want = path_fold(leaf, e, &path, |_| seen += 1, mix);
+                assert_eq!(path_root(leaf, e, &path, mix), want, "height {height}, index {e}");
+                assert_eq!(seen, height);
+            }
+        }
+    }
