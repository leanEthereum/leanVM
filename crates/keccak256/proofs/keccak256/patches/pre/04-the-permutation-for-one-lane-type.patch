+/// [`Lane::absorb`] for a lane type with no instructions of its own for it.
+#[inline(always)]
+fn absorb_by_lane<S: Lane>(st: &mut [S; STATE_LANES], inputs: &[u8], len: usize, at: usize, words: usize) {
+    for (w, lane) in st[..words].iter_mut().enumerate() {
+        *lane = lane.xor(gather(|l| {
+            u64::from_le_bytes(*inputs[l * len + at + 8 * w..].first_chunk().unwrap())
+        }));
+    }
