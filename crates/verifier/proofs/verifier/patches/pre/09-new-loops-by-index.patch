diff --git a/crates/verifier/src/transcript.rs b/crates/verifier/src/transcript.rs
index b8d8f65b7..91f0f22ac 100644
--- a/crates/verifier/src/transcript.rs
+++ b/crates/verifier/src/transcript.rs
@@ -224,12 +224,12 @@ impl<'a> Transcript<'a> {
             None => {
                 let constant = self.next_scalar()?;
                 let tail = self.next_scalars(count - 2)?;
-                [vec![constant, claim + E::sum(tail.iter().copied())], tail].concat()
+                [vec![constant, claim + tail.iter().fold(ZERO, |acc, &x| acc + x)], tail].concat()
             }
             // `(1 + r) q(0) + r q(1) == claim`. The transcript contains c1, c2, c3 ... (r := eq_factor)
