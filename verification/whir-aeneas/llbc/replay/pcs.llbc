 while out.len() < count {\n        let v: F192 = ch.verifier_message();\n        let take = per.min(count - out.len());\n        push_chunks(&mut out, [v.c0, v.c1, v.c2], depth, take);\n    }\n    let strata = Stratum::batch(count, depth);\n    let mut i = 0;\n    while i < out.len().min(strata.len()) {\n        let s = strata[i];\n        let low = depth - s.bits;\n        out[i] = (out[i] & ((1 << low) - 1)) | s.index << low;\n        i += 1;\n    }\n    out\n}","attr_info":{"attributes":[{"DocComment":" Sample `count` query positions of `depth` bits, in transcript order."},{"DocComment":""},{"DocComment":" - Each squeezed element of `E` yields `floor(192 / depth)` positions: its disjoint `depth`-bit chunks, low bits first."},{"DocComment":" - Each position then takes its stratum: its top bits are replaced by the stratum's."},{"DocComment":""},{"DocComment":" Positions are neither sorted nor deduplicated."},{"DocComment":""},{"DocComment":" A repeated position opens the same authenticated row again, which is harmless."}],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":true,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[{"index":0,"name":"T0","variance":"Invariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Value":[427,{"data":{"file_id":7,"beg":{"line":97,"col":43},"end":{"line":97,"col":53}},"generated_from_span":null}]},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":13,"generics":{"regions":[],"types":[{"Deduplicated":41}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[{"regions":[],"skip_binder":[{"Deduplicated":41},{"Var":{"Free":0}}]}],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":110},{"Deduplicated":0},{"Deduplicated":0}],"output