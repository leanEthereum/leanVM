s":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":22},"kind":"InherentImplBlock"}}},{"Ident":["share",0]}],"span":{"Untagged":{"data":{"file_id":7,"beg":{"line":178,"col":4},"end":{"line":209,"col":5}},"generated_from_span":null}},"source_text":"pub(crate) fn share<A: Arith>(&self, ar: &mut A, x: A::E, g1: &[A::E]) -> A::E {\n        let m = self.log_msg_cols;\n        let inverses = self.basis.inverses();\n        // W_b(x) for the bits of j < k, then W_m(x), by the subspace polynomials' recurrence.\n        let bits = g1.len().next_power_of_two().trailing_zeros() as usize;\n        let mut s = x;\n        let mut w = Vec::with_capacity(bits);\n        // An index loop rather than an enumerating iterator.\n        let mut b = 0;\n        while b <= m {\n            if b > 0 {\n                s = self.basis.next(ar, s, b - 1);\n            }\n            if b < bits {\n                w.push(ar.mul_const(s, F192::from(inverses[b])));\n            }\n            b += 1;\n        }\n        let w_m = ar.mul_const(s, F192::from(inverses[m]));\n        let w_m = ar.add_const(w_m, F192::from(self.shift));\n        // sum_j g1[j] X_j(x), folding the top bit of j at a time: X_j is the product of W_b over the bits b of j.\n        let mut g = g1.to_vec();\n        while g.len() > 1 {\n            let half = g.len().next_power_of_two() >> 1;\n            let w_b = w[half.trailing_zeros() as usize];\n            for j in 0..g.len() - half {\n                g[j] = ar.mul_add(w_b, g[j + half], g[j]);\n            }\n            g.truncate(half);\n        }\n        if g.is_empty() { ar.zero() } else { ar.mul(w_m, g[0]) }\n    }","attr_info":{"attributes":[{"DocComment":" The share at `x` of a padding whose lane fold is `g1`."},{"DocComment":""},{"DocComment":" ```text"},{"DocComment":"     W_m(x + s) * sum_j g1[j] X_j(x)"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Adding it, which in characteristic two takes it off, leaves the folded data's codeword."},{"DocComment":""},{"DocComment":" The same code runs natively, in the verifier, and in the recursion machine's rows."}],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown"},{"index":2,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[{"index":0,"name":"A","variance":"Invariant"},{"index":1,"name":"Clause0_E","variance":"Invariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Value":[3339,{"data":{"file_id":7,"beg":{"line":178,"col":27},"end":{"line":178,"col":32}},"generated_from_span":null}]},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":7,"generics":{"regions":[],"types":[{"Deduplicated":41},{"Deduplicated":47}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[{"regions":[],"skip_binder":[{"Deduplicated":41},{"Var":{"Free":1}}]},{"regions":[],"skip_binder":[{"Deduplicated":47},{"Var":{"Free":2}}]},{"regions":[],"skip_binder":[{"Deduplicated":41},{"Var":{"Free":2}}]}],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Value":[934,{"Ref":[{"Var":{"Free":0}},{"Deduplicated":22},"Shared"]}]},{"Deduplicated":424},{"Deduplicated":47},{"Deduplicated":767}],"output":{"Deduplicated":47}},"src":"Normal","body":{"Structured":{"span":{"Value":[3340,{"data":{"file_id":7,"beg":{"line":178,"col":4},"end":{"line":209,"col":5}},"generated_from_span":null}]},"bound_body_regions":87,"locals":{"arg_count":4,"locals":[{"index":0,"name":null,"span":{"Value":[3341,{"data":{"file_id":7,"beg":{"line":178,"col":78},"end":{"line":178,"col":82}},"generated_from_span":null}]},"ty