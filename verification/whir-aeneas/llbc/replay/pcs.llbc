pan":{"Deduplicated":3512},"id":132104,"kind":{"StorageDead":105},"comments_before":[]},{"span":{"Deduplicated":3512},"id":132105,"kind":{"StorageDead":104},"comments_before":[]},{"span":{"Deduplicated":3512},"id":132106,"kind":{"StorageDead":103},"comments_before":[]},{"span":{"Deduplicated":3512},"id":96083,"kind":"Return","comments_before":[]}]},"comments":[[182,["W_b(x) for the bits of j < k, then W_m(x), by the subspace polynomials' recurrence."]],[186,["An index loop rather than an enumerating iterator."]],[199,["sum_j g1[j] X_j(x), folding the top bit of j at a time: X_j is the product of W_b over the bits b of j."]]]}}},{"def_id":240,"item_meta":{"name":[{"Ident":["pcs",0]},{"Ident":["whir",0]},{"Ident":["verify",0]},{"Impl":{"Ty":{"params":{"regions":[],"types":[{"index":0,"name":"V","variance":"Unknown"},{"index":1,"name":"Clause0_Root","variance":"Invariant"},{"index":2,"name":"Clause0_K","variance":"Invariant"},{"index":3,"name":"Clause0_Query","variance":"Invariant"},{"index":4,"name":"Clause0_Clause0_Clause0_E","variance":"Invariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Deduplicated":2},"origin":"WhereClauseOnImpl","trait_":{"regions":[],"skip_binder":{"id":5,"generics":{"regions":[],"types":[{"Deduplicated":3},{"Deduplicated":11},{"Deduplicated":69},{"Deduplicated":70},{"Deduplicated":71}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"Deduplicated":72},"kind":"InherentImplBlock"}}},{"Ident":["terminal",0]}],"span":{"Untagged":{"data":{"file_id":6,"beg":{"line":663,"col":4},"end":{"line":694,"col":5}},"generated_from_span":null}},"source_text":"fn terminal(\n        &self,\n        v: &mut V,\n        config: &Config,\n        yr: &[V::E],\n        ris_tail: &[V::E],\n        weight_at: impl WeightAt<V::E, V>,\n    ) -> Result<(), WhirError> {\n        let tail = ris_tail.len();\n        let zero = v.zero();\n        let mut weight = zero;\n        for i in 0..self.levels.len() {\n            let ctx = &self.levels[i];\n            let folded = ctx.log_msg_cols - tail;\n            let mut point = self.ris[ctx.ris_start..ctx.ris_start + folded].to_vec();\n            point.extend_from_slice(ris_tail);\n            let at = ctx.basis_at(v, &point);\n            weight = v.mul_add(ctx.beta, at, weight);\n        }\n        weight = add_ood_terms(v, &self.oods, &self.ris, ris_tail, weight);\n        // Why rotate: `ris ++ ris_tail` is the fold challenges in round order.\n        // - The first `initial_k` rounds are the lane fold, which binds the witness's top `initial_k` variables.\n        // - Rotating left by `initial_k` indexes the point by witness variable, as the caller's weight expects.\n        let mut full_point = self.ris.clone();\n        full_point.extend_from_slice(ris_tail);\n        full_point.rotate_left(config.initial_k());\n        let caller = weight_at.call(v, &full_point);\n        let weight = v.add(weight, caller);\n        let folded_yr = v.mle(yr, ris_tail);\n        let lhs = v.mul(weight, folded_yr);\n        v.ensure_eq(lhs, self.t_r, || WhirError::TerminalMismatch)\n    }","attr_info":{"attributes":[{"DocComment":" Check `weight * <yr, eq(ris_tail)> = t_r`."},{"DocComment":""},{"DocComment":" `weight` is the batched weight at the full point."},{"DocComment":" It sums each level's induced basis and each OOD claim's `eq(z, .)`, each at its power, and the caller's weight."},{"DocComment":""},{"DocComment":" # Errors"},{"DocComment":""},{"DocComment":" Returns a terminal mismatch."}],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown"},{"index":2,"name":null,"variance":"Covariant","mutability":"Unkn