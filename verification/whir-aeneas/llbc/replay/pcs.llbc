":[],"regions_outlive":[],"types_outlive":[{"regions":[],"skip_binder":[{"Deduplicated":41},{"Var":{"Free":0}}]}],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":111},{"Deduplicated":106}],"output":{"Deduplicated":106}},"src":{"TraitImpl":{"impl_ref":{"id":5,"generics":{"regions":[],"types":[{"Deduplicated":41}],"const_generics":[],"trait_refs":[]}},"trait_ref":{"id":3,"generics":{"regions":[],"types":[{"Deduplicated":111},{"Deduplicated":104},{"Deduplicated":104}],"const_generics":[],"trait_refs":[]}},"item_id":5,"reuses_default":true}},"body":"Opaque"},{"def_id":11,"item_meta":{"name":[{"Ident":["pcs",0]},{"Ident":["whir",0]},{"Ident":["verify",0]},{"Ident":["verify",0]}],"span":{"Untagged":{"data":{"file_id":6,"beg":{"line":357,"col":0},"end":{"line":437,"col":1}},"generated_from_span":null}},"source_text":"pub(crate) fn verify<V: OpeningVerifier>(\n    v: &mut V,\n    config: &Config,\n    log_n: usize,\n    n_lanes: usize,\n    target: V::E,\n    root: V::Root,\n    weight_at: impl WeightAt<V::E, V>,\n) -> Result<(), WhirError> {\n    // The typed wrapper checks shape before reading its record frame; keep\n    // direct internal callers safe too, without duplicating record binding.\n    check_config_shape(config, log_n)?;\n    let initial_k = config.initial_k();\n    let max = 1usize << initial_k;\n    if n_lanes == 0 || n_lanes > max {\n        return Err(WhirError::LaneCount { n_lanes, max });\n    }\n    let quad = RoundQuad::read(v, target)?;\n    let mut w = WhirReplay {\n        t_r: target,\n        quad,\n        ris: Vec::new(),\n        levels: Vec::new(),\n        oods: Vec::new(),\n    };\n    let mut n_current = log_n\n        .checked_sub(initial_k)\n        .ok_or(WhirError::InvalidShape { level: 0 })?;\n    // The lane fold.\n    // A hiding opening reveals between its last challenge and the next round's message.\n    let mut lane_fold = w.fold_rounds(v, initial_k - 1)?;\n    lane_fold.push(w.fold_challenge(v));\n    let padding = if config.padding() > 0 {\n        Some(w.reveal(v, config, n_current)?)\n    } else {\n        None\n    };\n    w.quad = RoundQuad::read(v, w.t_r)?;\n    let root_1 = v.next_root()?;\n    let oods = Ood::replay_all(v, config.ood_samples()[1], n_current)?;\n    let phase = WhirReplay::<V>::phase(config, 0, n_current + config.log_inv_rates()[0]);\n    // The proof stores the committed lanes, the image's tail, lane-descending.\n    // Reversed, block `b` sits at index `b`.\n    let batch = WhirReplay::begin_query(v, phase)?;\n    let sum = match v.open_rows(&root, phase.depth, &batch.queries, n_lanes, max) {\n        Ok(mut rows) => {\n            let mut r = 0;\n            while r < rows.len() {\n                rows[r].reverse();\n                r += 1;\n            }\n            Ok(BaseRows(rows).enforced_sum(v, &lane_fold, &batch.weights, &batch.queries, padding.as_ref()))\n        }\n        Err(error) => Err(error),\n    };\n    w.finish_query(v, batch, oods, n_current, sum)?;\n\n    let mut oracle = WhirReplay::<V>::oracle(config, root_1, 0, n_current)?;\n    for i in 0..config.level_steps() {\n        let k = config.level_ks()[i];\n        if n_current < k {\n            return Err(WhirError::InvalidShape { level: i });\n        }\n        let level_rs = w.fold_rounds(v, k)?;\n        n_current -= k;\n        if i + 1 == config.level_steps() {\n            return w.last_level(v, config, &oracle, &level_rs, n_current, weight_at);\n        }\n        let root = v.next_root()?;\n        let oods = Ood::replay_all(v, config.ood_samples()[i + 2], n_current)?;\n        let phase = WhirReplay::<V>::phase(config, i + 1, oracle.depth());\n        let batch = WhirReplay::begin_query(v, phase)?;\n        let sum = match oracle.open_e_rows(v, &batch.queries) {\n            Ok(rows) => Ok(rows.enforced_sum(v, &level_rs, &batch.weights)),\n            Err(error) => Err(error),\n        };\n        w.finish_query(v, batch, oods, n_current, sum)?;\n        oracle = WhirReplay::<V>::oracle(config, root, i + 1, n_current)?;\n    }\n    unreachable!(\"the configuration has at least one level\")\n}","attr_info":{"attributes":[{"DocComment":" Verify `sum_x f(x) * w(x) = target` for the witness `f` of `2^log_n` words committed at `root`."},{"DocComment":""},{"DocComment":" It takes no dense weight: `weight_at` evaluates the multilinear extension of `w` once, at the terminal point."},{"DocComment":" That point is indexed by witness coordinate."},{"DocComment":""},{"DocComment":" # Why the point is rotated"},{"DocComment":""},{"DocComment":" - The fold challenges arrive in round order."},{"DocComment":" - The first `initial_k` rounds, the lane fold, bind the witness's top `initial_k` coordinates."},{"DocComment":" - So the point is rotated left by `initial_k` before `weight_at` sees it."},{"DocComment":""},{"DocComment":" # What is never built"},{"DocComment":""},{"DocComment":" - A level's induced weight: its sum is recomputed from its opened rows, its value taken in closed form."},{"DocComment":" - The absent lanes: the L0 rows the proof stores are the `n_lanes` committed ones."},{"DocComment":""},{"DocComment":" Under a configuration that pads, the commitment is a hiding one, and after the lane fold's last challenge:"},{"DocComment":""},{"DocComment":" - a transcript still hidden is revealed: the verifier reads the running claim and checks it;"},{"DocComment":" - it reads the padding's lane fold, and each level-0 query takes the padding's share off its folded row."},{"DocComment":""},{"DocComment":" # Errors"},{"DocComment":""},{"DocComment":" - A lane count a leaf cannot hold, or a configuration that does not fit the witness."},{"DocComment":" - A malformed stream, a revealed claim the lane fold does not reach, or a terminal claim the opening does not reproduce."}],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":true,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[{"index":0,"name":"V","variance":"Invariant"},{"index":1,"name":"T1","variance":"Contravariant"},{"index":2,"name":"Clause0_Root","variance":"Invariant"},{"index":3,"name":"Clause0_K","variance":"Invariant"},{"index":4,"name":"Clause0_Query","variance":"Invariant"},{"index":5,"name":"Clause0_Clause0_Clause0_E","variance":"Invariant"},{"index":6,"name":"Clause1_Clause0_Root","variance":"Invariant"},{"index":7,"name":"Clause1_Clause0_K","variance":"Invariant"},{"index":8,"name":"Clause1_Clause0_Query","variance":"Invariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Value":[15,{"data":{"file_id":6,"beg":{"line":357,"col":24},"end":{"line":357,"col":39}},"generated_from_span":null}]},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":5,"generics":{"regions":[],"types":[{"Deduplicated":41},{"Deduplicated":58},{"Deduplicated":55},{"Deduplicated":50},{"Deduplicated":89}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":1,"span":{"Value":[16,{"data":{"file_id":6,"beg":{"line":364,"col":20},"end":{"line":364,"col":37}},"generated_from_span":null}]},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":6,"generics":{"regions":[],"types":[{"Deduplicated":47},{"Deduplicated":89},{"Deduplicated":41},{"Deduplicated":90},{"Deduplicated":91},{"Deduplicated":92}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[{"regions":[],"skip_binder":[{"Deduplicated":41},{"Var":{"Free":0}}]}],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":110},{"Value":[112,{"Ref":[{"Var":{"Free":1}},{"Deduplicated":6},"Shared"]}]},{"Deduplicated":0},{"Deduplicated":0},{"Deduplicated":89},{"Deduplicated":58},{"Deduplic