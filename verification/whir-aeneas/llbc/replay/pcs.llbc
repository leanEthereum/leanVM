committer hashed them: zero prefix shared, leaves batched.\n        let leaf_hashes = hash_rows(&self.rows, sorted.len(), row_words, leaf_words);\n        let mut leaves: Vec<Node> = Vec::with_capacity(sorted.len());\n        let mut i = 0;\n        while i < sorted.len() {\n            leaves.push((sorted[i], leaf_hashes[i]));\n            i += 1;\n        }\n        let (known, starts) = rebuild(leaves, &self.sibling_hashes, height, root)?;\n        expand(&self.rows, &sorted, &known, &starts, queries, row_words, leaf_words)\n    }","attr_info":{"attributes":[{"DocComment":" Authenticate this phase against `root`, and expand it into one opening per query, in query order."},{"DocComment":""},{"DocComment":" - It is the one way to consume a phase, so no row is read before the Merkle check runs."},{"DocComment":" - Rebuilding every node on the queried paths recomputes the root and yields each query's full sibling path."},{"DocComment":" - So the pruned form is checked and the unpruned form produced in one walk."},{"DocComment":""},{"DocComment":" # Returns"},{"DocComment":""},{"DocComment":" Nothing on a wrong row count or width, an out-of-range query, a wrong sibling count, or another root."}],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":true,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown"},{"index":2,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Value":[295,{"Ref":[{"Var":{"Free":0}},{"Deduplicated":5},"Shared"]}]},{"Value":[296,{"Ref":[{"Var":{"Free":1}},{"Deduplicated":44},"Shared"]}]},{"Deduplicated":0},{"Value":[29