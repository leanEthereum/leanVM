ull = if j == 0 { lo } else { a.mul(lo, full) };\n                partial = if started {\n                    a.mul_add(hi, partial, lower_full)\n                } else {\n                    lower_full\n                };\n                started = true;\n            } else {\n                partial = a.mul(lo, partial);\n            }\n        }\n        // Higher zero count bits never consume full_j, so do not build it.\n        if shape.n_lanes >> (j + 1) != 0 {\n            full = if j == 0 { factor } else { a.mul(full, factor) };\n        }\n        j += 1;\n    }\n    a.mul(low, partial)\n}","attr_info":{"attributes":[{"DocComment":" The multilinear extension of the anchor weight on the occupied support."},{"DocComment":""},{"DocComment":" The low coordinates span whole lane blocks. On the high coordinates the"},{"DocComment":" weight is `sum_{lane < n_lanes} eq(lane, r) * eq(lane, point)`, not the"},{"DocComment":" full-cube equality product when the last lanes are absent."}],"inline":null,"rename":null,"public":false},"is_local":true,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"generics":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"},{"index":1,"name":null,"variance":"Covariant","mutability":"Unknown"},{"index":2,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[{"index":0,"name":"A","variance":"Invariant"},{"index":1,"name":"Clause0_E","variance":"Invariant"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"Value":[2177,{"data":{"file_id":50,"beg":{"line":105,"col":30},"end":{"line":105,"col":35}},"generated_from_span":null}]},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":6,"generics":{"regions":[],"types":[{"Deduplicated":18},{"Deduplicated":20}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[{"regions":[],"skip_binder":[{"Deduplicated":18},{"Var":{"Free":