rn":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":1061},{"Deduplicated":0},{"Deduplicated":20},{"Value":[1069,{"Adt":{"id":10,"generics":{"regions":[],"types":[{"Deduplicated":20}],"const_generics":[],"trait_refs":[]},"builtin":null}}]}],"output":{"Deduplicated":350}},"default":null},"kind":{"TraitMethod":[7,1]}},{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"sample","item_meta":{"name":[{"Ident":["fiat_shamir",0]},{"Ident":["arith",0]},{"Ident":["Verifier",0]},{"Ident":["sample",0]}],"span":{"Untagged":{"data":{"file_id":13,"beg":{"line":257,"col":4},"end":{"line":257,"col":36}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A challenge."}],"inline":null,"rename":null,"public":true},"is_local":false,"started_from":false,"is_extern":false,"opacity":"Transparent","lang_item":null,"diagnostic_item":null,"has_errors":false},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":1061}],"output":{"Deduplicated":20}},"default":null},"kind":{"TraitMethod":[7,2]}},{"params":{"regions":[{"index":0,"name":null,"variance":"Covariant","mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"grind_check","item_meta":{"name":[{"Ident":["fiat_shamir",0]},{"Ident":["arith",0]},{"Ident":["Verifier",0]},{"Ident":["grind_check",0]}],"span":{"Untagged":{"data":{"file_id":13,"beg":{"line":264,"col":4},"end":{"line":264,"col":72}},"generated_from_span":null}},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Read a nonce, check it clears a proof of work of the given bits, th