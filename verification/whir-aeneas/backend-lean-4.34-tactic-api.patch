-open Lean.Elab.Tactic.BVDecide.Frontend Lean.Elab in
+-- The 4.34 frontend keys bit-vector expressions by their elaborated width. Generalize scalar projections at the alias used in the goal and retain the numeral syntax expected by the frontend.
+meta def canonicalScalarBvs : TacticM Unit := withMainContext do
+  let mut args : Array GeneralizeArg := #[]
+  let mut hyps : Array FVarId := #[]
+  for decl in ← getLCtx do
+    if !decl.isImplementationDetail then
+      hyps := hyps.push decl.fvarId
+      let ty ← withTransparency .all (whnf decl.type)
+      let projection := if ty.isAppOf ``Std.UScalar then some ``Std.UScalar.bv
+                        else if ty.isAppOf ``Std.IScalar then some ``Std.IScalar.bv
+                        else none
+      if let some projection := projection then
+        let aliasName? := match decl.type.consumeMData.getAppFn with
+          | .const name _ => some (name ++ `bv)
+          | _ => none
+        let env ← getEnv
+        let projection := match aliasName? with
+          | some name => if env.contains name then name else projection
+          | none => projection
+        args := args.push { expr := ← mkAppM projection #[decl.toExpr] }
+  unless args.isEmpty do
+    let (_, fields, firstGoal) ← (← getMainGoal).generalizeHyp args hyps
+    let mut goal := firstGoal
+    for field in fields.take args.size do
+      goal ← goal.withContext do
+        let ty ← inferType (.fvar field)
+        let_expr BitVec width := ty | return goal
+        let width ← withTransparency .all (whnf width)
+        let width := match width with
+          | .lit (.natVal n) => mkNatLit n
+          | width => width
+        return ← goal.changeLocalDecl field (mkApp (mkConst ``BitVec) width)
+    replaceMainGoal [goal]
+
+open Lean.Meta.Tactic.BVDecide Lean.Elab in
 /-- `bv_tac n` solves goals about bit-vectors.
 
 **Usage**: `bv_tac n` where `n` is the bitwidth to use for the bit-vectors.
